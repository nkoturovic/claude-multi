 	helps.LogWithRequestID(ctx).Debugf("request error, error status: %d, failure kind: %s", failure.StatusCode(), failure.Kind)
 	return failure
diff --git a/internal/runtime/executor/retry_after_cm053_test.go b/internal/runtime/executor/retry_after_cm053_test.go
new file mode 100644
index 0000000..b3232f9
--- /dev/null
+++ b/internal/runtime/executor/retry_after_cm053_test.go
@@ -0,0 +1,331 @@
+package executor
+
+// Every managed executor attaches a typed, validated upstream
+// Retry-After hint (retryhint.Carrier) to its terminal 429/503 error at the
+// upstream response boundary: Claude ordinary execute/stream/token count,
+// Codex execute/stream/compact, OpenAI-compatible chat/stream/compact, keyed
+// (in the safe failure representation) and keyless. The Claude fast path is a
+// direct response: it forwards upstream headers by design and carries no
+// separate hint (the handler canonicalizes its Retry-After). HTTP upstreams
+// are injected RoundTrippers (no socket is opened); the Codex WebSocket
+// rejected-upgrade case needs a real handshake and uses a loopback
+// httptest server.
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/compatsafe"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/logging"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/retryhint"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+type cm053RetryUpstream struct {
+	status int
+	values []string
+	// delay holds back the first read of the failure body (the upstream
+	// headers have already arrived).
+	delay time.Duration
+}
+
+type cm053SlowBody struct {
+	io.Reader
+	delay time.Duration
+	once  sync.Once
+}
+
+func (b *cm053SlowBody) Read(p []byte) (int, error) {
+	b.once.Do(func() { time.Sleep(b.delay) })
+	return b.Reader.Read(p)
+}
+
+func (b *cm053SlowBody) Close() error { return nil }
+
+func (u cm053RetryUpstream) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Body != nil {
+		_, _ = io.Copy(io.Discard, req.Body)
+		_ = req.Body.Close()
+	}
+	header := http.Header{"Content-Type": {"application/json"}}
+	if u.values != nil {
+		header["Retry-After"] = u.values
+	}
+	body := `{"error":{"type":"rate_limit_error","message":"cm053 upstream busy"}}`
+	return &http.Response{StatusCode: u.status, Status: http.StatusText(u.status), Header: header, Body: &cm053SlowBody{Reader: strings.NewReader(body), delay: u.delay}, Request: req, ProtoMajor: 1, ProtoMinor: 1}, nil
+}
+
+type cm053RetryEntry struct {
+	cm053EntryPoint
+	stream bool
+	keyed  bool
+}
+
+func cm053RetryEntries() []cm053RetryEntry {
+	var entries []cm053RetryEntry
+	for _, entry := range cm053ClaudeEntryPoints() {
+		if strings.Contains(entry.name, "fast") {
+			continue
+		}
+		entries = append(entries, cm053RetryEntry{entry, strings.HasSuffix(entry.name, "stream"), false})
+	}
+	for _, entry := range cm053CodexEntryPoints() {
+		entries = append(entries, cm053RetryEntry{entry, strings.HasSuffix(entry.name, "stream"), false})
+	}
+	for _, keyed := range []bool{false, true} {
+		for _, entry := range cm053CompatEntryPoints(keyed) {
+			if keyed {
+				entry.name = "keyed-" + entry.name
+			}
+			entries = append(entries, cm053RetryEntry{entry, strings.HasSuffix(entry.name, "stream"), keyed && !strings.HasSuffix(entry.name, "compact")})
+		}
+	}
+	return entries
+}
+
+func cm053RunRetryEntry(t *testing.T, entry cm053RetryEntry, upstream cm053RetryUpstream) error {
+	t.Helper()
+	capture := cm053CaptureContext(upstream)
+	return entry.run(capture.ctx, &config.Config{})
+}
+
+func cm053AssertCarrier(t *testing.T, err error, status int, want string) {
+	t.Helper()
+	if err == nil {
+		t.Fatal("upstream failure returned no error")
+	}
+	hint, carrierStatus, ok := retryhint.From(err)
+	if want == "" {
+		if ok {
+			t.Fatalf("error %T carries a hint on a %d it must not have", err, status)
+		}
+		return
+	}
+	if !ok || carrierStatus != status {
+		t.Fatalf("error %T (%v) carries no hint for its %d (ok=%t status=%d)", err, err, status, ok, carrierStatus)
+	}
+	got, _ := hint.Value(time.Now())
+	if got != want && !(want != "0" && got == decrementSeconds(want)) {
+		t.Fatalf("hint value = %q, want %q", got, want)
+	}
+	if value, okValue := retryhint.ResponseValue(err, status, time.Now()); !okValue || (value != got && value != decrementSeconds(got)) {
+		t.Fatalf("ResponseValue = %q/%t, want %q", value, okValue, got)
+	}
+}
+
+// decrementSeconds tolerates one second elapsing between receipt and check.
+func decrementSeconds(value string) string {
+	n, errAtoi := strconv.Atoi(value)
+	if errAtoi != nil || n == 0 {
+		return value
+	}
+	return strconv.Itoa(n - 1)
+}
+
+func cm053RetryMatrix(t *testing.T, streamOnly bool) {
+	for _, entry := range cm053RetryEntries() {
+		if streamOnly && !entry.stream {
+			continue
+		}
+		for _, tc := range []struct {
+			name   string
+			status int
+			values []string
+			want   string
+		}{
+			{"429-120", http.StatusTooManyRequests, []string{"120"}, "120"},
+			{"429-zero", http.StatusTooManyRequests, []string{"0"}, "0"},
+			{"503-5", http.StatusServiceUnavailable, []string{"5"}, "5"},
+			{"429-date", http.StatusTooManyRequests, []string{time.Now().Add(-time.Hour).UTC().Format(http.TimeFormat)}, "0"},
+			{"429-duplicate", http.StatusTooManyRequests, []string{"5", "5"}, ""},
+			{"429-invalid", http.StatusTooManyRequests, []string{"-5"}, ""},
+			{"429-none", http.StatusTooManyRequests, nil, ""},
+			{"500-never", http.StatusInternalServerError, []string{"5"}, ""},
+		} {
+			t.Run(entry.name+"/"+tc.name, func(t *testing.T) {
+				err := cm053RunRetryEntry(t, entry, cm053RetryUpstream{status: tc.status, values: tc.values})
+				status := tc.status
+				// Codex maps some bodies to 429; this body is a plain rate limit.
+				cm053AssertCarrier(t, err, status, tc.want)
+				if entry.keyed {
+					var safe compatsafe.Error
+					if !errors.As(err, &safe) || err.Error() != safe.Kind.Body() || strings.Contains(err.Error(), "cm053 upstream busy") {
+						t.Fatalf("keyed compat error %T %q left the safe representation", err, err)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestCM053RetryAfterExecutorCarriers(t *testing.T) {
+	cm053RetryMatrix(t, false)
+
+	// The Claude fast path is a direct response: the upstream Retry-After is
+	// in its forwarded headers (canonicalized by the handler), never a second
+	// typed hint.
+	for _, entry := range cm053ClaudeEntryPoints() {
+		if !strings.Contains(entry.name, "fast") {
+			continue
+		}
+		t.Run(entry.name+"/direct", func(t *testing.T) {
+			capture := cm053CaptureContext(cm053RetryUpstream{status: http.StatusTooManyRequests, values: []string{"120"}})
+			err := entry.run(capture.ctx, &config.Config{})
+			if _, _, ok := retryhint.From(err); ok {
+				t.Fatalf("fast direct response also carries a typed hint: %T", err)
+			}
+			var direct *cliproxyexecutor.RequestTerminatedError
+			if !errors.As(err, &direct) || direct.ResponseHeaders().Get("Retry-After") != "120" {
+				t.Fatalf("fast path error = %T %v, want a direct response forwarding Retry-After", err, err)
+			}
+		})
+	}
+
+	// The gateway's own retry timing is untouched: the compat 429 keeps its
+	// Retry-After parse, the Claude/Codex/compat 503 keeps none.
+	compat := cm053RetryEntry{cm053CompatEntryPoints(false)[0], false, false}
+	err := cm053RunRetryEntry(t, compat, cm053RetryUpstream{status: http.StatusTooManyRequests, values: []string{"120"}})
+	if rap, ok := err.(interface{ RetryAfter() *time.Duration }); !ok || rap.RetryAfter() == nil || *rap.RetryAfter() != 120*time.Second {
+		t.Fatalf("compat internal retry timing changed: %v", err)
+	}
+	err = cm053RunRetryEntry(t, compat, cm053RetryUpstream{status: http.StatusServiceUnavailable, values: []string{"120"}})
+	if rap, ok := err.(interface{ RetryAfter() *time.Duration }); !ok || rap.RetryAfter() != nil {
+		t.Fatalf("compat 503 gained internal retry timing: %v", err)
+	}
+}
+
+func TestCM053RetryAfterStreamingBootstrap(t *testing.T) {
+	cm053RetryMatrix(t, true)
+}
+
+// TestCM053RetryAfterReceiptDeadline: the upstream Retry-After deadline
+// starts when the response headers arrive, not after the failure body has
+// been read and handled. Retry-After: 1 with a body whose first read takes
+// 1.2 s must be emitted as 0 by every carrier (ordinary execute, stream
+// bootstrap, keyed and keyless compat) and by the Claude fast direct path.
+func TestCM053RetryAfterReceiptDeadline(t *testing.T) {
+	const delay = 1200 * time.Millisecond
+	// The subtests run in parallel (each waits on a slow body): gin's global
+	// mode is set once here, never from a parallel subtest.
+	gin.SetMode(gin.TestMode)
+	receiptContext := func(upstream http.RoundTripper) context.Context {
+		ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+		ginCtx.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+		ctx := context.WithValue(context.Background(), "gin", ginCtx)
+		ctx = logging.WithResponseHeadersHolder(ctx)
+		return context.WithValue(ctx, "cliproxy.roundtripper", upstream)
+	}
+	for _, status := range []int{http.StatusTooManyRequests, http.StatusServiceUnavailable} {
+		for _, entry := range cm053RetryEntries() {
+			t.Run(entry.name+"/"+strconv.Itoa(status), func(t *testing.T) {
+				t.Parallel()
+				err := entry.run(receiptContext(cm053RetryUpstream{status: status, values: []string{"1"}, delay: delay}), &config.Config{})
+				cm053AssertCarrier(t, err, status, "0")
+			})
+		}
+		for _, entry := range cm053ClaudeEntryPoints() {
+			if !strings.Contains(entry.name, "fast") {
+				continue
+			}
+			t.Run(entry.name+"/direct/"+strconv.Itoa(status), func(t *testing.T) {
+				t.Parallel()
+				err := entry.run(receiptContext(cm053RetryUpstream{status: status, values: []string{"1"}, delay: delay}), &config.Config{})
+				var direct *cliproxyexecutor.RequestTerminatedError
+				if !errors.As(err, &direct) {
+					t.Fatalf("fast path error = %T %v, want a direct response", err, err)
+				}
+				header := direct.ResponseHeaders().Clone()
+				retryhint.CanonicalizeDirectHeader(header, err, time.Now())
+				if got := header.Values("Retry-After"); len(got) != 1 || got[0] != "0" {
+					t.Fatalf("direct Retry-After = %v, want [0] (the deadline from receipt)", got)
+				}
+			})
+		}
+	}
+}
+
+// TestCM053RetryAfterWebsocketDelayedBodyDeadline: a rejected Codex WebSocket
+// upgrade (429/503 with Retry-After) whose body is delayed. gorilla's dialer
+// reads the rejected handshake's body before DialContext returns, so the
+// deadline must start when the handshake response arrived, not when the dial
+// returned. The upstream (a loopback test server) flushes the status line and
+// headers with Retry-After: 1 at once and sends the body 1.2 s later: both
+// CodexWebsocketsExecutor paths (Execute and ExecuteStream) must carry a hint
+// that serializes as 0. The prompt control (Retry-After: 120, body at once)
+// shows the WebSocket carrier keeps a live deadline rather than zeroing it.
+func TestCM053RetryAfterWebsocketDelayedBodyDeadline(t *testing.T) {
+	body := `{"error":{"type":"rate_limit_error","message":"cm053 upstream busy"}}`
+	for _, tc := range []struct {
+		name, value, want string
+		delay             time.Duration
+	}{
+		{"delayed-body", "1", "0", 1200 * time.Millisecond},
+		{"prompt-body", "120", "120", 0},
+	} {
+		for _, status := range []int{http.StatusTooManyRequests, http.StatusServiceUnavailable} {
+			for _, path := range []string{"execute", "stream"} {
+				t.Run(tc.name+"/"+path+"/"+strconv.Itoa(status), func(t *testing.T) {
+					t.Parallel()
+					var upgrades atomic.Int32
+					upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						if strings.EqualFold(r.Header.Get("Upgrade"), "websocket") {
+							upgrades.Add(1)
+						}
+						w.Header().Set("Content-Type", "application/json")
+						w.Header().Set("Retry-After", tc.value)
+						w.Header().Set("Content-Length", strconv.Itoa(len(body)))
+						w.WriteHeader(status)
+						w.(http.Flusher).Flush()
+						select {
+						case <-time.After(tc.delay):
+						case <-r.Context().Done():
+							return
+						}
+						_, _ = io.WriteString(w, body)
+					}))
+					defer upstream.Close()
+					ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+					defer cancel()
+					exec := NewCodexWebsocketsExecutor(&config.Config{})
+					exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+					credential := &cliproxyauth.Auth{ID: "cm053-ws-retry-after", Provider: "codex", Status: cliproxyauth.StatusActive, Attributes: map[string]string{
+						"api_key": "cm053-key", "base_url": upstream.URL, "websockets": "true",
+					}}
+					req := cliproxyexecutor.Request{Model: "cm053-ws-model", Payload: []byte(`{"model":"cm053-ws-model","input":[]}`)}
+					opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("codex")}
+					start := time.Now()
+					var err error
+					if path == "execute" {
+						_, err = exec.Execute(ctx, credential, req, opts)
+					} else {
+						var result *cliproxyexecutor.StreamResult
+						result, err = exec.ExecuteStream(ctx, credential, req, opts)
+						if result != nil {
+							t.Fatalf("rejected upgrade returned a stream: %+v", result)
+						}
+					}
+					if elapsed := time.Since(start); elapsed < tc.delay {
+						t.Fatalf("returned after %v, before the delayed body (%v): the case does not discriminate", elapsed, tc.delay)
+					}
+					if upgrades.Load() != 1 {
+						t.Fatalf("upstream saw %d WebSocket upgrade requests, want exactly 1", upgrades.Load())
+					}
+					cm053AssertCarrier(t, err, status, tc.want)
+				})
+			}
+		}
+	}
+}
