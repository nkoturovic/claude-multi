+package handlers
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/interfaces"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/retryhint"
+)
+
+// The base (OpenAI/Gemini) error writer emits one validated
+// upstream Retry-After on a terminal 429/503 and canonicalizes the forwarded
+// Retry-After of a direct response.
+
+type cm053BaseHintErr struct {
+	status int
+	hint   retryhint.Hint
+}
+
+func (e cm053BaseHintErr) Error() string   { return `{"error":{"message":"cm053 busy"}}` }
+func (e cm053BaseHintErr) StatusCode() int { return e.status }
+func (e cm053BaseHintErr) UpstreamRetryAfter() (retryhint.Hint, bool) {
+	return e.hint, e.hint.Valid()
+}
+
+// cm053BaseDirectErr is a direct response error that validated its
+// Retry-After when the upstream headers arrived.
+type cm053BaseDirectErr struct{ hint retryhint.Hint }
+
+func (e cm053BaseDirectErr) Error() string { return "cm053 direct" }
+func (e cm053BaseDirectErr) DirectRetryAfter() (retryhint.Hint, bool) {
+	return e.hint, e.hint.Valid()
+}
+
+func TestCM053RetryAfterBaseHandlerWriter(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	hint, _ := retryhint.Parse([]string{"42"}, time.Now())
+	spent, _ := retryhint.Parse([]string{"1"}, time.Now().Add(-2*time.Second))
+	handler := &BaseAPIHandler{}
+	write := func(msg *interfaces.ErrorMessage) *httptest.ResponseRecorder {
+		recorder := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(recorder)
+		handler.WriteErrorResponse(c, msg)
+		return recorder
+	}
+	for _, tc := range []struct {
+		name string
+		msg  *interfaces.ErrorMessage
+		want []string
+	}{
+		{"429", &interfaces.ErrorMessage{StatusCode: 429, Error: cm053BaseHintErr{429, hint}}, []string{"42"}},
+		{"503", &interfaces.ErrorMessage{StatusCode: 503, Error: cm053BaseHintErr{503, hint}}, []string{"42"}},
+		{"500", &interfaces.ErrorMessage{StatusCode: 500, Error: cm053BaseHintErr{500, hint}}, nil},
+		{"status-mismatch", &interfaces.ErrorMessage{StatusCode: 503, Error: cm053BaseHintErr{429, hint}}, nil},
+		{"passthrough-off-addon-ignored", &interfaces.ErrorMessage{StatusCode: 429, Error: cm053BaseHintErr{429, retryhint.Hint{}}, Addon: http.Header{"Retry-After": {"9"}, "X-Upstream": {"v"}}}, nil},
+		{"direct-duplicate", &interfaces.ErrorMessage{StatusCode: 429, DirectResponse: true, Headers: http.Header{"Retry-After": {"5", "5"}}, Body: []byte(`{}`)}, nil},
+		{"direct-single", &interfaces.ErrorMessage{StatusCode: 429, DirectResponse: true, Headers: http.Header{"Retry-After": {"5"}}, Body: []byte(`{}`)}, []string{"5"}},
+		{"direct-receipt-deadline", &interfaces.ErrorMessage{StatusCode: 429, DirectResponse: true, Error: cm053BaseDirectErr{spent}, Headers: http.Header{"Retry-After": {"1"}}, Body: []byte(`{}`)}, []string{"0"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			recorder := write(tc.msg)
+			got := recorder.Header().Values("Retry-After")
+			if len(got) != len(tc.want) || (len(got) == 1 && got[0] != tc.want[0]) {
+				t.Fatalf("Retry-After = %v, want %v", got, tc.want)
+			}
+			if recorder.Header().Get("X-Upstream") != "" {
+				t.Fatalf("an addon header was forwarded with passthrough off: %v", recorder.Header())
+			}
+		})
+	}
+}
