diff --git a/internal/retryhint/retryhint.go b/internal/retryhint/retryhint.go
new file mode 100644
index 0000000..be67635
--- /dev/null
+++ b/internal/retryhint/retryhint.go
@@ -0,0 +1,204 @@
+// Package retryhint carries a validated upstream Retry-After hint from the
+// upstream response boundary to the gateway's terminal error response
+// (claude-multi retry-after).
+//
+// General upstream header passthrough stays off. An executor parses the
+// upstream Retry-After of a failure once, at the response boundary, into a
+// typed Hint (never a raw header map) and attaches it to the error it
+// returns. The handler that writes the terminal 429/503 re-serializes one
+// canonical delta-seconds value from it, after any trusted local recovery
+// header (which wins), before the response headers are committed. A hint
+// keeps the upstream deadline: time already spent in the gateway is
+// subtracted at emission rather than restarting the wait. There is no gateway
+// clamp. Mid-stream errors (after headers are committed) are out of scope.
+//
+// The package depends on the standard library only.
+package retryhint
+
+import (
+	"errors"
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// MaxValueLength bounds the accepted header value (an HTTP-date is 29 bytes).
+const MaxValueLength = 64
+
+// maxDeltaSeconds is the largest delta that fits a time.Duration.
+const maxDeltaSeconds = int64(math.MaxInt64 / int64(time.Second))
+
+// Hint is a validated upstream Retry-After deadline. The zero Hint is "no
+// hint"; a valid "0" is a hint with a deadline at receipt.
+type Hint struct {
+	deadline time.Time
+	valid    bool
+}
+
+// Valid reports whether h is a hint (as opposed to no hint).
+func (h Hint) Valid() bool { return h.valid }
+
+// Remaining returns the wait left at now, never negative. ok is false for
+// no hint.
+func (h Hint) Remaining(now time.Time) (time.Duration, bool) {
+	if !h.valid {
+		return 0, false
+	}
+	remaining := h.deadline.Sub(now)
+	if remaining < 0 {
+		remaining = 0
+	}
+	return remaining, true
+}
+
+// Value returns the one canonical Retry-After value at now: whole
+// delta-seconds, rounded up. ok is false for no hint.
+func (h Hint) Value(now time.Time) (string, bool) {
+	remaining, ok := h.Remaining(now)
+	if !ok {
+		return "", false
+	}
+	seconds := int64(remaining / time.Second)
+	if remaining%time.Second != 0 {
+		seconds++
+	}
+	return strconv.FormatInt(seconds, 10), true
+}
+
+// Parse validates the Retry-After values of one upstream response received
+// at now. Exactly one value is accepted: delta-seconds (ASCII digits only,
+// fitting a time.Duration) or an HTTP-date; a past date is a zero wait. No
+// value, several values (even identical ones), an over-long, negative,
+// signed, fractional, overflowing or otherwise malformed value is no hint.
+func Parse(values []string, now time.Time) (Hint, bool) {
+	if len(values) != 1 {
+		return Hint{}, false
+	}
+	raw := strings.Trim(values[0], " \t")
+	if raw == "" || len(raw) > MaxValueLength {
+		return Hint{}, false
+	}
+	if isDigits(raw) {
+		seconds, errParse := strconv.ParseInt(raw, 10, 64)
+		if errParse != nil || seconds > maxDeltaSeconds {
+			return Hint{}, false
+		}
+		return Hint{deadline: now.Add(time.Duration(seconds) * time.Second), valid: true}, true
+	}
+	date, errParse := http.ParseTime(raw)
+	if errParse != nil {
+		return Hint{}, false
+	}
+	if date.Before(now) {
+		date = now
+	}
+	return Hint{deadline: date, valid: true}, true
+}
+
+// FromHeader parses the Retry-After field of header (see Parse).
+func FromHeader(header http.Header, now time.Time) (Hint, bool) {
+	if header == nil {
+		return Hint{}, false
+	}
+	return Parse(header.Values("Retry-After"), now)
+}
+
+func isDigits(value string) bool {
+	for i := 0; i < len(value); i++ {
+		if value[i] < '0' || value[i] > '9' {
+			return false
+		}
+	}
+	return value != ""
+}
+
+// Carrier is implemented by an upstream failure that carries a hint. The
+// status is the carrier's own HTTP status: a hint is emitted only on a
+// terminal response with that same 429 or 503 status.
+type Carrier interface {
+	UpstreamRetryAfter() (Hint, bool)
+	StatusCode() int
+}
+
+// From returns the hint of the first carrier in err's chain.
+func From(err error) (Hint, int, bool) {
+	var carrier Carrier
+	if err == nil || !errors.As(err, &carrier) || carrier == nil {
+		return Hint{}, 0, false
+	}
+	hint, ok := carrier.UpstreamRetryAfter()
+	if !ok || !hint.Valid() {
+		return Hint{}, 0, false
+	}
+	return hint, carrier.StatusCode(), true
+}
+
+// Emittable reports whether a terminal response with status may carry an
+// upstream hint.
+func Emittable(status int) bool {
+	return status == http.StatusTooManyRequests || status == http.StatusServiceUnavailable
+}
+
+// ResponseValue returns the one canonical Retry-After value for a terminal
+// error response with status, when err carries an upstream hint whose
+// carrier has that same 429 or 503 status.
+func ResponseValue(err error, status int, now time.Time) (string, bool) {
+	if !Emittable(status) {
+		return "", false
+	}
+	hint, carrierStatus, ok := From(err)
+	if !ok || carrierStatus != status {
+		return "", false
+	}
+	return hint.Value(now)
+}
+
+// DirectCarrier is implemented by a direct upstream response error (one
+// whose headers are forwarded as they are) that validated its response's
+// Retry-After when the response headers arrived. It is deliberately not a
+// Carrier: a direct response never gains a second, typed Retry-After.
+type DirectCarrier interface {
+	DirectRetryAfter() (Hint, bool)
+}
+
+// CanonicalizeHeader replaces the Retry-After field of a forwarded upstream
+// header set (the direct-response path, which forwards upstream headers by
+// design) with at most one canonical value: a valid hint is re-serialized, an
+// invalid or duplicated field is dropped. Other fields are untouched.
+func CanonicalizeHeader(header http.Header, now time.Time) {
+	CanonicalizeDirectHeader(header, nil, now)
+}
+
+// CanonicalizeDirectHeader is CanonicalizeHeader for the direct response
+// built from err. When err carries a DirectCarrier hint (validated when the
+// upstream response headers arrived), that deadline is serialized at now, so
+// time spent reading and handling the failure is not added back to the
+// client's wait; otherwise the forwarded value is validated at now (a
+// response built in process, for example by an interceptor). Nothing is
+// emitted unless the forwarded header set has a Retry-After field.
+func CanonicalizeDirectHeader(header http.Header, err error, now time.Time) {
+	if header == nil {
+		return
+	}
+	values := header.Values("Retry-After")
+	if len(values) == 0 {
+		return
+	}
+	header.Del("Retry-After")
+	var direct DirectCarrier
+	if err != nil && errors.As(err, &direct) && direct != nil {
+		if hint, ok := direct.DirectRetryAfter(); ok && hint.Valid() {
+			if value, okValue := hint.Value(now); okValue {
+				header.Set("Retry-After", value)
+			}
+			return
+		}
+	}
+	if hint, ok := Parse(values, now); ok {
+		if value, okValue := hint.Value(now); okValue {
+			header.Set("Retry-After", value)
+		}
+	}
+}
diff --git a/internal/retryhint/retryhint_cm053_test.go b/internal/retryhint/retryhint_cm053_test.go
new file mode 100644
index 0000000..2cb95c3
--- /dev/null
+++ b/internal/retryhint/retryhint_cm053_test.go
@@ -0,0 +1,174 @@
+package retryhint
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+// The typed upstream Retry-After hint.
+
+func TestCM053RetryAfterParseAndCanonicalize(t *testing.T) {
+	now := time.Date(2026, 9, 28, 12, 0, 0, 0, time.UTC)
+	valid := []struct {
+		in   string
+		want string
+	}{
+		{"0", "0"},
+		{"5", "5"},
+		{"3600", "3600"},
+		{"30000", "30000"},
+		{" \t7 ", "7"},
+		{"007", "7"},
+		{now.Add(90 * time.Second).Format(http.TimeFormat), "90"},
+		{now.Add(-time.Hour).Format(http.TimeFormat), "0"},
+		{now.Add(90 * time.Second).Format(time.RFC850), "90"},
+		{now.Add(90 * time.Second).Format(time.ANSIC), "90"},
+		{fmt.Sprint(maxDeltaSeconds), fmt.Sprint(maxDeltaSeconds)},
+	}
+	for _, tc := range valid {
+		hint, ok := Parse([]string{tc.in}, now)
+		if !ok || !hint.Valid() {
+			t.Fatalf("Parse(%q) rejected a valid value", tc.in)
+		}
+		if got, okValue := hint.Value(now); !okValue || got != tc.want {
+			t.Fatalf("Parse(%q).Value = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+	invalid := [][]string{
+		nil,
+		{},
+		{""},
+		{"   "},
+		{"-5"},
+		{"+5"},
+		{"5.0"},
+		{"1e3"},
+		{"0x10"},
+		{"5 5"},
+		{"soon"},
+		{"5", "5"},
+		{"5", "6"},
+		{"99999999999999999999"},
+		{fmt.Sprint(maxDeltaSeconds + 1)},
+		{strings.Repeat("1", MaxValueLength+1)},
+		{"Mon, 32 Sep 2026 12:00:00 GMT"},
+	}
+	for _, in := range invalid {
+		if hint, ok := Parse(in, now); ok || hint.Valid() {
+			t.Fatalf("Parse(%q) accepted an invalid value", in)
+		}
+	}
+
+	var none Hint
+	if _, ok := none.Value(now); ok || none.Valid() {
+		t.Fatal("the zero Hint is a hint")
+	}
+	zero, _ := Parse([]string{"0"}, now)
+	if !zero.Valid() {
+		t.Fatal("a valid 0 is not distinguished from no hint")
+	}
+
+	// The upstream deadline is kept: time already spent is subtracted and
+	// the remainder is rounded up.
+	ten, _ := Parse([]string{"10"}, now)
+	for spent, want := range map[time.Duration]string{0: "10", 3500 * time.Millisecond: "7", 10 * time.Second: "0", time.Minute: "0"} {
+		if got, _ := ten.Value(now.Add(spent)); got != want {
+			t.Fatalf("after %s: Value = %q, want %q", spent, got, want)
+		}
+	}
+
+	header := http.Header{"Retry-After": {"30", "30"}, "X-Other": {"kept"}}
+	CanonicalizeHeader(header, now)
+	if len(header.Values("Retry-After")) != 0 || header.Get("X-Other") != "kept" {
+		t.Fatalf("duplicate Retry-After not dropped: %v", header)
+	}
+	header = http.Header{"Retry-After": {now.Add(2 * time.Minute).Format(http.TimeFormat)}}
+	CanonicalizeHeader(header, now)
+	if got := header.Values("Retry-After"); len(got) != 1 || got[0] != "120" {
+		t.Fatalf("date not canonicalized: %v", got)
+	}
+	header = http.Header{"Retry-After": {"later"}}
+	CanonicalizeHeader(header, now)
+	if len(header.Values("Retry-After")) != 0 {
+		t.Fatalf("invalid Retry-After kept: %v", header)
+	}
+	CanonicalizeHeader(nil, now)
+}
+
+type cm053Carrier struct {
+	status int
+	hint   Hint
+}
+
+func (c cm053Carrier) Error() string                    { return "carrier" }
+func (c cm053Carrier) StatusCode() int                  { return c.status }
+func (c cm053Carrier) UpstreamRetryAfter() (Hint, bool) { return c.hint, c.hint.Valid() }
+
+func TestCM053RetryAfterResponseValueGating(t *testing.T) {
+	now := time.Now()
+	hint, _ := Parse([]string{"5"}, now)
+	for _, tc := range []struct {
+		err    error
+		status int
+		ok     bool
+	}{
+		{cm053Carrier{429, hint}, 429, true},
+		{cm053Carrier{503, hint}, 503, true},
+		{fmt.Errorf("wrapped: %w", cm053Carrier{429, hint}), 429, true},
+		{cm053Carrier{429, hint}, 503, false},
+		{cm053Carrier{500, hint}, 500, false},
+		{cm053Carrier{429, Hint{}}, 429, false},
+		{errors.New("plain"), 429, false},
+		{nil, 429, false},
+	} {
+		if _, ok := ResponseValue(tc.err, tc.status, now); ok != tc.ok {
+			t.Fatalf("ResponseValue(%v, %d) ok = %t, want %t", tc.err, tc.status, ok, tc.ok)
+		}
+	}
+}
+
+type cm053DirectErr struct{ hint Hint }
+
+func (e cm053DirectErr) Error() string                  { return "cm053 direct response" }
+func (e cm053DirectErr) DirectRetryAfter() (Hint, bool) { return e.hint, e.hint.Valid() }
+
+// TestCM053RetryAfterDirectReceiptDeadline: a direct response serializes the
+// deadline its executor validated when the upstream headers arrived, not a
+// re-parse of the forwarded value at emission (time spent receiving and
+// handling the failure is not added back to the wait).
+func TestCM053RetryAfterDirectReceiptDeadline(t *testing.T) {
+	received := time.Date(2026, 9, 28, 12, 0, 0, 0, time.UTC)
+	emitted := received.Add(1200 * time.Millisecond)
+	atReceipt, _ := Parse([]string{"1"}, received)
+	wrapped := fmt.Errorf("wrapped: %w", cm053DirectErr{hint: atReceipt})
+	for _, tc := range []struct {
+		name   string
+		header http.Header
+		err    error
+		want   []string
+	}{
+		{"receipt-deadline-elapsed", http.Header{"Retry-After": {"1"}}, wrapped, []string{"0"}},
+		{"receipt-deadline-remaining", http.Header{"Retry-After": {"10"}}, cm053DirectErr{hint: func() Hint { h, _ := Parse([]string{"10"}, received); return h }()}, []string{"9"}},
+		{"no-carrier-parses-at-emission", http.Header{"Retry-After": {"1"}}, errors.New("in-process"), []string{"1"}},
+		{"nil-error-parses-at-emission", http.Header{"Retry-After": {"1"}}, nil, []string{"1"}},
+		{"carrier-without-hint-falls-back", http.Header{"Retry-After": {"5"}}, cm053DirectErr{}, []string{"5"}},
+		{"carrier-duplicate-forwarded-one-value", http.Header{"Retry-After": {"1", "1"}}, wrapped, []string{"0"}},
+		{"carrier-but-nothing-forwarded", http.Header{}, wrapped, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			header := tc.header.Clone()
+			CanonicalizeDirectHeader(header, tc.err, emitted)
+			got := header.Values("Retry-After")
+			if len(got) != len(tc.want) || (len(got) == 1 && got[0] != tc.want[0]) {
+				t.Fatalf("Retry-After = %v, want %v", got, tc.want)
+			}
+		})
+	}
+	if _, _, ok := From(wrapped); ok {
+		t.Fatal("a direct carrier must not also be a typed Carrier")
+	}
+}
