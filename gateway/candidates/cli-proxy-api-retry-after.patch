+package auth
+
+import (
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/retryhint"
+)
+
+// The terminal Retry-After of an error response.
+
+type cm053HintCarrier struct {
+	status int
+	hint   retryhint.Hint
+}
+
+func (c cm053HintCarrier) Error() string   { return "upstream failure" }
+func (c cm053HintCarrier) StatusCode() int { return c.status }
+func (c cm053HintCarrier) UpstreamRetryAfter() (retryhint.Hint, bool) {
+	return c.hint, c.hint.Valid()
+}
+
+func cm053HintOf(t *testing.T, value string) retryhint.Hint {
+	t.Helper()
+	hint, ok := retryhint.Parse([]string{value}, time.Now())
+	if !ok {
+		t.Fatalf("hint %q did not parse", value)
+	}
+	return hint
+}
+
+func TestCM053RetryAfterSurvivesErrorWrapping(t *testing.T) {
+	carrier := cm053HintCarrier{status: http.StatusTooManyRequests, hint: cm053HintOf(t, "120")}
+	wrapped := []struct {
+		name   string
+		err    error
+		status int
+		want   string
+	}{
+		{"direct", carrier, 429, "120"},
+		{"fmt-wrap", fmt.Errorf("attempt failed: %w", carrier), 429, "120"},
+		{"with-cause-same-status", WithCause(&Error{Code: "rate_limited", Message: "x", HTTPStatus: 429}, carrier), 429, "120"},
+		{"terminal-auth", NewTerminalAuthError(&Error{Message: "x", HTTPStatus: 429}, carrier), 429, "120"},
+		{"double-wrap", fmt.Errorf("outer: %w", WithCause(&Error{HTTPStatus: 429}, fmt.Errorf("inner: %w", carrier))), 429, "120"},
+		// An enrichment that changes the terminal status is a local error:
+		// the upstream hint is not emitted on it.
+		{"enriched-503-over-429", WithCause(&Error{Code: "auth_unavailable", Message: "x", HTTPStatus: 503}, carrier), 503, ""},
+		{"status-500", carrier, 500, ""},
+	}
+	for _, tc := range wrapped {
+		got := ResponseRetryAfter(tc.err, tc.status)
+		switch {
+		case tc.want == "" && len(got) != 0:
+			t.Fatalf("%s: Retry-After = %v, want none", tc.name, got)
+		case tc.want != "" && (len(got) != 1 || got[0] != tc.want):
+			t.Fatalf("%s: Retry-After = %v, want [%s]", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestCM053RetryAfterLocalDeadlinePrecedence(t *testing.T) {
+	carrier := cm053HintCarrier{status: http.StatusTooManyRequests, hint: cm053HintOf(t, "3600")}
+	local := 7 * time.Second
+	cases := []struct {
+		name string
+		err  error
+	}{
+		{"home-dispatch-cooldown", fmt.Errorf("%w: %w", &homeDispatchRetryAfterError{retryAfter: local}, carrier)},
+		{"model-cooldown", fmt.Errorf("%w: %w", newModelCooldownError("cm053-model", "cm053", local), carrier)},
+	}
+	for _, tc := range cases {
+		got := ResponseRetryAfter(tc.err, http.StatusTooManyRequests)
+		if len(got) != 1 || got[0] != "7" {
+			t.Fatalf("%s: Retry-After = %v, want only the local [7]", tc.name, got)
+		}
+	}
+	// Without a local value the upstream hint is the one value.
+	if got := ResponseRetryAfter(carrier, http.StatusTooManyRequests); len(got) != 1 || got[0] != "3600" {
+		t.Fatalf("upstream-only Retry-After = %v, want [3600]", got)
+	}
+	if got := ResponseRetryAfter(nil, http.StatusTooManyRequests); len(got) != 0 {
+		t.Fatalf("nil error Retry-After = %v", got)
+	}
+}
