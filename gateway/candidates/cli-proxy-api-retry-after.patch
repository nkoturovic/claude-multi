new file mode 100644
index 0000000..24a677a
--- /dev/null
+++ b/internal/runtime/executor/codex_websockets_retry_after.go
@@ -0,0 +1,48 @@
+package executor
+
+import (
+	"context"
+	"net/http/httptrace"
+	"sync"
+	"time"
+)
+
+// websocketHandshakeReceipt records when a WebSocket upgrade
+// response arrived. gorilla's dialer reads (up to 1 KiB of) a rejected
+// handshake's body before DialContext returns, so a time taken after that
+// return restarts the upstream Retry-After deadline late by however long the
+// body took. The dialer reports the handshake response's first byte (its
+// status line, which the header block follows before any body byte) through
+// the dial context's httptrace.ClientTrace: that is the receipt boundary.
+type websocketHandshakeReceipt struct {
+	mu sync.Mutex
+	at time.Time
+}
+
+// withWebsocketHandshakeReceipt returns a dial context whose client trace
+// (composed with any trace ctx already carries) records the receipt.
+func withWebsocketHandshakeReceipt(ctx context.Context) (context.Context, *websocketHandshakeReceipt) {
+	receipt := &websocketHandshakeReceipt{}
+	return httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{GotFirstResponseByte: receipt.mark}), receipt
+}
+
+func (r *websocketHandshakeReceipt) mark() {
+	now := time.Now()
+	r.mu.Lock()
+	r.at = now
+	r.mu.Unlock()
+}
+
+// receivedAt returns when the last handshake response arrived, or fallback
+// when no response was observed (or the recorded time is not earlier).
+func (r *websocketHandshakeReceipt) receivedAt(fallback time.Time) time.Time {
+	if r == nil {
+		return fallback
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.at.IsZero() || r.at.After(fallback) {
+		return fallback
+	}
+	return r.at
+}
