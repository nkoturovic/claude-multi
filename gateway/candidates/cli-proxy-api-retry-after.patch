diff --git a/sdk/api/handlers/claude/retry_after_cm053_test.go b/sdk/api/handlers/claude/retry_after_cm053_test.go
new file mode 100644
index 0000000..00641f8
--- /dev/null
+++ b/sdk/api/handlers/claude/retry_after_cm053_test.go
@@ -0,0 +1,320 @@
+package claude
+
+// Retry-After forwarding, end to end through the real Claude
+// handler, the auth manager (conductor) and a fake provider executor. The
+// executor returns typed upstream hints (retryhint.Carrier), the shape every
+// managed executor now attaches at its response boundary. Header passthrough
+// stays at its production default (off).
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/retryhint"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+const cm053RAProvider = "cm053ra"
+
+// cm053HintedErr is an upstream failure carrying a validated hint.
+type cm053HintedErr struct {
+	status int
+	hint   retryhint.Hint
+}
+
+func (e cm053HintedErr) Error() string {
+	return `{"type":"error","error":{"type":"rate_limit_error","message":"cm053 upstream failure"}}`
+}
+func (e cm053HintedErr) StatusCode() int { return e.status }
+func (e cm053HintedErr) UpstreamRetryAfter() (retryhint.Hint, bool) {
+	return e.hint, e.hint.Valid()
+}
+
+func cm053Hint(t *testing.T, value string) retryhint.Hint {
+	t.Helper()
+	hint, ok := retryhint.Parse([]string{value}, time.Now())
+	if !ok {
+		t.Fatalf("hint %q did not parse", value)
+	}
+	return hint
+}
+
+// cm053RABehavior is what the fake executor does for one auth.
+type cm053RABehavior struct {
+	err         error // bootstrap / non-stream failure
+	firstChunk  bool  // stream: send one chunk, then midErr
+	midErr      error
+	successBody string
+}
+
+type cm053RAExecutor struct {
+	mu        sync.Mutex
+	behaviors map[string]cm053RABehavior
+	calls     []string
+}
+
+func (e *cm053RAExecutor) Identifier() string { return cm053RAProvider }
+
+func (e *cm053RAExecutor) behavior(auth *coreauth.Auth) cm053RABehavior {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.calls = append(e.calls, auth.ID)
+	return e.behaviors[auth.ID]
+}
+
+func (e *cm053RAExecutor) Execute(_ context.Context, auth *coreauth.Auth, _ coreexecutor.Request, _ coreexecutor.Options) (coreexecutor.Response, error) {
+	b := e.behavior(auth)
+	if b.err != nil {
+		return coreexecutor.Response{}, b.err
+	}
+	return coreexecutor.Response{Payload: []byte(b.successBody)}, nil
+}
+
+func (e *cm053RAExecutor) ExecuteStream(_ context.Context, auth *coreauth.Auth, _ coreexecutor.Request, _ coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	b := e.behavior(auth)
+	if b.err != nil {
+		return nil, b.err
+	}
+	ch := make(chan coreexecutor.StreamChunk, 2)
+	if b.firstChunk {
+		ch <- coreexecutor.StreamChunk{Payload: []byte("event: message_start\ndata: {\"type\":\"message_start\"}\n\n")}
+	}
+	if b.midErr != nil {
+		ch <- coreexecutor.StreamChunk{Err: b.midErr}
+	}
+	close(ch)
+	return &coreexecutor.StreamResult{Chunks: ch}, nil
+}
+
+func (e *cm053RAExecutor) Refresh(_ context.Context, auth *coreauth.Auth) (*coreauth.Auth, error) {
+	return auth, nil
+}
+
+func (e *cm053RAExecutor) CountTokens(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, &coreauth.Error{HTTPStatus: http.StatusNotImplemented, Message: "not implemented"}
+}
+
+func (e *cm053RAExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, &coreauth.Error{HTTPStatus: http.StatusNotImplemented, Message: "not implemented"}
+}
+
+// cm053RAServe registers one auth per behavior (in order: the conductor tries
+// them by ID) and serves one /v1/messages request.
+func cm053RAServe(t *testing.T, stream bool, behaviors ...cm053RABehavior) (*httptest.ResponseRecorder, *cm053RAExecutor) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	executor := &cm053RAExecutor{behaviors: map[string]cm053RABehavior{}}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.RegisterExecutor(executor)
+	model := "cm053-ra-" + strings.NewReplacer("/", "-", " ", "-").Replace(t.Name())
+	for i, behavior := range behaviors {
+		id := model + "-auth-" + strconv.Itoa(i)
+		executor.behaviors[id] = behavior
+		if _, errRegister := manager.Register(context.Background(), &coreauth.Auth{ID: id, Provider: cm053RAProvider, Status: coreauth.StatusActive}); errRegister != nil {
+			t.Fatalf("register %s: %v", id, errRegister)
+		}
+		registry.GetGlobalRegistry().RegisterClient(id, cm053RAProvider, []*registry.ModelInfo{{ID: model}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	}
+	base := handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager)
+	if handlers.PassthroughHeadersEnabled(base.Cfg) {
+		t.Fatal("header passthrough is on; the gate needs the production default")
+	}
+	handler := NewClaudeCodeAPIHandler(base)
+	router := gin.New()
+	router.POST("/v1/messages", handler.ClaudeMessages)
+	body := `{"model":"` + model + `","max_tokens":16,"messages":[{"role":"user","content":"hi"}],"stream":` + strconv.FormatBool(stream) + `}`
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPost, "/v1/messages", strings.NewReader(body))
+	request.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(recorder, request)
+	return recorder, executor
+}
+
+func cm053AssertRetryAfter(t *testing.T, recorder *httptest.ResponseRecorder, wantStatus int, want string) {
+	t.Helper()
+	if recorder.Code != wantStatus {
+		t.Fatalf("status = %d, want %d; body %s", recorder.Code, wantStatus, recorder.Body.String())
+	}
+	values := recorder.Header().Values("Retry-After")
+	if want == "" {
+		if len(values) != 0 {
+			t.Fatalf("Retry-After = %v, want none", values)
+		}
+		return
+	}
+	if len(values) != 1 || values[0] != want {
+		t.Fatalf("Retry-After = %v, want exactly [%s]", values, want)
+	}
+}
+
+func TestCM053RetryAfterTerminal429And503(t *testing.T) {
+	cases := []struct {
+		name   string
+		status int
+		value  string
+		want   string
+	}{
+		{"429-3600", http.StatusTooManyRequests, "3600", "3600"},
+		{"429-zero", http.StatusTooManyRequests, "0", "0"},
+		{"429-30000", http.StatusTooManyRequests, "30000", "30000"},
+		{"503-5", http.StatusServiceUnavailable, "5", "5"},
+		{"500-never", http.StatusInternalServerError, "5", ""},
+		{"400-never", http.StatusBadRequest, "5", ""},
+	}
+	for _, tc := range cases {
+		for _, stream := range []bool{false, true} {
+			t.Run(tc.name+"/stream="+strconv.FormatBool(stream), func(t *testing.T) {
+				recorder, _ := cm053RAServe(t, stream, cm053RABehavior{err: cm053HintedErr{status: tc.status, hint: cm053Hint(t, tc.value)}})
+				cm053AssertRetryAfter(t, recorder, tc.status, tc.want)
+			})
+		}
+	}
+	t.Run("no-hint-no-header", func(t *testing.T) {
+		recorder, _ := cm053RAServe(t, false, cm053RABehavior{err: cm053HintedErr{status: http.StatusTooManyRequests}})
+		cm053AssertRetryAfter(t, recorder, http.StatusTooManyRequests, "")
+	})
+	t.Run("deadline-already-spent", func(t *testing.T) {
+		hint, _ := retryhint.Parse([]string{"10"}, time.Now().Add(-4*time.Second))
+		recorder, _ := cm053RAServe(t, false, cm053RABehavior{err: cm053HintedErr{status: http.StatusTooManyRequests, hint: hint}})
+		got := recorder.Header().Get("Retry-After")
+		if got != "6" && got != "5" {
+			t.Fatalf("Retry-After = %q, want the remaining 6s (the upstream deadline, not a restarted wait)", got)
+		}
+	})
+}
+
+func TestCM053RetryAfterWithoutHeaderPassthrough(t *testing.T) {
+	// The ordinary path introduces only Retry-After: the hinted error carries
+	// no other upstream header, and passthrough is off.
+	recorder, _ := cm053RAServe(t, false, cm053RABehavior{err: cm053HintedErr{status: http.StatusTooManyRequests, hint: cm053Hint(t, "7")}})
+	cm053AssertRetryAfter(t, recorder, http.StatusTooManyRequests, "7")
+	for name := range recorder.Header() {
+		switch http.CanonicalHeaderKey(name) {
+		case "Retry-After", "Content-Type":
+		default:
+			t.Fatalf("ordinary error response gained header %q: %v", name, recorder.Header())
+		}
+	}
+
+	// The fast/direct path already forwards upstream headers (pre-patch
+	// baseline); the patch only makes its Retry-After one canonical value.
+	upstream := http.Header{
+		"Retry-After":                       {"30", "30"},
+		"Anthropic-Ratelimit-Unified-Reset": {"1700000000"},
+		"Set-Cookie":                        {"a=b"},
+		"Content-Type":                      {"application/json"},
+	}
+	cases := []struct {
+		name  string
+		after []string
+		want  string
+	}{
+		{"duplicate-dropped", []string{"30", "30"}, ""},
+		{"single-kept", []string{"30"}, "30"},
+		{"date-canonical", []string{time.Now().Add(-time.Minute).UTC().Format(http.TimeFormat)}, "0"},
+		{"invalid-dropped", []string{"soon"}, ""},
+	}
+	for _, tc := range cases {
+		t.Run("direct/"+tc.name, func(t *testing.T) {
+			header := upstream.Clone()
+			header["Retry-After"] = tc.after
+			direct := &coreexecutor.RequestTerminatedError{HTTPStatus: http.StatusTooManyRequests, Header: header, Body: []byte(`{"type":"error"}`)}
+			recorder, _ := cm053RAServe(t, false, cm053RABehavior{err: direct})
+			cm053AssertRetryAfter(t, recorder, http.StatusTooManyRequests, tc.want)
+			if recorder.Header().Get("Anthropic-Ratelimit-Unified-Reset") != "1700000000" {
+				t.Fatalf("the direct path's existing forwarding changed: %v", recorder.Header())
+			}
+			if recorder.Header().Get("Set-Cookie") != "" {
+				t.Fatalf("Set-Cookie forwarded: %v", recorder.Header())
+			}
+		})
+	}
+}
+
+func TestCM053RetryAfterNotLeakedAcrossAttempts(t *testing.T) {
+	hinted := cm053RABehavior{err: cm053HintedErr{status: http.StatusTooManyRequests, hint: cm053Hint(t, "3600")}}
+	success := cm053RABehavior{successBody: `{"id":"msg_1","type":"message","role":"assistant","content":[{"type":"text","text":"ok"}],"model":"m","stop_reason":"end_turn","usage":{"input_tokens":1,"output_tokens":1}}`}
+	for _, stream := range []bool{false, true} {
+		t.Run("then-success/stream="+strconv.FormatBool(stream), func(t *testing.T) {
+			second := success
+			if stream {
+				second = cm053RABehavior{firstChunk: true}
+			}
+			recorder, executor := cm053RAServe(t, stream, hinted, second)
+			if len(executor.calls) != 2 {
+				t.Fatalf("attempts = %v, want the hinted credential then the successful one", executor.calls)
+			}
+			cm053AssertRetryAfter(t, recorder, http.StatusOK, "")
+		})
+		t.Run("then-unhinted-failure/stream="+strconv.FormatBool(stream), func(t *testing.T) {
+			recorder, executor := cm053RAServe(t, stream, hinted, cm053RABehavior{err: &coreauth.Error{HTTPStatus: http.StatusBadGateway, Message: "second failed"}})
+			if len(executor.calls) != 2 {
+				t.Fatalf("attempts = %v, want both credentials", executor.calls)
+			}
+			if recorder.Code == http.StatusTooManyRequests || recorder.Header().Get("Retry-After") != "" {
+				t.Fatalf("the first credential's hint reached the final response: %d %v", recorder.Code, recorder.Header())
+			}
+		})
+	}
+}
+
+func TestCM053RetryAfterCommittedStreamUnchanged(t *testing.T) {
+	recorder, _ := cm053RAServe(t, true, cm053RABehavior{firstChunk: true, midErr: cm053HintedErr{status: http.StatusTooManyRequests, hint: cm053Hint(t, "3600")}})
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("committed stream status = %d, want 200", recorder.Code)
+	}
+	if got := recorder.Header().Values("Retry-After"); len(got) != 0 {
+		t.Fatalf("Retry-After added after the stream was committed: %v", got)
+	}
+	if !strings.Contains(recorder.Body.String(), "message_start") || !strings.Contains(recorder.Body.String(), "event: error") {
+		t.Fatalf("stream body = %q, want the first chunk then a terminal SSE error", recorder.Body.String())
+	}
+}
+
+// cm053DirectReceiptErr is the shape of the Claude fast path's direct
+// response: forwarded upstream headers plus the Retry-After deadline its
+// executor validated when those headers arrived (retryhint.DirectCarrier).
+type cm053DirectReceiptErr struct {
+	response *coreexecutor.RequestTerminatedError
+	hint     retryhint.Hint
+}
+
+func (e *cm053DirectReceiptErr) Error() string { return "cm053 direct upstream failure" }
+func (e *cm053DirectReceiptErr) Unwrap() error { return e.response }
+func (e *cm053DirectReceiptErr) DirectRetryAfter() (retryhint.Hint, bool) {
+	return e.hint, e.hint.Valid()
+}
+
+// TestCM053RetryAfterDirectReceiptDeadline: the fast/direct path forwards
+// one canonical Retry-After that keeps the deadline from upstream receipt:
+// a 1 s wait whose time was already spent in the gateway is emitted as 0,
+// not restarted at the handler.
+func TestCM053RetryAfterDirectReceiptDeadline(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run("stream="+strconv.FormatBool(stream), func(t *testing.T) {
+			hint, _ := retryhint.Parse([]string{"1"}, time.Now().Add(-1200*time.Millisecond))
+			direct := &cm053DirectReceiptErr{
+				response: &coreexecutor.RequestTerminatedError{
+					HTTPStatus: http.StatusTooManyRequests,
+					Header:     http.Header{"Retry-After": {"1"}, "Content-Type": {"application/json"}},
+					Body:       []byte(`{"type":"error","error":{"type":"rate_limit_error","message":"cm053 direct"}}`),
+				},
+				hint: hint,
+			}
+			recorder, _ := cm053RAServe(t, stream, cm053RABehavior{err: direct})
+			cm053AssertRetryAfter(t, recorder, http.StatusTooManyRequests, "0")
+		})
+	}
+}
