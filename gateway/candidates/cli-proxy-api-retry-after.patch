@@ -0,0 +1,25 @@
+package auth
+
+import (
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/retryhint"
+)
+
+// ResponseRetryAfter returns the Retry-After values of a terminal error
+// response written with status. A trusted local
+// recovery value (SafeResponseHeaders) wins. Otherwise, when err carries a
+// validated upstream hint whose carrier has this same 429 or 503 status, it
+// returns that hint as one canonical delta-seconds value with the time
+// already spent subtracted. It never returns local and upstream values
+// together, nor more than one upstream value. General upstream header
+// passthrough is not involved.
+func ResponseRetryAfter(err error, status int) []string {
+	if local := SafeResponseHeaders(err).Values("Retry-After"); len(local) > 0 {
+		return local
+	}
+	if value, ok := retryhint.ResponseValue(err, status, time.Now()); ok {
+		return []string{value}
+	}
+	return nil
+}
