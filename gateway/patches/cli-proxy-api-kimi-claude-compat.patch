+func claudeUsesXAPIKey(auth *cliproxyauth.Auth) bool {
+	if auth == nil || auth.Attributes == nil {
+		return false
+	}
+	return strings.EqualFold(strings.TrimSpace(auth.Attributes["auth_header"]), "x-api-key")
+}
+
+// enforceClaudeXAPIKeyAuth re-applies the configured x-api-key override after
+// custom credential headers, so a configured Authorization header can never
+// displace the selected upstream authentication header.
+func enforceClaudeXAPIKeyAuth(r *http.Request, useXAPIKey bool, apiKey string) {
+	if r == nil || !useXAPIKey || strings.TrimSpace(apiKey) == "" {
+		return
+	}
+	r.Header.Del("Authorization")
+	r.Header.Set("x-api-key", apiKey)
+}
