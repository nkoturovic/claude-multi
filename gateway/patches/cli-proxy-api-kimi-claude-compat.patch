@@ -0,0 +1,76 @@
+package config
+
+import "testing"
+
+// claudeCompatGoldenYAML mirrors the claude-api-key shape claude-multi
+// renders for its third-party Claude-compatible providers (Kimi-style
+// x-api-key auth, owned-by/context-length advertisement). A silently ignored
+// YAML key (a partial port of the kimi-claude-compat patch) must fail here.
+const claudeCompatGoldenYAML = `claude-api-key:
+  - api-key: "dummy-kimi-key"
+    base-url: "https://api.kimi.com/coding"
+    auth-header: "x-api-key"
+    cloak:
+      mode: "never"
+    models:
+      - name: "k3"
+        alias: "claude-multi-kimi-k3"
+        display-name: "Kimi K3"
+        owned-by: "moonshot"
+        context-length: 1000000
+        max-completion-tokens: 64000
+        force-mapping: true
+  - api-key: "dummy-kimi-key"
+    base-url: "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic"
+    cloak:
+      mode: "never"
+    models:
+      - name: "qwen3.8-max"
+        alias: "claude-multi-qwen38-max"
+        display-name: "Qwen3.8 Max"
+        owned-by: "alibaba"
+        context-length: 983616
+        force-mapping: true
+`
+
+func TestClaudeCompatFieldsDecodeFromRenderedGoldenShape(t *testing.T) {
+	cfg, err := ParseConfigBytes([]byte(claudeCompatGoldenYAML))
+	if err != nil {
+		t.Fatalf("ParseConfigBytes() error = %v", err)
+	}
+	if len(cfg.ClaudeKey) != 2 {
+		t.Fatalf("claude-api-key entries = %d, want 2", len(cfg.ClaudeKey))
+	}
+
+	kimi := cfg.ClaudeKey[0]
+	if kimi.AuthHeader != "x-api-key" {
+		t.Fatalf("auth-header = %q, want x-api-key", kimi.AuthHeader)
+	}
+	if len(kimi.Models) != 1 {
+		t.Fatalf("kimi models = %d, want 1", len(kimi.Models))
+	}
+	model := kimi.Models[0]
+	if model.OwnedBy != "moonshot" || model.GetOwnedBy() != "moonshot" {
+		t.Fatalf("owned-by = %q/%q, want moonshot", model.OwnedBy, model.GetOwnedBy())
+	}
+	if model.ContextLength != 1000000 || model.GetContextLength() != 1000000 {
+		t.Fatalf("context-length = %d/%d, want 1000000", model.ContextLength, model.GetContextLength())
+	}
+	if model.MaxCompletionTokens != 64000 || model.GetMaxCompletionTokens() != 64000 {
+		t.Fatalf("max-completion-tokens = %d/%d, want 64000", model.MaxCompletionTokens, model.GetMaxCompletionTokens())
+	}
+	if !model.ForceMapping {
+		t.Fatal("force-mapping = false, want true")
+	}
+
+	qwen := cfg.ClaudeKey[1]
+	if qwen.AuthHeader != "" {
+		t.Fatalf("bearer provider auth-header = %q, want empty", qwen.AuthHeader)
+	}
+	if got := qwen.Models[0].GetOwnedBy(); got != "alibaba" {
+		t.Fatalf("qwen owned-by = %q, want alibaba", got)
+	}
+	if got := qwen.Models[0].GetContextLength(); got != 983616 {
+		t.Fatalf("qwen context-length = %d, want 983616", got)
+	}
+}
