diff --git a/internal/runtime/executor/claude_executor_auth_header_test.go b/internal/runtime/executor/claude_executor_auth_header_test.go
new file mode 100644
index 00000000..78ee2310
--- /dev/null
+++ b/internal/runtime/executor/claude_executor_auth_header_test.go
@@ -0,0 +1,227 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+// The auth-header override (claude-api-key "auth-header: x-api-key", carried
+// as the auth_header attribute) selects x-api-key on third-party
+// Claude-compatible upstreams, where the default would be a Bearer
+// Authorization header, and survives custom-header application. Injected
+// round-trippers only; no network.
+
+func TestClaudeExecutorAuthHeaderXAPIKeyOnThirdPartyMessages(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		authHeader string
+		wantXAPI   bool
+	}{
+		{name: "x-api-key override", authHeader: "x-api-key", wantXAPI: true},
+		{name: "x-api-key override case-insensitive", authHeader: " X-API-Key ", wantXAPI: true},
+		{name: "default bearer", authHeader: "", wantXAPI: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var gotAuthorization, gotXAPIKey string
+			rt := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+				gotAuthorization = req.Header.Get("Authorization")
+				gotXAPIKey = req.Header.Get("x-api-key")
+				return &http.Response{
+					StatusCode: http.StatusOK,
+					Header:     http.Header{"Content-Type": []string{"application/json"}},
+					Body:       io.NopCloser(strings.NewReader(`{"id":"msg_1","type":"message","model":"k3","role":"assistant","content":[{"type":"text","text":"ok"}],"usage":{"input_tokens":1,"output_tokens":1}}`)),
+				}, nil
+			})
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", rt)
+			attrs := map[string]string{
+				"api_key":  "third-party-key",
+				"base_url": "https://gateway.example.test/anthropic",
+				// A configured custom Authorization header must not win over
+				// the x-api-key override.
+				"header:Authorization": "Bearer custom-header",
+			}
+			if tc.authHeader != "" {
+				attrs["auth_header"] = tc.authHeader
+			}
+			executor := NewClaudeExecutor(&config.Config{})
+			auth := &cliproxyauth.Auth{Attributes: attrs}
+			if _, err := executor.Execute(ctx, auth, cliproxyexecutor.Request{
+				Model:   "k3",
+				Payload: []byte(`{"messages":[{"role":"user","content":[{"type":"text","text":"hello"}]}]}`),
+			}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude}); err != nil {
+				t.Fatalf("Execute() error = %v", err)
+			}
+			if tc.wantXAPI {
+				if gotXAPIKey != "third-party-key" {
+					t.Fatalf("x-api-key = %q, want third-party-key", gotXAPIKey)
+				}
+				if gotAuthorization != "" {
+					t.Fatalf("Authorization = %q, want empty with x-api-key override", gotAuthorization)
+				}
+				return
+			}
+			if gotXAPIKey != "" {
+				t.Fatalf("x-api-key = %q, want empty for default bearer", gotXAPIKey)
+			}
+			if gotAuthorization == "" {
+				t.Fatal("Authorization missing for default bearer")
+			}
+		})
+	}
+}
+
+func TestClaudeExecutorPrepareRequestHonorsAuthHeaderOverride(t *testing.T) {
+	req, err := http.NewRequest(http.MethodPost, "https://gateway.example.test/anthropic/v1/messages", nil)
+	if err != nil {
+		t.Fatalf("NewRequest() error = %v", err)
+	}
+	executor := NewClaudeExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"api_key":     "third-party-key",
+		"auth_header": "x-api-key",
+	}}
+	if err := executor.PrepareRequest(req, auth); err != nil {
+		t.Fatalf("PrepareRequest() error = %v", err)
+	}
+	if got := req.Header.Get("x-api-key"); got != "third-party-key" {
+		t.Fatalf("x-api-key = %q, want third-party-key", got)
+	}
+	if got := req.Header.Get("Authorization"); got != "" {
+		t.Fatalf("Authorization = %q, want empty", got)
+	}
+}
+
+// A confirmed Claude Code request is not caller-owned: it takes the CLI
+// header path of applyClaudeHeadersWithNativeProfile, which has its own
+// custom-header application and its own x-api-key enforcement. The override
+// alone selects x-api-key there, and a configured custom Authorization header
+// must not displace it (Execute and ExecuteStream).
+func TestClaudeExecutorAuthHeaderXAPIKeyOnConfirmedClaudeCodePath(t *testing.T) {
+	const sessionID = "11111111-2222-4333-8444-555555555555"
+	const userID = `{"device_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","account_uuid":"","session_id":"11111111-2222-4333-8444-555555555555"}`
+	payload := []byte(`{"model":"k3","messages":[{"role":"user","content":"hello"}],"metadata":{"user_id":` + fmt.Sprintf("%q", userID) + `}}`)
+	incoming := http.Header{
+		"User-Agent":               {"claude-cli/2.1.280 (external, cli)"},
+		"X-App":                    {"cli"},
+		"Anthropic-Beta":           {"claude-code-20250219"},
+		"X-Claude-Code-Session-Id": {sessionID},
+	}
+	// Premise: the headers are confirmed Claude Code, so the request cannot
+	// fall back to the caller-owned path this test does not target.
+	if !helps.DetectClaudeCodeRequest(incoming, payload, false).Confirmed {
+		t.Fatal("test premise: incoming headers are not confirmed Claude Code")
+	}
+
+	for _, tc := range []struct {
+		stream              bool
+		customAuthorization bool
+	}{
+		{stream: false, customAuthorization: true},
+		{stream: true, customAuthorization: true},
+		{stream: false, customAuthorization: false},
+		{stream: true, customAuthorization: false},
+	} {
+		stream := tc.stream
+		t.Run(fmt.Sprintf("stream=%v/custom-authorization=%v", tc.stream, tc.customAuthorization), func(t *testing.T) {
+			var seen http.Header
+			rt := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+				seen = req.Header.Clone()
+				if stream {
+					return &http.Response{
+						StatusCode: http.StatusOK,
+						Header:     http.Header{"Content-Type": []string{"text/event-stream"}},
+						Body:       io.NopCloser(strings.NewReader("event: message_stop\n" + `data: {"type":"message_stop"}` + "\n\n")),
+					}, nil
+				}
+				return &http.Response{
+					StatusCode: http.StatusOK,
+					Header:     http.Header{"Content-Type": []string{"application/json"}},
+					Body:       io.NopCloser(strings.NewReader(`{"id":"msg_1","type":"message","model":"k3","role":"assistant","content":[{"type":"text","text":"ok"}],"usage":{"input_tokens":1,"output_tokens":1}}`)),
+				}, nil
+			})
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", rt)
+			executor := NewClaudeExecutor(&config.Config{})
+			attrs := map[string]string{
+				"api_key":     "third-party-key",
+				"base_url":    "https://gateway.example.test/anthropic",
+				"auth_header": "x-api-key",
+			}
+			if tc.customAuthorization {
+				attrs["header:Authorization"] = "Bearer custom-header"
+			}
+			auth := &cliproxyauth.Auth{Attributes: attrs}
+			req := cliproxyexecutor.Request{Model: "k3", Payload: payload}
+			opts := cliproxyexecutor.Options{
+				Stream:          stream,
+				SourceFormat:    sdktranslator.FormatClaude,
+				OriginalRequest: payload,
+				Headers:         incoming,
+			}
+			if stream {
+				result, err := executor.ExecuteStream(ctx, auth, req, opts)
+				if err != nil {
+					t.Fatalf("ExecuteStream() error = %v", err)
+				}
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						t.Fatalf("stream chunk error = %v", chunk.Err)
+					}
+				}
+			} else if _, err := executor.Execute(ctx, auth, req, opts); err != nil {
+				t.Fatalf("Execute() error = %v", err)
+			}
+			if seen == nil {
+				t.Fatal("no upstream request captured")
+			}
+			// Path witness: only the CLI header path synthesizes these; the
+			// caller-owned path forwards the caller's headers, which omit them.
+			if got := seen.Get("X-Stainless-Timeout"); got != "600" {
+				t.Fatalf("X-Stainless-Timeout = %q, want 600 (CLI header path)", got)
+			}
+			if got := seen.Get("Connection"); got != "keep-alive" {
+				t.Fatalf("Connection = %q, want keep-alive (CLI header path)", got)
+			}
+			if got := seen.Values("X-Api-Key"); len(got) != 1 || got[0] != "third-party-key" {
+				t.Fatalf("x-api-key = %q, want exactly [third-party-key]", got)
+			}
+			if got := seen.Values("Authorization"); len(got) != 0 {
+				t.Fatalf("Authorization = %q, want absent with x-api-key override", got)
+			}
+		})
+	}
+}
+
+// PrepareRequest applies custom credential headers after selecting the auth
+// header, so its own enforcement must keep x-api-key even when a custom
+// Authorization header is configured.
+func TestClaudeExecutorPrepareRequestAuthHeaderOverrideBeatsCustomAuthorization(t *testing.T) {
+	req, err := http.NewRequest(http.MethodPost, "https://gateway.example.test/anthropic/v1/messages", nil)
+	if err != nil {
+		t.Fatalf("NewRequest() error = %v", err)
+	}
+	executor := NewClaudeExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"api_key":              "third-party-key",
+		"auth_header":          "x-api-key",
+		"header:Authorization": "Bearer custom-header",
+	}}
+	if err := executor.PrepareRequest(req, auth); err != nil {
+		t.Fatalf("PrepareRequest() error = %v", err)
+	}
+	if got := req.Header.Values("X-Api-Key"); len(got) != 1 || got[0] != "third-party-key" {
+		t.Fatalf("x-api-key = %q, want exactly [third-party-key]", got)
+	}
+	if got := req.Header.Values("Authorization"); len(got) != 0 {
+		t.Fatalf("Authorization = %q, want absent with x-api-key override", got)
+	}
+}
