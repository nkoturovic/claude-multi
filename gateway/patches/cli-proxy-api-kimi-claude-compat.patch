+// The static "codex" channel resolves to the codex-pro tier. On 7.3.15 that
+// tier lists gpt-5.6-sol at 921000/128000 and gpt-6-sol at 272000/128000;
+// claude-multi's OAuth aliases must advertise exactly the registry limits.
+func TestApplyOAuthModelAlias_CodexSolPreservesTokenLimits(t *testing.T) {
+	for _, tc := range []struct {
+		sourceID                string
+		wantContextLength       int
+		wantMaxCompletionTokens int
+		aliases                 []string
+	}{
+		{
+			sourceID:                "gpt-5.6-sol",
+			wantContextLength:       921000,
+			wantMaxCompletionTokens: 128000,
+			aliases:                 []string{"claude-multi-sol-high", "gpt-multi-sol-high", "claude-multi-sol-xhigh", "gpt-multi-sol-xhigh"},
+		},
+		{
+			sourceID:                "gpt-6-sol",
+			wantContextLength:       272000,
+			wantMaxCompletionTokens: 128000,
+			aliases:                 []string{"claude-multi-sol6-high", "gpt-multi-sol6-high"},
+		},
+	} {
+		var source *ModelInfo
+		for _, model := range registry.GetStaticModelDefinitionsByChannel("codex") {
+			if model != nil && model.ID == tc.sourceID {
+				source = model
+				break
+			}
+		}
+		if source == nil {
+			t.Fatalf("expected Codex registry model %q", tc.sourceID)
+		}
+		if source.ContextLength != tc.wantContextLength {
+			t.Fatalf("%s source context length = %d, want %d", tc.sourceID, source.ContextLength, tc.wantContextLength)
+		}
+		if source.MaxCompletionTokens != tc.wantMaxCompletionTokens {
+			t.Fatalf("%s source max completion tokens = %d, want %d", tc.sourceID, source.MaxCompletionTokens, tc.wantMaxCompletionTokens)
+		}
+		for _, alias := range tc.aliases {
+			t.Run(tc.sourceID+"/"+alias, func(t *testing.T) {
+				cfg := &config.Config{
+					OAuthModelAlias: map[string][]config.OAuthModelAlias{
+						"codex": {
+							{Name: tc.sourceID, Alias: alias, ForceMapping: true},
+						},
+					},
+				}
+				out := applyOAuthModelAlias(cfg, "codex", "oauth", []*ModelInfo{source})
+				if len(out) != 1 {
+					t.Fatalf("expected 1 aliased model, got %d", len(out))
+				}
+				if out[0].ID != alias {
+					t.Fatalf("alias model id = %q, want %q", out[0].ID, alias)
+				}
+				if out[0].ContextLength != tc.wantContextLength {
+					t.Fatalf("alias context length = %d, want %d", out[0].ContextLength, tc.wantContextLength)
+				}
+				if out[0].MaxCompletionTokens != tc.wantMaxCompletionTokens {
+					t.Fatalf("alias max completion tokens = %d, want %d", out[0].MaxCompletionTokens, tc.wantMaxCompletionTokens)
+				}
+			})
+		}
+	}
+}
