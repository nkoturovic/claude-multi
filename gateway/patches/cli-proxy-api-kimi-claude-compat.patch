+// claude-api-key models advertise the configured owner and token limits
+// (the kimi-claude-compat fields) through the Claude-shape model listing.
+func TestBuildClaudeConfigModelsAdvertisesCompatOwnerAndLimits(t *testing.T) {
+	models := buildClaudeConfigModels(&internalconfig.ClaudeKey{
+		Models: []internalconfig.ClaudeModel{
+			{Name: "k3", Alias: "claude-multi-kimi-k3", DisplayName: "Kimi K3", OwnedBy: " moonshot ", ContextLength: 1000000, MaxCompletionTokens: 64000},
+			{Name: "qwen3.8-max", Alias: "claude-multi-qwen38-max"},
+		},
+	})
+	if len(models) != 2 {
+		t.Fatalf("expected 2 models, got %d", len(models))
+	}
+	if got := models[0].OwnedBy; got != "moonshot" {
+		t.Fatalf("owned_by = %q, want moonshot", got)
+	}
+	if got := models[0].ContextLength; got != 1000000 {
+		t.Fatalf("context_length = %d, want 1000000", got)
+	}
+	if got := models[0].MaxCompletionTokens; got != 64000 {
+		t.Fatalf("max_completion_tokens = %d, want 64000", got)
+	}
+	if got := models[1].OwnedBy; got != "anthropic" {
+		t.Fatalf("default owned_by = %q, want anthropic", got)
+	}
+	if got := models[1].ContextLength; got != 0 {
+		t.Fatalf("default context_length = %d, want 0 (registry default applies downstream)", got)
+	}
+}
