+++ b/sdk/auth/refresh_shutdown_test.go
@@ -0,0 +1,191 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// Keep this integration in the FileTokenStore package so it uses the existing
+// private saveFileOps seam, rather than adding a production fault-injection API.
+type shutdownSyncFile struct {
+	saveFile
+	beforeSync func()
+	fail       bool
+}
+
+func (f *shutdownSyncFile) Sync() error {
+	f.beforeSync()
+	if f.fail {
+		return errors.New("synthetic file sync failure")
+	}
+	return f.saveFile.Sync()
+}
+
+type shutdownFileExecutor struct{ coreauth.ProviderExecutor }
+
+func (*shutdownFileExecutor) Identifier() string { return "shutdown-fixture" }
+func (*shutdownFileExecutor) Refresh(_ context.Context, a *coreauth.Auth) (*coreauth.Auth, error) {
+	a = a.Clone()
+	a.Metadata["refresh_token"] = "replacement-refresh"
+	a.Metadata["access_token"] = "replacement-access"
+	return a, nil
+}
+
+type shutdownFileReceipt struct{ messages chan string }
+
+func (*shutdownFileReceipt) Levels() []log.Level { return log.AllLevels }
+func (h *shutdownFileReceipt) Fire(e *log.Entry) error {
+	if strings.HasPrefix(e.Message, "credential_save_v1 operation=refresh ") {
+		h.messages <- e.Message
+	}
+	return nil
+}
+
+func TestRefreshShutdownFileTokenStore(t *testing.T) {
+	for _, stage := range []string{"sync", "dirsync"} {
+		for _, fail := range []bool{false, true} {
+			name := stage + "/success"
+			if fail {
+				name = stage + "/failure"
+			}
+			t.Run(name, func(t *testing.T) {
+				entered, release := make(chan struct{}), make(chan struct{})
+				var once sync.Once
+				unblock := func() { once.Do(func() { close(release) }) }
+				var fileSyncs, dirSyncs atomic.Int32
+				pause := func() { close(entered); <-release }
+				store := NewFileTokenStore()
+				root := t.TempDir()
+				store.SetBaseDir(root)
+				ops := *defaultSaveFileOps
+				ops.openTemp = func(name string) (saveFile, error) {
+					file, err := defaultSaveFileOps.openTemp(name)
+					if err != nil {
+						return nil, err
+					}
+					return &shutdownSyncFile{saveFile: file, fail: stage == "sync" && fail, beforeSync: func() {
+						fileSyncs.Add(1)
+						if stage == "sync" {
+							pause()
+						}
+					}}, nil
+				}
+				ops.syncDir = func(dir string) error {
+					dirSyncs.Add(1)
+					if stage == "dirsync" {
+						pause()
+						if fail {
+							return errors.New("synthetic directory sync failure")
+						}
+					}
+					return defaultSaveFileOps.syncDir(dir)
+				}
+				store.fileOps = &ops
+				path := filepath.Join(root, "shutdown.json")
+				if err := os.WriteFile(path, []byte(`{"type":"shutdown-fixture","refresh_token":"old-refresh","access_token":"old-access"}`), 0600); err != nil {
+					t.Fatal(err)
+				}
+				manager := coreauth.NewManager(store, nil, nil)
+				manager.RegisterExecutor(&shutdownFileExecutor{})
+				_, err := manager.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{
+					ID: "shutdown.json", FileName: "shutdown.json", Provider: "shutdown-fixture",
+					Metadata: map[string]any{"type": "shutdown-fixture", "refresh_token": "old-refresh", "access_token": "old-access", "refresh_interval_seconds": 3600},
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				logger := log.StandardLogger()
+				oldHooks, oldLevel := logger.ReplaceHooks(make(log.LevelHooks)), logger.GetLevel()
+				logger.SetLevel(log.InfoLevel)
+				hook := &shutdownFileReceipt{messages: make(chan string, 2)}
+				logger.AddHook(hook)
+				t.Cleanup(func() {
+					unblock()
+					ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+					defer cancel()
+					if err := manager.StopAutoRefreshAndWait(ctx); err != nil {
+						t.Errorf("cleanup: %v", err)
+					}
+					logger.ReplaceHooks(oldHooks)
+					logger.SetLevel(oldLevel)
+				})
+				manager.StartAutoRefresh(context.Background(), time.Hour)
+				select {
+				case <-entered:
+				case <-time.After(5 * time.Second):
+					t.Fatal("refresh did not reach FileTokenStore sync")
+				}
+				done := make(chan error, 1)
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				defer cancel()
+				go func() { done <- manager.StopAutoRefreshAndWait(ctx) }()
+				select {
+				case err := <-done:
+					t.Fatalf("join returned during %s: %v", stage, err)
+				case <-time.After(20 * time.Millisecond):
+				}
+				select {
+				case msg := <-hook.messages:
+					t.Fatalf("receipt before sync completion: %s", msg)
+				default:
+				}
+				unblock()
+				select {
+				case err := <-done:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatal("join did not finish after sync")
+				}
+				var receipt string
+				select {
+				case receipt = <-hook.messages:
+				default:
+					t.Fatal("join returned before receipt reporting")
+				}
+				if fail {
+					if !strings.Contains(receipt, "result=failed ") || !strings.Contains(receipt, "stage="+stage+" ") {
+						t.Fatalf("sync failure was not reported honestly: %s", receipt)
+					}
+				} else if !strings.Contains(receipt, "result=persisted ") {
+					t.Fatalf("missing durable-save receipt: %s", receipt)
+				}
+				if fileSyncs.Load() != 1 {
+					t.Fatalf("file sync calls = %d, want 1", fileSyncs.Load())
+				}
+				wantDirSyncs := int32(1)
+				wantToken := "replacement-refresh"
+				if stage == "sync" && fail {
+					wantDirSyncs = 0
+					wantToken = "old-refresh"
+				}
+				if dirSyncs.Load() != wantDirSyncs {
+					t.Fatalf("directory sync calls = %d, want %d", dirSyncs.Load(), wantDirSyncs)
+				}
+				raw, err := os.ReadFile(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var saved map[string]any
+				if err := json.Unmarshal(raw, &saved); err != nil {
+					t.Fatal(err)
+				}
+				if saved["refresh_token"] != wantToken {
+					t.Fatalf("on-disk refresh token = %v, want %s", saved["refresh_token"], wantToken)
+				}
+			})
+		}
+	}
+}
