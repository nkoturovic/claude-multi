diff --git a/sdk/cliproxy/auth/auto_refresh_shutdown_test.go b/sdk/cliproxy/auth/auto_refresh_shutdown_test.go
new file mode 100644
--- /dev/null
+++ b/sdk/cliproxy/auth/auto_refresh_shutdown_test.go
@@ -0,0 +1,420 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	log "github.com/sirupsen/logrus"
+)
+
+// Embedding the interface makes an accidental non-refresh call fail the test.
+type shutdownRefreshExecutor struct {
+	ProviderExecutor
+	refresh func(context.Context, *Auth) (*Auth, error)
+}
+
+func (*shutdownRefreshExecutor) Identifier() string { return "shutdown-fixture" }
+func (e *shutdownRefreshExecutor) Refresh(ctx context.Context, a *Auth) (*Auth, error) {
+	return e.refresh(ctx, a)
+}
+
+type shutdownRefreshStore struct {
+	Store
+	mu    sync.Mutex
+	saved string
+	save  func(SaveOptions)
+}
+
+func (s *shutdownRefreshStore) SaveWithReport(_ context.Context, a *Auth, opts SaveOptions) (SaveReport, error) {
+	if s.save != nil {
+		s.save(opts)
+	}
+	if opts.Commit != nil {
+		release, ok := opts.Commit()
+		if !ok {
+			return SaveReport{Outcome: SaveOutcomeSkipped}, nil
+		}
+		defer release()
+	}
+	s.mu.Lock()
+	s.saved, _ = a.Metadata["refresh_token"].(string)
+	s.mu.Unlock()
+	return SaveReport{Outcome: SaveOutcomePersisted, Stage: SaveStageNone, Category: SaveCategoryNone, CredentialsChanged: true}, nil
+}
+
+func (s *shutdownRefreshStore) token() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.saved
+}
+
+func shutdownRefreshReplacement(a *Auth) *Auth {
+	a = a.Clone()
+	a.Metadata["refresh_token"] = "replacement-refresh"
+	a.Metadata["access_token"] = "replacement-access"
+	return a
+}
+
+func shutdownRefreshManager(t *testing.T, store *shutdownRefreshStore, refresh func(context.Context, *Auth) (*Auth, error)) *Manager {
+	t.Helper()
+	m := NewManager(store, nil, nil)
+	m.SetConfig(&internalconfig.Config{AuthAutoRefreshWorkers: 1})
+	m.RegisterExecutor(&shutdownRefreshExecutor{refresh: refresh})
+	_, err := m.Register(WithSkipPersist(context.Background()), &Auth{
+		ID: "shutdown-fixture", Provider: "shutdown-fixture",
+		Metadata: map[string]any{"refresh_token": "old-refresh", "access_token": "old-access"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		if err := m.StopAutoRefreshAndWait(ctx); err != nil {
+			t.Errorf("refresh cleanup: %v", err)
+		}
+	})
+	return m
+}
+
+func shutdownRefreshStart(m *Manager) *authAutoRefreshLoop {
+	// This provider has no automatic refresh lead: enqueue explicitly, without timers.
+	m.StartAutoRefresh(context.Background(), time.Hour)
+	m.mu.RLock()
+	loop := m.refreshLoop
+	m.mu.RUnlock()
+	loop.jobs <- "shutdown-fixture"
+	return loop
+}
+
+func shutdownRefreshSignal(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for refresh fixture")
+	}
+}
+
+func shutdownRefreshBlocked(t *testing.T, done <-chan error) {
+	t.Helper()
+	select {
+	case err := <-done:
+		t.Fatalf("join returned before refresh completion: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+}
+
+func shutdownRefreshJoined(t *testing.T, done <-chan error, store *shutdownRefreshStore) {
+	t.Helper()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("refresh join did not finish")
+	}
+	if got := store.token(); got != "replacement-refresh" {
+		t.Fatalf("saved token = %q, want replacement-refresh", got)
+	}
+}
+
+func shutdownRefreshJoin(m *Manager) <-chan error {
+	done := make(chan error, 1)
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		done <- m.StopAutoRefreshAndWait(ctx)
+	}()
+	return done
+}
+
+func shutdownRefreshRelease(t *testing.T) (chan struct{}, func()) {
+	t.Helper()
+	ch := make(chan struct{})
+	var once sync.Once
+	release := func() { once.Do(func() { close(ch) }) }
+	t.Cleanup(release)
+	return ch, release
+}
+
+func TestRefreshShutdownWaitsForExecutor(t *testing.T) {
+	entered, cancelled := make(chan struct{}), make(chan struct{})
+	store := &shutdownRefreshStore{}
+	var hold <-chan struct{}
+	m := shutdownRefreshManager(t, store, func(ctx context.Context, a *Auth) (*Auth, error) {
+		close(entered)
+		<-ctx.Done()
+		close(cancelled)
+		// Like a shielded provider HTTP attempt, cancellation does not end this call.
+		<-hold
+		return shutdownRefreshReplacement(a), nil
+	})
+	releaseCh, release := shutdownRefreshRelease(t)
+	hold = releaseCh
+	shutdownRefreshStart(m)
+	shutdownRefreshSignal(t, entered)
+	done := shutdownRefreshJoin(m)
+	shutdownRefreshSignal(t, cancelled)
+	shutdownRefreshBlocked(t, done)
+	if got := store.token(); got != "" {
+		t.Fatalf("save occurred before executor release: %q", got)
+	}
+	release()
+	shutdownRefreshJoined(t, done, store)
+}
+
+type shutdownReceiptHook struct {
+	entered chan struct{}
+	release <-chan struct{}
+	once    sync.Once
+}
+
+func (*shutdownReceiptHook) Levels() []log.Level { return []log.Level{log.InfoLevel} }
+func (h *shutdownReceiptHook) Fire(e *log.Entry) error {
+	if strings.HasPrefix(e.Message, "credential_save_v1 operation=refresh result=persisted ") {
+		h.once.Do(func() {
+			close(h.entered)
+			<-h.release
+		})
+	}
+	return nil
+}
+
+func TestRefreshShutdownWaitsForDurableSave(t *testing.T) {
+	storeEntered := make(chan struct{})
+	store := &shutdownRefreshStore{}
+	m := shutdownRefreshManager(t, store, func(_ context.Context, a *Auth) (*Auth, error) {
+		return shutdownRefreshReplacement(a), nil
+	})
+	// The receipt hook is installed before starting any refresh and restored only
+	// after cleanup joined it; the store barrier and reporting barrier are separate.
+	logger := log.StandardLogger()
+	oldHooks, oldLevel := logger.ReplaceHooks(make(log.LevelHooks)), logger.GetLevel()
+	logger.SetLevel(log.InfoLevel)
+	t.Cleanup(func() { logger.ReplaceHooks(oldHooks); logger.SetLevel(oldLevel) })
+	storeHold, releaseStore := shutdownRefreshRelease(t)
+	receiptHold, releaseReceipt := shutdownRefreshRelease(t)
+	hook := &shutdownReceiptHook{entered: make(chan struct{}), release: receiptHold}
+	logger.AddHook(hook)
+	store.save = func(opts SaveOptions) {
+		if !opts.Sync {
+			t.Error("refresh did not request a durable save")
+		}
+		close(storeEntered)
+		<-storeHold
+	}
+	shutdownRefreshStart(m)
+	shutdownRefreshSignal(t, storeEntered)
+	done := shutdownRefreshJoin(m)
+	shutdownRefreshBlocked(t, done)
+	releaseStore()
+	shutdownRefreshSignal(t, hook.entered)
+	shutdownRefreshBlocked(t, done)
+	releaseReceipt()
+	shutdownRefreshJoined(t, done, store)
+}
+
+func TestRefreshShutdownSkipsQueuedJobs(t *testing.T) {
+	entered, cancelled := make(chan struct{}), make(chan struct{})
+	store := &shutdownRefreshStore{}
+	var hold <-chan struct{}
+	calls := 0 // read only after the join
+	m := shutdownRefreshManager(t, store, func(ctx context.Context, a *Auth) (*Auth, error) {
+		calls++
+		if calls == 1 {
+			close(entered)
+			<-ctx.Done()
+			close(cancelled)
+			<-hold
+		}
+		return shutdownRefreshReplacement(a), nil
+	})
+	releaseCh, release := shutdownRefreshRelease(t)
+	hold = releaseCh
+	loop := shutdownRefreshStart(m)
+	shutdownRefreshSignal(t, entered)
+	for i := 0; i < cap(loop.jobs); i++ {
+		loop.jobs <- "shutdown-fixture"
+	}
+	done := shutdownRefreshJoin(m)
+	shutdownRefreshSignal(t, cancelled)
+	release()
+	shutdownRefreshJoined(t, done, store)
+	if calls != 1 {
+		t.Fatalf("executor calls = %d, want only the already-active refresh", calls)
+	}
+}
+
+func TestRefreshShutdownCanceledAuthLockWaitDoesNotStartRefresh(t *testing.T) {
+	store := &shutdownRefreshStore{}
+	called := make(chan struct{}, 1)
+	m := shutdownRefreshManager(t, store, func(_ context.Context, a *Auth) (*Auth, error) {
+		called <- struct{}{}
+		return shutdownRefreshReplacement(a), nil
+	})
+	lock := &authRefreshLock{}
+	lock.mu.Lock()
+	m.refreshLocks.Store("shutdown-fixture", lock)
+	var once sync.Once
+	unlock := func() { once.Do(lock.mu.Unlock) }
+	t.Cleanup(unlock)
+	loop := shutdownRefreshStart(m)
+	deadline := time.After(5 * time.Second)
+	for len(loop.jobs) != 0 {
+		select {
+		case <-deadline:
+			t.Fatal("worker did not dequeue the job")
+		case <-time.After(time.Millisecond):
+		}
+	}
+	// Cancellation occurs before the held per-auth lock can be acquired, whether
+	// the worker is already waiting there or is just about to try to acquire it.
+	m.StopAutoRefresh()
+	unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err := m.StopAutoRefreshAndWait(ctx); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-called:
+		t.Fatal("cancelled lock waiter started a provider refresh")
+	default:
+	}
+	if got := store.token(); got != "" {
+		t.Fatalf("cancelled lock waiter saved token %q", got)
+	}
+}
+
+func TestRefreshShutdownDeadline(t *testing.T) {
+	entered := make(chan struct{})
+	store := &shutdownRefreshStore{}
+	var hold <-chan struct{}
+	m := shutdownRefreshManager(t, store, func(_ context.Context, a *Auth) (*Auth, error) {
+		close(entered)
+		<-hold
+		return shutdownRefreshReplacement(a), nil
+	})
+	releaseCh, release := shutdownRefreshRelease(t)
+	hold = releaseCh
+	shutdownRefreshStart(m)
+	shutdownRefreshSignal(t, entered)
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- m.StopAutoRefreshAndWait(ctx) }()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("join error = %v, want deadline exceeded", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("uncooperative refresh hung the bounded join")
+	}
+	if got := store.token(); got != "" {
+		t.Fatalf("deadline exit claimed an unfinished save: %q", got)
+	}
+	// Deadline failure must retain the old run for a later join.
+	release()
+	shutdownRefreshJoined(t, shutdownRefreshJoin(m), store)
+}
+
+func TestRefreshShutdownRepeatedStop(t *testing.T) {
+	var nilManager *Manager
+	nilManager.StopAutoRefresh()
+	if err := nilManager.StopAutoRefreshAndWait(nil); err != nil {
+		t.Fatal(err)
+	}
+	m := NewManager(nil, nil, nil)
+	if err := m.StopAutoRefreshAndWait(nil); err != nil {
+		t.Fatal(err)
+	}
+	entered := make(chan struct{})
+	store := &shutdownRefreshStore{}
+	var hold <-chan struct{}
+	m = shutdownRefreshManager(t, store, func(_ context.Context, a *Auth) (*Auth, error) {
+		close(entered)
+		<-hold
+		return shutdownRefreshReplacement(a), nil
+	})
+	releaseCh, release := shutdownRefreshRelease(t)
+	hold = releaseCh
+	shutdownRefreshStart(m)
+	shutdownRefreshSignal(t, entered)
+	// The old API must return promptly even though the executor ignores cancel.
+	m.StopAutoRefresh()
+	m.StopAutoRefresh()
+	const waiters = 8
+	dones := make([]<-chan error, waiters)
+	for i := range dones {
+		dones[i] = shutdownRefreshJoin(m)
+	}
+	shutdownRefreshBlocked(t, dones[0])
+	release()
+	for _, done := range dones {
+		shutdownRefreshJoined(t, done, store)
+	}
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := m.StopAutoRefreshAndWait(cancelled); err != nil {
+		t.Fatalf("already-complete run: %v", err)
+	}
+}
+
+func TestRefreshShutdownPreviousRunIsJoined(t *testing.T) {
+	for _, stopFirst := range []bool{false, true} {
+		name := "replacement"
+		if stopFirst {
+			name = "stop_then_replacement"
+		}
+		t.Run(name, func(t *testing.T) {
+			entered := make(chan struct{})
+			store := &shutdownRefreshStore{}
+			var hold <-chan struct{}
+			m := shutdownRefreshManager(t, store, func(_ context.Context, a *Auth) (*Auth, error) {
+				close(entered)
+				<-hold
+				return shutdownRefreshReplacement(a), nil
+			})
+			releaseCh, release := shutdownRefreshRelease(t)
+			hold = releaseCh
+			shutdownRefreshStart(m)
+			shutdownRefreshSignal(t, entered)
+			if stopFirst {
+				m.StopAutoRefresh()
+			}
+			m.StartAutoRefresh(context.Background(), time.Hour)
+			done := shutdownRefreshJoin(m)
+			shutdownRefreshBlocked(t, done)
+			release()
+			shutdownRefreshJoined(t, done, store)
+		})
+	}
+
+	// Start/stop publication races must not orphan a run before it starts.
+	t.Run("concurrent_start_stop", func(t *testing.T) {
+		m := NewManager(nil, nil, nil)
+		var wg sync.WaitGroup
+		for i := 0; i < 8; i++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				m.StartAutoRefresh(context.Background(), time.Hour)
+				m.StopAutoRefresh()
+			}()
+		}
+		wg.Wait()
