+// cloneMetadataValue copies the JSON container shapes credential metadata holds
+// (nested objects, arrays and the Claude device-ID pool), so a clone never shares
+// a mutable container with its source. Scalars and other values are returned as is.
+func cloneMetadataValue(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		if typed == nil {
+			return typed
+		}
+		out := make(map[string]any, len(typed))
+		for key, item := range typed {
+			out[key] = cloneMetadataValue(item)
+		}
+		return out
+	case map[string]string:
+		if typed == nil {
+			return typed
+		}
+		out := make(map[string]string, len(typed))
+		for key, item := range typed {
+			out[key] = item
