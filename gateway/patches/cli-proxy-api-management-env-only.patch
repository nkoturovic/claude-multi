diff --git a/internal/config/management_env_only.go b/internal/config/management_env_only.go
new file mode 100644
index 0000000..98fd5f5
--- /dev/null
+++ b/internal/config/management_env_only.go
@@ -0,0 +1,17 @@
+package config
+
+import log "github.com/sirupsen/logrus"
+
+// claude-multi local patch (management-env-only): the management API
+// authenticates only with the MANAGEMENT_PASSWORD environment secret. A
+// remote-management secret-key from a config file or payload, plaintext or
+// bcrypt, is dropped at every load (start and hot reload): it never enables
+// the management API, never authenticates, is never hashed and is never
+// written back. The value itself is never logged.
+func dropConfigManagementSecret(cfg *Config) {
+	if cfg == nil || cfg.RemoteManagement.SecretKey == "" {
+		return
+	}
+	cfg.RemoteManagement.SecretKey = ""
+	log.Warn("remote-management.secret-key is ignored: management authenticates only with MANAGEMENT_PASSWORD")
+}
diff --git a/internal/config/management_env_only_test.go b/internal/config/management_env_only_test.go
new file mode 100644
