@@ -0,0 +1,497 @@
+package api
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	managementHandlers "github.com/router-for-me/CLIProxyAPI/v7/internal/api/handlers/management"
+	proxyconfig "github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/pluginhost"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/watcher"
+	sdkaccess "github.com/router-for-me/CLIProxyAPI/v7/sdk/access"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"golang.org/x/crypto/bcrypt"
+)
+
+// claude-multi local patch (management-env-only) gate. The management API
+// authenticates only with the MANAGEMENT_PASSWORD environment secret, at
+// start and after every config reload; a remote-management secret-key from
+// config.yaml, plaintext or bcrypt, and a runtime local management password
+// (-password / TUI mode) never enable it and never authenticate. Network-free: requests go through server.engine.ServeHTTP,
+// hot reloads through a real config watcher (fsnotify on a temp dir) whose
+// callback is Server.UpdateClients, as in production.
+
+const (
+	envOnlyEnvKey    = "env-only-management-env-key"
+	envOnlyConfigKey = "env-only-management-config-key"
+	envOnlyClientKey = "env-only-client-api-key"
+	envOnlyLocalKey  = "env-only-local-management-password"
+	envOnlyTimeout   = 5 * time.Second
+)
+
+type envOnlySecret struct {
+	name  string
+	value string // the secret-key value written into config.yaml
+}
+
+// envOnlySecrets returns the config secret shapes: the plaintext key and a
+// bcrypt hash of it (both authenticate on the six-patch build).
+func envOnlySecrets(t *testing.T, key string) []envOnlySecret {
+	t.Helper()
+	hashed, err := bcrypt.GenerateFromPassword([]byte(key), bcrypt.MinCost)
+	if err != nil {
+		t.Fatalf("bcrypt: %v", err)
+	}
+	return []envOnlySecret{{"plaintext", key}, {"bcrypt", string(hashed)}}
+}
+
+// envOnlyUnsetEnv removes MANAGEMENT_PASSWORD for the test (restored after).
+func envOnlyUnsetEnv(t *testing.T) {
+	t.Helper()
+	t.Setenv("MANAGEMENT_PASSWORD", "")
+	if err := os.Unsetenv("MANAGEMENT_PASSWORD"); err != nil {
+		t.Fatalf("unsetenv: %v", err)
+	}
+}
+
+// envOnlyYAML renders a claude-multi-shaped config; secret "" omits the key.
+func envOnlyYAML(authDir string, port int, secret string) []byte {
+	var b strings.Builder
+	fmt.Fprintf(&b, "host: \"127.0.0.1\"\nport: %d\nauth-dir: %q\napi-keys:\n  - %q\n", port, authDir, envOnlyClientKey)
+	b.WriteString("remote-management:\n  allow-remote: false\n")
+	if secret != "" {
+		fmt.Fprintf(&b, "  secret-key: %q\n", secret)
+	}
+	b.WriteString("  disable-control-panel: true\n  disable-auto-update-panel: true\n")
+	return []byte(b.String())
+}
+
+type envOnlyFixture struct {
+	t       *testing.T
+	root    string
+	cfgPath string
+	authDir string
+}
+
+func newEnvOnlyFixture(t *testing.T) *envOnlyFixture {
+	t.Helper()
+	root := t.TempDir()
+	f := &envOnlyFixture{
+		t:       t,
+		root:    root,
+		cfgPath: filepath.Join(root, "cfg", "config.yaml"),
+		authDir: filepath.Join(root, "auth"),
+	}
+	for _, dir := range []string{filepath.Dir(f.cfgPath), f.authDir} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatalf("mkdir %s: %v", dir, err)
+		}
+	}
+	return f
+}
+
+// write seeds config.yaml and loads it through the production start path.
+func (f *envOnlyFixture) write(secret string) *proxyconfig.Config {
+	f.t.Helper()
+	data := envOnlyYAML(f.authDir, 1, secret)
+	if err := os.WriteFile(f.cfgPath, data, 0o600); err != nil {
+		f.t.Fatalf("write config: %v", err)
+	}
+	cfg, err := proxyconfig.LoadConfig(f.cfgPath)
+	if err != nil {
+		f.t.Fatalf("load config: %v", err)
+	}
+	if after, _ := os.ReadFile(f.cfgPath); string(after) != string(data) {
+		f.t.Errorf("loading the config rewrote config.yaml (%d -> %d bytes)", len(data), len(after))
+	}
+	return cfg
+}
+
+// parse loads config bytes through the reload path without touching
+// config.yaml (a running watcher must not see these).
+func (f *envOnlyFixture) parse(port int) *proxyconfig.Config {
+	f.t.Helper()
+	cfg, err := proxyconfig.LoadConfigBytes(envOnlyYAML(f.authDir, port, ""))
+	if err != nil {
+		f.t.Fatalf("load config bytes: %v", err)
+	}
+	cfg.AuthDir = f.authDir
+	return cfg
+}
+
+// server builds a production-shaped server (plugin host wired as
+// sdk/cliproxy/builder.go does) over cfg and the fixture's config path.
+func (f *envOnlyFixture) server(cfg *proxyconfig.Config, opts ...ServerOption) *Server {
+	f.t.Helper()
+	gin.SetMode(gin.TestMode)
+	cfg.Port = 0
+	cfg.AuthDir = f.authDir
+	cfg.LoggingToFile = false
+	cfg.UsageStatisticsEnabled = false
+	host := pluginhost.New()
+	host.ApplyConfig(context.Background(), cfg)
+	host.RegisterFrontendAuthProviders()
+	opts = append([]ServerOption{WithPluginHost(host)}, opts...)
+	s := NewServer(cfg, auth.NewManager(nil, nil, nil), sdkaccess.NewManager(), f.cfgPath, opts...)
+	if s.pluginHost != host || s.mgmt == nil {
+		f.t.Fatal("server is not production-shaped: plugin host or management handler missing")
+	}
+	return s
+}
+
+// watch starts a real config watcher whose callback applies each reload to s
+// and then reports the config it applied.
+func (f *envOnlyFixture) watch(s *Server, running *proxyconfig.Config) <-chan *proxyconfig.Config {
+	f.t.Helper()
+	applied := make(chan *proxyconfig.Config, 16)
+	w, err := watcher.NewWatcher(f.cfgPath, f.authDir, func(cfg *proxyconfig.Config) {
+		s.UpdateClients(cfg)
+		applied <- cfg
+	})
+	if err != nil {
+		f.t.Fatalf("NewWatcher: %v", err)
+	}
+	w.SetConfig(running)
+	ctx, cancel := context.WithCancel(context.Background())
+	f.t.Cleanup(func() {
+		cancel()
+		_ = w.Stop()
+	})
+	if err = w.Start(ctx); err != nil {
+		f.t.Fatalf("watcher Start: %v", err)
+	}
+	f.expectApplied(applied, "initial load")
+	return applied
+}
+
+func (f *envOnlyFixture) expectApplied(applied <-chan *proxyconfig.Config, label string) *proxyconfig.Config {
+	f.t.Helper()
+	select {
+	case cfg := <-applied:
+		return cfg
+	case <-time.After(envOnlyTimeout):
+		f.t.Fatalf("%s: no config reload applied within %s", label, envOnlyTimeout)
+		return nil
+	}
+}
+
+// replace rename-replaces config.yaml (claude-multi's atomic write pattern)
+// and waits until the watcher has applied it.
+func (f *envOnlyFixture) replace(applied <-chan *proxyconfig.Config, port int, secret, label string) *proxyconfig.Config {
+	f.t.Helper()
+	tmp := filepath.Join(filepath.Dir(f.cfgPath), ".config.yaml.envonly.tmp")
+	if err := os.WriteFile(tmp, envOnlyYAML(f.authDir, port, secret), 0o600); err != nil {
+		f.t.Fatalf("write temp config: %v", err)
+	}
+	if err := os.Rename(tmp, f.cfgPath); err != nil {
+		f.t.Fatalf("rename config: %v", err)
+	}
+	cfg := f.expectApplied(applied, label)
+	if cfg.Port != port {
+		f.t.Fatalf("%s: applied port %d, want %d", label, cfg.Port, port)
+	}
+	return cfg
+}
+
+func envOnlyGet(s *Server, key string) (int, string) {
+	rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/v0/management/auth-files", key, ""))
+	return rr.Code, rr.Body.String()
+}
+
+// assertManagementOff: the allowlisted route answers the bare 404 of an
+// unavailable management API for the config key, a wrong key and no key.
+func assertManagementOff(t *testing.T, s *Server, label string) {
+	t.Helper()
+	if s.managementRoutesEnabled.Load() {
+		t.Fatalf("%s: management routes enabled without MANAGEMENT_PASSWORD", label)
+	}
+	for _, key := range []string{envOnlyConfigKey, envOnlyLocalKey, "wrong", ""} {
+		rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/v0/management/auth-files", key, ""))
+		assertRefused(t, rr, fmt.Sprintf("%s: key %q", label, key))
+	}
+}
+
+// assertEnvKeyOnly: the config key is refused as an invalid key and the env
+// key is accepted (the accepted request also resets the failure count).
+func assertEnvKeyOnly(t *testing.T, s *Server, label string) {
+	t.Helper()
+	if code, body := envOnlyGet(s, envOnlyConfigKey); code != http.StatusUnauthorized || !strings.Contains(body, "invalid management key") {
+		t.Fatalf("%s: config key: status = %d body=%q, want 401 invalid management key", label, code, body)
+	}
+	if code, body := envOnlyGet(s, envOnlyEnvKey); code != http.StatusOK {
+		t.Fatalf("%s: env key: status = %d body=%q, want 200", label, code, body)
+	}
+}
+
+// (1) A secret-key in the initial config, plaintext or bcrypt, does not
+// enable management: it is dropped at load (never hashed, never written
+// back) and the server leaves management off.
+func TestManagementEnvOnly_InitialConfigSecretDoesNotEnableManagement(t *testing.T) {
+	envOnlyUnsetEnv(t)
+	for _, secret := range envOnlySecrets(t, envOnlyConfigKey) {
+		t.Run(secret.name, func(t *testing.T) {
+			f := newEnvOnlyFixture(t)
+			cfg := f.write(secret.value)
+			if cfg.RemoteManagement.SecretKey != "" {
+				t.Error("the config secret-key survived the load")
+			}
+			assertManagementOff(t, f.server(cfg), "initial "+secret.name+" secret-key")
+		})
+	}
+}
+
+// (1) The server itself never treats a config secret as a management secret,
+// whatever built the config.
+func TestManagementEnvOnly_ServerIgnoresConfigSecretAtStart(t *testing.T) {
+	envOnlyUnsetEnv(t)
+	for _, secret := range envOnlySecrets(t, envOnlyConfigKey) {
+		t.Run(secret.name, func(t *testing.T) {
+			f := newEnvOnlyFixture(t)
+			cfg := f.write("")
+			cfg.RemoteManagement.SecretKey = secret.value
+			assertManagementOff(t, f.server(cfg), "start with a "+secret.name+" config secret")
+		})
+	}
+}
+
+// (2) A hot-reloaded config that adds a secret-key, plaintext or bcrypt,
+// does not enable management or authenticate.
+func TestManagementEnvOnly_HotReloadedConfigSecretDoesNotEnableManagement(t *testing.T) {
+	envOnlyUnsetEnv(t)
+	f := newEnvOnlyFixture(t)
+	running := f.write("")
+	s := f.server(running)
+	applied := f.watch(s, running)
+	assertManagementOff(t, s, "before reload")
+	for i, secret := range envOnlySecrets(t, envOnlyConfigKey) {
+		cfg := f.replace(applied, 10+i, secret.value, "reload adding a "+secret.name+" secret-key")
+		if cfg.RemoteManagement.SecretKey != "" {
+			t.Errorf("reload with a %s secret-key: the value survived the reload load", secret.name)
+		}
+		assertManagementOff(t, s, "after a reload adding a "+secret.name+" secret-key")
+	}
+	f.replace(applied, 20, "", "reload removing the secret-key")
+	assertManagementOff(t, s, "after a reload removing the secret-key")
+}
+
+// (2) The reload path itself never treats a config secret as a management
+// secret, whatever built the reloaded config.
+func TestManagementEnvOnly_ReloadIgnoresConfigSecret(t *testing.T) {
+	envOnlyUnsetEnv(t)
+	f := newEnvOnlyFixture(t)
+	s := f.server(f.write(""))
+	for i, secret := range envOnlySecrets(t, envOnlyConfigKey) {
+		next := f.parse(60 + i)
+		next.RemoteManagement.SecretKey = secret.value
+		s.UpdateClients(next)
+		assertManagementOff(t, s, "reload of a config carrying a "+secret.name+" secret")
+	}
+}
+
+// (3) With MANAGEMENT_PASSWORD set, only the env value authenticates; a
+// config secret-key, initial or hot-reloaded, plaintext or bcrypt, never
+// does.
+func TestManagementEnvOnly_EnvSecretIsTheOnlyKey(t *testing.T) {
+	t.Setenv("MANAGEMENT_PASSWORD", envOnlyEnvKey)
+	secrets := envOnlySecrets(t, envOnlyConfigKey)
+	for _, secret := range secrets {
+		t.Run("initial-"+secret.name, func(t *testing.T) {
+			f := newEnvOnlyFixture(t)
+			assertEnvKeyOnly(t, f.server(f.write(secret.value)), "initial "+secret.name+" secret-key")
+		})
+	}
+	t.Run("hot-reload", func(t *testing.T) {
+		f := newEnvOnlyFixture(t)
+		running := f.write("")
+		s := f.server(running)
+		applied := f.watch(s, running)
+		assertEnvKeyOnly(t, s, "before reload")
+		for i, secret := range secrets {
+			f.replace(applied, 30+i, secret.value, "reload adding a "+secret.name+" secret-key")
+			assertEnvKeyOnly(t, s, "after a reload adding a "+secret.name+" secret-key")
+		}
+		for i, secret := range secrets {
+			next := f.parse(70 + i)
+			next.RemoteManagement.SecretKey = secret.value
+			s.UpdateClients(next)
+			assertEnvKeyOnly(t, s, "reload of a config carrying a "+secret.name+" secret")
+		}
+	})
+}
+
+// (3) The management key check never accepts a config secret-key, with or
+// without the env secret, whatever built the config.
+func TestManagementEnvOnly_AuthenticateManagementKeyIgnoresConfigSecret(t *testing.T) {
+	for _, secret := range envOnlySecrets(t, envOnlyConfigKey) {
+		cfg := &proxyconfig.Config{}
+		cfg.RemoteManagement.SecretKey = secret.value
+
+		t.Run("env-set-"+secret.name, func(t *testing.T) {
+			t.Setenv("MANAGEMENT_PASSWORD", envOnlyEnvKey)
+			h := managementHandlers.NewHandler(cfg, "", nil)
+			if ok, code, msg := h.AuthenticateManagementKey("127.0.0.1", true, envOnlyConfigKey); ok || code != http.StatusUnauthorized {
+				t.Fatalf("config key with env set: ok=%v status=%d msg=%q, want 401", ok, code, msg)
+			}
+			if ok, code, msg := h.AuthenticateManagementKey("127.0.0.1", true, envOnlyEnvKey); !ok {
+				t.Fatalf("env key: ok=%v status=%d msg=%q, want accepted", ok, code, msg)
+			}
+		})
+		t.Run("env-unset-"+secret.name, func(t *testing.T) {
+			envOnlyUnsetEnv(t)
+			h := managementHandlers.NewHandler(cfg, "", nil)
+			ok, code, msg := h.AuthenticateManagementKey("127.0.0.1", true, envOnlyConfigKey)
+			if ok || code != http.StatusForbidden || msg != "remote management key not set" {
+				t.Fatalf("config key without env: ok=%v status=%d msg=%q, want 403 remote management key not set", ok, code, msg)
+			}
+		})
+	}
+}
+
+// (4) No regression: env-only management serves the read-only allowlist at
+// start and across reloads, refused routes stay bare 404s, and with no env
+// secret management stays off across reloads.
+func TestManagementEnvOnly_EnvOnlyManagementUnchanged(t *testing.T) {
+	t.Run("env-set", func(t *testing.T) {
+		t.Setenv("MANAGEMENT_PASSWORD", envOnlyEnvKey)
+		f := newEnvOnlyFixture(t)
+		running := f.write("")
+		s := f.server(running)
+		check := func(label string) {
+			t.Helper()
+			if !s.managementRoutesEnabled.Load() {
+				t.Fatalf("%s: management routes disabled with MANAGEMENT_PASSWORD set", label)
+			}
+			for route, target := range allowlistedManagementRoutes {
+				rr := serveAllowlist(s, allowlistRequest(http.MethodGet, target, envOnlyEnvKey, ""))
+				if rr.Code == http.StatusNotFound && rr.Body.Len() == 0 {
+					t.Fatalf("%s: %s refused with the env key", label, route)
+				}
+				if rr.Code == http.StatusUnauthorized || rr.Code == http.StatusForbidden {
+					t.Fatalf("%s: %s with the env key: status = %d body=%q", label, route, rr.Code, rr.Body.String())
+				}
+			}
+			if rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/v0/management/auth-files", "", "")); rr.Code != http.StatusUnauthorized {
+				t.Fatalf("%s: no key: status = %d, want 401", label, rr.Code)
+			}
+			assertRefused(t, serveAllowlist(s, allowlistRequest(http.MethodGet, "/v0/management/config.yaml", envOnlyEnvKey, "")), label+": refused route")
+			assertRefused(t, serveAllowlist(s, allowlistRequest(http.MethodPut, "/v0/management/debug", envOnlyEnvKey, "")), label+": refused write")
+			if code, body := envOnlyGet(s, envOnlyEnvKey); code != http.StatusOK {
+				t.Fatalf("%s: env key after the checks: status = %d body=%q, want 200 (not banned)", label, code, body)
+			}
+		}
+		check("start")
+		applied := f.watch(s, running)
+		check("after the initial watcher load")
+		f.replace(applied, 40, "", "reload without a secret-key")
+		check("after a reload")
+	})
+	t.Run("env-unset", func(t *testing.T) {
+		envOnlyUnsetEnv(t)
+		f := newEnvOnlyFixture(t)
+		running := f.write("")
+		s := f.server(running)
+		assertManagementOff(t, s, "start")
+		applied := f.watch(s, running)
+		f.replace(applied, 50, "", "reload without a secret-key")
+		assertManagementOff(t, s, "after a reload")
+	})
+}
+
+// assertLocalKeyRefused: with MANAGEMENT_PASSWORD set, a distinct local
+// management password is refused as an invalid key (from loopback, where
+// upstream accepts it) and the env key is accepted (resetting the count).
+func assertLocalKeyRefused(t *testing.T, s *Server, label string) {
+	t.Helper()
+	if !s.managementRoutesEnabled.Load() {
+		t.Fatalf("%s: management routes disabled with MANAGEMENT_PASSWORD set", label)
+	}
+	if code, body := envOnlyGet(s, envOnlyLocalKey); code != http.StatusUnauthorized || !strings.Contains(body, "invalid management key") {
+		t.Fatalf("%s: local password: status = %d body=%q, want 401 invalid management key", label, code, body)
+	}
+	if code, body := envOnlyGet(s, envOnlyEnvKey); code != http.StatusOK {
+		t.Fatalf("%s: env key: status = %d body=%q, want 200", label, code, body)
+	}
+}
+
+// (5) A runtime local management password (the -password flag, TUI mode;
+// WithLocalManagementPassword) is never a management key: with
+// MANAGEMENT_PASSWORD set only the env value authenticates, at start, after
+// hot reloads through the config watcher and after direct reloads; without
+// it the local password does not enable management (bare 404), at start or
+// after a reload.
+func TestManagementEnvOnly_LocalPasswordNeverAuthenticates(t *testing.T) {
+	t.Run("env-set", func(t *testing.T) {
+		t.Setenv("MANAGEMENT_PASSWORD", envOnlyEnvKey)
+		f := newEnvOnlyFixture(t)
+		running := f.write("")
+		s := f.server(running, WithLocalManagementPassword(envOnlyLocalKey))
+		assertLocalKeyRefused(t, s, "start")
+		applied := f.watch(s, running)
+		assertLocalKeyRefused(t, s, "after the initial watcher load")
+		f.replace(applied, 80, "", "hot reload")
+		assertLocalKeyRefused(t, s, "after a hot reload")
+		s.UpdateClients(f.parse(81))
+		assertLocalKeyRefused(t, s, "after a direct reload")
+	})
+	t.Run("env-unset", func(t *testing.T) {
+		envOnlyUnsetEnv(t)
+		f := newEnvOnlyFixture(t)
+		running := f.write("")
+		s := f.server(running, WithLocalManagementPassword(envOnlyLocalKey))
+		assertManagementOff(t, s, "start with a local password")
+		applied := f.watch(s, running)
+		assertManagementOff(t, s, "after the initial watcher load")
+		f.replace(applied, 82, "", "hot reload")
+		assertManagementOff(t, s, "after a hot reload")
+		s.UpdateClients(f.parse(83))
+		assertManagementOff(t, s, "after a direct reload")
+	})
+}
+
+// (5) The management key check never accepts the local password, loopback
+// or not, with or without the env secret.
+func TestManagementEnvOnly_AuthenticateManagementKeyIgnoresLocalPassword(t *testing.T) {
+	t.Run("env-set", func(t *testing.T) {
+		t.Setenv("MANAGEMENT_PASSWORD", envOnlyEnvKey)
+		h := managementHandlers.NewHandler(&proxyconfig.Config{}, "", nil)
+		h.SetLocalPassword(envOnlyLocalKey)
+		if ok, code, msg := h.AuthenticateManagementKey("127.0.0.1", true, envOnlyLocalKey); ok || code != http.StatusUnauthorized {
+			t.Fatalf("local password with env set: ok=%v status=%d msg=%q, want 401", ok, code, msg)
+		}
+		if ok, code, msg := h.AuthenticateManagementKey("127.0.0.1", true, envOnlyEnvKey); !ok {
+			t.Fatalf("env key: ok=%v status=%d msg=%q, want accepted", ok, code, msg)
+		}
+	})
+	t.Run("env-unset", func(t *testing.T) {
+		envOnlyUnsetEnv(t)
+		h := managementHandlers.NewHandler(&proxyconfig.Config{}, "", nil)
+		h.SetLocalPassword(envOnlyLocalKey)
+		ok, code, msg := h.AuthenticateManagementKey("127.0.0.1", true, envOnlyLocalKey)
+		if ok || code != http.StatusForbidden || msg != "remote management key not set" {
+			t.Fatalf("local password without env: ok=%v status=%d msg=%q, want 403 remote management key not set", ok, code, msg)
+		}
+	})
+}
+
+// (5) No regression: the local password still guards the keep-alive
+// endpoint it was made for (TUI / background mode), while management stays
+// off without MANAGEMENT_PASSWORD.
+func TestManagementEnvOnly_LocalPasswordStillGuardsKeepAlive(t *testing.T) {
+	envOnlyUnsetEnv(t)
+	f := newEnvOnlyFixture(t)
+	s := f.server(f.write(""), WithLocalManagementPassword(envOnlyLocalKey), WithKeepAliveEndpoint(time.Hour, func() {}))
+	if rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/keep-alive", envOnlyLocalKey, "")); rr.Code != http.StatusOK {
+		t.Fatalf("keep-alive with the local password: status = %d body=%q, want 200", rr.Code, rr.Body.String())
+	}
+	if rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/keep-alive", "wrong", "")); rr.Code != http.StatusUnauthorized {
+		t.Fatalf("keep-alive with a wrong password: status = %d body=%q, want 401", rr.Code, rr.Body.String())
+	}
+	assertManagementOff(t, s, "keep-alive server without MANAGEMENT_PASSWORD")
+}
