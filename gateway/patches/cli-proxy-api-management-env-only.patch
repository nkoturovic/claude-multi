--- /dev/null
+++ b/internal/config/management_env_only_test.go
@@ -0,0 +1,79 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/crypto/bcrypt"
+)
+
+// claude-multi local patch (management-env-only) gate: every config load
+// drops a remote-management secret-key, plaintext or bcrypt; it is never
+// hashed and config.yaml is never rewritten.
+
+const envOnlyConfigTestKey = "env-only-config-test-key"
+
+func envOnlyConfigYAML(secret string) []byte {
+	return []byte("port: 8317\napi-keys:\n  - \"client-key\"\nremote-management:\n  allow-remote: false\n  secret-key: \"" + secret + "\"\n")
+}
+
+func envOnlyConfigSecrets(t *testing.T) map[string]string {
+	t.Helper()
+	hashed, err := bcrypt.GenerateFromPassword([]byte(envOnlyConfigTestKey), bcrypt.MinCost)
+	if err != nil {
+		t.Fatalf("bcrypt: %v", err)
+	}
+	return map[string]string{"plaintext": envOnlyConfigTestKey, "bcrypt": string(hashed)}
+}
+
+func TestManagementEnvOnly_LoadConfigDropsSecretKeyWithoutWriteBack(t *testing.T) {
+	for name, secret := range envOnlyConfigSecrets(t) {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			data := envOnlyConfigYAML(secret)
+			if err := os.WriteFile(path, data, 0o600); err != nil {
+				t.Fatalf("write config: %v", err)
+			}
+			cfg, err := LoadConfig(path)
+			if err != nil {
+				t.Fatalf("LoadConfig: %v", err)
+			}
+			if cfg.RemoteManagement.SecretKey != "" {
+				t.Fatalf("LoadConfig kept a %s secret-key (len %d)", name, len(cfg.RemoteManagement.SecretKey))
+			}
+			if len(cfg.APIKeys) != 1 || cfg.Port != 8317 {
+				t.Fatalf("the rest of the config did not load: port=%d api-keys=%d", cfg.Port, len(cfg.APIKeys))
+			}
+			after, errRead := os.ReadFile(path)
+			if errRead != nil {
+				t.Fatalf("read config: %v", errRead)
+			}
+			if string(after) != string(data) {
+				t.Fatalf("LoadConfig rewrote config.yaml:\n%s", after)
+			}
+		})
+	}
+}
+
+func TestManagementEnvOnly_ReloadAndPayloadLoadsDropSecretKey(t *testing.T) {
+	for name, secret := range envOnlyConfigSecrets(t) {
+		t.Run(name, func(t *testing.T) {
+			data := envOnlyConfigYAML(secret)
+			cfg, err := LoadConfigBytes(data)
+			if err != nil {
+				t.Fatalf("LoadConfigBytes: %v", err)
+			}
+			if cfg.RemoteManagement.SecretKey != "" {
+				t.Fatalf("LoadConfigBytes (the watcher reload path) kept a %s secret-key", name)
+			}
+			parsed, err := ParseConfigBytes(data)
+			if err != nil {
+				t.Fatalf("ParseConfigBytes: %v", err)
+			}
+			if parsed.RemoteManagement.SecretKey != "" {
+				t.Fatalf("ParseConfigBytes kept a %s secret-key", name)
+			}
+		})
+	}
+}
