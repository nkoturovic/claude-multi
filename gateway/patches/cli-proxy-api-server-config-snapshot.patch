new file mode 100644
index 0000000..f1dc07e
--- /dev/null
+++ b/sdk/api/handlers/openai/openai_config_snapshot.go
@@ -0,0 +1,16 @@
+package openai
+
+import (
+	"github.com/gin-gonic/gin"
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+)
+
+// imageGenerationDisabled reads the request's SDK config snapshot (claude-multi
+// local patch, server-config-snapshot).
+func imageGenerationDisabled(h *OpenAIAPIHandler, c *gin.Context) bool {
+	if h == nil || h.BaseAPIHandler == nil {
+		return false
+	}
+	cfg := h.RequestConfig(c)
+	return cfg != nil && cfg.DisableImageGeneration == internalconfig.DisableImageGenerationAll
+}
diff --git a/sdk/api/handlers/openai/openai_config_snapshot_cm053_test.go b/sdk/api/handlers/openai/openai_config_snapshot_cm053_test.go
new file mode 100644
index 0000000..080ee5d
--- /dev/null
+++ b/sdk/api/handlers/openai/openai_config_snapshot_cm053_test.go
@@ -0,0 +1,73 @@
+package openai
+
+// claude-multi server-config-snapshot: every SDK config read of an image
+// or video request uses the snapshot the request pinned (RequestConfig), so a
+// reload that publishes a new snapshot mid-request never mixes two
+// configurations in one request, while a new request sees the new one.
+import (
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	apihandlers "github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+func cm053SnapshotContext() *gin.Context {
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	return c
+}
+
+// cm053KeepAliveEnabled reports whether the request's image-stream keepalive
+// ticker runs (configuration A enables it, configuration B disables it).
+func cm053KeepAliveEnabled(t *testing.T, h *OpenAIAPIHandler, c *gin.Context) bool {
+	t.Helper()
+	ticker, tick := h.newImagesStreamKeepAliveTicker(c)
+	if ticker == nil {
+		if tick != nil {
+			t.Fatal("disabled keepalive returned a channel")
+		}
+		return false
+	}
+	ticker.Stop()
+	return true
+}
+
+func TestCM053ImagesKeepAliveUsesRequestSnapshot(t *testing.T) {
+	configA := &sdkconfig.SDKConfig{}
+	configA.Streaming.KeepAliveSeconds = 1
+	configB := &sdkconfig.SDKConfig{}
+	configB.Streaming.KeepAliveSeconds = 0
+	base := apihandlers.NewBaseAPIHandlers(configA, nil)
+	h := NewOpenAIAPIHandler(base)
+
+	inFlight := cm053SnapshotContext()
+	if got := h.RequestConfig(inFlight); got != configA {
+		t.Fatal("request did not pin configuration A")
+	}
+	base.UpdateClients(configB)
+
+	// A enables keepalives, B disables them: the in-flight request keeps A.
+	if !cm053KeepAliveEnabled(t, h, inFlight) {
+		t.Fatal("in-flight request lost its keepalive to a reload published after it pinned A")
+	}
+	if cm053KeepAliveEnabled(t, h, cm053SnapshotContext()) {
+		t.Fatal("a new request did not see configuration B (keepalives disabled)")
+	}
+}
+
+func TestCM053VideoBindingTTLUsesRequestSnapshot(t *testing.T) {
+	base := apihandlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{VideoResultAuthCacheTTL: "45m"}, nil)
+	h := NewOpenAIAPIHandler(base)
+	inFlight := cm053SnapshotContext()
+	_ = h.RequestConfig(inFlight)
+	base.UpdateClients(&sdkconfig.SDKConfig{VideoResultAuthCacheTTL: "5m"})
+	if got := h.videoAuthBindingTTL(inFlight); got != 45*time.Minute {
+		t.Fatalf("in-flight request TTL = %v, want its pinned 45m", got)
+	}
+	if got := h.videoAuthBindingTTL(cm053SnapshotContext()); got != 5*time.Minute {
+		t.Fatalf("new request TTL = %v, want the published 5m", got)
+	}
+}
