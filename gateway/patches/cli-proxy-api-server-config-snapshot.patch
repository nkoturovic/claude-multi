@@ -0,0 +1,193 @@
+package handlers_test
+
+// claude-multi local patch (server-config-snapshot): the SDK
+// handler configuration publication (BaseAPIHandler.UpdateClients) against its
+// runtime readers. In-process only: a stub executor, gin test contexts, no
+// listener and no network. Repeat-safe; runs under -race -count=100.
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/interfaces"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers/claude"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+const (
+	cm053SDKModel  = "cm053-sdk-config-model"
+	cm053SDKAuthID = "cm053-sdk-config-auth"
+	cm053SDKRounds = 40
+)
+
+type cm053ConfigExecutor struct{}
+
+func (cm053ConfigExecutor) Identifier() string { return "codex" }
+
+func (cm053ConfigExecutor) Execute(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{Payload: []byte("ok"), Headers: http.Header{"X-Cm053-Upstream": {"1"}}}, nil
+}
+
+func (cm053ConfigExecutor) ExecuteStream(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	chunks := make(chan coreexecutor.StreamChunk, 1)
+	chunks <- coreexecutor.StreamChunk{Payload: []byte("ok")}
+	close(chunks)
+	return &coreexecutor.StreamResult{Headers: http.Header{"X-Cm053-Upstream": {"1"}}, Chunks: chunks}, nil
+}
+
+func (cm053ConfigExecutor) Refresh(_ context.Context, auth *coreauth.Auth) (*coreauth.Auth, error) {
+	return auth, nil
+}
+
+func (cm053ConfigExecutor) CountTokens(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, &coreauth.Error{Code: "not_implemented", Message: "CountTokens not implemented"}
+}
+
+func (cm053ConfigExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, &coreauth.Error{Code: "not_implemented", Message: "HttpRequest not implemented", HTTPStatus: http.StatusNotImplemented}
+}
+
+// cm053SDKConfig is a genuinely changed, freshly allocated SDK config per round.
+func cm053SDKConfig(round int) *sdkconfig.SDKConfig {
+	cfg := &sdkconfig.SDKConfig{
+		PassthroughHeaders:         round%2 == 0,
+		RequestLog:                 round%3 == 0,
+		NonStreamKeepAliveInterval: round % 2,
+	}
+	cfg.Streaming.KeepAliveSeconds = 5 + round%4
+	cfg.Streaming.BootstrapRetries = round % 2
+	cfg.ClaudeCode.DisableCloakingModelList = round%2 == 1
+	return cfg
+}
+
+func cm053SDKHandler(t *testing.T) *handlers.BaseAPIHandler {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.RegisterExecutor(cm053ConfigExecutor{})
+	auth := &coreauth.Auth{ID: cm053SDKAuthID, Provider: "codex", Status: coreauth.StatusActive, Metadata: map[string]any{"email": "cm053@example.invalid"}}
+	if _, err := manager.Register(context.Background(), auth); err != nil {
+		t.Fatalf("manager.Register: %v", err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: cm053SDKModel}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+	return handlers.NewBaseAPIHandlers(cm053SDKConfig(0), manager)
+}
+
+func cm053GinContext() (*gin.Context, *httptest.ResponseRecorder) {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+	return c, recorder
+}
+
+// cm053ServeOnce runs the SDK config readers one request goes through.
+func cm053ServeOnce(h *handlers.BaseAPIHandler, claudeHandler *claude.ClaudeCodeAPIHandler) error {
+	c, _ := cm053GinContext()
+	ctx, cancel := h.GetContextWithCancel(nil, c, context.Background())
+	pinned := h.RequestConfig(c)
+	stopKeepAlive := h.StartNonStreamingKeepAlive(c, ctx)
+	stopKeepAlive()
+	if _, _, errMsg := h.ExecuteWithAuthManager(ctx, "openai", cm053SDKModel, []byte(`{"model":"`+cm053SDKModel+`"}`), ""); errMsg != nil {
+		cancel(errMsg.Error)
+		return errors.New("execute failed")
+	}
+	data, _, errs := h.ExecuteStreamWithAuthManager(ctx, "openai", cm053SDKModel, []byte(`{"model":"`+cm053SDKModel+`","stream":true}`), "")
+	for range data {
+	}
+	for errMsg := range errs {
+		if errMsg != nil {
+			cancel(errMsg.Error)
+			return errors.New("stream failed")
+		}
+	}
+	h.WriteErrorResponse(c, &interfaces.ErrorMessage{StatusCode: http.StatusBadGateway, Error: errors.New("cm053"), Addon: http.Header{"X-Cm053-Addon": {"1"}}})
+	closed := make(chan []byte)
+	close(closed)
+	h.ForwardStream(c, c.Writer, func(error) {}, closed, nil, handlers.StreamForwardOptions{})
+	models, _ := cm053GinContext()
+	claudeHandler.ClaudeModels(models)
+	cancel([]byte("done"))
+	if h.RequestConfig(c) != pinned {
+		return errors.New("request changed SDK config snapshots mid-request")
+	}
+	return nil
+}
+
+func TestCM053ReloadConcurrentSDKHandlerConfig(t *testing.T) {
+	h := cm053SDKHandler(t)
+	claudeHandler := claude.NewClaudeCodeAPIHandler(h)
+	var served atomic.Int64
+	var failures sync.Map
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	for worker := 0; worker < 4; worker++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				if err := cm053ServeOnce(h, claudeHandler); err != nil {
+					failures.Store(err.Error(), true)
+				}
+				served.Add(1)
+			}
+		}()
+	}
+	// Interleave: each publication waits until requests have run since the
+	// previous one, so every round overlaps live readers.
+	deadline := time.Now().Add(30 * time.Second)
+	for round := 1; round <= cm053SDKRounds; round++ {
+		h.UpdateClients(cm053SDKConfig(round))
+		for want := served.Load() + 2; served.Load() < want && time.Now().Before(deadline); {
+			runtime.Gosched()
+		}
+	}
+	close(stop)
+	wg.Wait()
+	if served.Load() < 2*cm053SDKRounds {
+		t.Fatalf("only %d requests overlapped %d SDK config publications", served.Load(), cm053SDKRounds)
+	}
+	failures.Range(func(key, _ any) bool {
+		t.Errorf("request failure: %v", key)
+		return true
+	})
+
+	// One captured snapshot per request: the snapshot GetContextWithCancel
+	// pins survives a publication; a new request sees the new snapshot.
+	c, _ := cm053GinContext()
+	_, cancel := h.GetContextWithCancel(nil, c, context.Background())
+	defer cancel()
+	pinned := h.RequestConfig(c)
+	if pinned == nil || pinned != h.CurrentConfig() {
+		t.Fatal("GetContextWithCancel must pin the current snapshot")
+	}
+	next := cm053SDKConfig(cm053SDKRounds + 1)
+	h.UpdateClients(next)
+	if h.CurrentConfig() != next {
+		t.Fatal("UpdateClients did not publish the new snapshot")
+	}
+	if h.RequestConfig(c) != pinned {
+		t.Fatal("a request changed SDK config snapshots mid-request")
+	}
+	fresh, _ := cm053GinContext()
+	if h.RequestConfig(fresh) != next {
+		t.Fatal("a new request must use the newest SDK config snapshot")
+	}
+}
