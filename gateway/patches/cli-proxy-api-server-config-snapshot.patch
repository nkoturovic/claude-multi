diff --git a/internal/api/server_config_snapshot.go b/internal/api/server_config_snapshot.go
new file mode 100644
index 0000000..62cc9c9
--- /dev/null
+++ b/internal/api/server_config_snapshot.go
@@ -0,0 +1,55 @@
+package api
+
+// claude-multi local patch (server-config-snapshot): the
+// server configuration is one published, server-owned snapshot. NewServer and
+// UpdateClientsContext publish cfg.CloneForRuntime(), so no caller keeps a
+// mutable alias of what request handlers read, and a published snapshot is
+// never mutated. cfgMu guards only the pointer: it is never held across
+// c.Next(), network or filesystem I/O, or plugin callbacks. reloadMu
+// serializes reload bookkeeping (oldConfigYaml and the change-driven side
+// effects) separately; request readers never take it.
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+)
+
+// serverConfigSnapshotKey pins the server config snapshot a request uses in its
+// gin context.
+const serverConfigSnapshotKey = "cliproxy.cm053.serverConfigSnapshot"
+
+// currentConfig returns the published server configuration snapshot.
+func (s *Server) currentConfig() *config.Config {
+	if s == nil {
+		return nil
+	}
+	s.cfgMu.RLock()
+	cfg := s.cfg
+	s.cfgMu.RUnlock()
+	return cfg
+}
+
+// requestConfig returns the one snapshot a request uses: the first reader of
+// the request (the home heartbeat middleware, which runs for every route)
+// pins the snapshot current at that moment in the gin context, and later
+// readers of the same request get it even when a reload publishes a new one.
+func (s *Server) requestConfig(c *gin.Context) *config.Config {
+	if c != nil {
+		if value, ok := c.Get(serverConfigSnapshotKey); ok {
+			if cfg, okCfg := value.(*config.Config); okCfg {
+				return cfg
+			}
+		}
+	}
+	cfg := s.currentConfig()
+	if c != nil {
+		c.Set(serverConfigSnapshotKey, cfg)
+	}
+	return cfg
+}
+
+// requestHomeEnabled reports Home mode from the request's snapshot.
+func (s *Server) requestHomeEnabled(c *gin.Context) bool {
+	cfg := s.requestConfig(c)
+	return cfg != nil && cfg.Home.Enabled
+}
diff --git a/internal/api/server_config_snapshot_cm053_test.go b/internal/api/server_config_snapshot_cm053_test.go
new file mode 100644
index 0000000..7fef9ed
--- /dev/null
+++ b/internal/api/server_config_snapshot_cm053_test.go
@@ -0,0 +1,259 @@
+package api
+
+// claude-multi local patch (server-config-snapshot) gates.
+// In-process gin engine only: no listener, no network. The concurrency gates
+// are repeat-safe and run under -race -count=100.
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	proxyconfig "github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers/claude"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers/openai"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+const (
+	cm053ClientKey     = "cm053-snapshot-client"
+	cm053ReloadRounds  = 40
+	cm053RequestWorker = 4
+)
+
+// cm053NextConfig builds a genuinely changed, freshly allocated configuration
+// for one accepted reload (every container is new, as a watcher reload's is).
+func cm053NextConfig(base *proxyconfig.Config, round int) *proxyconfig.Config {
+	next := &proxyconfig.Config{
+		SDKConfig: sdkconfig.SDKConfig{
+			APIKeys:                    []string{cm053ClientKey},
+			PassthroughHeaders:         round%2 == 0,
+			NonStreamKeepAliveInterval: 0,
+		},
+	}
+	next.Port = base.Port
+	next.AuthDir = base.AuthDir
+	next.Debug = base.Debug
+	next.LoggingToFile = base.LoggingToFile
+	next.UsageStatisticsEnabled = base.UsageStatisticsEnabled
+	next.RequestRetry = round%3 + 1
+	next.ClaudeCode.DisableCloakingModelList = round%2 == 1
+	next.OAuthModelAlias = map[string][]proxyconfig.OAuthModelAlias{
+		"claude": {{Name: "cm053-upstream", Alias: "cm053-alias"}},
+	}
+	return next
+}
+
+func cm053SnapshotServer(t *testing.T) (*Server, *proxyconfig.Config) {
+	t.Helper()
+	t.Setenv("MANAGEMENT_PASSWORD", "")
+	cfg := &proxyconfig.Config{SDKConfig: sdkconfig.SDKConfig{APIKeys: []string{cm053ClientKey}}}
+	server := newTestServerWithConfig(t, cfg)
+	return server, cfg
+}
+
+// cm053ReloadWhileServing applies rounds genuinely changed reloads while
+// workers send the given requests through the real engine; afterReload runs
+// after each accepted reload on the reloading goroutine.
+func cm053ReloadWhileServing(t *testing.T, server *Server, base *proxyconfig.Config, request func(worker, n int) *http.Request, okStatus func(*http.Request, int) bool, afterReload func()) {
+	t.Helper()
+	var served, unexpected atomic.Int64
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	for worker := 0; worker < cm053RequestWorker; worker++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			for n := 0; ; n++ {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				req := request(worker, n)
+				recorder := httptest.NewRecorder()
+				server.engine.ServeHTTP(recorder, req)
+				served.Add(1)
+				if !okStatus(req, recorder.Code) {
+					unexpected.Add(1)
+				}
+			}
+		}(worker)
+	}
+	applied := 0
+	for round := 0; round < cm053ReloadRounds; round++ {
+		if server.UpdateClientsContext(context.Background(), cm053NextConfig(base, round)) {
+			applied++
+		}
+		if afterReload != nil {
+			afterReload()
+		}
+	}
+	close(stop)
+	wg.Wait()
+	if applied != cm053ReloadRounds {
+		t.Fatalf("accepted reloads = %d, want %d", applied, cm053ReloadRounds)
+	}
+	if served.Load() == 0 {
+		t.Fatal("no request overlapped the reloads")
+	}
+	if unexpected.Load() != 0 {
+		t.Fatalf("%d of %d requests returned an unexpected status", unexpected.Load(), served.Load())
+	}
+}
+
+func TestCM053ReloadConcurrentHomeHeartbeat(t *testing.T) {
+	server, base := cm053SnapshotServer(t)
+	cm053ReloadWhileServing(t, server, base, func(int, int) *http.Request {
+		// Every route passes homeHeartbeatMiddleware; /healthz needs no auth.
+		return httptest.NewRequest(http.MethodGet, "/healthz", nil)
+	}, func(_ *http.Request, code int) bool { return code == http.StatusOK }, nil)
+}
+
+func TestCM053ReloadConcurrentUnifiedModels(t *testing.T) {
+	server, base := cm053SnapshotServer(t)
+	// The production /v1/models route's model handlers write through
+	// s.handlers, whose plugin-host field every reload also rewrites
+	// (SetPluginHost, the plugin-host-locking patch's scope). This gate keeps to
+	// the config: the same unifiedModelsHandler (Server.cfg reads) behind the same
+	// middleware chain, over model handlers whose SDK config is republished
+	// from the server snapshot after every reload (UpdateClients vs
+	// ClaudeModels/OpenAIModels), without a plugin-host writer.
+	side := handlers.NewBaseAPIHandlers(effectiveSDKConfig(server.currentConfig()), server.handlers.AuthManager)
+	v1 := server.engine.Group("/cm053/v1")
+	v1.Use(AuthMiddleware(server.accessManager))
+	v1.GET("/models", server.unifiedModelsHandler(openai.NewOpenAIAPIHandler(side), claude.NewClaudeCodeAPIHandler(side)))
+	cm053ReloadWhileServing(t, server, base, func(worker, n int) *http.Request {
+		req := httptest.NewRequest(http.MethodGet, "/cm053/v1/models", nil)
+		req.Header.Set("Authorization", "Bearer "+cm053ClientKey)
+		if (worker+n)%2 == 0 {
+			// Anthropic request: unifiedModelsHandler -> ClaudeModels.
+			req.Header.Set("Anthropic-Version", "2023-06-01")
+		}
+		return req
+	}, func(_ *http.Request, code int) bool { return code == http.StatusOK }, func() {
+		side.UpdateClients(effectiveSDKConfig(server.currentConfig()))
+	})
+}
+
+func TestCM053ServerConfigSnapshotOwnership(t *testing.T) {
+	server, callerCfg := cm053SnapshotServer(t)
+
+	// NewServer publishes a server-owned copy, not the caller's object.
+	initial := server.currentConfig()
+	if initial == nil || initial == callerCfg {
+		t.Fatal("NewServer must publish a server-owned snapshot, not the caller's config")
+	}
+	callerCfg.APIKeys[0] = "mutated-by-caller"
+	if initial.APIKeys[0] != cm053ClientKey {
+		t.Fatal("the initial snapshot shares the caller's api-keys backing array")
+	}
+	if sdk := server.handlers.CurrentConfig(); sdk == nil || sdk.APIKeys[0] != cm053ClientKey {
+		t.Fatal("the initial SDK handler config shares the caller's api-keys backing array")
+	}
+
+	// A reload publishes a deep, server-owned copy and derives the SDK
+	// handler config from it.
+	next := cm053NextConfig(callerCfg, 1)
+	if !server.UpdateClientsContext(context.Background(), next) {
+		t.Fatal("reload was not accepted")
+	}
+	published := server.currentConfig()
+	if published == nil || published == next || published == initial {
+		t.Fatal("reload must publish a new server-owned snapshot")
+	}
+	if published.RequestRetry != next.RequestRetry || !published.ClaudeCode.DisableCloakingModelList {
+		t.Fatal("the published snapshot does not carry the reloaded values")
+	}
+	next.APIKeys[0] = "mutated-after-reload"
+	next.OAuthModelAlias["claude"][0].Alias = "mutated-alias"
+	next.OAuthModelAlias["codex"] = nil
+	if published.APIKeys[0] != cm053ClientKey {
+		t.Fatal("the published snapshot shares the reload source's api-keys")
+	}
+	if aliases := published.OAuthModelAlias; len(aliases) != 1 || aliases["claude"][0].Alias != "cm053-alias" {
+		t.Fatal("the published snapshot shares the reload source's nested containers")
+	}
+	sdk := server.handlers.CurrentConfig()
+	if sdk == nil || sdk.APIKeys[0] != cm053ClientKey || sdk.PassthroughHeaders != next.PassthroughHeaders {
+		t.Fatal("the SDK handler config is not derived from the published snapshot")
+	}
+
+	// One captured snapshot per request: the first reader pins it, a later
+	// reload does not change what the same request sees.
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodGet, "/v1/models", nil)
+	pinnedServer := server.requestConfig(c)
+	pinnedSDK := server.handlers.RequestConfig(c)
+	if pinnedServer != published || pinnedSDK != sdk {
+		t.Fatal("the first reader must pin the current snapshots")
+	}
+	if !server.UpdateClientsContext(context.Background(), cm053NextConfig(callerCfg, 2)) {
+		t.Fatal("second reload was not accepted")
+	}
+	if server.currentConfig() == published || server.handlers.CurrentConfig() == sdk {
+		t.Fatal("the second reload did not publish new snapshots")
+	}
+	if server.requestConfig(c) != pinnedServer || server.handlers.RequestConfig(c) != pinnedSDK {
+		t.Fatal("a request changed snapshots mid-request")
+	}
+	fresh, _ := gin.CreateTestContext(httptest.NewRecorder())
+	if server.requestConfig(fresh) != server.currentConfig() {
+		t.Fatal("a new request must use the newest snapshot")
+	}
+
+	// No publication or reload lock is held across c.Next(): a reload
+	// completes while a request is parked inside its handler chain, and that
+	// request still reads its own pinned snapshot afterwards.
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var parkedSnapshot, afterSnapshot *proxyconfig.Config
+	server.engine.GET("/cm053-parked", func(c *gin.Context) {
+		parkedSnapshot = server.requestConfig(c)
+		close(entered)
+		<-release
+		afterSnapshot = server.requestConfig(c)
+		c.Status(http.StatusNoContent)
+	})
+	done := make(chan int, 1)
+	go func() {
+		recorder := httptest.NewRecorder()
+		server.engine.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/cm053-parked", nil))
+		done <- recorder.Code
+	}()
+	<-entered
+	reloaded := make(chan bool, 1)
+	go func() { reloaded <- server.UpdateClientsContext(context.Background(), cm053NextConfig(callerCfg, 3)) }()
+	select {
+	case ok := <-reloaded:
+		if !ok {
+			t.Fatal("reload during a parked request was not accepted")
+		}
+	case <-time.After(10 * time.Second):
+		close(release)
+		t.Fatal("reload blocked behind a request parked in c.Next()")
+	}
+	if server.currentConfig() == parkedSnapshot {
+		t.Fatal("the reload did not publish while the request was parked")
+	}
+	close(release)
+	if code := <-done; code != http.StatusNoContent {
+		t.Fatalf("parked request status = %d", code)
+	}
+	if afterSnapshot != parkedSnapshot {
+		t.Fatal("the parked request changed snapshots across the reload")
+	}
+
+	// Environment-only management is preserved through the reloads: no
+	// MANAGEMENT_PASSWORD, so management stays disabled.
+	if server.managementRoutesEnabled.Load() {
+		t.Fatal("management routes enabled without MANAGEMENT_PASSWORD")
+	}
+}
