+func TestManagementAllowlist_BypassVariantsRefused(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	for _, tc := range managementBypassTargets {
+		assertRefused(t, serveAllowlist(s, allowlistRequest(tc.method, tc.target, allowlistTestKey, "")), tc.method+" "+tc.target)
+	}
+	for _, tc := range managementTrailingSlashTargets {
+		label := tc.method + " " + tc.target
+		rr := serveAllowlist(s, allowlistRequest(tc.method, tc.target, allowlistTestKey, ""))
+		if rr.Code != http.StatusMovedPermanently && rr.Code != http.StatusTemporaryRedirect {
+			t.Fatalf("%s: status = %d, want gin trailing-slash redirect", label, rr.Code)
+		}
+		if rr.Header().Get("X-CPA-VERSION") != "" {
+			t.Fatalf("%s: management key middleware ran before redirect", label)
+		}
+		loc, err := url.Parse(rr.Header().Get("Location"))
+		if err != nil || loc.Path == "" {
+			t.Fatalf("%s: bad Location %q", label, rr.Header().Get("Location"))
+		}
+		follow := serveAllowlist(s, allowlistRequest(tc.method, loc.RequestURI(), allowlistTestKey, ""))
+		if follow.Code != tc.final {
+			t.Fatalf("%s -> %s: status = %d, want %d", label, loc.RequestURI(), follow.Code, tc.final)
+		}
+	}
+}
