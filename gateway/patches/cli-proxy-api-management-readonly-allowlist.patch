+// The RESP surface authenticates with the management key; it is closed
+// before any command is read, so no RESP attempt reaches the ban counter.
+func TestManagementAllowlist_RESPSurfaceClosedWithoutKeyCheck(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	addr, stop := startRedisMuxListener(t, s)
+	defer stop()
+	for i := 0; i < 6; i++ {
+		for _, args := range [][]string{{"AUTH", "wrong"}, {"PING"}, {"AUTH", allowlistTestKey}, {"LPOP", "usage"}} {
+			conn, err := net.DialTimeout("tcp", addr, 2*time.Second)
+			if err != nil {
+				t.Fatalf("dial: %v", err)
+			}
+			_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+			if err := writeTestRESPCommand(conn, args...); err != nil {
+				t.Fatalf("write: %v", err)
+			}
+			buf := make([]byte, 64)
+			n, err := conn.Read(buf)
+			if n != 0 || err == nil {
+				t.Fatalf("RESP %v: got reply %q (err=%v), want the connection closed without a reply", args, buf[:n], err)
+			}
+			var netErr net.Error
+			if errors.As(err, &netErr) && netErr.Timeout() {
+				t.Fatalf("RESP %v: connection left open (timeout)", args)
+			}
+			_ = conn.Close()
+		}
+	}
+	assertNotBanned(t, s, "RESP attempts")
+}
