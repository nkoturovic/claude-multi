+func allowlistModuleRoot(t *testing.T) string {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("getwd: %v", err)
+	}
+	for {
+		data, errRead := os.ReadFile(filepath.Join(dir, "go.mod"))
+		if errRead == nil {
+			module := ""
+			for _, line := range strings.Split(string(data), "\n") {
+				if rest, ok := strings.CutPrefix(strings.TrimSpace(line), "module "); ok {
+					module = strings.TrimSpace(rest)
+					break
+				}
+			}
+			if module != "github.com/router-for-me/CLIProxyAPI/v7" {
+				t.Fatalf("%s/go.mod declares module %q, want github.com/router-for-me/CLIProxyAPI/v7", dir, module)
+			}
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("go.mod not found above the test directory")
+		}
+		dir = parent
+	}
+}
