+func TestManagementAllowlist_ManagementKeyConsumersAudited(t *testing.T) {
+	root := allowlistModuleRoot(t)
+	found := make(map[string]int)
+	defined := make(map[string][]string)
+	files := 0
+	fset := token.NewFileSet()
+	errWalk := filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, errRel := filepath.Rel(root, p)
+		if errRel != nil {
+			return errRel
+		}
+		rel = filepath.ToSlash(rel)
+		if d.IsDir() {
+			if rel == "." {
+				return nil
+			}
+			name := d.Name()
+			if rel == "vendor" || name == "testdata" || strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_") {
+				return filepath.SkipDir
+			}
+			if _, errStat := os.Stat(filepath.Join(p, "go.mod")); errStat == nil {
+				return filepath.SkipDir // a nested module is not part of this one
+			}
+			return nil
+		}
+		if !d.Type().IsRegular() || !strings.HasSuffix(rel, ".go") || strings.HasSuffix(rel, "_test.go") {
+			return nil
+		}
+		file, errParse := parser.ParseFile(fset, p, nil, parser.SkipObjectResolution)
+		if errParse != nil {
+			return errParse
+		}
+		files++
+		ast.Inspect(file, func(n ast.Node) bool {
+			switch x := n.(type) {
+			case *ast.SelectorExpr:
+				if _, ok := managementKeyConsumerNames[x.Sel.Name]; ok {
+					found[x.Sel.Name+" "+rel]++
+				}
+			case *ast.FuncDecl:
+				if _, ok := managementKeyConsumerNames[x.Name.Name]; ok && x.Recv != nil {
+					defined[x.Name.Name] = append(defined[x.Name.Name], rel)
+				}
+			}
+			return true
+		})
+		return nil
+	})
+	if errWalk != nil {
+		t.Fatalf("walk %s: %v", root, errWalk)
+	}
+	if files < 300 {
+		t.Fatalf("parsed only %d non-test Go files under %s; walk broken?", files, root)
+	}
+	for name := range managementKeyConsumerNames {
+		ok := false
+		for _, rel := range defined[name] {
+			ok = ok || rel == managementKeyHandlerFile
+		}
+		if !ok {
+			t.Fatalf("method %s is no longer declared in %s (declared in %v); re-audit the management key consumers", name, managementKeyHandlerFile, defined[name])
+		}
+	}
+	keys := make(map[string]struct{})
+	for k := range found {
+		keys[k] = struct{}{}
+	}
+	for k := range auditedManagementKeyConsumers {
+		keys[k] = struct{}{}
+	}
+	var diffs []string
+	for k := range keys {
+		if found[k] != auditedManagementKeyConsumers[k] {
+			diffs = append(diffs, fmt.Sprintf("%s: found %d, audited %d", k, found[k], auditedManagementKeyConsumers[k]))
+		}
+	}
+	sort.Strings(diffs)
+	if len(diffs) > 0 {
+		t.Fatalf("management key consumers changed; audit each against the read-only allowlist, then update auditedManagementKeyConsumers:\n  %s", strings.Join(diffs, "\n  "))
+	}
+	t.Logf("parsed %d non-test Go files; management key consumers match the audited set", files)
+}
