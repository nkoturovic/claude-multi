diff --git a/internal/api/server_management_allowlist.go b/internal/api/server_management_allowlist.go
new file mode 100644
index 0000000..9e8348f
--- /dev/null
+++ b/internal/api/server_management_allowlist.go
@@ -0,0 +1,163 @@
+package api
+
+import (
+	"net"
+	"net/http"
+	"path"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// claude-multi local patch (management-readonly-allowlist).
+//
+// The Management API is reduced to an exact read-only allowlist. The guard is
+// an engine-level middleware installed before any route exists, so it runs
+// ahead of every /v0/management handler: the group routes (and their
+// management-key middleware), the engine-level oauth-callback routes, and the
+// NoRoute plugin dispatcher. A management-scoped request is refused with a
+// bare 404 before any key check, so it never reaches the failed-attempt
+// counter, when any of these holds:
+//   - it is not an exact allowlisted request (GET, canonical path);
+//   - it carries browser request metadata (Origin or Sec-Fetch-*), so a
+//     Fetch-Metadata-capable browser page cannot drive the 5-strike ban on
+//     the allowlisted routes;
+//   - its Host is not a loopback literal, so the Host check covers DNS
+//     rebinding.
+//
+// Older browsers without Fetch Metadata remain an accepted residual: their
+// cross-site simple GETs to 127.0.0.1 still reach the key check on the
+// allowlisted routes, and the ban they can drive only blocks quota reads for
+// 30 minutes.
+//
+// The refusal has an empty body and no X-CPA-* headers, like upstream's
+// "management unavailable" 404, but also no Access-Control-* headers: CORS
+// runs after the guard. That is intentional: no cross-origin read or
+// preflight succeeds on a management path.
+//
+// The one pre-routing exception is gin's trailing-slash redirect
+// (RedirectTrailingSlash): a registered path plus "/" is answered with a
+// 301/307 before any middleware runs. It runs no handler, counts nothing and
+// returns no data, but it does show which refused paths are registered.
+
+const managementAllowlistScopePrefix = "/v0/management"
+
+// managementRESPOutputDisabled closes the RESP (Redis protocol) usage/error
+// surface that shares the HTTP port, authenticates with the management key
+// and pops the usage queue. It is outside the read-only allowlist.
+const managementRESPOutputDisabled = true
+
+var managementAllowlistExactGET = map[string]struct{}{
+	"/v0/management/auth-files":        {},
+	"/v0/management/auth-files/models": {},
+}
+
+const managementAllowlistChannelPrefix = "/v0/management/model-definitions/"
+
+var managementBrowserRequestHeaders = []string{
+	"Origin",
+	"Sec-Fetch-Site",
+	"Sec-Fetch-Mode",
+	"Sec-Fetch-Dest",
+}
+
+func managementReadOnlyAllowlistMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		r := c.Request
+		if r == nil || r.URL == nil {
+			c.AbortWithStatus(http.StatusNotFound)
+			return
+		}
+		if !isManagementScopedRequest(r) {
+			c.Next()
+			return
+		}
+		if isBrowserOriginatedRequest(r) || !isLoopbackHostHeader(r.Host) || !isAllowlistedManagementRequest(r) {
+			c.AbortWithStatus(http.StatusNotFound)
+			return
+		}
+		c.Next()
+	}
+}
+
+// isManagementScopedRequest is deliberately broad: any spelling that gin (in
+// any engine configuration: raw or decoded path, extra slashes removed or
+// not) or the NoRoute dispatcher could route to a management handler is in
+// scope. There is no segment boundary on purpose.
+func isManagementScopedRequest(r *http.Request) bool {
+	for _, candidate := range []string{r.URL.Path, r.URL.RawPath} {
+		if candidate == "" {
+			continue
+		}
+		lower := strings.ToLower(candidate)
+		if strings.HasPrefix(lower, managementAllowlistScopePrefix) ||
+			strings.HasPrefix(path.Clean("/"+lower), managementAllowlistScopePrefix) {
+			return true
+		}
+	}
+	return false
+}
+
+// isBrowserOriginatedRequest reports whether the request carries any header a
+// browser attaches to cross-site or fetch-metadata requests. The claude-multi
+// client sends none of them.
+func isBrowserOriginatedRequest(r *http.Request) bool {
+	for _, name := range managementBrowserRequestHeaders {
+		if len(r.Header.Values(name)) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// isLoopbackHostHeader accepts only loopback literals (any port): 127.0.0.1,
+// [::1] and localhost. A DNS-rebinding page carries its own host name.
+func isLoopbackHostHeader(hostport string) bool {
+	host := hostport
+	if h, _, err := net.SplitHostPort(hostport); err == nil {
+		host = h
+	} else if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+		host = host[1 : len(host)-1]
+	}
+	switch strings.ToLower(host) {
+	case "127.0.0.1", "::1", "localhost":
+		return true
+	}
+	return false
+}
+
+// isAllowlistedManagementRequest is deliberately strict: GET only, canonical
+// (no percent-encoding) path, exact match. Allowed paths are fixed points of
+// gin's path cleaning and unescaping, so an allowed request routes to exactly
+// one allowlisted handler.
+func isAllowlistedManagementRequest(r *http.Request) bool {
+	if r.Method != http.MethodGet || r.URL.RawPath != "" {
+		return false
+	}
+	p := r.URL.Path
+	if _, ok := managementAllowlistExactGET[p]; ok {
+		return true
+	}
+	if channel, ok := strings.CutPrefix(p, managementAllowlistChannelPrefix); ok {
+		return isManagementAllowlistChannel(channel)
+	}
+	return false
+}
+
+// isManagementAllowlistChannel matches ^[a-z0-9][a-z0-9._-]{0,63}$, which
+// excludes "", ".", ".." and "/".
+func isManagementAllowlistChannel(channel string) bool {
+	if len(channel) == 0 || len(channel) > 64 {
+		return false
+	}
+	for i := 0; i < len(channel); i++ {
+		ch := channel[i]
+		switch {
+		case ch >= 'a' && ch <= 'z', ch >= '0' && ch <= '9':
+		case i > 0 && (ch == '.' || ch == '-' || ch == '_'):
+		default:
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/api/server_management_allowlist_test.go b/internal/api/server_management_allowlist_test.go
new file mode 100644
index 0000000..b5abecd
--- /dev/null
+++ b/internal/api/server_management_allowlist_test.go
@@ -0,0 +1,734 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io/fs"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	managementHandlers "github.com/router-for-me/CLIProxyAPI/v7/internal/api/handlers/management"
+	proxyconfig "github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/pluginhost"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+// claude-multi local patch (management-readonly-allowlist) gate.
+// Network-free: requests go through server.engine.ServeHTTP (no listener);
+// the RESP check uses a 127.0.0.1:0 listener only; the source tripwire reads
+// the module's own files.
+
+const (
+	allowlistTestKey  = "allowlist-test-management-key"
+	allowlistTestHost = "127.0.0.1:8317"
+)
+
+var allowlistedManagementRoutes = map[string]string{
+	"GET /v0/management/auth-files":                 "/v0/management/auth-files",
+	"GET /v0/management/auth-files/models":          "/v0/management/auth-files/models?name=none",
+	"GET /v0/management/model-definitions/:channel": "/v0/management/model-definitions/claude",
+}
+
+// newAllowlistTestServer builds every gate server production-shaped: the
+// plugin host is wired exactly as sdk/cliproxy/builder.go Build does
+// (pluginhost.New, ApplyConfig, RegisterFrontendAuthProviders, then
+// WithPluginHost). Production always has a plugin host, and without one the
+// NoRoute dispatcher 404s before the management key middleware
+// (pluginManagementNoRoute), so NoRoute probes on newTestServer are vacuous.
+func newAllowlistTestServer(t *testing.T) *Server {
+	t.Helper()
+	t.Setenv("MANAGEMENT_PASSWORD", allowlistTestKey)
+	cfg := &proxyconfig.Config{
+		SDKConfig: sdkconfig.SDKConfig{
+			APIKeys: []string{"test-key"},
+		},
+	}
+	host := pluginhost.New()
+	host.ApplyConfig(context.Background(), cfg)
+	host.RegisterFrontendAuthProviders()
+	s := newTestServerWithConfig(t, cfg, WithPluginHost(host))
+	if s.pluginHost != host || s.mgmt == nil {
+		t.Fatal("gate server is not production-shaped: plugin host or management handler missing")
+	}
+	return s
+}
+
+// allowlistRequest builds a request shaped like the claude-multi client: a
+// loopback peer, a loopback Host literal, no browser headers.
+func allowlistRequest(method, target, key, remoteAddr string) *http.Request {
+	req := httptest.NewRequest(method, target, nil)
+	if remoteAddr == "" {
+		remoteAddr = "127.0.0.1:40000"
+	}
+	req.RemoteAddr = remoteAddr
+	req.Host = allowlistTestHost
+	if key != "" {
+		req.Header.Set("Authorization", "Bearer "+key)
+	}
+	return req
+}
+
+func serveAllowlist(s *Server, req *http.Request) *httptest.ResponseRecorder {
+	rr := httptest.NewRecorder()
+	s.engine.ServeHTTP(rr, req)
+	return rr
+}
+
+// concreteRoutePath substitutes gin parameters with a sample segment.
+func concreteRoutePath(routePath string) string {
+	segments := strings.Split(routePath, "/")
+	for i, seg := range segments {
+		if strings.HasPrefix(seg, ":") || strings.HasPrefix(seg, "*") {
+			segments[i] = "sample"
+		}
+	}
+	return strings.Join(segments, "/")
+}
+
+func managementRoutes(t *testing.T, s *Server) map[string]string {
+	t.Helper()
+	out := make(map[string]string)
+	for _, route := range s.engine.Routes() {
+		if strings.HasPrefix(route.Path, managementAllowlistScopePrefix) {
+			out[route.Method+" "+route.Path] = concreteRoutePath(route.Path)
+		}
+	}
+	return out
+}
+
+// refusalProblem returns "" for the guard's refusal (a bare 404: empty body,
+// no X-CPA-* header from the management key middleware) and a description
+// otherwise.
+func refusalProblem(rr *httptest.ResponseRecorder) string {
+	if rr.Code != http.StatusNotFound {
+		return fmt.Sprintf("status = %d, want 404 body=%q", rr.Code, rr.Body.String())
+	}
+	if rr.Body.Len() != 0 {
+		return fmt.Sprintf("body = %q, want empty (upstream NoRoute shape)", rr.Body.String())
+	}
+	for name := range rr.Header() {
+		if strings.HasPrefix(strings.ToUpper(name), "X-CPA-") {
+			return fmt.Sprintf("header %s present: management key middleware ran on a refused request", name)
+		}
+	}
+	return ""
+}
+
+func assertRefused(t *testing.T, rr *httptest.ResponseRecorder, label string) {
+	t.Helper()
+	if problem := refusalProblem(rr); problem != "" {
+		t.Fatalf("%s: %s", label, problem)
+	}
+}
+
+func assertNotBanned(t *testing.T, s *Server, label string) {
+	t.Helper()
+	rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/v0/management/auth-files", allowlistTestKey, ""))
+	if rr.Code != http.StatusOK {
+		t.Fatalf("valid key after %s: status = %d body=%q, want 200 (not banned)", label, rr.Code, rr.Body.String())
+	}
+}
+
+func TestManagementAllowlist_EveryRegisteredRouteRefusedUnlessAllowlisted(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	routes := managementRoutes(t, s)
+	if len(routes) < 100 {
+		t.Fatalf("only %d management routes registered; enumeration broken?", len(routes))
+	}
+	for key := range allowlistedManagementRoutes {
+		if _, ok := routes[key]; !ok {
+			t.Fatalf("allowlisted route %s is not registered upstream", key)
+		}
+	}
+	for _, key := range []string{
+		"GET /v0/management/config",
+		"GET /v0/management/config.yaml",
+		"GET /v0/management/api-keys",
+		"GET /v0/management/usage-queue",
+		"GET /v0/management/auth-files/download",
+		"GET /v0/management/oauth-callback",
+		"POST /v0/management/oauth-callback",
+	} {
+		if _, ok := routes[key]; !ok {
+			t.Fatalf("refused route %s is not registered upstream; enumeration broken?", key)
+		}
+	}
+	for key, concrete := range routes {
+		method := strings.SplitN(key, " ", 2)[0]
+		if target, ok := allowlistedManagementRoutes[key]; ok {
+			rr := serveAllowlist(s, allowlistRequest(method, target, allowlistTestKey, ""))
+			if rr.Code != http.StatusOK {
+				t.Fatalf("%s: allowlisted status = %d, want 200 body=%q", key, rr.Code, rr.Body.String())
+			}
+			continue
+		}
+		assertRefused(t, serveAllowlist(s, allowlistRequest(method, concrete, allowlistTestKey, "")), key)
+	}
+}
+
+// The management key is consumed outside the /v0/management route group too:
+// s.mgmt.Middleware() also runs from the NoRoute dispatcher, and
+// AuthenticateManagementKey from the RESP protocol (closed; see the RESP
+// test). Probe every engine route with no prefix filter, plus unregistered
+// paths that reach NoRoute, with a bad key in each header the key middleware
+// reads. Only the three allowlisted routes may run it (X-CPA-VERSION), so an
+// upstream route that attaches the key middleware outside the prefix fails
+// here instead of silently counting strikes and serving data.
+func TestManagementAllowlist_KeyMiddlewareRunsOnlyOnAllowlistedRoutes(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	badKeys := []struct{ header, value string }{
+		{"Authorization", "Bearer wrong"},
+		{"X-Management-Key", "wrong"},
+	}
+	probe := func(method, target, header, value string) *httptest.ResponseRecorder {
+		req := allowlistRequest(method, target, "", "")
+		req.Header.Set(header, value)
+		return serveAllowlist(s, req)
+	}
+	probed, outsidePrefix := 0, 0
+	for _, route := range s.engine.Routes() {
+		if route.Path == "/management.html" {
+			continue // control panel; may fetch its asset over the network
+		}
+		key := route.Method + " " + route.Path
+		if _, ok := allowlistedManagementRoutes[key]; ok {
+			continue // positive control below
+		}
+		probed++
+		if !strings.HasPrefix(route.Path, managementAllowlistScopePrefix) {
+			outsidePrefix++
+		}
+		target := concreteRoutePath(route.Path)
+		for _, bad := range badKeys {
+			if rr := probe(route.Method, target, bad.header, bad.value); rr.Header().Get("X-CPA-VERSION") != "" {
+				t.Fatalf("%s (bad key via %s): management key middleware ran outside the allowlist, status = %d", key, bad.header, rr.Code)
+			}
+		}
+	}
+	if probed < 150 || outsidePrefix < 30 {
+		t.Fatalf("probed %d routes (%d outside %s); enumeration broken?", probed, outsidePrefix, managementAllowlistScopePrefix)
+	}
+	t.Logf("probed %d non-allowlisted routes (%d outside %s)", probed, outsidePrefix, managementAllowlistScopePrefix)
+	for _, target := range []string{"/unregistered", "/v0/unregistered", "/v1/unregistered", "/v0/resource/plugins/sample"} {
+		for _, method := range []string{http.MethodGet, http.MethodPost} {
+			for _, bad := range badKeys {
+				if rr := probe(method, target, bad.header, bad.value); rr.Header().Get("X-CPA-VERSION") != "" {
+					t.Fatalf("%s %s (NoRoute, bad key via %s): management key middleware ran, status = %d", method, target, bad.header, rr.Code)
+				}
+			}
+		}
+	}
+	assertNotBanned(t, s, "bad keys on every non-allowlisted route")
+	// Positive control: the sentinel is live, and the allowlisted routes are
+	// exactly where the key is checked. The valid-key request after each
+	// strike resets the counter.
+	for key, target := range allowlistedManagementRoutes {
+		for _, bad := range badKeys {
+			rr := probe(http.MethodGet, target, bad.header, bad.value)
+			if rr.Code != http.StatusUnauthorized || rr.Header().Get("X-CPA-VERSION") == "" {
+				t.Fatalf("%s (bad key via %s): status = %d X-CPA-VERSION = %q, want 401 from the key middleware", key, bad.header, rr.Code, rr.Header().Get("X-CPA-VERSION"))
+			}
+			assertNotBanned(t, s, key+" positive control")
+		}
+	}
+}
+
+// ginRoutePatternMatches reports whether a registered gin path pattern
+// (":param" matches one non-empty segment, "*catch" the rest) matches path.
+func ginRoutePatternMatches(pattern, path string) bool {
+	ps, xs := strings.Split(pattern, "/"), strings.Split(path, "/")
+	for i, seg := range ps {
+		if strings.HasPrefix(seg, "*") {
+			return len(xs) >= i
+		}
+		if i >= len(xs) {
+			return false
+		}
+		if strings.HasPrefix(seg, ":") {
+			if xs[i] == "" {
+				return false
+			}
+			continue
+		}
+		if seg != xs[i] {
+			return false
+		}
+	}
+	return len(ps) == len(xs)
+}
+
+// On a production-shaped server the NoRoute dispatcher runs the management key
+// middleware for every unregistered /v0/management path (plugin routes and
+// plugin *-auth-url logins; pluginManagementNoRoute). Four real strikes land
+// first, so a single strike leaking past the guard would ban loopback.
+func TestManagementAllowlist_UnregisteredManagementPathsNeverReachKeyMiddleware(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	targets := []string{
+		"/v0/management/no-such-route",
+		"/v0/management/plugins/x/y",
+		"/v0/management/foo-auth-url",
+	}
+	methods := []string{http.MethodGet, http.MethodPost}
+	keys := []struct{ label, header, value string }{
+		{"bad key via Authorization", "Authorization", "Bearer wrong"},
+		{"bad key via X-Management-Key", "X-Management-Key", "wrong"},
+		{"no key", "", ""},
+	}
+	probe := func(method, target, header, value string) *http.Request {
+		req := allowlistRequest(method, target, "", "")
+		if header != "" {
+			req.Header.Set(header, value)
+		}
+		return req
+	}
+	for _, target := range targets {
+		for _, route := range s.engine.Routes() {
+			if ginRoutePatternMatches(route.Path, target) {
+				t.Fatalf("%s matches registered route %s %s; the probe must reach NoRoute", target, route.Method, route.Path)
+			}
+		}
+	}
+	// Positive control: on this server shape the dispatcher itself runs the
+	// key middleware for these paths (a bare engine with only the dispatcher,
+	// no guard). The valid key on the guarded engine then resets the counter.
+	bare := gin.New()
+	bare.NoRoute(s.pluginManagementNoRoute)
+	for _, target := range targets {
+		for _, method := range methods {
+			for _, key := range keys {
+				rr := httptest.NewRecorder()
+				bare.ServeHTTP(rr, probe(method, target, key.header, key.value))
+				if rr.Code != http.StatusUnauthorized || rr.Header().Get("X-CPA-VERSION") == "" {
+					t.Fatalf("positive control %s %s (%s, no guard): status = %d X-CPA-VERSION = %q, want 401 from the key middleware; the NoRoute dispatcher changed, re-audit this gate", method, target, key.label, rr.Code, rr.Header().Get("X-CPA-VERSION"))
+				}
+				assertNotBanned(t, s, "positive control "+method+" "+target)
+			}
+		}
+	}
+	for i := 0; i < 4; i++ {
+		rr := serveAllowlist(s, allowlistRequest(http.MethodGet, "/v0/management/auth-files", "wrong", ""))
+		if rr.Code != http.StatusUnauthorized || rr.Header().Get("X-CPA-VERSION") == "" {
+			t.Fatalf("strike %d on the allowlisted route: status = %d, want 401 from the key middleware", i+1, rr.Code)
+		}
+	}
+	total, leaked := 0, 0
+	for n := 0; n < 5; n++ {
+		for _, target := range targets {
+			for _, method := range methods {
+				for _, key := range keys {
+					total++
+					if problem := refusalProblem(serveAllowlist(s, probe(method, target, key.header, key.value))); problem != "" {
+						leaked++
+						if leaked <= 6 {
+							t.Errorf("%s %s (%s): %s", method, target, key.label, problem)
+						}
+					}
+				}
+			}
+		}
+	}
+	if leaked > 0 {
+		t.Errorf("%d of %d unregistered-path probes were not a bare 404", leaked, total)
+	}
