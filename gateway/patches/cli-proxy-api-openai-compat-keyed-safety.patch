 	switch accountType {
 	case "api_key":
+		if isOpenAICompatAuthForLog(auth) {
+			return "api_key=" + openAICompatAuthLogIdentity(auth)
+		}
 		return fmt.Sprintf("api_key=%s", util.HideAPIKey(accountInfo))
 	case "oauth":
