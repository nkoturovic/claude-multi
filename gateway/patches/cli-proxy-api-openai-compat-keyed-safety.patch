+func TestCM053KeyedCompatHeadersSafe(t *testing.T) {
+	for _, key := range cm053KeyedKeys {
+		malicious := func(contentType string) http.Header {
+			return http.Header{
+				"Content-Type":              {contentType},
+				"X-" + key + "-Echo":        {key},
+				"X-Echo":                    {key + " " + cm053KeyedCanary},
+				"Set-Cookie":                {"session=" + key},
+				"Location":                  {"https://evil.cm053.invalid/" + key},
+				"Retry-After":               {"7"},
+				"Anthropic-Ratelimit-Probe": {key},
+			}
+		}
+		cases := []struct {
+			name   string
+			status int
+			ct     string
+			body   string
+			stream bool
+			wantCT string
+		}{
+			{"success", http.StatusOK, "application/json; charset=utf-8; x=" + key, `{"id":"c1","object":"chat.completion","created":1,"model":"cm053-model","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`, false, "application/json"},
+			{"success-odd-content-type", http.StatusOK, "application/x-" + key, `{"id":"c1","object":"chat.completion","created":1,"model":"cm053-model","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`, false, ""},
+			{"stream", http.StatusOK, "text/event-stream", `data: {"id":"c1","object":"chat.completion.chunk","created":1,"model":"cm053-model","choices":[{"index":0,"delta":{"content":"ok"},"finish_reason":null}]}` + "\n\ndata: [DONE]\n\n", true, "text/event-stream"},
+			{"failure", http.StatusInternalServerError, "application/json", `{"error":{"message":"` + cm053KeyedCanary + `"}}`, false, "application/json"},
+			{"stream-failure", http.StatusServiceUnavailable, "application/json", `{"error":{"message":"` + cm053KeyedCanary + `"}}`, true, "application/json"},
+		}
+		for _, tc := range cases {
+			t.Run(fmt.Sprintf("key%d/%s", len(key), tc.name), func(t *testing.T) {
+				upstream := cm053KeyedUpstream(func(req *http.Request) (*http.Response, error) {
+					resp := cm053KeyedResponse(req, tc.status, malicious(tc.ct), io.NopCloser(strings.NewReader(tc.body)))
+					resp.Trailer = http.Header{"X-Trailer": {key + " " + cm053KeyedCanary}}
+					return resp, nil
+				})
+				s := cm053NewSinks(t, upstream, false)
+				var headers http.Header
+				var client string
+				if tc.stream {
+					outcome := cm053RunStream(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+					headers, client = outcome.headers, outcome.client()
+				} else {
+					resp, err := cm053RunExecute(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+					headers, client = resp.Headers, fmt.Sprintf("%v|%s|%v", err, resp.Payload, resp.Headers)
+				}
+				if tc.status == http.StatusOK {
+					want := http.Header{}
+					if tc.wantCT != "" {
+						want.Set("Content-Type", tc.wantCT)
+					}
+					if fmt.Sprint(headers) != fmt.Sprint(want) {
+						t.Fatalf("returned headers = %v, want %v", headers, want)
+					}
+				}
+				recorded := logging.GetResponseHeaders(s.ctx)
+				for name := range recorded {
+					if name != "Content-Type" {
+						t.Fatalf("recorded response metadata keeps %q: %v", name, recorded)
+					}
+				}
+				if got := recorded.Get("Content-Type"); got != tc.wantCT {
+					t.Fatalf("recorded Content-Type = %q, want %q", got, tc.wantCT)
+				}
+				s.assertAbsent(t, client, append(cm053Needles(key), "evil.cm053.invalid", "Set-Cookie", "Location", "Anthropic-Ratelimit")...)
+			})
+		}
+	}
+}
