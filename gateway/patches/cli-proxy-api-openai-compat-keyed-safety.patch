+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/compatsafe"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/util"
+	log "github.com/sirupsen/logrus"
+)
+
+// The keyed OpenAI-compatible chat route replaces a provider
+// failure with a fixed compatsafe representation. These gates prove that the
+// conductor reaches the same semantic verdict on the fixed representation as
+// on the raw provider failure for every category the route supports, name
+// the one documented divergence, and prove that conductor logs never show a
+// compat credential (not even prefix/suffix-masked).
+
+// cm053RawCompatErr is the shape of the upstream compat executor error: the
+// raw body as the message and the HTTP status.
+type cm053RawCompatErr struct {
+	status int
+	body   string
+}
+
+func (e cm053RawCompatErr) Error() string   { return e.body }
+func (e cm053RawCompatErr) StatusCode() int { return e.status }
+
+type cm053Verdict struct {
+	status           int
+	requestInvalid   bool
+	modelSupport     bool
+	modelNotFound    bool
+	cloudflare       bool
+	invalidGrant     bool
+	lifecycle        bool
+	transient        bool
+	credentialScoped bool
+	resultCode       string
+}
+
+func cm053VerdictOf(err error) cm053Verdict {
+	result := resultErrorFromError(err)
+	return cm053Verdict{
+		status:           statusCodeFromError(err),
+		requestInvalid:   isRequestInvalidError(err),
+		modelSupport:     isModelSupportError(err),
+		modelNotFound:    isExplicitModelNotFoundError(err, ""),
+		cloudflare:       isCloudflareChallengeError(err),
+		invalidGrant:     isInvalidGrantError(err),
+		lifecycle:        isConnectionLifecycleError(err),
+		transient:        isTransientTransportError(err),
+		credentialScoped: isCredentialScopedError(err),
+		resultCode:       result.Code,
+	}
+}
+
+func TestCM053KeyedCompatConductorClassificationPreserved(t *testing.T) {
+	cases := []struct {
+		status int
+		body   string
+	}{
+		{400, `{"error":{"type":"invalid_request_error","message":"bad"}}`},
+		{400, `{"error":{"code":"context_length_exceeded","message":"too long"}}`},
+		{400, `{"error":{"code":"unsupported_value","message":"x"}}`},
+		{400, `plain bad request`},
+		{400, `{"error":{"message":"The requested model is not supported"}}`},
+		{422, `model unavailable`},
+		{404, `{"error":{"code":"model_not_found","message":"x"}}`},
+		{404, `{"error":{"type":"not_found_error","message":"The model foo does not exist"}}`},
+		{404, `{"detail":"Unknown model: foo"}`},
+		{404, `{"detail":"Unknown model"}`},
+		{404, `{"error":{"message":"The model does not exist."}}`},
+		{404, `{"errors":[{"code":"models/model-not-found"}]}`},
+		{404, `{"error":{"message":"model_not_found in request body"}}`},
+		{404, `not here`},
+		{401, `{"error":{"type":"authentication_error","code":"invalid_request_error"}}`},
+		{401, `{"error":{"type":"invalid_request_error"}}`},
+		{401, `unauthorized`},
+		{402, `{"error":{"type":"invalid_request_error","message":"pay"}}`},
+		{403, `<html><title>Just a moment...</title>cloudflare</html>`},
+		{403, `forbidden`},
+		{409, `conflict`},
+		{413, `too large`},
+		{429, `{"error":{"type":"invalid_request_error","message":"slow down"}}`},
+		{500, `<html>cloudflare challenge-platform</html>`},
+		{500, `{"error":{"message":"boom"}}`},
+		{502, `bad gateway`},
+		{503, `{"error":{"code":"overloaded"}}`},
+	}
+	for _, tc := range cases {
+		t.Run(fmt.Sprintf("%d/%s", tc.status, tc.body), func(t *testing.T) {
+			raw := cm053RawCompatErr{status: tc.status, body: tc.body}
+			safe := compatsafe.HTTPFailure(tc.status, []byte(tc.body), false, true, nil)
+			if got, want := cm053VerdictOf(safe), cm053VerdictOf(raw); got != want {
+				t.Fatalf("fixed %s verdict %+v, raw provider verdict %+v", safe.Kind, got, want)
+			}
+		})
+	}
+
+	// Documented divergence: free-text categories the route does not
+	// support. invalid_grant is an OAuth refresh failure; an API-key compat
+	// provider never produces it, and the fixed representation cannot carry
+	// arbitrary provider text.
+	raw := cm053RawCompatErr{status: 400, body: `{"error":"invalid_grant"}`}
+	safe := compatsafe.HTTPFailure(400, []byte(raw.body), false, true, nil)
+	if !isInvalidGrantError(raw) || isInvalidGrantError(safe) {
+		t.Fatalf("invalid_grant divergence changed: raw=%t safe=%t", isInvalidGrantError(raw), isInvalidGrantError(safe))
+	}
+
+	transport := []error{
+		fmt.Errorf("secret: %w", context.Canceled),
+		fmt.Errorf("secret: %w", context.DeadlineExceeded),
+		fmt.Errorf("secret: %w", io.EOF),
+		fmt.Errorf("secret: %w", io.ErrUnexpectedEOF),
+		&net.OpError{Op: "dial", Net: "tcp", Err: errors.New("secret")},
+		fmt.Errorf("secret: %w", syscall.ECONNREFUSED),
+		errors.New("secret: tls handshake timeout"),
+		errors.New("secret: no such host"),
+		errors.New("secret: x509 certificate signed by unknown authority"),
+	}
+	for _, rawErr := range transport {
+		safeErr := compatsafe.Transport(rawErr, nil)
+		if got, want := cm053VerdictOf(safeErr), cm053VerdictOf(rawErr); got != want {
+			t.Fatalf("transport %q: fixed %q verdict %+v, raw verdict %+v", rawErr, safeErr, got, want)
+		}
+	}
+
+	retry := 7 * time.Second
+	rateLimited := compatsafe.HTTPFailure(http.StatusTooManyRequests, nil, false, true, &retry)
+	if got := retryAfterFromError(rateLimited); got == nil || *got != retry {
+		t.Fatalf("retryAfterFromError = %v, want %s", got, retry)
+	}
+}
