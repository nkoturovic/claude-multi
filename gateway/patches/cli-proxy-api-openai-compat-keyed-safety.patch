+					upstream := cm053KeyedUpstream(func(req *http.Request) (*http.Response, error) {
+						switch name {
+						case "http-error":
+							return cm053KeyedResponse(req, 401, http.Header{"Content-Type": {"application/json"}, "X-Key": {key}}, io.NopCloser(strings.NewReader(`{"error":{"type":"authentication_error","message":"key `+key+` `+cm053KeyedCanary+`"}}`))), nil
+						case "sse-error":
+							return cm053KeyedResponse(req, 200, http.Header{"Content-Type": {"text/event-stream"}}, io.NopCloser(strings.NewReader(partial+`data: {"error":{"message":"`+key+` `+cm053KeyedCanary+`"}}`+"\n\n"))), nil
+						}
+						return nil, cm053OpError(key)
+					})
+					s := cm053NewSinks(t, upstream, production)
+					auth := cm053KeyedAuth(key)
+					auth.Attributes["header:X-Custom-Credential"] = key
+					client := run(t, s, auth)
+					s.assertAbsent(t, client, cm053Needles(key)...)
+					requestLog, _ := s.gin.Get("API_REQUEST")
+					requestText, _ := requestLog.([]byte)
+					if production {
+						if len(requestText) != 0 {
+							t.Fatalf("production configuration captured the request: %s", requestText)
+						}
+						return
+					}
+					for _, want := range []string{"type=api_key", "X-Custom-Credential", "[redacted]"} {
+						if !strings.Contains(string(requestText), want) {
+							t.Fatalf("request log lacks %q: %s", want, requestText)
+						}
+					}
+					for _, unwanted := range []string{"value=", "auth_id=", "Bearer " + key} {
+						if strings.Contains(string(requestText), unwanted) {
+							t.Fatalf("request log contains %q: %s", unwanted, requestText)
+						}
+					}
+				})
+			}
+		}
+	}
+}
