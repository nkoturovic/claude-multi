+func TestCM053CompatSafeTransport(t *testing.T) {
+	const secret = "secret-transport-text"
+	refused := errors.New("fixed refusal sentinel")
+	cases := []struct {
+		name string
+		in   error
+		want error
+		text string
+	}{
+		{"nil", nil, nil, ""},
+		{"canceled", fmt.Errorf("%s: %w", secret, context.Canceled), context.Canceled, "context canceled"},
+		{"deadline", fmt.Errorf("%s: %w", secret, context.DeadlineExceeded), context.DeadlineExceeded, "context deadline exceeded"},
+		{"eof", fmt.Errorf("%s: %w", secret, io.EOF), io.EOF, "EOF"},
+		{"unexpected-eof", fmt.Errorf("%s: %w", secret, io.ErrUnexpectedEOF), io.ErrUnexpectedEOF, "unexpected EOF"},
+		{"unexpected-eof-text", errors.New(secret + " unexpected EOF"), io.ErrUnexpectedEOF, "unexpected EOF"},
+		{"op-error", &net.OpError{Op: "dial", Net: "tcp", Err: errors.New(secret)}, nil, "upstream transport failed: connection refused, reset or unreachable"},
+		{"errno", fmt.Errorf("%s: %w", secret, syscall.ECONNRESET), nil, "upstream transport failed: connection refused, reset or unreachable"},
+		{"timeout", fmt.Errorf("%s: %w", secret, cm053TimeoutErr{}), nil, "upstream transport failed: i/o timeout"},
+		{"dns", &net.DNSError{Err: secret, Name: secret}, nil, "upstream transport failed: connection refused, reset or unreachable"},
+		{"phrase", errors.New(secret + ": connection reset by peer"), nil, "upstream transport failed: connection refused, reset or unreachable"},
+		{"other", errors.New(secret), nil, "upstream transport failed"},
+		{"kept", fmt.Errorf("%s: %w", secret, refused), refused, "fixed refusal sentinel"},
+	}
+	keep := func(err error) bool { return errors.Is(err, refused) && !errors.Is(err, context.Canceled) }
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Transport(tc.in, keep)
+			if tc.in == nil {
+				if got != nil {
+					t.Fatalf("Transport(nil) = %v", got)
+				}
+				return
+			}
+			if tc.name == "kept" {
+				if !errors.Is(got, refused) {
+					t.Fatalf("kept error lost: %v", got)
+				}
+				return
+			}
+			if tc.want != nil && got != tc.want {
+				t.Fatalf("Transport = %T %v, want the sentinel %v itself", got, got, tc.want)
+			}
+			if got.Error() != tc.text || strings.Contains(fmt.Sprintf("%+v %#v", got, got), secret) {
+				t.Fatalf("Transport = %q (%#v), want %q without the source text", got.Error(), got, tc.text)
+			}
+			if errors.Unwrap(got) != nil {
+				t.Fatalf("Transport result wraps %v", errors.Unwrap(got))
+			}
+		})
+	}
+}
