+func TestCM053KeyedCompatIOErrorsSafe(t *testing.T) {
+	for _, key := range cm053KeyedKeys {
+		prefix := fmt.Sprintf("key%d/", len(key))
+		transport := []struct {
+			name  string
+			err   error
+			check func(t *testing.T, err error)
+		}{
+			{"op-error", cm053OpError(key), func(t *testing.T, err error) {
+				var te compatsafe.TransportError
+				if !errors.As(err, &te) || err.Error() != "upstream transport failed: connection refused, reset or unreachable" {
+					t.Fatalf("err = %T %v, want the fixed transient transport error", err, err)
+				}
+				if clienterror.HTTPStatusFromError(err) != 0 {
+					t.Fatalf("transport error gained a status: %v", err)
+				}
+			}},
+			{"text-error", errors.New("proxy said " + key + " " + cm053KeyedCanary), func(t *testing.T, err error) {
+				if err.Error() != "upstream transport failed" {
+					t.Fatalf("err = %v, want the fixed transport error", err)
+				}
+			}},
+			{"canceled", fmt.Errorf("%s %s: %w", key, cm053KeyedCanary, context.Canceled), func(t *testing.T, err error) {
+				if err != context.Canceled {
+					t.Fatalf("err = %T %v, want context.Canceled itself", err, err)
+				}
+			}},
+			{"deadline", fmt.Errorf("%s %s: %w", key, cm053KeyedCanary, context.DeadlineExceeded), func(t *testing.T, err error) {
+				if err != context.DeadlineExceeded {
+					t.Fatalf("err = %T %v, want context.DeadlineExceeded itself", err, err)
+				}
+			}},
+			{"unexpected-eof", fmt.Errorf("%s %s: %w", key, cm053KeyedCanary, io.ErrUnexpectedEOF), func(t *testing.T, err error) {
+				if err != io.ErrUnexpectedEOF {
+					t.Fatalf("err = %T %v, want io.ErrUnexpectedEOF itself", err, err)
+				}
+			}},
+		}
+		for _, tc := range transport {
+			for _, stream := range []bool{false, true} {
+				t.Run(prefix+"do/"+tc.name+fmt.Sprintf("/stream=%t", stream), func(t *testing.T) {
+					upstream := cm053KeyedUpstream(func(*http.Request) (*http.Response, error) { return nil, tc.err })
+					s := cm053NewSinks(t, upstream, false)
+					var err error
+					var client string
+					if stream {
+						outcome := cm053RunStream(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+						err, client = outcome.bootErr, outcome.client()
+					} else {
+						_, err = cm053RunExecute(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+						client = fmt.Sprintf("%v|%+v", err, err)
+					}
+					tc.check(t, err)
+					s.assertAbsent(t, client, cm053Needles(key)...)
+				})
+			}
+		}
+
+		t.Run(prefix+"query-credential-transport-error", func(t *testing.T) {
+			auth := cm053KeylessAuth()
+			auth.Attributes["base_url"] = cm053KeyedBaseURL + "?key=" + url.QueryEscape(key) + cm053KeyedCanary
+			upstream := cm053KeyedUpstream(func(*http.Request) (*http.Response, error) { return nil, errors.New("refused") })
+			s := cm053NewSinks(t, upstream, false)
+			_, err := cm053RunExecute(t, s, auth, sdktranslator.FormatOpenAI, "")
+			if err == nil || err.Error() != "upstream transport failed" {
+				t.Fatalf("err = %v, want the fixed transport error (a URL credential makes the request keyed)", err)
+			}
+			s.assertAbsent(t, fmt.Sprintf("%v|%+v", err, err), cm053Needles(key)...)
+		})
+
+		bodyFaults := []struct {
+			name     string
+			data     string
+			readErr  error
+			closeErr error
+			want     func(t *testing.T, err error)
+		}{
+			{"read-error", "", errors.New("read " + key + " " + cm053KeyedCanary), nil, func(t *testing.T, err error) {
+				if _, ok := err.(compatsafe.TransportError); !ok {
+					t.Fatalf("err = %T %v, want compatsafe.TransportError", err, err)
+				}
+			}},
+			{"read-unexpected-eof", "", fmt.Errorf("%s: %w", key, io.ErrUnexpectedEOF), nil, func(t *testing.T, err error) {
+				if err != io.ErrUnexpectedEOF {
+					t.Fatalf("err = %T %v, want io.ErrUnexpectedEOF itself", err, err)
+				}
+			}},
+			{"close-error", "", nil, errors.New("close " + key + " " + cm053KeyedCanary), nil},
+		}
+		for _, tc := range bodyFaults {
+			t.Run(prefix+"body/"+tc.name+"/execute", func(t *testing.T) {
+				data := tc.data
+				if tc.want == nil {
+					data = `{"id":"c1","object":"chat.completion","created":1,"model":"cm053-model","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`
+				}
+				upstream := cm053KeyedUpstream(func(req *http.Request) (*http.Response, error) {
+					return cm053KeyedResponse(req, http.StatusOK, http.Header{"Content-Type": {"application/json"}}, &cm053FaultBody{data: strings.NewReader(data), readErr: tc.readErr, closeErr: tc.closeErr}), nil
+				})
+				s := cm053NewSinks(t, upstream, false)
+				resp, err := cm053RunExecute(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+				if tc.want != nil {
+					tc.want(t, err)
+				} else if err != nil {
+					t.Fatalf("close error failed the request: %v", err)
+				} else if !strings.Contains(s.logs.String(), "close response body error: upstream transport failed") {
+					t.Fatalf("close error not logged in its safe form: %s", s.logs.String())
+				}
+				s.assertAbsent(t, fmt.Sprintf("%v|%+v|%s", err, err, resp.Payload), cm053Needles(key)...)
+			})
+			t.Run(prefix+"body/"+tc.name+"/stream", func(t *testing.T) {
+				partial := `data: {"id":"c1","object":"chat.completion.chunk","created":1,"model":"cm053-model","choices":[{"index":0,"delta":{"content":"partial"},"finish_reason":null}]}` + "\n\n"
+				upstream := cm053KeyedUpstream(func(req *http.Request) (*http.Response, error) {
+					data := partial
+					if tc.want == nil {
+						data += "data: [DONE]\n\n"
+					}
+					return cm053KeyedResponse(req, http.StatusOK, http.Header{"Content-Type": {"text/event-stream"}}, &cm053FaultBody{data: strings.NewReader(data), readErr: tc.readErr, closeErr: tc.closeErr}), nil
+				})
+				s := cm053NewSinks(t, upstream, false)
+				outcome := cm053RunStream(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+				if outcome.bootErr != nil {
+					t.Fatalf("bootstrap error: %v", outcome.bootErr)
+				}
+				if tc.want != nil {
+					tc.want(t, outcome.streamErr)
+				} else if outcome.streamErr != nil {
+					t.Fatalf("close error failed the stream: %v", outcome.streamErr)
+				}
+				if !strings.Contains(outcome.payload, "partial") {
+					t.Fatalf("frame before the fault not delivered: %q", outcome.payload)
+				}
+				s.assertAbsent(t, outcome.client(), cm053Needles(key)...)
+				if tc.want == nil && !strings.Contains(s.logs.String(), "close response body error: upstream transport failed") {
+					t.Fatalf("close error not logged in its safe form: %s", s.logs.String())
+				}
+			})
+		}
+	}
+}
