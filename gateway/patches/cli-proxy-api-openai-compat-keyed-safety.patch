+	}
+	lower := func(t *testing.T, line, frameBytes int) {
+		t.Helper()
+		previous := openAICompatKeyedStreamLimits
+		openAICompatKeyedStreamLimits.line = line
+		openAICompatKeyedStreamLimits.frameBytes = frameBytes
+		t.Cleanup(func() { openAICompatKeyedStreamLimits = previous })
+	}
+	valid := `data: {"id":"c1","object":"chat.completion.chunk","created":1,"model":"cm053-model","choices":[{"index":0,"delta":{"content":"%s"},"finish_reason":null}]}` + "\n\n"
+
+	t.Run("line-ceiling-default", func(t *testing.T) {
+		body := strings.Repeat("data: 1\n", compatsafe.MaxStreamFrameLines+1) + fmt.Sprintf("data: %s %s\n\n", key, cm053KeyedCanary)
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
+	t.Run("aggregate-bytes", func(t *testing.T) {
+		lower(t, 4096, 1024)
+		line := "data: " + strings.Repeat("a", 600) + "\n"
+		body := line + line + fmt.Sprintf("data: %s %s\n\n", key, cm053KeyedCanary)
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
+	t.Run("aggregate-bytes-at-bound-passes", func(t *testing.T) {
+		lower(t, 4096, 1024)
+		outcome := run(t, fmt.Sprintf(valid, strings.Repeat("b", 800))+"data: [DONE]\n\n")
+		if outcome.streamErr != nil || !strings.Contains(outcome.payload, "bbbb") {
+			t.Fatalf("frame within the bound failed: err=%v payload=%q", outcome.streamErr, outcome.payload)
+		}
+	})
+	t.Run("per-line-ceiling", func(t *testing.T) {
+		lower(t, 1024, 4096)
+		body := "data: " + strings.Repeat("c", 2000) + key + cm053KeyedCanary + "\n\n"
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
+	// Every field line of a frame counts toward both frame bounds, not only
+	// its data lines: comment-only and mixed-field frames overflow too.
+	chunk := fmt.Sprintf(valid, "ok")
+	t.Run("line-ceiling-comment-lines", func(t *testing.T) {
+		body := strings.Repeat(": keepalive\n", compatsafe.MaxStreamFrameLines) + chunk
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
+	t.Run("line-ceiling-mixed-fields", func(t *testing.T) {
+		body := strings.Repeat("id: 1\nretry: 5\nevent: message\ndata: 1\n", compatsafe.MaxStreamFrameLines/4) + chunk
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
+	t.Run("line-ceiling-comment-lines-reset-per-frame", func(t *testing.T) {
+		frame := strings.Repeat(": keepalive\n", compatsafe.MaxStreamFrameLines/2) + "\n"
+		outcome := run(t, frame+frame+frame+chunk+"data: [DONE]\n\n")
+		if outcome.streamErr != nil || !strings.Contains(outcome.payload, `"ok"`) {
+			t.Fatalf("frames within the line bound failed: err=%v payload=%q", outcome.streamErr, outcome.payload)
+		}
+	})
+	t.Run("aggregate-bytes-event-name", func(t *testing.T) {
+		lower(t, 4096, 1024)
+		body := "event: " + strings.Repeat("e", 600) + "\n" + "data: " + strings.Repeat("a", 600) + "\n\n"
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
+	t.Run("aggregate-bytes-comment-only", func(t *testing.T) {
+		lower(t, 4096, 1024)
+		body := ": " + strings.Repeat("c", 600) + "\nid: " + strings.Repeat("i", 600) + "\n" + chunk
+		if got := cm053AsSafe(t, run(t, body).streamErr).Kind; got != compatsafe.KindStreamFrameTooLarge {
+			t.Fatalf("kind = %s, want %s", got, compatsafe.KindStreamFrameTooLarge)
+		}
+	})
