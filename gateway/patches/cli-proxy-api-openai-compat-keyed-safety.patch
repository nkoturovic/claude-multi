+type cm053CountingReader struct {
+	read int
+	err  error
+}
+
+func (r *cm053CountingReader) Read(p []byte) (int, error) {
+	if r.err != nil {
+		return 0, r.err
+	}
+	for i := range p {
+		p[i] = 'k'
+	}
+	r.read += len(p)
+	return len(p), nil
+}
