+func TestCM053CompatSafeReadErrorBodyBound(t *testing.T) {
+	infinite := &cm053CountingReader{}
+	body, overflow, readable := ReadErrorBody(infinite)
+	if !overflow || !readable || len(body) != MaxErrorBody || infinite.read > MaxErrorBody+1+32<<10 {
+		t.Fatalf("infinite body: len=%d overflow=%t readable=%t read=%d", len(body), overflow, readable, infinite.read)
+	}
+	body, overflow, readable = ReadErrorBody(strings.NewReader(strings.Repeat("a", MaxErrorBody)))
+	if overflow || !readable || len(body) != MaxErrorBody {
+		t.Fatalf("exact body: len=%d overflow=%t readable=%t", len(body), overflow, readable)
+	}
+	body, overflow, readable = ReadErrorBody(strings.NewReader(strings.Repeat("a", MaxErrorBody+1)))
+	if !overflow || !readable || len(body) != MaxErrorBody {
+		t.Fatalf("64 KiB + 1: len=%d overflow=%t readable=%t", len(body), overflow, readable)
+	}
+	_, overflow, readable = ReadErrorBody(&cm053CountingReader{err: errors.New("secret read failure")})
+	if overflow || readable {
+		t.Fatalf("unreadable body: overflow=%t readable=%t", overflow, readable)
+	}
+	if got := HTTPFailure(500, nil, false, false, nil); got.Kind != KindErrorBodyUnreadable {
+		t.Fatalf("unreadable kind = %s", got.Kind)
+	}
+	if got := HTTPFailure(429, nil, true, true, nil); got.Kind != KindRateLimited {
+		t.Fatalf("429 overflow kind = %s, want the authoritative rate-limit kind", got.Kind)
+	}
+	if got := HTTPFailure(500, []byte(`{"error":{"code":"context_length_exceeded"}}`), true, true, nil); got.Kind != KindErrorBodyTooLarge {
+		t.Fatalf("overflow kind = %s, want %s (an overflowing body is not classified)", got.Kind, KindErrorBodyTooLarge)
+	}
+}
