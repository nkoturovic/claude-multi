+func TestCM053KeyedCompatAuditScope(t *testing.T) {
+	key := cm053KeyedKeys[len(cm053KeyedKeys)-1]
+	errorBody := `{"error":{"message":"` + key + " " + cm053KeyedCanary + `"}}`
+	// Inside the promise: keyed chat whatever the source format, the stream
+	// under a responses/compact Alt, and credentials from a configured header
+	// or the URL instead of api_key.
+	inside := []struct {
+		name string
+		auth func() *cliproxyauth.Auth
+		run  func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error
+	}{}
+	for _, format := range []sdktranslator.Format{sdktranslator.FormatOpenAI, sdktranslator.FormatClaude, sdktranslator.FormatOpenAIResponse} {
+		format := format
+		inside = append(inside, struct {
+			name string
+			auth func() *cliproxyauth.Auth
+			run  func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error
+		}{"execute/" + format.String(), func() *cliproxyauth.Auth { return cm053KeyedAuth(key) }, func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error {
+			_, err := cm053RunExecute(t, s, auth, format, "")
+			return err
+		}}, struct {
+			name string
+			auth func() *cliproxyauth.Auth
+			run  func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error
+		}{"stream/" + format.String(), func() *cliproxyauth.Auth { return cm053KeyedAuth(key) }, func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error {
+			return cm053RunStream(t, s, auth, format, "").bootErr
+		}})
+	}
+	inside = append(inside,
+		struct {
+			name string
+			auth func() *cliproxyauth.Auth
+			run  func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error
+		}{"stream-under-compact-alt", func() *cliproxyauth.Auth { return cm053KeyedAuth(key) }, func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error {
+			return cm053RunStream(t, s, auth, sdktranslator.FormatOpenAIResponse, "responses/compact").bootErr
+		}},
+		struct {
+			name string
+			auth func() *cliproxyauth.Auth
+			run  func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error
+		}{"custom-header-credential", func() *cliproxyauth.Auth {
+			auth := cm053KeylessAuth()
+			auth.Attributes["header:X-Api-Token"] = key
+			return auth
+		}, func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error {
+			_, err := cm053RunExecute(t, s, auth, sdktranslator.FormatOpenAI, "")
+			return err
+		}},
+		struct {
+			name string
+			auth func() *cliproxyauth.Auth
+			run  func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error
+		}{"url-credential", func() *cliproxyauth.Auth {
+			auth := cm053KeylessAuth()
+			auth.Attributes["base_url"] = cm053KeyedBaseURL + "?api-key=" + key
+			return auth
+		}, func(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth) error {
+			_, err := cm053RunExecute(t, s, auth, sdktranslator.FormatOpenAI, "")
+			return err
+		}},
+	)
+	for _, tc := range inside {
+		t.Run("inside/"+tc.name, func(t *testing.T) {
+			s := cm053NewSinks(t, cm053KeyedStatic(400, http.Header{"Content-Type": {"application/json"}}, errorBody), false)
+			err := tc.run(t, s, tc.auth())
+			cm053AsSafe(t, err)
+			s.assertAbsent(t, fmt.Sprintf("%v", err), key, cm053KeyedCanary)
+		})
+	}
+
+	// Outside the route-scoped promise (upstream behaviour, documented as
+	// such): images, the genuine non-stream compact request and the generic
+	// HttpRequest API.
+	t.Run("outside/genuine-compact", func(t *testing.T) {
+		s := cm053NewSinks(t, cm053KeyedStatic(400, http.Header{"Content-Type": {"application/json"}}, errorBody), false)
+		_, err := cm053RunExecute(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAIResponse, "responses/compact")
+		if _, ok := err.(statusErr); !ok || !strings.Contains(err.Error(), cm053KeyedCanary) {
+			t.Fatalf("genuine compact error = %T %v, want the unchanged upstream statusErr", err, err)
+		}
+	})
+	t.Run("outside/images", func(t *testing.T) {
+		s := cm053NewSinks(t, cm053KeyedStatic(400, http.Header{"Content-Type": {"application/json"}}, errorBody), false)
+		executor := NewOpenAICompatExecutor("openai-compatibility", s.cfg)
+		_, err := executor.Execute(s.ctx, cm053KeyedAuth(key), cliproxyexecutor.Request{Model: "cm053-image", Payload: []byte(`{"model":"cm053-image","prompt":"x"}`)}, cliproxyexecutor.Options{
+			SourceFormat: sdktranslator.FromString(openAICompatImageHandlerType),
+		})
+		if _, ok := err.(statusErr); !ok || !strings.Contains(err.Error(), cm053KeyedCanary) {
+			t.Fatalf("images error = %T %v, want the unchanged upstream statusErr", err, err)
+		}
+	})
+	t.Run("outside/http-request", func(t *testing.T) {
+		s := cm053NewSinks(t, cm053KeyedStatic(400, http.Header{"Content-Type": {"application/json"}}, errorBody), false)
+		executor := NewOpenAICompatExecutor("openai-compatibility", s.cfg)
+		req, _ := http.NewRequestWithContext(s.ctx, http.MethodGet, cm053KeyedBaseURL+"/models", nil)
+		resp, err := executor.HttpRequest(s.ctx, cm053KeyedAuth(key), req)
+		if err != nil {
+			t.Fatalf("HttpRequest: %v", err)
+		}
+		defer resp.Body.Close()
+		raw, _ := io.ReadAll(resp.Body)
+		if !strings.Contains(string(raw), cm053KeyedCanary) {
+			t.Fatalf("generic HttpRequest response changed: %s", raw)
+		}
+	})
+}
