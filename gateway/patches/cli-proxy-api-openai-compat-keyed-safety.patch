+func TestCM053KeylessCompatErrorBehaviorPreserved(t *testing.T) {
+	const providerText = "keyless provider wording"
+	t.Run("http-error", func(t *testing.T) {
+		body := `{"error":{"message":"` + providerText + `"}}`
+		s := cm053NewSinks(t, cm053KeyedStatic(500, http.Header{"Content-Type": {"application/json"}, "X-Upstream": {"kept"}}, body), false)
+		_, err := cm053RunExecute(t, s, cm053KeylessAuth(), sdktranslator.FormatOpenAI, "")
+		if _, ok := err.(statusErr); !ok || err.Error() != body {
+			t.Fatalf("keyless error = %T %v, want the upstream statusErr with the provider body", err, err)
+		}
+		if !strings.Contains(s.captured(), providerText) {
+			t.Fatalf("keyless capture lost the provider body: %q", s.captured())
+		}
+		if logging.GetResponseHeaders(s.ctx).Get("X-Upstream") != "kept" {
+			t.Fatalf("keyless response metadata was normalized: %v", logging.GetResponseHeaders(s.ctx))
+		}
+	})
+	t.Run("success-headers", func(t *testing.T) {
+		body := `{"id":"c1","object":"chat.completion","created":1,"model":"cm053-model","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`
+		s := cm053NewSinks(t, cm053KeyedStatic(200, http.Header{"Content-Type": {"application/json"}, "X-Upstream": {"kept"}}, body), false)
+		resp, err := cm053RunExecute(t, s, cm053KeylessAuth(), sdktranslator.FormatOpenAI, "")
+		if err != nil || resp.Headers.Get("X-Upstream") != "kept" {
+			t.Fatalf("keyless success: err=%v headers=%v", err, resp.Headers)
+		}
+	})
+	t.Run("http-200-error-envelope-not-classified", func(t *testing.T) {
+		body := `{"error":{"message":"` + providerText + `"}}`
+		s := cm053NewSinks(t, cm053KeyedStatic(200, http.Header{"Content-Type": {"application/json"}}, body), false)
+		if _, err := cm053RunExecute(t, s, cm053KeylessAuth(), sdktranslator.FormatOpenAI, ""); err != nil {
+			t.Fatalf("keyless 200 envelope became an error: %v", err)
+		}
+	})
+	t.Run("sse-error", func(t *testing.T) {
+		body := `data: {"error":{"message":"` + providerText + `"}}` + "\n\n"
+		s := cm053NewSinks(t, cm053KeyedStatic(200, http.Header{"Content-Type": {"text/event-stream"}}, body), false)
+		outcome := cm053RunStream(t, s, cm053KeylessAuth(), sdktranslator.FormatOpenAI, "")
+		if outcome.streamErr == nil || !strings.Contains(outcome.streamErr.Error(), providerText) {
+			t.Fatalf("keyless stream error = %v, want the provider wording", outcome.streamErr)
+		}
+	})
+	t.Run("transport-error", func(t *testing.T) {
+		upstream := cm053KeyedUpstream(func(*http.Request) (*http.Response, error) { return nil, errors.New(providerText) })
+		s := cm053NewSinks(t, upstream, false)
+		_, err := cm053RunExecute(t, s, cm053KeylessAuth(), sdktranslator.FormatOpenAI, "")
+		if err == nil || !strings.Contains(err.Error(), providerText) {
+			t.Fatalf("keyless transport error = %v, want the raw error", err)
+		}
+	})
+}
