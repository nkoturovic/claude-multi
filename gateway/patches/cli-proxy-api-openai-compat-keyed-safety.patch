+// Package compatsafe is the safe failure representation of the keyed
+// OpenAI-compatible chat route.
+//
+// A keyed compatibility provider (an api_key, a configured credential
+// header, or credentials in its URL) can echo the credential back in an
+// error body, an SSE error frame, a response header or a transport error.
+// On the reviewed chat route every such failure is rebuilt from local data
+// only: the numeric status, one Kind from the finite set below, the fixed
+// local text of that Kind, and typed retry metadata (the executor's existing
+// Retry-After / TPM parsing, computed before the raw input is dropped).
+// Provider message, detail, type and code strings, URLs, event names, header
+// maps and wrapped error chains are never retained. A recognized provider
+// code or type only selects a Kind; it is never copied.
+//
+// The fixed text of each Kind is an OpenAI-style error envelope chosen so
+// that the conductor's existing semantic classification (request fault,
+// model not found, model not supported, authentication, Cloudflare
+// challenge, rate limit) reaches the same verdict it reached on the raw
+// provider body for those categories. Arbitrary provider-text matching (for
+// example request-scoped-error rules with free-text match strings) is not
+// supported on this route.
+//
+// The package depends on the standard library only.
+package compatsafe
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// MaxErrorBody is the most bytes of an upstream failure body that are ever
+// examined. ReadErrorBody reads one byte more to detect overflow.
+const MaxErrorBody = 64 << 10
+
+// Stream bounds of the keyed chat route: the existing 50 MiB per-line
+// scanner ceiling is kept, and one SSE frame may hold at most 50 MiB of
+// line bytes in at most 65,536 lines.
+const (
+	MaxStreamLine       = 52_428_800
+	MaxStreamFrameBytes = 52_428_800
+	MaxStreamFrameLines = 65_536
+)
+
+// Kind is one locally defined failure kind.
+type Kind uint8
+
+// The finite set of failure kinds.
+const (
+	// KindUpstreamStatus is a non-2xx response with no recognized category.
+	KindUpstreamStatus Kind = iota + 1
+	KindInvalidRequest
+	KindContextLength
+	KindModelNotFound
+	KindModelNotSupported
+	KindAuthentication
+	KindPermission
+	KindRateLimited
+	KindQuota
+	KindCloudflareChallenge
+	KindServerError
+	KindErrorBodyTooLarge
+	KindErrorBodyUnreadable
+	// KindErrorPayload is an error envelope (2xx body or SSE frame) with no
+	// recognized category.
+	KindErrorPayload
+	KindMalformedResponse
+	KindStreamErrorEventNoData
+	KindStreamErrorEventBeforeDone
+	KindStreamIncompleteBeforeDone
+	KindStreamIncompleteFrame
+	KindStreamClosedBeforeDone
+	KindStreamFrameTooLarge
+	kindEnd
+)
+
+type kindText struct {
+	name    string
+	errType string
+	code    string
+	message string
+}
+
+var kindTexts = [...]kindText{
+	KindUpstreamStatus:             {"upstream_status", "upstream_error", "upstream_error", "upstream returned an error status"},
+	KindInvalidRequest:             {"invalid_request", "invalid_request_error", "invalid_request_error", "upstream rejected the request as invalid"},
+	KindContextLength:              {"context_length", "invalid_request_error", "context_length_exceeded", "upstream rejected the request: context length exceeded"},
+	KindModelNotFound:              {"model_not_found", "not_found_error", "model_not_found", "upstream model not found"},
+	KindModelNotSupported:          {"model_not_supported", "upstream_error", "model_not_supported", "upstream model not supported"},
+	KindAuthentication:             {"authentication", "authentication_error", "invalid_api_key", "upstream rejected the credential"},
+	KindPermission:                 {"permission", "permission_error", "permission_denied", "upstream denied permission"},
+	KindRateLimited:                {"rate_limited", "rate_limit_error", "rate_limit_exceeded", "upstream rate limit exceeded"},
+	KindQuota:                      {"quota", "insufficient_quota", "insufficient_quota", "upstream quota or billing limit reached"},
+	KindCloudflareChallenge:        {"cloudflare_challenge", "upstream_error", "cloudflare_challenge", "upstream returned a cloudflare challenge"},
+	KindServerError:                {"server_error", "server_error", "upstream_server_error", "upstream server error"},
+	KindErrorBodyTooLarge:          {"error_body_too_large", "upstream_error", "upstream_error_body_too_large", "upstream error body exceeded the size limit"},
+	KindErrorBodyUnreadable:        {"error_body_unreadable", "upstream_error", "upstream_error_body_unreadable", "upstream error body could not be read"},
+	KindErrorPayload:               {"error_payload", "upstream_error", "upstream_error_payload", "upstream returned an error payload"},
+	KindMalformedResponse:          {"malformed_response", "upstream_error", "malformed_response", "upstream returned a malformed response"},
+	KindStreamErrorEventNoData:     {"stream_error_event_no_data", "upstream_error", "stream_protocol_error", "upstream error event ended without data"},
+	KindStreamErrorEventBeforeDone: {"stream_error_event_before_done", "upstream_error", "stream_protocol_error", "upstream error event ended before [DONE]"},
+	KindStreamIncompleteBeforeDone: {"stream_incomplete_before_done", "upstream_error", "stream_protocol_error", "upstream stream ended with incomplete data before [DONE]"},
+	KindStreamIncompleteFrame:      {"stream_incomplete_frame", "upstream_error", "stream_protocol_error", "upstream stream ended with incomplete SSE data frame"},
+	KindStreamClosedBeforeDone:     {"stream_closed_before_done", "upstream_error", "stream_protocol_error", "upstream stream closed before [DONE]"},
+	KindStreamFrameTooLarge:        {"stream_frame_too_large", "upstream_error", "stream_frame_too_large", "upstream stream frame exceeded the size limit"},
+}
+
+var kindBodies = func() [len(kindTexts)]string {
+	var bodies [len(kindTexts)]string
+	for i := range kindTexts {
+		text := kindTexts[i]
+		if text.name == "" {
+			continue
+		}
+		type detail struct {
+			Message string `json:"message"`
+			Type    string `json:"type"`
+			Code    string `json:"code"`
+		}
+		raw, errMarshal := json.Marshal(struct {
+			Error detail `json:"error"`
+		}{detail{Message: text.message, Type: text.errType, Code: text.code}})
+		if errMarshal != nil {
+			panic("compatsafe: " + errMarshal.Error())
+		}
+		bodies[i] = string(raw)
+	}
+	return bodies
+}()
+
+// Kinds returns every defined Kind.
+func Kinds() []Kind {
+	kinds := make([]Kind, 0, int(kindEnd)-1)
+	for k := KindUpstreamStatus; k < kindEnd; k++ {
+		kinds = append(kinds, k)
+	}
+	return kinds
+}
+
+func (k Kind) valid() bool { return k >= KindUpstreamStatus && k < kindEnd }
+
+// String returns the kind's fixed name.
+func (k Kind) String() string {
+	if !k.valid() {
+		return "unknown"
+	}
+	return kindTexts[k].name
+}
+
+// Message returns the kind's fixed local message.
+func (k Kind) Message() string {
+	if !k.valid() {
+		return "upstream request failed"
+	}
+	return kindTexts[k].message
+}
+
+// Body returns the kind's fixed error envelope.
+func (k Kind) Body() string {
+	if !k.valid() {
+		return kindBodies[KindUpstreamStatus]
+	}
+	return kindBodies[k]
+}
+
+// Error is the safe failure of the keyed chat route: a numeric status, a
+// Kind and typed retry metadata. It wraps nothing.
+type Error struct {
+	Kind   Kind
+	Status int
+	Retry  *time.Duration
+}
+
+// NewError returns the safe failure of kind with status. A status outside
+// 400..599 becomes 502.
+func NewError(kind Kind, status int, retry *time.Duration) Error {
+	if status < http.StatusBadRequest || status > 599 {
+		status = http.StatusBadGateway
+	}
+	if retry != nil {
+		value := *retry
+		retry = &value
+	}
+	return Error{Kind: kind, Status: status, Retry: retry}
+}
+
+// Error returns the kind's fixed error envelope.
+func (e Error) Error() string { return e.Kind.Body() }
+
+// StatusCode returns the numeric status.
+func (e Error) StatusCode() int { return e.Status }
+
+// RetryAfter returns the typed retry metadata, or nil.
+func (e Error) RetryAfter() *time.Duration {
+	if e.Retry == nil {
+		return nil
+	}
+	value := *e.Retry
+	return &value
+}
+
+// IsCredentialScoped reports false: the compatibility executor never marks a
+// failure credential-scoped.
+func (e Error) IsCredentialScoped() bool { return false }
+
+// ReadErrorBody reads at most MaxErrorBody+1 bytes of r. It returns the
+// bytes read (never more than MaxErrorBody), whether the body was larger,
+// and whether it could be read at all.
+func ReadErrorBody(r io.Reader) (body []byte, overflow bool, readable bool) {
+	if r == nil {
+		return nil, false, true
+	}
+	raw, errRead := io.ReadAll(io.LimitReader(r, MaxErrorBody+1))
+	if len(raw) > MaxErrorBody {
+		return raw[:MaxErrorBody], true, true
+	}
+	if errRead != nil {
+		return nil, false, false
+	}
+	return raw, false, true
+}
+
+// HTTPFailure classifies a non-2xx response. body is at most MaxErrorBody
+// bytes; overflow and unreadable select their fixed kinds. retry is the
+// executor's typed retry metadata.
+func HTTPFailure(status int, body []byte, overflow, readable bool, retry *time.Duration) Error {
+	switch {
+	case !readable:
+		return NewError(statusKindOr(status, KindErrorBodyUnreadable), status, retry)
+	case overflow:
+		return NewError(statusKindOr(status, KindErrorBodyTooLarge), status, retry)
+	}
+	return NewError(Classify(status, body), status, retry)
+}
+
+// statusKindOr keeps the authoritative status kinds (402, 429) when the body
+// cannot be examined, and otherwise uses fallback.
+func statusKindOr(status int, fallback Kind) Kind {
+	switch status {
+	case http.StatusPaymentRequired:
+		return KindQuota
+	case http.StatusTooManyRequests:
+		return KindRateLimited
+	}
+	return fallback
+}
+
+// Classify selects the Kind of an upstream failure from its status and at
+// most MaxErrorBody bytes of body. The order mirrors the conductor: 402 and
+// 429 are authoritative; a Cloudflare challenge below 500 is never a request
+// fault; 401 with authentication_error stays a credential failure; model
+// availability wins over a generic request fault; recognized request-fault
+// codes and types come next; the status decides the rest.
+func Classify(status int, body []byte) Kind {
+	if len(body) > MaxErrorBody {
+		body = body[:MaxErrorBody]
+	}
+	return classify(status, body, errorFields(body))
+}
+
+func classify(status int, body []byte, fields fieldSet) Kind {
+	if len(body) > MaxErrorBody {
+		body = body[:MaxErrorBody]
+	}
+	lower := strings.ToLower(string(body))
+	switch {
+	case status == http.StatusPaymentRequired:
+		return KindQuota
+	case status == http.StatusTooManyRequests:
+		return KindRateLimited
+	case status < http.StatusInternalServerError && isCloudflareChallenge(lower):
+		return KindCloudflareChallenge
+	case status == http.StatusUnauthorized && fields.hasType("authentication_error"):
+		return KindAuthentication
+	case fields.modelNotFound():
+		return KindModelNotFound
+	case (status == http.StatusBadRequest || status == http.StatusUnprocessableEntity || status == http.StatusNotFound) && isModelSupportText(lower):
+		return KindModelNotSupported
+	case fields.hasCode("context_length_exceeded"):
+		return KindContextLength
+	case fields.requestFault():
+		return KindInvalidRequest
+	}
+	switch {
+	case status == http.StatusUnauthorized:
+		return KindAuthentication
+	case status == http.StatusForbidden:
+		return KindPermission
+	case status >= http.StatusInternalServerError:
+		return KindServerError
+	}
+	return KindUpstreamStatus
+}
+
+// PayloadFailure classifies an error envelope carried by a 2xx body or an
+// SSE frame: the status is the envelope's numeric status field in 400..599,
+// otherwise 502, and the category comes from Classify; an envelope with no
+// recognized category is KindErrorPayload. A payload that is not exactly
+// one duplicate-free JSON object (see Inspect) is KindMalformedResponse.
+func PayloadFailure(payload []byte) Error {
+	root, ok := decodeStrict(payload)
+	if !ok {
+		return NewError(KindMalformedResponse, http.StatusBadGateway, nil)
+	}
+	if _, isObject := root.(map[string]any); !isObject {
+		return NewError(KindMalformedResponse, http.StatusBadGateway, nil)
+	}
+	return payloadFailure(payload, root)
+}
+
+func payloadFailure(payload []byte, root any) Error {
+	status := payloadStatus(root)
+	kind := classify(status, payload, fieldsOf(root))
+	if kind == KindUpstreamStatus || kind == KindServerError {
+		kind = KindErrorPayload
+	}
+	return NewError(kind, status, nil)
+}
+
+// PayloadStatus returns the numeric status an error envelope names in its
+// usual fields, or 502 (also for a payload that does not decode strictly).
+func PayloadStatus(payload []byte) int {
+	root, ok := decodeStrict(payload)
+	if !ok {
+		return http.StatusBadGateway
+	}
+	return payloadStatus(root)
+}
+
+func payloadStatus(root any) int {
+	for _, path := range [][]string{{"status"}, {"status_code"}, {"error", "status"}, {"error", "status_code"}, {"response", "error", "status"}, {"response", "error", "status_code"}} {
+		if n, ok := lookupNumber(root, path); ok && n >= http.StatusBadRequest && n <= 599 {
+			return n
+		}
+	}
+	return http.StatusBadGateway
+}
+
+// Inspect validates and classifies a keyed JSON payload (a 2xx body or the
+// data of one complete SSE frame) before anything captures, observes or
+// translates it. It reports failed=false only for a validated success: a
+// payload that decodes as exactly one JSON object, with no duplicate member
+// name at any depth, that is not an error envelope. Everything else fails
+// closed with a fixed Error: an error envelope (or any payload of an
+// error-named SSE event) is classified by PayloadFailure; invalid JSON,
+// trailing data, a duplicate member (ambiguous: downstream parsers disagree
+// on which member wins), or a non-object top level (a string, number, array,
+// boolean or null) is KindMalformedResponse. Numbers are decoded without
+// float64 conversion, so a huge number never turns an error envelope into
+// an undecodable success.
+func Inspect(payload []byte, errorEvent bool) (failure Error, failed bool) {
+	trimmed := bytes.TrimSpace(payload)
+	root, ok := decodeStrict(trimmed)
+	if !ok {
+		return NewError(KindMalformedResponse, http.StatusBadGateway, nil), true
+	}
+	object, isObject := root.(map[string]any)
+	if !isObject {
+		return NewError(KindMalformedResponse, http.StatusBadGateway, nil), true
+	}
+	if errorEvent || isErrorEnvelope(object) {
+		return payloadFailure(trimmed, root), true
+	}
+	return Error{}, false
+}
+
+// errNotStrict is the internal verdict of decodeStrict; it never leaves the
+// package.
+var errNotStrict = errors.New("compatsafe: payload is not strict JSON")
+
+// decodeStrict decodes exactly one JSON value: numbers stay json.Number,
+// and an object with a duplicate member name (compared after unescaping) at
+// any depth is rejected. json.Valid runs first, so nesting is bounded by the
+// standard decoder's depth limit before the recursive walk.
+func decodeStrict(payload []byte) (any, bool) {
+	trimmed := bytes.TrimSpace(payload)
+	if len(trimmed) == 0 || !json.Valid(trimmed) {
+		return nil, false
+	}
+	decoder := json.NewDecoder(bytes.NewReader(trimmed))
+	decoder.UseNumber()
+	root, errDecode := decodeStrictValue(decoder)
+	if errDecode != nil {
+		return nil, false
+	}
+	if _, errTrailing := decoder.Token(); errTrailing != io.EOF {
+		return nil, false
+	}
+	return root, true
+}
+
+func decodeStrictValue(decoder *json.Decoder) (any, error) {
+	token, errToken := decoder.Token()
+	if errToken != nil {
+		return nil, errNotStrict
+	}
+	delim, isDelim := token.(json.Delim)
+	if !isDelim {
+		return token, nil
+	}
+	switch delim {
+	case '{':
+		object := make(map[string]any)
+		for decoder.More() {
+			keyToken, errKey := decoder.Token()
+			if errKey != nil {
+				return nil, errNotStrict
+			}
+			key, isString := keyToken.(string)
+			if !isString {
+				return nil, errNotStrict
+			}
+			if _, duplicate := object[key]; duplicate {
+				return nil, errNotStrict
+			}
+			value, errValue := decodeStrictValue(decoder)
+			if errValue != nil {
+				return nil, errNotStrict
+			}
+			object[key] = value
+		}
+		if end, errEnd := decoder.Token(); errEnd != nil || end != json.Delim('}') {
+			return nil, errNotStrict
+		}
+		return object, nil
+	case '[':
+		array := make([]any, 0)
+		for decoder.More() {
+			value, errValue := decodeStrictValue(decoder)
+			if errValue != nil {
+				return nil, errNotStrict
+			}
+			array = append(array, value)
+		}
+		if end, errEnd := decoder.Token(); errEnd != nil || end != json.Delim(']') {
+			return nil, errNotStrict
+		}
+		return array, nil
+	}
+	return nil, errNotStrict
+}
+
+// isErrorEnvelope reports whether a decoded object is an error envelope: a
+// non-null error or response.error, an error/response.error/response.failed
+// type, or a top-level code+message pair.
+func isErrorEnvelope(object map[string]any) bool {
+	if value, exists := object["error"]; exists && value != nil {
+		return true
+	}
+	if response, isObject := object["response"].(map[string]any); isObject {
+		if value, exists := response["error"]; exists && value != nil {
+			return true
+		}
+	}
+	if typ, isString := object["type"].(string); isString {
+		switch strings.ToLower(typ) {
+		case "error", "response.error", "response.failed":
+			return true
+		}
+	}
+	_, hasCode := object["code"]
+	_, hasMessage := object["message"]
+	return hasCode && hasMessage
+}
+
+type fieldSet struct {
+	codes             []string
+	types             []string
+	modelNotFoundTree bool
+}
+
+func (f fieldSet) hasCode(code string) bool {
+	for _, c := range f.codes {
+		if c == code {
+			return true
+		}
+	}
+	return false
+}
+
+func (f fieldSet) hasType(typ string) bool {
+	for _, t := range f.types {
+		if t == typ {
+			return true
+		}
+	}
+	return false
+}
+
+var requestFaultCodes = map[string]struct{}{
+	"cyber_policy": {}, "context_length_exceeded": {}, "message_too_big": {}, "string_above_max_length": {},
+	"invalid_prompt": {}, "invalid_value": {}, "unsupported_value": {}, "invalid_request_error": {},
+	"previous_response_not_found": {},
+}
+
+var requestFaultTypes = map[string]struct{}{
+	"invalid_request": {}, "invalid_request_error": {}, "bad_request_error": {}, "invalid_prompt": {},
+}
+
+func (f fieldSet) requestFault() bool {
+	for _, c := range f.codes {
+		if _, ok := requestFaultCodes[c]; ok {
+			return true
+		}
+	}
+	for _, t := range f.types {
+		if _, ok := requestFaultTypes[t]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+// isModelNotFoundIdentifier mirrors the conductor: the last path segment of
+// a code or type, normalized, names a missing model.
+func isModelNotFoundIdentifier(value string) bool {
+	candidate := strings.ToLower(strings.TrimSpace(value))
+	if fragment := strings.LastIndex(candidate, "#"); fragment >= 0 && fragment+1 < len(candidate) {
+		candidate = candidate[fragment+1:]
+	} else {
+		if query := strings.Index(candidate, "?"); query >= 0 {
+			candidate = candidate[:query]
+		}
+		candidate = strings.TrimRight(candidate, "/")
+		if separator := strings.LastIndexAny(candidate, "/:"); separator >= 0 {
+			candidate = candidate[separator+1:]
+		}
+	}
+	switch strings.NewReplacer("-", "_", " ", "_").Replace(candidate) {
+	case "model_not_found", "model_not_found_error", "unknown_model", "model_does_not_exist", "model_not_exist":
+		return true
+	}
+	return false
+}
+
+// isModelNotFoundMessage mirrors the conductor's explicit model-not-found
+// message rule without a requested model (the form every classification
+// call of the conductor uses).
+func isModelNotFoundMessage(message string) bool {
+	lower := strings.Trim(strings.ToLower(strings.TrimSpace(message)), " .!;\t\r\n")
+	if lower == "" || strings.Contains(lower, "in request") || strings.Contains(lower, "in body") || strings.Contains(lower, "request body") {
+		return false
+	}
+	normalized := strings.NewReplacer("-", "_").Replace(lower)
+	if strings.Contains(normalized, "model_not_found") || strings.Contains(normalized, "unknown_model") {
+		return true
+	}
+	for _, prefix := range []string{"no such model", "unknown model"} {
+		if lower != prefix && !strings.HasPrefix(lower, prefix+" ") && !strings.HasPrefix(lower, prefix+":") {
+			continue
+		}
+		remainder := strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(strings.TrimPrefix(lower, prefix)), ":"))
+		return remainder == ""
+	}
+	for _, prefix := range []string{"the requested model", "requested model", "the model", "model"} {
+		if lower != prefix && !strings.HasPrefix(lower, prefix+" ") && !strings.HasPrefix(lower, prefix+":") {
+			continue
+		}
+		remainder := strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(strings.TrimPrefix(lower, prefix)), ":"))
+		switch strings.Trim(remainder, " .!;\t\r\n") {
+		case "not found", "was not found", "could not be found", "does not exist", "doesn't exist", "not exist", "is unknown", "does not exist or you do not have access to it":
+			return true
+		}
+		return false
+	}
+	return false
+}
+
+// containsModelNotFound walks a decoded error envelope the way the
+// conductor does: code/type identifiers and error/message/detail/
+// error_description/title strings at any depth.
+func containsModelNotFound(value any) bool {
+	switch typed := value.(type) {
+	case map[string]any:
+		for key, item := range typed {
+			if text, isString := item.(string); isString {
+				switch strings.ToLower(strings.TrimSpace(key)) {
+				case "code", "type":
+					if isModelNotFoundIdentifier(text) {
+						return true
+					}
+				case "error", "message", "detail", "error_description", "title":
+					if isModelNotFoundMessage(text) {
+						return true
+					}
+				}
+			}
+			switch item.(type) {
+			case map[string]any, []any:
+				if containsModelNotFound(item) {
+					return true
+				}
+			}
+		}
+	case []any:
+		for _, item := range typed {
+			if text, isString := item.(string); isString && isModelNotFoundMessage(text) {
+				return true
+			}
+			if containsModelNotFound(item) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (f fieldSet) modelNotFound() bool { return f.modelNotFoundTree }
+
+// errorFields collects the lower-cased code and type strings of the usual
+// error-envelope paths and the conductor's model-not-found verdict. It is
+// used for classification only. A body that does not decode strictly (see
+// Inspect) yields no fields, so the status decides.
+func errorFields(body []byte) fieldSet {
+	root, ok := decodeStrict(body)
+	if !ok {
+		return fieldSet{}
+	}
+	return fieldsOf(root)
+}
+
+func fieldsOf(root any) fieldSet {
+	var f fieldSet
+	for _, prefix := range [][]string{nil, {"error"}, {"response", "error"}, {"body", "error"}} {
+		if value, ok := lookupString(root, append(append([]string{}, prefix...), "code")); ok {
+			f.codes = append(f.codes, value)
+		}
+		if value, ok := lookupString(root, append(append([]string{}, prefix...), "type")); ok {
+			f.types = append(f.types, value)
+		}
+	}
+	f.modelNotFoundTree = containsModelNotFound(root)
+	return f
+}
+
+func lookup(root any, path []string) (any, bool) {
+	current := root
+	for _, key := range path {
+		object, ok := current.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current, ok = object[key]
+		if !ok {
+			return nil, false
+		}
+	}
+	return current, true
+}
+
+func lookupString(root any, path []string) (string, bool) {
+	value, ok := lookup(root, path)
+	if !ok {
+		return "", false
+	}
+	switch typed := value.(type) {
+	case string:
+		return strings.ToLower(strings.TrimSpace(typed)), true
+	case json.Number:
+		if n, errInt := typed.Int64(); errInt == nil {
+			return strconv.FormatInt(n, 10), true
+		}
+		if f, errFloat := typed.Float64(); errFloat == nil {
+			return strconv.FormatFloat(f, 'f', -1, 64), true
+		}
+		return "", false
+	}
+	return "", false
+}
+
+func lookupNumber(root any, path []string) (int, bool) {
+	value, ok := lookup(root, path)
+	if !ok {
+		return 0, false
+	}
+	switch typed := value.(type) {
+	case json.Number:
+		if n, errInt := typed.Int64(); errInt == nil {
+			if n < 0 || n > 999 {
+				return 0, false
+			}
+			return int(n), true
+		}
+		f, errFloat := typed.Float64()
+		if errFloat != nil || f < 0 || f > 999 || f != float64(int(f)) {
+			return 0, false
+		}
+		return int(f), true
+	case string:
+		n, errAtoi := strconv.Atoi(strings.TrimSpace(typed))
+		return n, errAtoi == nil
+	}
+	return 0, false
+}
+
+func isModelSupportText(lower string) bool {
+	for _, pattern := range []string{
+		"model_not_supported", "requested model is not supported", "requested model is unsupported",
+		"requested model is unavailable", "model is not supported", "model not supported", "unsupported model",
+		"model unavailable", "not available for your plan", "not available for your account",
+	} {
+		if strings.Contains(lower, pattern) {
+			return true
+		}
+	}
+	return false
+}
+
+func isCloudflareChallenge(lower string) bool {
+	return strings.Contains(lower, "challenge-platform") ||
+		strings.Contains(lower, "cf-mitigated") ||
+		strings.Contains(lower, "cloudflare challenge") ||
+		(strings.Contains(lower, "just a moment") && strings.Contains(lower, "cloudflare"))
+}
+
+// TransportError is the safe form of a transport, read or close failure
+// that has no trusted identity. It carries no status and wraps nothing; its
+// fixed text keeps the conductor's transient-transport classification.
+type TransportError struct {
+	transient bool
+	timeout   bool
+}
+
+// Error returns the fixed text.
+func (e TransportError) Error() string {
+	switch {
+	case e.timeout:
+		return "upstream transport failed: i/o timeout"
+	case e.transient:
+		return "upstream transport failed: connection refused, reset or unreachable"
+	}
+	return "upstream transport failed"
+}
+
+// Transport returns the safe form of a transport, read, scanner or close
+// error. Trusted identities are kept as their standard sentinels
+// (context.Canceled, context.DeadlineExceeded, io.EOF,
+// io.ErrUnexpectedEOF); a sentinel refusal from the redirect policy is kept
+// as is when keep reports it; bufio.ErrTooLong and anything else become a
+// fixed TransportError.
+func Transport(err error, keep func(error) bool) error {
+	switch {
+	case err == nil:
+		return nil
+	case keep != nil && keep(err):
+		return err
+	case errors.Is(err, context.Canceled):
+		return context.Canceled
+	case errors.Is(err, context.DeadlineExceeded):
+		return context.DeadlineExceeded
+	case errors.Is(err, io.ErrUnexpectedEOF):
+		return io.ErrUnexpectedEOF
+	case errors.Is(err, io.EOF):
+		return io.EOF
+	}
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) && dnsErr != nil && (dnsErr.IsTimeout || dnsErr.Timeout()) {
+		return TransportError{transient: true, timeout: true}
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr != nil && netErr.Timeout() {
+		return TransportError{transient: true, timeout: true}
+	}
+	var errno syscall.Errno
+	if errors.As(err, &errno) {
+		switch errno {
+		case syscall.ECONNREFUSED, syscall.ECONNRESET, syscall.ECONNABORTED,
+			syscall.ETIMEDOUT, syscall.EHOSTUNREACH, syscall.ENETUNREACH, syscall.EPIPE:
+			return TransportError{transient: true}
+		}
+	}
+	var opErr *net.OpError
+	if (errors.As(err, &opErr) && opErr != nil) || (errors.As(err, &dnsErr) && dnsErr != nil) {
+		return TransportError{transient: true}
+	}
+	lower := strings.ToLower(err.Error())
+	if strings.Contains(lower, "unexpected eof") {
+		return io.ErrUnexpectedEOF
+	}
+	for _, phrase := range []string{
+		"tls handshake timeout", "i/o timeout",
+	} {
+		if strings.Contains(lower, phrase) {
+			return TransportError{transient: true, timeout: true}
+		}
+	}
+	for _, phrase := range []string{
+		"tls: tls handshake", "wsarecv", "wsasend", "a connection attempt failed", "connection refused",
+		"connection reset", "no such host", "server misbehaving", "network is unreachable", "no route to host",
+		"broken pipe", "connection aborted", "use of closed network connection",
+	} {
+		if strings.Contains(lower, phrase) {
+			return TransportError{transient: true}
+		}
+	}
+	return TransportError{}
+}
+
+// safeMediaTypes are the only response Content-Type values kept, each
+// reduced to its bare media type.
+var safeMediaTypes = map[string]struct{}{
+	"application/json":  {},
+	"text/event-stream": {},
+	"text/plain":        {},
+	"text/html":         {},
+}
+
+// ResponseHeaders returns the normalized response metadata of the keyed
+// chat route: at most a Content-Type reduced to one of a fixed set of media
+// types. No other upstream header name or value is kept. The result is
+// never nil.
+func ResponseHeaders(src http.Header) http.Header {
+	out := make(http.Header, 1)
+	if src == nil {
+		return out
+	}
+	values := src.Values("Content-Type")
+	if len(values) != 1 {
+		return out
+	}
+	mediaType, _, errParse := mime.ParseMediaType(values[0])
+	if errParse != nil {
+		return out
+	}
+	if _, ok := safeMediaTypes[strings.ToLower(mediaType)]; ok {
+		out.Set("Content-Type", strings.ToLower(mediaType))
+	}
+	return out
+}
+
+// Redacted is the fixed replacement of a credential-bearing value.
+const Redacted = "[redacted]"
+
+// RequestHeaders returns a copy of h for diagnostics in which every value of
+// a header outside keep is Redacted. Header names are kept.
+func RequestHeaders(h http.Header, keep map[string]struct{}) http.Header {
+	out := make(http.Header, len(h))
+	for name, values := range h {
+		canonical := http.CanonicalHeaderKey(name)
+		if _, ok := keep[canonical]; ok {
+			out[canonical] = append([]string(nil), values...)
+			continue
+		}
+		redacted := make([]string, len(values))
+		for i := range redacted {
+			redacted[i] = Redacted
+		}
+		out[canonical] = redacted
+	}
+	return out
+}
+
+// RequestURL returns rawURL for diagnostics without userinfo or fragment and
+// with any query replaced by Redacted.
+func RequestURL(rawURL string) string {
+	parsed, errParse := url.Parse(rawURL)
+	if errParse != nil {
+		return Redacted
+	}
+	parsed.User = nil
+	parsed.Fragment = ""
+	parsed.RawFragment = ""
+	if parsed.RawQuery != "" || parsed.ForceQuery {
+		parsed.RawQuery = Redacted
+		parsed.ForceQuery = false
+	}
+	return parsed.String()
+}
