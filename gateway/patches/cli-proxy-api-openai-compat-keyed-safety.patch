+func TestCM053KeyedCompatRetryClassificationPreserved(t *testing.T) {
+	now := time.Now()
+	date := now.Add(90 * time.Second).UTC().Format(http.TimeFormat)
+	cases := []struct {
+		name      string
+		status    int
+		header    http.Header
+		body      string
+		wantKind  compatsafe.Kind
+		wantRetry time.Duration // 0: nil; -1: any positive value up to 90s
+	}{
+		{"429-retry-after-seconds", 429, http.Header{"Retry-After": {"7"}}, `{"error":{"code":"rate_limit","message":"try later"}}`, compatsafe.KindRateLimited, 7 * time.Second},
+		{"429-retry-after-date", 429, http.Header{"Retry-After": {date}}, `{"error":{"message":"later"}}`, compatsafe.KindRateLimited, -1},
+		{"429-tpm-fallback", 429, nil, `{"error":{"code":"TPMRateLimitExceeded","message":"x"}}`, compatsafe.KindRateLimited, time.Minute},
+		{"429-tpm-message-fallback", 429, nil, `{"error":{"message":"Tokens per minute limit exceeded"}}`, compatsafe.KindRateLimited, time.Minute},
+		{"429-overflow-keeps-header", 429, http.Header{"Retry-After": {"3"}}, `{"error":{"code":"TPMRateLimitExceeded","message":"` + strings.Repeat("x", compatsafe.MaxErrorBody) + `"}}`, compatsafe.KindRateLimited, 3 * time.Second},
+		{"401-authentication", 401, nil, `{"error":{"type":"authentication_error","code":"invalid_request_error","message":"bad key"}}`, compatsafe.KindAuthentication, 0},
+		{"401-request-fault-body", 401, nil, `{"error":{"type":"invalid_request_error","message":"x"}}`, compatsafe.KindInvalidRequest, 0},
+		{"401-plain", 401, nil, `unauthorized`, compatsafe.KindAuthentication, 0},
+		{"400-context-length", 400, nil, `{"error":{"code":"context_length_exceeded","message":"too long"}}`, compatsafe.KindContextLength, 0},
+		{"400-invalid-request", 400, nil, `{"error":{"type":"invalid_request_error","message":"bad"}}`, compatsafe.KindInvalidRequest, 0},
+		{"400-generic", 400, nil, `oops`, compatsafe.KindUpstreamStatus, 0},
+		{"404-model-not-found-code", 404, nil, `{"error":{"code":"model_not_found","message":"x"}}`, compatsafe.KindModelNotFound, 0},
+		{"404-model-does-not-exist", 404, nil, `{"error":{"message":"The model does not exist"}}`, compatsafe.KindModelNotFound, 0},
+		{"404-model-named-does-not-exist", 404, nil, `{"error":{"message":"The model cm053-model does not exist"}}`, compatsafe.KindUpstreamStatus, 0},
+		{"400-model-not-supported", 400, nil, `{"error":{"message":"The requested model is not supported"}}`, compatsafe.KindModelNotSupported, 0},
+		{"403-cloudflare", 403, nil, `<html><title>Just a moment...</title>cloudflare</html>`, compatsafe.KindCloudflareChallenge, 0},
+		{"403-permission", 403, nil, `{"error":{"message":"no"}}`, compatsafe.KindPermission, 0},
+		{"402-quota", 402, nil, `{"error":{"type":"invalid_request_error","message":"pay"}}`, compatsafe.KindQuota, 0},
+		{"500-server", 500, nil, `{"error":{"message":"boom"}}`, compatsafe.KindServerError, 0},
+		{"503-no-retry-parsing", 503, http.Header{"Retry-After": {"30"}}, `busy`, compatsafe.KindServerError, 0},
+	}
+	for _, tc := range cases {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/stream=%t", tc.name, stream), func(t *testing.T) {
+				header := tc.header.Clone()
+				if header == nil {
+					header = http.Header{}
+				}
+				s := cm053NewSinks(t, cm053KeyedStatic(tc.status, header, tc.body), true)
+				var err error
+				if stream {
+					err = cm053RunStream(t, s, cm053KeyedAuth("sk-cm053-classify"), sdktranslator.FormatOpenAI, "").bootErr
+				} else {
+					_, err = cm053RunExecute(t, s, cm053KeyedAuth("sk-cm053-classify"), sdktranslator.FormatOpenAI, "")
+				}
+				safe := cm053AsSafe(t, err)
+				if safe.Kind != tc.wantKind {
+					t.Fatalf("kind = %s, want %s", safe.Kind, tc.wantKind)
+				}
+				raw := cm053RawStatusErr(tc.status, header, tc.body)
+				if got, want := clienterror.HTTPStatusFromError(err), clienterror.HTTPStatusFromError(raw); got != want {
+					t.Fatalf("status = %d, upstream %d", got, want)
+				}
+				if !strings.HasPrefix(tc.name, "429-overflow") {
+					if got, want := clienterror.IsRequestFault(0, err), clienterror.IsRequestFault(0, raw); got != want {
+						t.Fatalf("request-fault verdict = %t, upstream %t", got, want)
+					}
+				}
+				if safe.IsCredentialScoped() {
+					t.Fatal("safe failure is credential-scoped")
+				}
+				retry := safe.RetryAfter()
+				switch {
+				case tc.wantRetry == 0:
+					if retry != nil {
+						t.Fatalf("retry = %v, want none", *retry)
+					}
+				case tc.wantRetry < 0:
+					if retry == nil || *retry <= 0 || *retry > 90*time.Second {
+						t.Fatalf("retry = %v, want the HTTP-date delay", retry)
+					}
+				default:
+					if retry == nil || *retry != tc.wantRetry {
+						t.Fatalf("retry = %v, want %s", retry, tc.wantRetry)
+					}
+				}
+				if !strings.HasPrefix(tc.name, "429-overflow") && !strings.HasPrefix(tc.name, "429-retry-after-date") {
+					rawRetry := raw.(interface{ RetryAfter() *time.Duration }).RetryAfter()
+					if (rawRetry == nil) != (retry == nil) || (rawRetry != nil && *rawRetry != *retry) {
+						t.Fatalf("retry = %v, upstream parsing %v", retry, rawRetry)
+					}
+				}
+			})
+		}
+	}
+}
