+func TestCM053CompatSafeKindsFixed(t *testing.T) {
+	names := map[string]Kind{}
+	for _, kind := range Kinds() {
+		if kind.String() == "unknown" || kind.Message() == "" {
+			t.Fatalf("kind %d has no fixed text", kind)
+		}
+		if previous, dup := names[kind.String()]; dup {
+			t.Fatalf("kinds %d and %d share the name %q", previous, kind, kind.String())
+		}
+		names[kind.String()] = kind
+		var envelope struct {
+			Error struct {
+				Message string `json:"message"`
+				Type    string `json:"type"`
+				Code    string `json:"code"`
+			} `json:"error"`
+		}
+		if errUnmarshal := json.Unmarshal([]byte(kind.Body()), &envelope); errUnmarshal != nil {
+			t.Fatalf("kind %s body is not JSON: %v", kind, errUnmarshal)
+		}
+		if envelope.Error.Message != kind.Message() || envelope.Error.Type == "" || envelope.Error.Code == "" {
+			t.Fatalf("kind %s body = %s", kind, kind.Body())
+		}
+		err := NewError(kind, 0, nil)
+		if err.Error() != kind.Body() || err.StatusCode() != http.StatusBadGateway || err.RetryAfter() != nil || err.IsCredentialScoped() {
+			t.Fatalf("NewError(%s) = %+v", kind, err)
+		}
+	}
+	if len(names) != int(kindEnd)-1 {
+		t.Fatalf("%d named kinds, want %d", len(names), int(kindEnd)-1)
+	}
+	retry := 5 * time.Second
+	err := NewError(KindRateLimited, http.StatusTooManyRequests, &retry)
+	retry = time.Hour
+	if got := err.RetryAfter(); got == nil || *got != 5*time.Second {
+		t.Fatalf("retry metadata is shared with the caller: %v", got)
+	}
+	*err.RetryAfter() = time.Hour
+	if got := err.RetryAfter(); *got != 5*time.Second {
+		t.Fatalf("RetryAfter exposes internal state: %v", *got)
+	}
+}
