+// cm053SSEScenario is one keyed stream: the upstream SSE bytes, whether the
+// stream must fail, and a string a valid earlier frame must leave captured.
+type cm053SSEScenario struct {
+	body         string
+	wantKind     compatsafe.Kind
+	wantCaptured string
+}
+
+func cm053SSEScenarios(key string) map[string]cm053SSEScenario {
+	escaped := cm053Needles(key)[1]
+	partial := `data: {"id":"c1","object":"chat.completion.chunk","created":1,"model":"cm053-model","choices":[{"index":0,"delta":{"role":"assistant","content":"partial"},"finish_reason":null}]}` + "\n\n"
+	return map[string]cm053SSEScenario{
+		"early-error-frame": {
+			body:     fmt.Sprintf(`data: {"error":{"message":"bad key %s %s","code":"%s","type":"%s"}}`+"\n\n", key, cm053KeyedCanary, key, key),
+			wantKind: compatsafe.KindErrorPayload,
+		},
+		"midstream-error-frame": {
+			body:         partial + fmt.Sprintf(`data: {"error":{"message":"%s %s"}}`+"\n\ndata: [DONE]\n\n", key, cm053KeyedCanary),
+			wantKind:     compatsafe.KindErrorPayload,
+			wantCaptured: "partial",
+		},
+		"midstream-rate-limit-frame": {
+			body:         partial + fmt.Sprintf(`data: {"error":{"status":429,"message":"%s %s","type":"rate_limit_error"}}`+"\n\n", key, cm053KeyedCanary),
+			wantKind:     compatsafe.KindRateLimited,
+			wantCaptured: "partial",
+		},
+		"split-multiline-error-event": {
+			body:         partial + "event: error\n" + `data: {"message":` + "\n" + fmt.Sprintf(`data: "%s %s"}`, escaped, cm053KeyedCanary) + "\n\n",
+			wantKind:     compatsafe.KindErrorPayload,
+			wantCaptured: "partial",
+		},
+		"malicious-fields-on-valid-frame": {
+			body:         fmt.Sprintf(": %s %s\nid: %s\nretry: %s\nevent: %s-%s\n", key, cm053KeyedCanary, key, key, key, cm053KeyedCanary) + partial + "data: [DONE]\n\n",
+			wantCaptured: "partial",
+		},
+		"malformed-frame": {
+			body:         partial + fmt.Sprintf(`data: {"x":"%s %s"`, key, cm053KeyedCanary) + "\n\n",
+			wantKind:     compatsafe.KindStreamIncompleteFrame,
+			wantCaptured: "partial",
+		},
+		"plain-json-line": {
+			body:     "\n\n: keepalive\n\n" + fmt.Sprintf(`{"error":{"message":"%s %s"}}`, key, cm053KeyedCanary) + "\n",
+			wantKind: compatsafe.KindErrorPayload,
+		},
+		"plain-malformed-line": {
+			body:     fmt.Sprintf(`{"error":"%s %s"`, key, cm053KeyedCanary) + "\n",
+			wantKind: compatsafe.KindMalformedResponse,
+		},
+		"error-frame-model-field": {
+			body:     fmt.Sprintf(`data: {"type":"response.failed","model":"%s","response":{"model":"%s","error":{"message":"%s"}}}`, key, key, cm053KeyedCanary) + "\n\n",
+			wantKind: compatsafe.KindErrorPayload,
+		},
+		"error-event-then-done": {
+			body:     partial + fmt.Sprintf("event: error\nid: %s\ndata: [DONE]\n\n", key),
+			wantKind: compatsafe.KindStreamErrorEventBeforeDone,
+		},
+		"done-inside-error-frame": {
+			body:     partial + fmt.Sprintf("event: error\ndata: {\"message\":\"%s\"\ndata: [DONE]\n\n", key),
+			wantKind: compatsafe.KindStreamIncompleteBeforeDone,
+		},
+		"trailing-error-frame-without-blank": {
+			body:     partial + fmt.Sprintf(`data: {"error":{"message":"%s %s"}}`, key, cm053KeyedCanary),
+			wantKind: compatsafe.KindErrorPayload,
+		},
+		// An error event still pending at EOF, without data, is a terminal
+		// failure: never a synthesized [DONE]/end_turn completion.
+		"error-event-at-eof-unterminated": {
+			body:         partial + "event: error",
+			wantKind:     compatsafe.KindStreamErrorEventNoData,
+			wantCaptured: "partial",
+		},
+		"error-event-at-eof-newline": {
+			body:         partial + "event: error\n",
+			wantKind:     compatsafe.KindStreamErrorEventNoData,
+			wantCaptured: "partial",
+		},
+		"error-event-at-eof-after-comment": {
+			body:         partial + fmt.Sprintf("event: error\nid: %s\n: %s\n", key, cm053KeyedCanary),
+			wantKind:     compatsafe.KindStreamErrorEventNoData,
+			wantCaptured: "partial",
+		},
+		// Ambiguous or non-object frames fail closed before capture.
+		"duplicate-error-member-frame": {
+			body:         partial + fmt.Sprintf(`data: {"model":"%s","error":{"message":"invalid key %s %s"},"error":null}`, key, key, cm053KeyedCanary) + "\n\ndata: [DONE]\n\n",
+			wantKind:     compatsafe.KindMalformedResponse,
+			wantCaptured: "partial",
+		},
+		"non-object-frame": {
+			body:         partial + fmt.Sprintf(`data: "invalid key %s %s"`, key, cm053KeyedCanary) + "\n\ndata: [DONE]\n\n",
+			wantKind:     compatsafe.KindMalformedResponse,
+			wantCaptured: "partial",
+		},
+	}
+}
