+// isOpenAICompatAuthForLog reports an OpenAI-compatible provider auth
+// (keyed chat safety). Its credential is never shown in logs, not even
+// prefix/suffix-masked: a short key would survive HideAPIKey unchanged.
+func isOpenAICompatAuthForLog(auth *Auth) bool {
+	return auth != nil && auth.Attributes != nil && strings.TrimSpace(auth.Attributes["compat_name"]) != ""
+}
+
+// openAICompatAuthLogIdentity names an OpenAI-compatible auth by fixed
+// redaction plus its configured name and config position. It never uses any
+// part of the credential, nor the auth ID or auth index: both are short
+// hashes over the key, which a short key would not survive.
+func openAICompatAuthLogIdentity(auth *Auth) string {
+	identity := "[redacted] compat=" + strconv.Quote(strings.TrimSpace(auth.Attributes["compat_name"]))
+	if index := strings.TrimSpace(auth.Attributes["config_index"]); index != "" {
+		if _, errAtoi := strconv.Atoi(index); errAtoi == nil {
+			identity += " config_index=" + index
+		}
+	}
+	return identity
+}
+
 func formatAuthIdentity(auth *Auth, provider string) string {
 	if auth == nil {
 		return "auth=nil"
@@ -1878,6 +1903,9 @@ func formatAuthIdentity(auth *Auth, provider string) string {
