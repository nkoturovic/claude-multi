+func TestCM053KeyedCompatAuthIdentityRedacted(t *testing.T) {
+	var logs bytes.Buffer
+	previousOut, previousLevel := log.StandardLogger().Out, log.GetLevel()
+	log.SetOutput(&logs)
+	log.SetLevel(log.DebugLevel)
+	t.Cleanup(func() {
+		log.SetOutput(previousOut)
+		log.SetLevel(previousLevel)
+	})
+	for _, key := range []string{"Zq", "Zq9", "Zq9x", "sk-cm053-LongSyntheticSecret-0123456789abcdef"} {
+		logs.Reset()
+		compat := &Auth{
+			ID:       "openai-compatibility:cm053:0123456789ab",
+			Index:    "0123456789abcdef",
+			Provider: "cm053",
+			Attributes: map[string]string{
+				AttributeAPIKey: key,
+				"base_url":      "https://compat.cm053.invalid/v1",
+				"compat_name":   "cm053",
+				"config_index":  "2",
+			},
+		}
+		identity := formatAuthIdentity(compat, "cm053")
+		if identity != `api_key=[redacted] compat="cm053" config_index=2` {
+			t.Fatalf("compat identity = %q", identity)
+		}
+		entry := log.NewEntry(log.StandardLogger())
+		debugLogAuthSelection(entry, compat, "cm053", "cm053-model")
+		warnLogUpstreamFailure(context.Background(), entry, "cm053", "cm053-model", compat, time.Second, compatsafe.NewError(compatsafe.KindServerError, 500, nil))
+		text := logs.String()
+		for _, leak := range []string{key, util.HideAPIKey(key), compat.ID, compat.Index} {
+			if strings.Contains(text, leak) || strings.Contains(identity, leak) {
+				t.Fatalf("compat auth log shows %q:\n%s", leak, text)
+			}
+		}
+		if !strings.Contains(text, "[redacted]") || !strings.Contains(text, "upstream server error") {
+			t.Fatalf("compat auth logs = %s", text)
+		}
+	}
+
+	// Control: a non-compat API-key auth keeps upstream's masked identity.
+	other := &Auth{Provider: "gemini", Attributes: map[string]string{AttributeAPIKey: "gemini-key-0123456789"}}
+	if got := formatAuthIdentity(other, "gemini"); got != "api_key="+util.HideAPIKey("gemini-key-0123456789") {
+		t.Fatalf("non-compat identity = %q", got)
+	}
+}
