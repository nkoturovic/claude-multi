+func TestCM053KeyedCompatHTTP200ErrorEnvelopeSafe(t *testing.T) {
+	for _, key := range cm053KeyedKeys {
+		cases := []struct {
+			name       string
+			body       string
+			wantKind   compatsafe.Kind
+			wantStatus int
+		}{
+			{"error-envelope", fmt.Sprintf(`{"error":{"message":"%s %s","code":"%s"}}`, key, cm053KeyedCanary, key), compatsafe.KindErrorPayload, 502},
+			{"status-envelope", fmt.Sprintf(`{"error":{"status":429,"type":"rate_limit_error","message":"%s %s"}}`, key, cm053KeyedCanary), compatsafe.KindRateLimited, 429},
+			{"response-failed", fmt.Sprintf(`{"type":"response.failed","model":"%s","response":{"error":{"message":"%s"}}}`, key, cm053KeyedCanary), compatsafe.KindErrorPayload, 502},
+			{"code-message", fmt.Sprintf(`{"code":"model_not_found","message":"%s %s"}`, key, cm053KeyedCanary), compatsafe.KindModelNotFound, 502},
+			{"malformed", fmt.Sprintf(`<html>%s %s</html>`, key, cm053KeyedCanary), compatsafe.KindMalformedResponse, 502},
+			{"empty", "", compatsafe.KindMalformedResponse, 502},
+		}
+		for _, tc := range cases {
+			for _, format := range []sdktranslator.Format{sdktranslator.FormatOpenAI, sdktranslator.FormatClaude} {
+				t.Run(fmt.Sprintf("key%d/%s/%s", len(key), tc.name, format), func(t *testing.T) {
+					s := cm053NewSinks(t, cm053KeyedStatic(http.StatusOK, http.Header{"Content-Type": {"application/json"}}, tc.body), false)
+					resp, err := cm053RunExecute(t, s, cm053KeyedAuth(key), format, "")
+					safe := cm053AsSafe(t, err)
+					if safe.Kind != tc.wantKind || safe.StatusCode() != tc.wantStatus {
+						t.Fatalf("failure = %s/%d, want %s/%d", safe.Kind, safe.StatusCode(), tc.wantKind, tc.wantStatus)
+					}
+					if len(resp.Payload) != 0 {
+						t.Fatalf("an error envelope was translated into a response: %s", resp.Payload)
+					}
+					if strings.Contains(s.logs.String(), "upstream served model") {
+						t.Fatalf("an unclassified body reached model observation: %s", s.logs.String())
+					}
+					s.assertAbsent(t, fmt.Sprintf("%v|%+v|%s|%v", err, err, resp.Payload, resp.Headers), cm053Needles(key)...)
+				})
+			}
+		}
+	}
+}
