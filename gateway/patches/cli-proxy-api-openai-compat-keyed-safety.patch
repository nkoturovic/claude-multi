+// cm053RawStatusErr is the error upstream code builds for a failure body
+// (newOpenAICompatStatusError), used as the classification baseline.
+func cm053RawStatusErr(status int, header http.Header, body string) error {
+	return newOpenAICompatStatusError(status, header, []byte(body))
+}
