+func TestCM053KeyedCompatSSEClassifiedBeforeCapture(t *testing.T) {
+	for _, key := range cm053KeyedKeys {
+		for name, scenario := range cm053SSEScenarios(key) {
+			for _, format := range []sdktranslator.Format{sdktranslator.FormatOpenAI, sdktranslator.FormatClaude} {
+				t.Run(fmt.Sprintf("key%d/%s/%s", len(key), name, format), func(t *testing.T) {
+					upstream := cm053KeyedStatic(http.StatusOK, http.Header{"Content-Type": {"text/event-stream"}}, scenario.body)
+					s := cm053NewSinks(t, upstream, false)
+					outcome := cm053RunStream(t, s, cm053KeyedAuth(key), format, "")
+					if outcome.bootErr != nil {
+						t.Fatalf("bootstrap error: %v", outcome.bootErr)
+					}
+					if scenario.wantKind == 0 {
+						if outcome.streamErr != nil {
+							t.Fatalf("valid stream failed: %v", outcome.streamErr)
+						}
+						if !strings.Contains(outcome.payload, "partial") {
+							t.Fatalf("valid frame not delivered: %q", outcome.payload)
+						}
+					} else {
+						safe := cm053AsSafe(t, outcome.streamErr)
+						if safe.Kind != scenario.wantKind {
+							t.Fatalf("kind = %s, want %s", safe.Kind, scenario.wantKind)
+						}
+						if outcome.afterErr != 0 {
+							t.Fatalf("%d chunks followed the terminal error", outcome.afterErr)
+						}
+						for _, completion := range []string{"[DONE]", "message_stop", `"finish_reason":"stop"`, "response.completed"} {
+							if strings.Contains(outcome.payload, completion) {
+								t.Fatalf("a completion (%s) was emitted around a terminal error: %q", completion, outcome.payload)
+							}
+						}
+					}
+					if scenario.wantCaptured != "" && !strings.Contains(s.captured(), scenario.wantCaptured) {
+						t.Fatalf("classified valid frame was not captured: %q", s.captured())
+					}
+					if strings.Contains(s.logs.String(), "upstream served model") {
+						t.Fatalf("an unclassified frame reached model observation: %s", s.logs.String())
+					}
+					s.assertAbsent(t, outcome.client(), cm053Needles(key)...)
+				})
+			}
+		}
+	}
+}
