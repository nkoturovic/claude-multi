+func TestCM053KeyedCompatStreamFrameBounds(t *testing.T) {
+	key := cm053KeyedKeys[len(cm053KeyedKeys)-1]
+	run := func(t *testing.T, body string) cm053StreamOutcome {
+		t.Helper()
+		s := cm053NewSinks(t, cm053KeyedStatic(http.StatusOK, http.Header{"Content-Type": {"text/event-stream"}}, body), false)
