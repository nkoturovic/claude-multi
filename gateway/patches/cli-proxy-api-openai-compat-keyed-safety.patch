diff --git a/internal/runtime/executor/openai_compat_keyed_safety.go b/internal/runtime/executor/openai_compat_keyed_safety.go
new file mode 100644
index 0000000..1803768
--- /dev/null
+++ b/internal/runtime/executor/openai_compat_keyed_safety.go
@@ -0,0 +1,291 @@
+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/compatsafe"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/upstreamredirect"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	log "github.com/sirupsen/logrus"
+)
+
+// Keyed OpenAI-compatible chat safety.
+//
+// The keyed chat route is a chat-completions request (non-stream Execute
+// outside the genuine responses/compact branch, and every ExecuteStream,
+// which always targets /chat/completions) whose prepared request carries a
+// credential: exactly the requests the credentialed-redirect policy puts in
+// RefuseAll mode (an api_key, a configured custom header, URL userinfo or a
+// query, or any header outside the credentialless set). The inbound source
+// format does not matter. On that route every failure is rebuilt by
+// package compatsafe from local data only, and nothing an upstream sends
+// reaches diagnostics, response capture, usage records or the returned error
+// before it is classified:
+//
+//   - response metadata is normalized (compatsafe.ResponseHeaders) before it
+//     is recorded, and the same normalized headers are returned with a
+//     success or an initial stream;
+//   - a failure body is read through a 64 KiB + 1 byte overflow detector and
+//     becomes a fixed compatsafe.Error; the existing Retry-After / TPM
+//     parsing runs on the raw input first and only its typed duration is
+//     kept;
+//   - a 2xx body is validated and classified (compatsafe.Inspect: exactly
+//     one duplicate-free JSON object that is not an error envelope, or a
+//     fixed failure) before capture, model/usage observation and
+//     translation;
+//   - an SSE frame is validated and classified the same way when it is
+//     complete, before capture and observation; comment, id, retry and event
+//     fields are never captured; an error event still pending at EOF is a
+//     fixed failure, never a synthesized completion;
+//     one frame holds at most compatsafe.MaxStreamFrameBytes in
+//     compatsafe.MaxStreamFrameLines lines of any field;
+//   - transport, read, scanner and close errors keep only their trusted
+//     identity (context cancellation/deadline, EOF, the redirect refusal);
+//   - request diagnostics redact the credential by name, never by
+//     prefix/suffix masking.
+//
+// Keyless chat, images, the genuine non-stream compact request and the
+// generic HttpRequest API keep upstream behaviour: they are outside the
+// route-scoped promise.
+
+// openAICompatKeyedStreamLimits are the keyed stream bounds (a variable
+// only so the gates can lower them).
+var openAICompatKeyedStreamLimits = struct{ line, frameBytes, frameLines int }{
+	line:       compatsafe.MaxStreamLine,
+	frameBytes: compatsafe.MaxStreamFrameBytes,
+	frameLines: compatsafe.MaxStreamFrameLines,
+}
+
+// openAICompatKeyedRoute reports whether the prepared chat request req is on
+// the keyed route.
+func openAICompatKeyedRoute(auth *cliproxyauth.Auth, req *http.Request) bool {
+	return openAICompatRequestRedirectMode(auth, req) == upstreamredirect.RefuseAll
+}
+
+// openAICompatKeyedRequestLog redacts the credential of a keyed request for
+// the request log: no auth value and no auth ID (a compat auth ID is a short
+// hash over the key), a URL without userinfo or query, and every header
+// outside the credentialless set replaced by a fixed marker. Names (the
+// provider label, header names) stay.
+func openAICompatKeyedRequestLog(info helps.UpstreamRequestLog) helps.UpstreamRequestLog {
+	info.URL = compatsafe.RequestURL(info.URL)
+	info.Headers = compatsafe.RequestHeaders(info.Headers, openAICompatCredentiallessHeaders)
+	info.AuthID = ""
+	info.AuthValue = ""
+	return info
+}
+
+// openAICompatKeyedTransportError keeps only the trusted identity of a
+// transport, read or scanner error of the keyed route.
+func openAICompatKeyedTransportError(err error) error {
+	return compatsafe.Transport(err, upstreamredirect.IsRefused)
+}
+
+// closeOpenAICompatBody closes an upstream body; on the keyed route a close
+// error is logged in its safe form only.
+func closeOpenAICompatBody(body io.Closer, keyed bool) {
+	errClose := body.Close()
+	if errClose == nil {
+		return
+	}
+	if keyed {
+		errClose = openAICompatKeyedTransportError(errClose)
+	}
+	log.Errorf("openai compat executor: close response body error: %v", errClose)
+}
+
+// openAICompatKeyedHTTPFailure turns a non-2xx keyed response into its safe
+// failure. The typed retry metadata is parsed from the raw headers and body
+// before they are dropped; only the fixed representation is captured.
+func openAICompatKeyedHTTPFailure(ctx context.Context, cfg *config.Config, resp *http.Response) error {
+	body, overflow, readable := compatsafe.ReadErrorBody(resp.Body)
+	retryBody := body
+	if overflow || !readable {
+		retryBody = nil
+	}
+	retry := openAICompatRetryAfter(resp.StatusCode, resp.Header, retryBody, time.Now())
+	failure := compatsafe.HTTPFailure(resp.StatusCode, body, overflow, readable, retry)
+	helps.AppendAPIResponseChunk(ctx, cfg, []byte(failure.Error()))
+	helps.LogWithRequestID(ctx).Debugf("request error, error status: %d, failure kind: %s", failure.StatusCode(), failure.Kind)
+	return failure
+}
+
+// openAICompatKeyedBodyFailure validates and classifies a keyed 2xx body
+// before it is captured, observed or translated: only a strictly decoded,
+// non-error JSON object passes (see compatsafe.Inspect).
+func openAICompatKeyedBodyFailure(body []byte) (compatsafe.Error, bool) {
+	return compatsafe.Inspect(body, false)
+}
+
+// openAICompatKeyedStream runs the keyed chat stream: it classifies every
+// complete SSE frame before any capture or observation and returns only
+// safe failures. translate converts one "data: <payload>" line.
+func (e *OpenAICompatExecutor) openAICompatKeyedStream(ctx context.Context, body io.ReadCloser, reporter *helps.UsageReporter, responseFormat sdktranslator.Format, translate func(line []byte) [][]byte) <-chan cliproxyexecutor.StreamChunk {
+	out := make(chan cliproxyexecutor.StreamChunk)
+	limits := openAICompatKeyedStreamLimits
+	go func() {
+		defer close(out)
+		defer closeOpenAICompatBody(body, true)
+		scanner := bufio.NewScanner(body)
+		scanner.Buffer(nil, limits.line)
+		var streamUsage helps.StreamUsageBuffer
+		var seenDone, streamFailed, streamAborted bool
+		var upstreamEvent string
+		var frameData [][]byte
+		var frameBytes, frameLines int
+		defer streamUsage.Publish(ctx, reporter)
+
+		fail := func(streamErr error) {
+			helps.RecordAPIResponseError(ctx, e.cfg, streamErr)
+			reporter.PublishFailure(ctx, streamErr)
+			select {
+			case out <- cliproxyexecutor.StreamChunk{Err: streamErr}:
+			case <-ctx.Done():
+			}
+			streamFailed = true
+		}
+		failKind := func(kind compatsafe.Kind) {
+			fail(compatsafe.NewError(kind, http.StatusBadGateway, nil))
+		}
+
+		processFrame := func() bool {
+			errorEvent := openAICompatErrorEvent(upstreamEvent)
+			upstreamEvent = ""
+			dataLines := frameData
+			frameData = nil
+			frameBytes, frameLines = 0, 0
+			if len(dataLines) == 0 {
+				if errorEvent {
+					failKind(compatsafe.KindStreamErrorEventNoData)
+					return true
+				}
+				return false
+			}
+			if len(dataLines) > 1 {
+				for _, dataLine := range dataLines {
+					if bytes.Equal(dataLine, []byte("[DONE]")) {
+						failKind(compatsafe.KindStreamIncompleteBeforeDone)
+						return true
+					}
+				}
+			}
+			dataPayload := bytes.TrimSpace(bytes.Join(dataLines, []byte("\n")))
+			isDone := bytes.Equal(dataPayload, []byte("[DONE]"))
+			switch {
+			case isDone && errorEvent:
+				failKind(compatsafe.KindStreamErrorEventBeforeDone)
+				return true
+			case !isDone && !json.Valid(dataPayload):
+				failKind(compatsafe.KindStreamIncompleteFrame)
+				return true
+			case !isDone:
+				if failure, failed := compatsafe.Inspect(dataPayload, errorEvent); failed {
+					fail(failure)
+					return true
+				}
+			}
+
+			// The frame is classified: only now is it captured and observed.
+			streamLine := append([]byte("data: "), dataPayload...)
+			helps.AppendAPIResponseChunk(ctx, e.cfg, streamLine)
+			if !isDone {
+				reporter.ObserveResponseModel(streamLine)
+				streamUsage.ObserveOpenAIStream(streamLine)
+			}
+			for _, chunk := range translate(streamLine) {
+				select {
+				case out <- cliproxyexecutor.StreamChunk{Payload: chunk}:
+				case <-ctx.Done():
+					streamAborted = true
+					return true
+				}
+			}
+			if isDone {
+				seenDone = true
+				return true
+			}
+			return false
+		}
+
+	scanLoop:
+		for scanner.Scan() {
+			trimmedLine := bytes.TrimSpace(scanner.Bytes())
+			if len(trimmedLine) > 0 {
+				// Every line of a frame counts toward its bounds, whatever the
+				// field (data, event, id, retry, comments, unknown lines), and
+				// the bound is enforced before anything of the line is retained.
+				frameLines++
+				frameBytes += len(trimmedLine)
+				if frameLines > limits.frameLines || frameBytes > limits.frameBytes {
+					failKind(compatsafe.KindStreamFrameTooLarge)
+					break scanLoop
+				}
+			}
+			switch {
+			case len(trimmedLine) == 0:
+				if processFrame() {
+					break scanLoop
+				}
+			case bytes.HasPrefix(trimmedLine, []byte("data:")):
+				data := bytes.TrimSpace(trimmedLine[len("data:"):])
+				frameData = append(frameData, bytes.Clone(data))
+			case bytes.HasPrefix(trimmedLine, []byte("event:")):
+				upstreamEvent = strings.TrimSpace(string(trimmedLine[len("event:"):]))
+			case bytes.HasPrefix(trimmedLine, []byte("{")) || bytes.HasPrefix(trimmedLine, []byte("[")):
+				failKind(compatsafe.PayloadFailure(trimmedLine).Kind)
+				break scanLoop
+			default:
+				// Comments, id:, retry: and unknown lines are neither
+				// captured nor observed.
+			}
+		}
+		errScan := scanner.Err()
+		// A frame still pending at EOF is classified: its data lines, or an
+		// error event without data (which must not become a synthesized
+		// completion).
+		if errScan == nil && !seenDone && !streamFailed && !streamAborted && (len(frameData) > 0 || upstreamEvent != "") {
+			_ = processFrame()
+		}
+		if streamFailed || streamAborted {
+			return
+		}
+		if errScan != nil {
+			if errors.Is(errScan, bufio.ErrTooLong) {
+				failKind(compatsafe.KindStreamFrameTooLarge)
+			} else {
+				fail(openAICompatKeyedTransportError(errScan))
+			}
+			return
+		}
+		if !seenDone {
+			// Responses clients require an explicit terminal event; other
+			// protocols keep the compatibility [DONE] for providers that omit it.
+			if responseFormat == sdktranslator.FormatOpenAIResponse {
+				failKind(compatsafe.KindStreamClosedBeforeDone)
+				return
+			}
+			for _, chunk := range translate([]byte("data: [DONE]")) {
+				select {
+				case out <- cliproxyexecutor.StreamChunk{Payload: chunk}:
+				case <-ctx.Done():
+					return
+				}
+			}
+		}
+		streamUsage.Publish(ctx, reporter)
+		reporter.EnsurePublished(ctx)
+	}()
+	return out
+}
diff --git a/internal/runtime/executor/openai_compat_keyed_safety_cm053_test.go b/internal/runtime/executor/openai_compat_keyed_safety_cm053_test.go
new file mode 100644
index 0000000..a87da20
--- /dev/null
+++ b/internal/runtime/executor/openai_compat_keyed_safety_cm053_test.go
@@ -0,0 +1,1257 @@
+package executor
+
+// Keyed OpenAI-compatible chat safety gates.
+//
+// Every upstream is an injected RoundTripper ("cliproxy.roundtripper"); no
+// socket is opened. Each scenario runs with every sink the gateway has:
+// the returned error and stream chunks, the returned headers, the
+// request-log capture (gin context keys, request logging on, commercial mode
+// off, the disposable debug configuration) or the production configuration
+// (commercial mode on, request logging off), the response-header metadata
+// holder, logrus output at debug level, and the usage records. A synthetic
+// credential (short and long) and a provider canary are echoed by the
+// upstream in every shape the gate names; neither may reach any sink.
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/clienterror"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/compatsafe"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/logging"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/usage"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	cm053KeyedCanary  = "cm053-provider-canary"
+	cm053KeyedBaseURL = "https://compat.cm053.invalid/v1"
+)
+
+// cm053KeyedKeys are synthetic credentials: two short keys (HideAPIKey keeps
+// a 2-character key unchanged and shows the ends of a 3-character one) and a
+// long one.
+var cm053KeyedKeys = []string{"Zq", "Zq9", "sk-cm053-LongSyntheticSecret-0123456789abcdef"}
+
+// cm053Needles are the strings that must never reach a sink for key: the key
+// itself, its JSON-escaped, base64 and URL-encoded echoes, and the canary.
+func cm053Needles(key string) []string {
+	var escaped strings.Builder
+	for _, r := range key {
+		fmt.Fprintf(&escaped, `\u%04x`, r)
+	}
+	return []string{key, escaped.String(), base64.StdEncoding.EncodeToString([]byte(key)), url.QueryEscape(key), cm053KeyedCanary}
+}
+
+type cm053KeyedUpstream func(*http.Request) (*http.Response, error)
+
+func (f cm053KeyedUpstream) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Body != nil {
+		_, _ = io.Copy(io.Discard, req.Body)
+		_ = req.Body.Close()
+	}
+	return f(req)
+}
+
+func cm053KeyedResponse(req *http.Request, status int, header http.Header, body io.ReadCloser) *http.Response {
+	if header == nil {
+		header = http.Header{}
+	}
+	return &http.Response{StatusCode: status, Status: fmt.Sprintf("%d %s", status, http.StatusText(status)), Header: header, Body: body, Request: req, ProtoMajor: 1, ProtoMinor: 1}
+}
+
+func cm053KeyedStatic(status int, header http.Header, body string) cm053KeyedUpstream {
+	return func(req *http.Request) (*http.Response, error) {
+		return cm053KeyedResponse(req, status, header.Clone(), io.NopCloser(strings.NewReader(body))), nil
+	}
+}
+
+// cm053FaultBody yields its data, then fails the next read with readErr
+// (nil: io.EOF), and fails Close with closeErr.
+type cm053FaultBody struct {
+	data     *strings.Reader
+	readErr  error
+	closeErr error
+}
+
+func (b *cm053FaultBody) Read(p []byte) (int, error) {
+	if b.data.Len() > 0 {
+		return b.data.Read(p)
+	}
+	if b.readErr != nil {
+		return 0, b.readErr
+	}
+	return 0, io.EOF
+}
+
+func (b *cm053FaultBody) Close() error { return b.closeErr }
+
+type cm053UsageSink struct {
+	alias   string
+	mu      sync.Mutex
+	records []coreusage.Record
+}
+
+func (s *cm053UsageSink) HandleUsage(_ context.Context, record coreusage.Record) {
+	if record.Alias != s.alias {
+		return
+	}
+	s.mu.Lock()
+	s.records = append(s.records, record)
+	s.mu.Unlock()
+}
+
+type cm053NoopUsage struct{}
+
+func (cm053NoopUsage) HandleUsage(context.Context, coreusage.Record) {}
+
+// cm053Sinks is every place an upstream failure could surface.
+type cm053Sinks struct {
+	ctx   context.Context
+	cfg   *config.Config
+	gin   *gin.Context
+	logs  *cm053LogBuffer
+	usage *cm053UsageSink
+}
+
+type cm053LogBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *cm053LogBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *cm053LogBuffer) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
+
+var cm053SinkSeq struct {
+	mu sync.Mutex
+	n  int
+}
+
+// cm053NewSinks wires the sinks for one scenario. production selects commercial
+// mode with request logging off; otherwise request logging is on and commercial
+// mode off (the disposable debug configuration). logrus runs at debug level
+// either way.
+func cm053NewSinks(t *testing.T, upstream http.RoundTripper, production bool) *cm053Sinks {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ginCtx.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+	cm053SinkSeq.mu.Lock()
+	cm053SinkSeq.n++
+	alias := fmt.Sprintf("cm053-keyed-alias-%d", cm053SinkSeq.n)
+	cm053SinkSeq.mu.Unlock()
+	usage := &cm053UsageSink{alias: alias}
+	coreusage.RegisterNamedPlugin("cm053-keyed-usage", usage)
+	t.Cleanup(func() { coreusage.RegisterNamedPlugin("cm053-keyed-usage", cm053NoopUsage{}) })
+
+	ctx := context.WithValue(context.Background(), "gin", ginCtx)
+	ctx = logging.WithResponseHeadersHolder(ctx)
+	ctx = coreusage.WithRequestedModelAlias(ctx, alias)
+	ctx = context.WithValue(ctx, "cliproxy.roundtripper", upstream)
+
+	cfg := &config.Config{}
+	if production {
+		cfg.CommercialMode = true
+	} else {
+		cfg.RequestLog = true
+	}
+
+	logs := &cm053LogBuffer{}
+	previousOut, previousLevel := log.StandardLogger().Out, log.GetLevel()
+	log.SetOutput(logs)
+	log.SetLevel(log.DebugLevel)
+	t.Cleanup(func() {
+		log.SetOutput(previousOut)
+		log.SetLevel(previousLevel)
+	})
+	return &cm053Sinks{ctx: ctx, cfg: cfg, gin: ginCtx, logs: logs, usage: usage}
+}
+
+// awaitUsage waits for the scenario's usage record.
+func (s *cm053Sinks) awaitUsage(t *testing.T) []coreusage.Record {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		s.usage.mu.Lock()
+		records := append([]coreusage.Record(nil), s.usage.records...)
+		s.usage.mu.Unlock()
+		if len(records) > 0 {
+			return records
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for the usage record")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// text renders every sink (plus the client-visible text) for absence checks.
+func (s *cm053Sinks) text(t *testing.T, client string) map[string]string {
+	t.Helper()
+	out := map[string]string{"client": client, "logs": s.logs.String()}
+	for key, value := range s.gin.Keys {
+		switch v := value.(type) {
+		case []byte:
+			out["gin:"+key] = string(v)
+		default:
+			out["gin:"+key] = fmt.Sprintf("%+v", v)
+		}
+	}
+	out["response-header-metadata"] = fmt.Sprintf("%v", logging.GetResponseHeaders(s.ctx))
+	out["usage"] = fmt.Sprintf("%+v", s.awaitUsage(t))
+	return out
+}
+
+func (s *cm053Sinks) assertAbsent(t *testing.T, client string, needles ...string) {
+	t.Helper()
+	for sink, text := range s.text(t, client) {
+		for _, needle := range needles {
+			if needle != "" && strings.Contains(text, needle) {
+				t.Fatalf("sink %s contains %q:\n%s", sink, needle, text)
+			}
+		}
+	}
+}
+
+func (s *cm053Sinks) captured() string {
+	value, _ := s.gin.Get("API_RESPONSE")
+	raw, _ := value.([]byte)
+	return string(raw)
+}
+
+func cm053KeyedAuth(key string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{
+		ID:       "cm053-keyed-auth",
+		Provider: "openai-compatibility",
+		Attributes: map[string]string{
+			"base_url":    cm053KeyedBaseURL,
+			"api_key":     key,
+			"compat_name": "cm053-compat",
+		},
+	}
+}
+
+func cm053KeylessAuth() *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{
+		ID:         "cm053-keyless-auth",
+		Provider:   "openai-compatibility",
+		Attributes: map[string]string{"base_url": cm053KeyedBaseURL, "compat_name": "cm053-compat"},
+	}
+}
+
+func cm053KeyedRequest(format sdktranslator.Format, stream bool) (cliproxyexecutor.Request, cliproxyexecutor.Options) {
+	var payload string
+	switch format {
+	case sdktranslator.FormatClaude:
+		payload = `{"model":"cm053-model","max_tokens":16,"messages":[{"role":"user","content":"hi"}]`
+	case sdktranslator.FormatOpenAIResponse:
+		payload = `{"model":"cm053-model","input":"hi"`
+	default:
+		payload = `{"model":"cm053-model","messages":[{"role":"user","content":"hi"}]`
+	}
+	payload += fmt.Sprintf(`,"stream":%t}`, stream)
+	return cliproxyexecutor.Request{Model: "cm053-model", Payload: []byte(payload)},
+		cliproxyexecutor.Options{SourceFormat: format, OriginalRequest: []byte(payload), Stream: stream}
+}
+
+type cm053StreamOutcome struct {
+	bootErr   error
+	headers   http.Header
+	payload   string
+	streamErr error
+	afterErr  int
+}
+
+func (o cm053StreamOutcome) client() string {
+	return fmt.Sprintf("%v|%+v|%v|%s|%v", o.bootErr, o.bootErr, o.headers, o.payload, o.streamErr)
+}
+
+func cm053RunStream(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth, format sdktranslator.Format, alt string) cm053StreamOutcome {
+	t.Helper()
+	executor := NewOpenAICompatExecutor("openai-compatibility", s.cfg)
+	req, opts := cm053KeyedRequest(format, true)
+	opts.Alt = alt
+	result, err := executor.ExecuteStream(s.ctx, auth, req, opts)
+	if err != nil {
+		return cm053StreamOutcome{bootErr: err}
+	}
+	outcome := cm053StreamOutcome{headers: result.Headers}
+	var payload strings.Builder
+	for chunk := range result.Chunks {
+		if outcome.streamErr != nil {
+			outcome.afterErr++
+		}
+		if chunk.Err != nil {
+			outcome.streamErr = chunk.Err
+			continue
+		}
+		payload.Write(chunk.Payload)
+	}
+	outcome.payload = payload.String()
+	return outcome
+}
+
+func cm053RunExecute(t *testing.T, s *cm053Sinks, auth *cliproxyauth.Auth, format sdktranslator.Format, alt string) (cliproxyexecutor.Response, error) {
+	t.Helper()
+	executor := NewOpenAICompatExecutor("openai-compatibility", s.cfg)
+	req, opts := cm053KeyedRequest(format, false)
+	opts.Alt = alt
+	return executor.Execute(s.ctx, auth, req, opts)
+}
+
+func cm053AsSafe(t *testing.T, err error) compatsafe.Error {
+	t.Helper()
+	safe, ok := err.(compatsafe.Error)
+	if !ok {
+		t.Fatalf("error = %T %v, want the fixed compatsafe.Error", err, err)
+	}
+	if safe.Error() != safe.Kind.Body() {
+		t.Fatalf("error text %q is not the fixed body of %s", safe.Error(), safe.Kind)
+	}
+	return safe
+}
+
+// cm053ErrorBodies are the echo shapes of an upstream failure body.
+func cm053ErrorBodies(key string) map[string]struct {
+	contentType string
+	body        string
+} {
+	escaped := cm053Needles(key)[1]
+	huge := strings.Repeat("x", compatsafe.MaxErrorBody)
+	return map[string]struct {
+		contentType string
+		body        string
+	}{
+		"json":            {"application/json", fmt.Sprintf(`{"error":{"message":"invalid key %s %s","type":"%s","code":"%s","param":"%s"}}`, key, cm053KeyedCanary, key, key, key)},
+		"text":            {"text/plain", fmt.Sprintf("bad key %s %s", key, cm053KeyedCanary)},
+		"html":            {"text/html", fmt.Sprintf("<html><body><h1>%s</h1><p>%s</p></body></html>", key, cm053KeyedCanary)},
+		"escaped-json":    {"application/json", fmt.Sprintf(`{"error":{"message":"key %s %s"}}`, escaped, cm053KeyedCanary)},
+		"base64-and-url":  {"application/json", fmt.Sprintf(`{"error":{"message":"b64 %s url %s %s"}}`, base64.StdEncoding.EncodeToString([]byte(key)), url.QueryEscape(key), cm053KeyedCanary)},
+		"model-field":     {"application/json", fmt.Sprintf(`{"model":"%s","error":{"message":"%s"}}`, key, cm053KeyedCanary)},
+		"overflow-prefix": {"application/json", fmt.Sprintf(`{"error":{"message":"%s %s %s"}}`, key, cm053KeyedCanary, huge)},
+		"overflow-suffix": {"text/plain", huge + key + cm053KeyedCanary},
+	}
+}
+
+func TestCM053KeyedCompatHTTPErrorSafe(t *testing.T) {
+	for _, key := range cm053KeyedKeys {
+		for name, shape := range cm053ErrorBodies(key) {
+			for _, status := range []int{400, 401, 404, 429, 500, 503} {
+				for _, stream := range []bool{false, true} {
+					t.Run(fmt.Sprintf("key%d/%s/%d/stream=%t", len(key), name, status, stream), func(t *testing.T) {
+						header := http.Header{"Content-Type": {shape.contentType}, "X-Echo": {key + " " + cm053KeyedCanary}}
+						s := cm053NewSinks(t, cm053KeyedStatic(status, header, shape.body), false)
+						var err error
+						var client string
+						if stream {
+							outcome := cm053RunStream(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+							err, client = outcome.bootErr, outcome.client()
+						} else {
+							var resp cliproxyexecutor.Response
+							resp, err = cm053RunExecute(t, s, cm053KeyedAuth(key), sdktranslator.FormatOpenAI, "")
+							client = fmt.Sprintf("%v|%+v|%s|%v", err, err, resp.Payload, resp.Headers)
+						}
+						safe := cm053AsSafe(t, err)
+						if safe.StatusCode() != status {
+							t.Fatalf("status = %d, want %d", safe.StatusCode(), status)
+						}
+						if strings.HasPrefix(name, "overflow") && safe.Kind != compatsafe.KindErrorBodyTooLarge && safe.Kind != compatsafe.KindRateLimited {
+							t.Fatalf("overflowing body kind = %s, want %s", safe.Kind, compatsafe.KindErrorBodyTooLarge)
+						}
+						if got := s.captured(); !strings.Contains(got, safe.Kind.Message()) {
+							t.Fatalf("captured response %q lacks the fixed representation %q", got, safe.Kind.Message())
+						}
+						s.assertAbsent(t, client, cm053Needles(key)...)
+					})
+				}
+			}
+		}
+	}
+}
