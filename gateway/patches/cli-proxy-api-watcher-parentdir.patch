+	if got := f.logs.count(logReloadApplied); got != 1 {
+		t.Fatalf("config reloads applied = %d, want 1 (only the restored config)", got)
+	}
+}
+
+func TestConfigReloadRefusesDroppingEveryAPIKey(t *testing.T) {
+	running := []string{"old-key"}
+	f := startConfigDirWatcher(t, running)
+	authDir := fmt.Sprintf("auth-dir: %q\n", f.authDir)
+	for i, tc := range []struct {
+		name string
+		body string
+	}{
+		{"empty list", authDir + "port: 2\napi-keys: []\n"},
+		{"key absent", authDir + "port: 3\n"},
+		{"blank entries only", authDir + "port: 4\napi-keys:\n  - \"\"\n  - \"   \"\n"},
+		{"comment only", "# api-keys removed\n"},
+		{"null document", "~\n"},
+	} {
+		renameReplace(t, f.cfgPath, []byte(tc.body))
+		f.waitLog(logAPIKeyRefusal, i+1)
+		f.expectNoCallbackYet(tc.name)
+		f.expectRunning(1, running)
+	}
+	// Refusing keeps the watch and the guard state intact: a keyed config applies.
+	renameReplace(t, f.cfgPath, f.render(6, []string{"old-key", "new-key"}))
+	f.expectReload(6, []string{"old-key", "new-key"})
+	f.expectRunning(6, []string{"old-key", "new-key"})
+	f.expectNotScheduled("after the accepted reload")
+	if got := f.logs.count(logReloadApplied); got != 1 {
+		t.Fatalf("config reloads applied = %d, want 1 (only the keyed config)", got)
+	}
+}
+
+func TestConfigReloadAppliesAPIKeyRotation(t *testing.T) {
+	f := startConfigDirWatcher(t, []string{"key-1"})
+	for i, keys := range [][]string{
+		{"key-2"},          // old -> new
+		{"key-2", "key-3"}, // dual-key window
+		{"key-3"},          // [old,new] -> [new]
+	} {
+		port := 2 + i
+		renameReplace(t, f.cfgPath, f.render(port, keys))
+		f.expectReload(port, keys)
+		f.expectRunning(port, keys)
+	}
+	f.expectNotScheduled("after the rotation")
+	if got := f.logs.count(logAPIKeyRefusal); got != 0 {
+		t.Fatalf("api-key refusal logged %d times during a normal rotation", got)
+	}
+	if got := f.logs.count(logReloadApplied); got != 3 {
+		t.Fatalf("config reloads applied = %d, want 3", got)
+	}
+}
