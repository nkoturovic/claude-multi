+// notifyLatestConfig selects the current config only after acquiring the same
+// transaction lock as file reloads. A delayed auth notification must not apply
+// the caller's captured (and possibly retired) credentials.
+func (w *Watcher) notifyLatestConfig() {
+	w.configApplyMu.Lock()
+	defer w.configApplyMu.Unlock()
+	w.clientsMutex.RLock()
+	cfg := w.config
