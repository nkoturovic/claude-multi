+
+// Manual triggers avoid scheduler/debounce races in the regression itself.
+func transactionWatcher(t *testing.T, callback func(*config.Config)) (*Watcher, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	path := filepath.Join(root, "config.yaml")
+	authDir := filepath.Join(root, "auth")
+	if err := os.Mkdir(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	w, err := NewWatcher(path, authDir, callback)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = w.Stop() })
+	w.SetConfig(&config.Config{Port: 1, AuthDir: authDir, SDKConfig: config.SDKConfig{APIKeys: []string{"old"}}})
+	return w, path, authDir
+}
+
+func transactionBody(authDir string, port int, keys []string) []byte {
+	cfg := &configDirWatchFixture{authDir: authDir}
+	return cfg.render(port, keys)
+}
+
+func waitTransaction(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(configWatchEventTimeout):
+		t.Fatal("config transaction did not finish")
+	}
+}
+
+type replaceBetweenHashAndParse struct {
+	once sync.Once
+	path string
+	body []byte
+	err  error
+}
+
+func (h *replaceBetweenHashAndParse) Levels() []log.Level { return []log.Level{log.InfoLevel} }
+func (h *replaceBetweenHashAndParse) Fire(entry *log.Entry) error {
+	if strings.HasPrefix(entry.Message, "config file changed, reloading:") {
+		h.once.Do(func() { h.err = atomicReplace(h.path, h.body) })
+	}
+	return nil
+}
+
+func TestConfigTransactionHashAndParserUseOneSnapshot(t *testing.T) {
+	ports := []int{}
+	w, path, authDir := transactionWatcher(t, func(c *config.Config) { ports = append(ports, c.Port) })
+	b := transactionBody(authDir, 2, []string{"old", "new"})
+	c := transactionBody(authDir, 3, []string{"new"})
+	renameReplace(t, path, b)
+	// This log is after the hash read but before parsing: replace the path
+	// synchronously there, rather than hoping a goroutine wins a tiny window.
+	installLogCapture(t)
+	hook := &replaceBetweenHashAndParse{path: path, body: c}
+	log.AddHook(hook)
+	w.ReloadConfigIfChanged()
+	if hook.err != nil {
+		t.Fatal(hook.err)
+	}
+	if len(ports) != 1 || ports[0] != 2 {
+		t.Fatalf("applied ports=%v, want only snapshot B (2)", ports)
+	}
+	sum := sha256.Sum256(b)
+	if w.lastConfigHash != hex.EncodeToString(sum[:]) {
+		t.Fatal("hash does not describe applied snapshot B")
+	}
+	// Restoring B must be a genuine no-op, not an incorrectly skipped repair
+	// of C (the double-read regression).
+	renameReplace(t, path, b)
+	w.ReloadConfigIfChanged()
+	if len(ports) != 1 || w.config.Port != 2 {
+		t.Fatal("restored B did not converge")
+	}
+	renameReplace(t, path, c)
+	w.ReloadConfigIfChanged()
+	if len(ports) != 2 || ports[1] != 3 {
+		t.Fatalf("subsequent C not applied: %v", ports)
+	}
+}
+
+func TestConfigTransactionSerializesStartupAndReloadCallbacks(t *testing.T) {
+	for _, startup := range []bool{false, true} {
+		name := "reload"
+		if startup {
+			name = "startup"
+		}
+		t.Run(name, func(t *testing.T) {
+			entered, release := make(chan struct{}), make(chan struct{})
+			var releaseOnce sync.Once
+			unblock := func() { releaseOnce.Do(func() { close(release) }) }
+			t.Cleanup(unblock)
+			var w *Watcher
+			var mu sync.Mutex
+			var applied []int
+			callback := func(c *config.Config) {
+				// A deterministic assertion of exclusion while this callback
+				// is suspended; no sleep-based negative observation needed.
+				if w.configApplyMu.TryLock() {
+					w.configApplyMu.Unlock()
+					t.Error("callback is outside config application transaction")
+				}
+				if c.Port == 2 {
+					close(entered)
+					<-release
+				}
+				mu.Lock()
+				applied = append(applied, c.Port)
+				mu.Unlock()
+			}
+			var path, authDir string
+			w, path, authDir = transactionWatcher(t, callback)
+			dual := transactionBody(authDir, 2, []string{"old", "new"})
+			single := transactionBody(authDir, 3, []string{"new"})
+			renameReplace(t, path, dual)
+			if startup {
+				cfg, err := config.LoadConfigBytes(dual)
+				if err != nil {
+					t.Fatal(err)
+				}
+				w.SetConfig(cfg)
+			}
+			first, second := make(chan struct{}), make(chan struct{})
+			go func() {
+				defer close(first)
+				if startup {
+					w.reloadClients(true, nil, false)
+				} else {
+					w.ReloadConfigIfChanged()
+				}
+			}()
+			waitTransaction(t, entered)
+			renameReplace(t, path, single)
+			go func() { defer close(second); w.ReloadConfigIfChanged() }()
+			unblock()
+			waitTransaction(t, first)
+			waitTransaction(t, second)
+			mu.Lock()
+			defer mu.Unlock()
+			if len(applied) != 2 || applied[0] != 2 || applied[1] != 3 {
+				t.Fatalf("callbacks applied out of order: %v", applied)
+			}
+			if !sameKeys(w.config.APIKeys, []string{"new"}) {
+				t.Fatal("retired key returned")
+			}
+			sum := sha256.Sum256(single)
+			if w.lastConfigHash != hex.EncodeToString(sum[:]) {
+				t.Fatal("final hash is not single-key snapshot")
+			}
+		})
+	}
+}
+
+func TestConfigTransactionAuthCallbackUsesCurrentConfig(t *testing.T) {
+	var applied []int
+	var w *Watcher
+	w, path, authDir := transactionWatcher(t, func(c *config.Config) {
+		if w.configApplyMu.TryLock() {
+			w.configApplyMu.Unlock()
+			t.Error("auth callback not serialized")
+		}
+		applied = append(applied, c.Port)
+	})
+	old := w.config
+	renameReplace(t, path, transactionBody(authDir, 3, []string{"new"}))
+	w.ReloadConfigIfChanged()
+	w.triggerServerUpdate(old)
+	if len(applied) != 2 || applied[0] != 3 || applied[1] != 3 {
+		t.Fatalf("delayed auth callback restored stale config: %v", applied)
+	}
+}
+
+func TestConfigDirWatchRejectsSymlinkConfig(t *testing.T) {
+	w, path, authDir := transactionWatcher(t, nil)
+	target := path + ".target"
+	renameReplace(t, target, transactionBody(authDir, 2, []string{"old"}))
+	if err := os.Symlink(target, path); err != nil {
+		t.Fatal(err)
+	}
+	// start rejects before any event processor or callback can run.
+	if err := w.start(nil); err == nil || !strings.Contains(err.Error(), "regular file") {
+		t.Fatalf("symlink config must be explicitly refused: %v", err)
+	}
+}
