diff --git a/internal/watcher/config_dir_watch_test.go b/internal/watcher/config_dir_watch_test.go
new file mode 100644
--- /dev/null
+++ b/internal/watcher/config_dir_watch_test.go
@@ -0,0 +1,559 @@
+package watcher
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	log "github.com/sirupsen/logrus"
+)
+
+// These tests drive the real fsnotify watch with an atomic rename-replace:
+// a same-directory ".config.yaml.<rand>.tmp" temp file, fsync, rename over the
+// config, then a directory fsync (the writer pattern of claude-multi's
+// state.atomic_write).
+
+const (
+	// configWatchEventTimeout bounds every wait for an expected event; it is
+	// reached only when the expectation fails.
+	configWatchEventTimeout = 5 * time.Second
+	// configWatchQuietWindow is how long a negative check keeps listening for
+	// an unexpected reload after the event barrier (one debounce period plus
+	// margin for a reload that was already in flight).
+	configWatchQuietWindow = 2 * configReloadDebounce
+	// Log messages emitted by the reload guards.
+	logEmptyConfig   = "ignoring empty config file"
+	logMissingRead   = "failed to read config file for hash check"
+	logAPIKeyRefusal = "removes every api-key"
+	// Logged once per applied config reload.
+	logReloadApplied = "config successfully reloaded"
+)
+
+type reloadRecord struct {
+	port    int
+	apiKeys []string
+}
+
+type logCapture struct {
+	mu       sync.Mutex
+	messages []string
+}
+
+func (c *logCapture) Levels() []log.Level { return log.AllLevels }
+
+func (c *logCapture) Fire(entry *log.Entry) error {
+	c.mu.Lock()
+	c.messages = append(c.messages, entry.Message)
+	c.mu.Unlock()
+	return nil
+}
+
+func (c *logCapture) count(substr string) int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := 0
+	for _, message := range c.messages {
+		if strings.Contains(message, substr) {
+			n++
+		}
+	}
+	return n
+}
+
+func installLogCapture(t *testing.T) *logCapture {
+	t.Helper()
+	capture := &logCapture{}
+	logger := log.StandardLogger()
+	savedHooks := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		savedHooks[level] = append([]log.Hook(nil), hooks...)
+	}
+	savedLevel := logger.GetLevel()
+	logger.SetLevel(log.InfoLevel)
+	logger.AddHook(capture)
+	t.Cleanup(func() {
+		logger.ReplaceHooks(savedHooks)
+		logger.SetLevel(savedLevel)
+	})
+	return capture
+}
+
+type configDirWatchFixture struct {
+	t        *testing.T
+	w        *Watcher
+	cfgPath  string
+	authDir  string
+	reloads  chan reloadRecord
+	logs     *logCapture
+	barriers int
+}
+
+// startConfigDirWatcher starts a real watcher on <tmp>/cfg/config.yaml with an
+// auth dir <tmp>/auth, seeded with port 1 and the given api-keys.
+func startConfigDirWatcher(t *testing.T, apiKeys []string) *configDirWatchFixture {
+	t.Helper()
+	return startConfigDirWatcherWithHook(t, apiKeys, nil)
+}
+
+// startConfigDirWatcherWithHook is startConfigDirWatcher with a hook that runs
+// inside every reload callback, on the watcher's goroutine.
+func startConfigDirWatcherWithHook(t *testing.T, apiKeys []string, hook func(*configDirWatchFixture, reloadRecord)) *configDirWatchFixture {
+	t.Helper()
+	root := t.TempDir()
+	f := &configDirWatchFixture{
+		t:       t,
+		cfgPath: filepath.Join(root, "cfg", "config.yaml"),
+		authDir: filepath.Join(root, "auth"),
+		reloads: make(chan reloadRecord, 256),
+	}
+	f.logs = installLogCapture(t)
+	for _, dir := range []string{filepath.Dir(f.cfgPath), f.authDir} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatalf("mkdir %s: %v", dir, err)
+		}
+	}
+	if err := os.WriteFile(f.cfgPath, f.render(1, apiKeys), 0o600); err != nil {
+		t.Fatalf("seed config: %v", err)
+	}
+	running, err := config.LoadConfig(f.cfgPath)
+	if err != nil {
+		t.Fatalf("load seed config: %v", err)
+	}
+	w, err := NewWatcher(f.cfgPath, f.authDir, func(cfg *config.Config) {
+		record := reloadRecord{}
+		if cfg != nil {
+			record.port = cfg.Port
+			record.apiKeys = append([]string(nil), cfg.APIKeys...)
+		}
+		if hook != nil {
+			hook(f, record)
+		}
+		select {
+		case f.reloads <- record:
+		default:
+		}
+	})
+	if err != nil {
+		t.Fatalf("NewWatcher: %v", err)
+	}
+	f.w = w
+	w.SetConfig(running)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		_ = w.Stop()
+	})
+	if err = w.Start(ctx); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	// Start performs one initial client load, which invokes the callback.
+	f.expectReload(1, apiKeys)
+	return f
+}
+
+func (f *configDirWatchFixture) render(port int, apiKeys []string) []byte {
+	var b strings.Builder
+	fmt.Fprintf(&b, "auth-dir: %q\nport: %d\n", f.authDir, port)
+	if len(apiKeys) > 0 {
+		b.WriteString("api-keys:\n")
+		for _, key := range apiKeys {
+			fmt.Fprintf(&b, "  - %q\n", key)
+		}
+	}
+	return []byte(b.String())
+}
+
+// atomicReplace replaces target the way state.atomic_write does.
+func atomicReplace(target string, data []byte) error {
+	dir := filepath.Dir(target)
+	tmp, err := os.CreateTemp(dir, "."+filepath.Base(target)+".*.tmp")
+	if err != nil {
+		return fmt.Errorf("create temp: %w", err)
+	}
+	if err = tmp.Chmod(0o600); err == nil {
+		_, err = tmp.Write(data)
+	}
+	if err == nil {
+		err = tmp.Sync()
+	}
+	if errClose := tmp.Close(); err == nil {
+		err = errClose
+	}
+	if err == nil {
+		err = os.Rename(tmp.Name(), target)
+	}
+	if err != nil {
+		_ = os.Remove(tmp.Name())
+		return fmt.Errorf("replace %s: %w", target, err)
+	}
+	dirHandle, err := os.Open(dir)
+	if err != nil {
+		return fmt.Errorf("open dir: %w", err)
+	}
+	defer dirHandle.Close()
+	return dirHandle.Sync()
+}
+
+func renameReplace(t *testing.T, target string, data []byte) {
+	t.Helper()
+	if err := atomicReplace(target, data); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func sameKeys(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// expectReload waits for the next reload callback and checks what it applied.
+func (f *configDirWatchFixture) expectReload(wantPort int, wantKeys []string) {
+	f.t.Helper()
+	select {
+	case got := <-f.reloads:
+		if got.port != wantPort || !sameKeys(got.apiKeys, wantKeys) {
+			f.t.Fatalf("reload applied port=%d api-keys=%q, want port=%d api-keys=%q", got.port, got.apiKeys, wantPort, wantKeys)
+		}
+	case <-time.After(configWatchEventTimeout):
+		f.t.Fatalf("no reload within %s (want port=%d)", configWatchEventTimeout, wantPort)
+	}
+}
+
+// expectNoCallbackYet fails if any reload callback is queued right now.
+func (f *configDirWatchFixture) expectNoCallbackYet(context string) {
+	f.t.Helper()
+	select {
+	case got := <-f.reloads:
+		f.t.Fatalf("%s: unexpected reload applied port=%d api-keys=%q", context, got.port, got.apiKeys)
+	default:
+	}
+}
+
+// waitLog waits until at least want log messages contain substr.
+func (f *configDirWatchFixture) waitLog(substr string, want int) {
+	f.t.Helper()
+	deadline := time.Now().Add(configWatchEventTimeout)
+	for f.logs.count(substr) < want {
+		if time.Now().After(deadline) {
+			f.t.Fatalf("log %q seen %d times within %s, want %d", substr, f.logs.count(substr), configWatchEventTimeout, want)
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+}
+
+// barrier writes a file into the auth dir and waits until the watcher has
+// handled it. All watches share one inotify queue that is handled in order, so
+// every earlier event has been handled once the barrier is seen. It also
+// proves the auth-dir watch still works next to the config-dir watch.
+func (f *configDirWatchFixture) barrier() {
+	f.t.Helper()
+	f.barriers++
+	path := filepath.Join(f.authDir, fmt.Sprintf("barrier-%d.json", f.barriers))
+	if err := os.WriteFile(path, []byte("{}"), 0o600); err != nil {
+		f.t.Fatalf("write barrier: %v", err)
+	}
+	key := f.w.normalizeAuthPath(path)
+	deadline := time.Now().Add(configWatchEventTimeout)
+	for {
+		f.w.clientsMutex.RLock()
+		_, seen := f.w.lastAuthHashes[key]
+		f.w.clientsMutex.RUnlock()
+		if seen {
+			return
+		}
+		if time.Now().After(deadline) {
+			f.t.Fatalf("auth-dir barrier %s not handled within %s", filepath.Base(path), configWatchEventTimeout)
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+}
+
+// expectNotScheduled proves that no config reload was scheduled or applied for
+// the events so far.
+func (f *configDirWatchFixture) expectNotScheduled(context string) {
+	f.t.Helper()
+	f.barrier()
+	f.w.configReloadMu.Lock()
+	pending := f.w.configReloadTimer != nil
+	f.w.configReloadMu.Unlock()
+	if pending {
+		f.t.Fatalf("%s: a config reload was scheduled", context)
+	}
+	select {
+	case got := <-f.reloads:
+		f.t.Fatalf("%s: unexpected reload applied port=%d api-keys=%q", context, got.port, got.apiKeys)
+	case <-time.After(configWatchQuietWindow):
+	}
+}
+
+// expectRunning checks the watcher's running config.
+func (f *configDirWatchFixture) expectRunning(wantPort int, wantKeys []string) {
+	f.t.Helper()
+	f.w.clientsMutex.RLock()
+	defer f.w.clientsMutex.RUnlock()
+	if f.w.config == nil || f.w.config.Port != wantPort || !sameKeys(f.w.config.APIKeys, wantKeys) {
+		f.t.Fatalf("running config = %+v, want port=%d api-keys=%q", f.w.config, wantPort, wantKeys)
+	}
+}
+
+func TestConfigDirWatchReloadsOncePerRenameReplace(t *testing.T) {
+	f := startConfigDirWatcher(t, nil)
+	const replaces = 5
+	for i := 0; i < replaces; i++ {
+		port := 10 + i
+		renameReplace(t, f.cfgPath, f.render(port, nil))
+		// The next callback must be exactly this replace: a missing reload
+		// times out, and a duplicate of the previous one fails the port check.
+		f.expectReload(port, nil)
+	}
+	f.expectNotScheduled("after the last rename-replace")
+	f.expectRunning(10+replaces-1, nil)
+	if got := f.logs.count(logReloadApplied); got != replaces {
+		t.Fatalf("config reloads applied = %d, want %d (one per rename-replace)", got, replaces)
+	}
+}
+
+func TestConfigDirWatchReloadsWhileOldInodeHeldOpen(t *testing.T) {
+	f := startConfigDirWatcher(t, nil)
+	held, err := os.Open(f.cfgPath)
+	if err != nil {
+		t.Fatalf("open config: %v", err)
+	}
+	defer held.Close()
+	renameReplace(t, f.cfgPath, f.render(7, nil))
+	f.expectReload(7, nil)
+	renameReplace(t, f.cfgPath, f.render(8, nil))
+	f.expectReload(8, nil)
+	f.expectNotScheduled("with the replaced inode still open")
+	f.expectRunning(8, nil)
+	if got := f.logs.count(logReloadApplied); got != 2 {
+		t.Fatalf("config reloads applied = %d, want 2", got)
+	}
+}
+
+func TestConfigDirWatchReplaceDuringReloadIsApplied(t *testing.T) {
+	var once sync.Once
+	f := startConfigDirWatcherWithHook(t, nil, func(f *configDirWatchFixture, applied reloadRecord) {
+		if applied.port != 2 {
+			return
+		}
+		// The next render lands while the reload of port 2 is still running.
+		once.Do(func() {
+			if err := atomicReplace(f.cfgPath, f.render(3, nil)); err != nil {
+				f.t.Error(err)
+			}
+		})
+	})
+	renameReplace(t, f.cfgPath, f.render(2, nil))
+	f.expectReload(2, nil)
+	f.expectReload(3, nil)
+	f.expectNotScheduled("after the overlapping replace")
+	f.expectRunning(3, nil)
+	if got := f.logs.count(logReloadApplied); got != 2 {
+		t.Fatalf("config reloads applied = %d, want 2", got)
+	}
+}
+
+func TestConfigDirWatchRelativeConfigPath(t *testing.T) {
+	dir := t.TempDir()
+	t.Chdir(dir)
+	authDir := filepath.Join(dir, "auth")
+	if err := os.Mkdir(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	render := func(port int) []byte { return []byte(fmt.Sprintf("auth-dir: %q\nport: %d\n", authDir, port)) }
+	if err := os.WriteFile("config.yaml", render(1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	reloads := make(chan int, 16)
+	w, err := NewWatcher("config.yaml", authDir, func(cfg *config.Config) { reloads <- cfg.Port })
+	if err != nil {
+		t.Fatalf("NewWatcher: %v", err)
+	}
+	w.SetConfig(&config.Config{AuthDir: authDir, Port: 1})
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		_ = w.Stop()
+	})
+	if err = w.Start(ctx); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	for _, want := range []int{1, 2} {
+		if want == 2 {
+			renameReplace(t, "config.yaml", render(2))
+		}
+		select {
+		case got := <-reloads:
+			if got != want {
+				t.Fatalf("reload applied port=%d, want %d", got, want)
+			}
+		case <-time.After(configWatchEventTimeout):
+			t.Fatalf("no reload within %s (want port=%d)", configWatchEventTimeout, want)
+		}
+	}
+}
+
+func TestConfigDirWatchIgnoresTempAndSiblingFiles(t *testing.T) {
+	f := startConfigDirWatcher(t, nil)
+	dir := filepath.Dir(f.cfgPath)
+	body := []byte("port: 99\n")
+
+	// An abandoned writer temp file (created, written, never renamed in).
+	tmp, err := os.CreateTemp(dir, ".config.yaml.*.tmp")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = tmp.Write(body); err != nil {
+		t.Fatal(err)
+	}
+	if err = tmp.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(tmp.Name()); err != nil {
+		t.Fatal(err)
+	}
+	// Sibling files: claude-multi state next to its config, and look-alikes.
+	for _, name := range []string{
+		"api-key", "api-key.lock", "previous-key", "custom.json", "native-contract.json",
+		"config.yaml.bak", "config.yaml~", ".config.yaml.swp", "xconfig.yaml", "config.yml",
+	} {
+		if err = os.WriteFile(filepath.Join(dir, name), body, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = os.Rename(filepath.Join(dir, "config.yaml.bak"), filepath.Join(dir, "config.yaml.old")); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(filepath.Join(dir, "config.yml")); err != nil {
+		t.Fatal(err)
+	}
+	// A nested directory (not watched) and a metadata-only change of the config.
+	if err = os.Mkdir(filepath.Join(dir, "compositions"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(dir, "compositions", "config.yaml"), body, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Chmod(f.cfgPath, 0o640); err != nil {
+		t.Fatal(err)
+	}
+	f.expectNotScheduled("temp, sibling and chmod events")
+	f.expectRunning(1, nil)
+	if got := f.logs.count("config file changed, reloading"); got != 0 {
+		t.Fatalf("a config reload was attempted %d times for temp/sibling events", got)
+	}
+
+	// The watch is still live: a real replace reloads.
+	renameReplace(t, f.cfgPath, f.render(2, nil))
+	f.expectReload(2, nil)
+}
+
+func TestConfigDirWatchNeverLoadsEmptyOrMissing(t *testing.T) {
+	f := startConfigDirWatcher(t, nil)
+
+	// Empty and whitespace-only rename-replaces, then an in-place truncation.
+	renameReplace(t, f.cfgPath, []byte(""))
+	f.waitLog(logEmptyConfig, 1)
+	f.expectNoCallbackYet("empty rename-replace")
+	renameReplace(t, f.cfgPath, []byte(" \n\t\n  \n"))
+	f.waitLog(logEmptyConfig, 2)
+	f.expectNoCallbackYet("whitespace-only rename-replace")
+	if err := os.WriteFile(f.cfgPath, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	f.waitLog(logEmptyConfig, 3)
+	f.expectNoCallbackYet("in-place truncation")
+	f.expectRunning(1, nil)
+
+	// Deleted: the Remove event schedules nothing, and an explicit reload
+	// request (the management-save path) cannot load a missing file.
+	if err := os.Remove(f.cfgPath); err != nil {
+		t.Fatal(err)
+	}
+	f.expectNotScheduled("config deleted")
+	f.w.ReloadConfigIfChanged()
+	f.waitLog(logMissingRead, 1)
+	f.expectNoCallbackYet("explicit reload of a missing config")
+
+	// Renamed away: the Rename event reloads, finds no file, loads nothing.
+	renameReplace(t, f.cfgPath, []byte("\n"))
+	f.waitLog(logEmptyConfig, 4)
+	if err := os.Rename(f.cfgPath, f.cfgPath+".moved"); err != nil {
+		t.Fatal(err)
+	}
+	f.waitLog(logMissingRead, 2)
+	f.expectNoCallbackYet("config renamed away")
+	f.expectRunning(1, nil)
+
+	// A valid config put back is applied, exactly once.
