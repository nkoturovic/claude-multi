+	aliased := cm053Find(claudeModels, alias)
+	if len(aliased) != 1 || aliased[0].MetadataModelID != cm053OverlayClaudeID || aliased[0].Thinking == nil || aliased[0].MaxCompletionTokens != 128000 {
+		t.Fatalf("alias registration = %+v", aliased)
+	}
+	if len(cm053Find(codexModels, forkAlias)) != 1 {
+		t.Fatalf("fork alias registration missing: %v", cm053IDs(codexModels))
+	}
