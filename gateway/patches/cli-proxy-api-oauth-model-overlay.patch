+func TestCM053OverlayExclusionsApply(t *testing.T) {
+	const other = "claude-cm053-overlay-kept"
+	base := cm053OverlayExampleYAML + "    - name: gpt-cm053-overlay-kept\n"
+	base = strings.Replace(base, "  codex:\n", "    - name: "+other+"\n  codex:\n", 1)
+
+	// Global oauth-excluded-models, exact and wildcard.
+	global := &Service{cfg: cm053LoadConfig(t, base+`oauth-excluded-models:
+  claude: [claude-cm053-overlay-example-1]
+  codex: ["gpt-cm053-overlay-*-1"]
+`)}
+	claudeModels := cm053Register(t, global, cm053ClaudeOAuth("cm053-overlay-excl-claude"))
+	if len(cm053Find(claudeModels, cm053OverlayClaudeID)) != 0 || len(cm053Find(claudeModels, other)) != 1 {
+		t.Fatalf("global claude exclusion not applied to the overlay: %v", cm053IDs(claudeModels))
+	}
+	codexModels := cm053Register(t, global, cm053CodexOAuth("cm053-overlay-excl-codex", "pro"))
+	if len(cm053Find(codexModels, cm053OverlayCodexID)) != 0 || len(cm053Find(codexModels, "gpt-cm053-overlay-kept")) != 1 {
+		t.Fatalf("global codex wildcard exclusion not applied to the overlay: %v", cm053IDs(codexModels))
+	}
+
+	// Per-account exclusions (the synthesizer's pre-merged attribute).
+	perAccount := &Service{cfg: cm053LoadConfig(t, base)}
+	claudeAuth := cm053ClaudeOAuth("cm053-overlay-excl-account-claude")
+	claudeAuth.Attributes["excluded_models"] = "CLAUDE-CM053-OVERLAY-EXAMPLE-1"
+	claudeModels = cm053Register(t, perAccount, claudeAuth)
+	if len(cm053Find(claudeModels, cm053OverlayClaudeID)) != 0 || len(cm053Find(claudeModels, other)) != 1 {
+		t.Fatalf("per-account claude exclusion not applied to the overlay: %v", cm053IDs(claudeModels))
+	}
+	codexAuth := cm053CodexOAuth("cm053-overlay-excl-account-codex", "team")
+	codexAuth.Attributes["excluded_models"] = "gpt-cm053-*"
+	codexModels = cm053Register(t, perAccount, codexAuth)
+	if len(cm053Find(codexModels, cm053OverlayCodexID)) != 0 || len(cm053Find(codexModels, "gpt-cm053-overlay-kept")) != 0 {
+		t.Fatalf("per-account codex exclusion not applied to the overlay: %v", cm053IDs(codexModels))
+	}
+	// An unexcluded account of the same config still gets the overlay.
+	if len(cm053Find(cm053Register(t, perAccount, cm053ClaudeOAuth("cm053-overlay-excl-none")), cm053OverlayClaudeID)) != 1 {
+		t.Fatal("overlay missing on an account without exclusions")
+	}
+}
