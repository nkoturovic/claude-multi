+func TestCM053OverlayPassThroughClaude(t *testing.T) {
+	const alias = "cm053-overlay-passthrough-claude-alias"
+	upstream := &cm053Upstream{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		upstream.record(r)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"id":"msg_1","type":"message","model":"` + cm053OverlayClaudeID + `","role":"assistant","content":[{"type":"text","text":"ok"}],"usage":{"input_tokens":1,"output_tokens":1}}`))
+	}))
+	defer server.Close()
+
+	execute := func(manager *coreauth.Manager, model string) error {
+		_, err := manager.Execute(context.Background(), []string{"claude"}, cliproxyexecutor.Request{
+			Model:   model,
+			Payload: []byte(`{"model":"` + model + `","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}`),
+		}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude})
+		return err
+	}
+
+	// Unregistered: the pool does not route the id at all.
+	bareCfg := cm053LoadConfig(t, "debug: false\n")
+	bareAuth := cm053ClaudeOAuth("cm053-overlay-passthrough-claude-bare")
+	bareAuth.Attributes["base_url"] = server.URL
+	bare := cm053Pipeline(t, bareCfg, runtimeexecutor.NewClaudeExecutor(bareCfg), bareAuth)
+	if err := execute(bare, cm053OverlayClaudeID); err == nil {
+		t.Fatal("precondition: an unregistered id must not route to the OAuth pool")
+	}
+
+	// Overlaid: forwarded upstream unchanged, directly and through a non-fork alias.
+	cfg := cm053LoadConfig(t, cm053OverlayExampleYAML+"oauth-model-alias:\n  claude:\n    - name: "+cm053OverlayClaudeID+"\n      alias: "+alias+"\n")
+	auth := cm053ClaudeOAuth("cm053-overlay-passthrough-claude")
+	auth.Attributes["base_url"] = server.URL
+	manager := cm053Pipeline(t, cfg, runtimeexecutor.NewClaudeExecutor(cfg), auth)
+	if err := execute(manager, alias); err != nil {
+		t.Fatalf("execute via alias: %v", err)
+	}
+	directCfg := cm053LoadConfig(t, cm053OverlayExampleYAML)
+	directAuth := cm053ClaudeOAuth("cm053-overlay-passthrough-claude-direct")
+	directAuth.Attributes["base_url"] = server.URL
+	direct := cm053Pipeline(t, directCfg, runtimeexecutor.NewClaudeExecutor(directCfg), directAuth)
+	if err := execute(direct, cm053OverlayClaudeID); err != nil {
+		t.Fatalf("execute overlay id: %v", err)
+	}
+	models, paths, authz := upstream.snapshot()
+	if len(models) != 2 {
+		t.Fatalf("upstream requests = %d (%v), want 2 (the unregistered id never reaches upstream)", len(models), paths)
+	}
+	for i := range models {
+		if models[i] != cm053OverlayClaudeID || paths[i] != "/v1/messages" || !strings.HasPrefix(authz[i], "Bearer ") {
+			t.Fatalf("upstream request %d: model %q path %q oauth-bearer %v", i, models[i], paths[i], strings.HasPrefix(authz[i], "Bearer "))
+		}
+	}
+}
