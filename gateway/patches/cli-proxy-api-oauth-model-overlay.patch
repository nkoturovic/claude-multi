+func TestCM053OverlayCapabilityThroughAlias(t *testing.T) {
+	const alias = "cm053-overlay-capability-alias"
+	staticClaude := internalregistry.GetClaudeModels()[0]
+	cfg := cm053LoadConfig(t, `oauth-extra-models:
+  claude:
+    - name: claude-cm053-overlay-capability-1
+      max-completion-tokens: 32000
+      thinking:
+        levels: [low, medium, high]
+oauth-model-alias:
+  claude:
+    - name: claude-cm053-overlay-capability-1
+      alias: `+alias+`
+`)
+	executor := &cm053CapabilityExecutor{}
+	manager := cm053Pipeline(t, cfg, executor, cm053ClaudeOAuth("cm053-overlay-capability-claude"))
+	registered := GlobalModelRegistry().GetModelsForClient("cm053-overlay-capability-claude")
+	if len(cm053Find(registered, "claude-cm053-overlay-capability-1")) != 0 || len(cm053Find(registered, alias)) != 1 {
+		t.Fatalf("precondition: the non-fork alias must replace the overlay id: %v", cm053IDs(registered))
+	}
+
+	for _, requested := range []string{alias, alias + "(max)"} {
+		_, err := manager.Execute(context.Background(), []string{"claude"}, cliproxyexecutor.Request{
+			Model:   requested,
+			Payload: []byte(`{"model":"` + requested + `","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}`),
+		}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude})
+		executor.mu.Lock()
+		seen, info, body := executor.seenModel, executor.info, executor.body
+		executor.mu.Unlock()
+		if seen == "" || !strings.HasPrefix(seen, "claude-cm053-overlay-capability-1") {
+			t.Fatalf("%s: wire resolution = %q (err %v)", requested, seen, err)
+		}
+		if info == nil || info.Thinking == nil || !reflect.DeepEqual(info.Thinking.Levels, []string{"low", "medium", "high"}) || info.MaxCompletionTokens != 32000 || info.UserDefined {
+			t.Fatalf("%s: capabilities bound after wire resolution = %+v (err %v)", requested, info, err)
+		}
+		// The overlay's levels are authoritative: "max" is not one of them, so it
+		// never reaches upstream unvalidated.
+		if err == nil && gjson.GetBytes(body, "output_config.effort").String() == "max" {
+			t.Fatalf("%s: effort max passed through unvalidated: %s", requested, body)
+		}
+	}
+
+	// A model the static registry defines keeps the registry path (static wins).
+	staticCfg := cm053LoadConfig(t, "oauth-extra-models:\n  claude:\n    - name: "+staticClaude.ID+"\n      thinking:\n        levels: [low]\n")
+	staticExec := &cm053CapabilityExecutor{}
+	staticManager := cm053Pipeline(t, staticCfg, staticExec, cm053ClaudeOAuth("cm053-overlay-capability-static"))
+	_, _ = staticManager.Execute(context.Background(), []string{"claude"}, cliproxyexecutor.Request{
+		Model:   staticClaude.ID,
+		Payload: []byte(`{"model":"` + staticClaude.ID + `","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}`),
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude})
+	staticExec.mu.Lock()
+	if staticExec.seenModel != staticClaude.ID || staticExec.info != nil {
+		staticExec.mu.Unlock()
+		t.Fatalf("static model got overlay capabilities: model %q info %+v", staticExec.seenModel, staticExec.info)
+	}
+	staticExec.mu.Unlock()
+
+	// Concurrent reloads: every attempt binds one whole overlay snapshot (the
+	// old or the new entry), never a mix and never none.
+	wider := cm053LoadConfig(t, strings.Replace(`oauth-extra-models:
+  claude:
+    - name: claude-cm053-overlay-capability-1
+      max-completion-tokens: 64000
+      thinking:
+        levels: [low, medium, high, max]
+oauth-model-alias:
+  claude:
+    - name: claude-cm053-overlay-capability-1
+      alias: ALIAS
+`, "ALIAS", alias, 1))
+	executor.mu.Lock()
+	executor.effort = "high"
+	executor.mu.Unlock()
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				manager.SetConfig(cfg)
+				return
+			default:
+			}
+			if i%2 == 0 {
+				manager.SetConfig(wider)
+			} else {
+				manager.SetConfig(cfg)
+			}
+		}
+	}()
+	var workers sync.WaitGroup
+	for worker := 0; worker < 4; worker++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for i := 0; i < 25; i++ {
+				_, _ = manager.Execute(context.Background(), []string{"claude"}, cliproxyexecutor.Request{
+					Model:   alias,
+					Payload: []byte(`{"model":"` + alias + `","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}`),
+				}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude})
+			}
+		}()
+	}
+	workers.Wait()
+	close(stop)
+	wg.Wait()
+	executor.mu.Lock()
+	defer executor.mu.Unlock()
+	if len(executor.infos) < 2+100 {
+		t.Fatalf("concurrent attempts recorded = %d", len(executor.infos))
+	}
+	for _, resolved := range executor.infos[2:] {
+		if resolved == nil || resolved.Thinking == nil {
+			t.Fatal("an attempt ran without the overlay capabilities")
+		}
+		narrow := reflect.DeepEqual(resolved.Thinking.Levels, []string{"low", "medium", "high"}) && resolved.MaxCompletionTokens == 32000
+		broad := reflect.DeepEqual(resolved.Thinking.Levels, []string{"low", "medium", "high", "max"}) && resolved.MaxCompletionTokens == 64000
+		if !narrow && !broad {
+			t.Fatalf("an attempt bound a mixed overlay snapshot: %+v", resolved)
+		}
+	}
+}
