new file mode 100644
index 0000000..88dc8aa
--- /dev/null
+++ b/internal/modelconfig/oauth_extra_models.go
@@ -0,0 +1,83 @@
+package modelconfig
+
+// claude-multi local patch (oauth-model-overlay): the one builder of the
+// ModelInfo for an oauth-extra-models entry, shared by registration and by the
+// execution-time capability lookup, and the one static-collision rule.
+
+import (
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+// OAuthExtraModelInfo returns the registry entry of one validated overlay
+// entry. It carries exactly the closed schema's fields: id, display name,
+// context, max output and thinking; nothing else (no header overrides, no
+// transport controls).
+func OAuthExtraModelInfo(channel string, entry config.OAuthExtraModel, created int64) *registry.ModelInfo {
+	name := strings.TrimSpace(entry.Name)
+	if name == "" {
+		return nil
+	}
+	ownedBy, modelType := "", ""
+	switch channel {
+	case "claude":
+		ownedBy, modelType = "anthropic", "claude"
+	case "codex":
+		ownedBy, modelType = "openai", "openai"
+	default:
+		return nil
+	}
+	displayName := strings.TrimSpace(entry.DisplayName)
+	if displayName == "" {
+		displayName = name
+	}
+	info := &registry.ModelInfo{
+		ID:          name,
+		Object:      "model",
+		Created:     created,
+		OwnedBy:     ownedBy,
+		Type:        modelType,
+		DisplayName: displayName,
+	}
+	if entry.MaxContextLength > 0 {
+		info.ContextLength = entry.MaxContextLength
+		info.MaxContextLength = entry.MaxContextLength
+	}
+	if entry.MaxCompletionTokens > 0 {
+		info.MaxCompletionTokens = entry.MaxCompletionTokens
+	}
+	if entry.Thinking != nil {
+		info.Thinking = NormalizeThinkingSupport(entry.Thinking)
+		info.ExplicitThinking = true
+	}
+	return info
+}
+
+// OAuthExtraModelStaticKnown reports whether the pinned static registry already
+// defines modelID for the channel (case-normalized; for codex, any plan). The
+// static definition then wins: the overlay never redefines a known model.
+func OAuthExtraModelStaticKnown(channel, modelID string) bool {
+	key := strings.ToLower(strings.TrimSpace(modelID))
+	if key == "" {
+		return false
+	}
+	var lists [][]*registry.ModelInfo
+	switch channel {
+	case "claude":
+		lists = [][]*registry.ModelInfo{registry.GetClaudeModels()}
+	case "codex":
+		lists = [][]*registry.ModelInfo{registry.GetCodexProModels(), registry.GetCodexPlusModels(), registry.GetCodexTeamModels(), registry.GetCodexFreeModels()}
+	default:
+		return false
+	}
+	for _, list := range lists {
+		for _, model := range list {
+			if model != nil && strings.ToLower(strings.TrimSpace(model.ID)) == key {
+				return true
+			}
+		}
+	}
+	return false
+}
