+func TestCM053OverlayRegistersClaudeModel(t *testing.T) {
+	cfg := cm053LoadConfig(t, cm053OverlayExampleYAML)
+	service := &Service{cfg: cfg}
+	static := internalregistry.GetClaudeModels()
+
+	models := cm053Register(t, service, cm053ClaudeOAuth("cm053-overlay-claude-oauth"))
+	found := cm053Find(models, cm053OverlayClaudeID)
+	if len(found) != 1 {
+		t.Fatalf("overlay model registered %d times, want 1: %v", len(found), cm053IDs(models))
+	}
+	got := found[0]
+	if got.ID != cm053OverlayClaudeID || got.DisplayName != "Claude CM053 Overlay Example" || got.OwnedBy != "anthropic" || got.Type != "claude" {
+		t.Fatalf("overlay model identity = %+v", got)
+	}
+	if got.ContextLength != 1000000 || got.MaxContextLength != 1000000 || got.MaxCompletionTokens != 128000 {
+		t.Fatalf("overlay model limits = ctx %d/%d out %d", got.ContextLength, got.MaxContextLength, got.MaxCompletionTokens)
+	}
+	if got.Thinking == nil || !reflect.DeepEqual(got.Thinking.Levels, []string{"low", "medium", "high", "xhigh", "max"}) || !got.Thinking.ZeroAllowed || !got.Thinking.DynamicAllowed {
+		t.Fatalf("overlay model thinking = %+v", got.Thinking)
+	}
+	if got.UserDefined || len(got.SupportedParameters) != 0 {
+		t.Fatalf("overlay model carries fields outside the closed schema: %+v", got)
+	}
+	// Appended to the static list: every static model is still there, once.
+	if len(models) != len(static)+1 {
+		t.Fatalf("registered %d models, want %d static + 1 overlay", len(models), len(static))
+	}
+	for _, model := range static {
+		if len(cm053Find(models, model.ID)) != 1 {
+			t.Fatalf("static model %q missing after overlay append", model.ID)
+		}
+	}
+	if len(cm053Find(models, cm053OverlayCodexID)) != 0 {
+		t.Fatal("codex overlay entry leaked into the claude channel")
+	}
+
+	// API-key credentials of the channel never receive OAuth overlay models.
+	apiKey := &coreauth.Auth{ID: "cm053-overlay-claude-apikey", Provider: "claude", Status: coreauth.StatusActive,
+		Attributes: map[string]string{"auth_kind": "apikey", "api_key": "sk-ant-api03-cm053"}}
