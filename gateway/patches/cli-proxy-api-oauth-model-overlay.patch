+func TestCM053OverlayAliasVisibleInModels(t *testing.T) {
+	const alias = "cm053-overlay-alias-served"
+	const forkAlias = "cm053-overlay-fork-alias-served"
+	aliasYAML := `oauth-model-alias:
+  claude:
+    - name: claude-cm053-overlay-example-1
+      alias: ` + alias + `
+  codex:
+    - name: gpt-cm053-overlay-example-1
+      alias: ` + forkAlias + `
+      fork: true
+`
+	// Without the overlay the alias has nothing to attach to.
+	bare := &Service{cfg: cm053LoadConfig(t, aliasYAML)}
+	cm053Register(t, bare, cm053ClaudeOAuth("cm053-overlay-alias-claude"))
+	cm053Register(t, bare, cm053CodexOAuth("cm053-overlay-alias-codex", "pro"))
+	served := cm053ServeModels(t)
+	if cm053Contains(served, alias) || cm053Contains(served, forkAlias) {
+		t.Fatalf("alias served without the overlay: %v", served)
+	}
+
+	service := &Service{cfg: cm053LoadConfig(t, cm053OverlayExampleYAML+aliasYAML)}
+	claudeModels := cm053Register(t, service, cm053ClaudeOAuth("cm053-overlay-alias-claude"))
+	codexModels := cm053Register(t, service, cm053CodexOAuth("cm053-overlay-alias-codex", "pro"))
+	served = cm053ServeModels(t)
+	if !cm053Contains(served, alias) {
+		t.Fatalf("/v1/models does not serve the alias %q onto the overlay model: %v", alias, served)
+	}
+	if cm053Contains(served, cm053OverlayClaudeID) {
+		t.Fatalf("non-fork alias left the overlay id %q served", cm053OverlayClaudeID)
+	}
+	if !cm053Contains(served, forkAlias) || !cm053Contains(served, cm053OverlayCodexID) {
+		t.Fatalf("fork alias must serve both %q and %q: %v", forkAlias, cm053OverlayCodexID, served)
