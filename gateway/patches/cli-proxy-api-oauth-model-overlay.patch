@@ -0,0 +1,576 @@
+package config
+
+// claude-multi local patch (oauth-model-overlay): an explicit list of extra
+// models per OAuth channel. The OAuth pools register models only from the
+// pinned static registry, so a newly released first-party model is never
+// advertised (and an oauth-model-alias cannot attach to it) until a gateway
+// release. `oauth-extra-models` registers such a model for every OAuth auth of
+// the channel, like a static entry. The schema is closed: no aliases (those
+// stay in oauth-model-alias), no ModelInfo.Config header overrides and no
+// transport controls. An invalid overlay refuses the whole load or reload.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"reflect"
+	"regexp"
+	"sort"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/thinking"
+	"gopkg.in/yaml.v3"
+)
+
+// OAuthExtraModelsKey is the top-level config key of the OAuth model overlay.
+const OAuthExtraModelsKey = "oauth-extra-models"
+
+// maxOAuthExtraModelDisplayName bounds display-name (in runes).
+const maxOAuthExtraModelDisplayName = 256
+
+// oauthExtraModelChannels are the only OAuth channels the overlay accepts.
+var oauthExtraModelChannels = map[string]struct{}{"claude": {}, "codex": {}}
+
+// oauthExtraModelNamePattern is the accepted upstream model id charset: no
+// whitespace, no prefix separator "/", no thinking suffix "(...)".
+var oauthExtraModelNamePattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`)
+
+// OAuthExtraModel is one overlay entry: an upstream model id plus the
+// capability fields upstream validates.
+type OAuthExtraModel struct {
+	// Name is the upstream model identifier, forwarded unchanged.
+	Name string `yaml:"name" json:"name"`
+
+	// DisplayName is the optional human-readable name shown in model catalogs.
+	DisplayName string `yaml:"display-name,omitempty" json:"display-name,omitempty"`
+
+	// MaxContextLength is the context window advertised to clients.
+	MaxContextLength int `yaml:"max-context-length,omitempty" json:"max-context-length,omitempty"`
+
+	// MaxCompletionTokens is the maximum output length advertised to clients.
+	MaxCompletionTokens int `yaml:"max-completion-tokens,omitempty" json:"max-completion-tokens,omitempty"`
+
+	// Thinking is the model's thinking/reasoning capability.
+	Thinking *registry.ThinkingSupport `yaml:"thinking,omitempty" json:"thinking,omitempty"`
+}
+
+// oauthExtraModelStrict is the strict decode shape: pointers tell an explicit
+// zero from an absent field. Unknown fields (also inside thinking) are refused.
+type oauthExtraModelStrict struct {
+	Name                *string                   `yaml:"name"`
+	DisplayName         *string                   `yaml:"display-name"`
+	MaxContextLength    *int                      `yaml:"max-context-length"`
+	MaxCompletionTokens *int                      `yaml:"max-completion-tokens"`
+	Thinking            *registry.ThinkingSupport `yaml:"thinking"`
+}
+
+// IsOAuthExtraModelChannel reports whether channel accepts overlay entries.
+func IsOAuthExtraModelChannel(channel string) bool {
+	_, ok := oauthExtraModelChannels[channel]
+	return ok
+}
+
+// parseOAuthExtraModelsYAML validates the overlay of a config document
+// structurally, on the parsed yaml.Node and before any decode, and then
+// decodes it strictly from that validated node. The decoder alone cannot be
+// trusted with the overlay's shape: a !!null tag on a mapping skips any
+// Unmarshaler yet still fills the field, a merge ("<<") or an alias supplies
+// content from elsewhere, and an explicit 0 decodes like an omitted key. So:
+//   - a root mapping is plain (standard tag, no anchor);
+//   - the overlay is a literal top-level key: a plain string key, and no root
+//     merge may supply the key (directly, through an alias or a sequence, or
+//     through a nested merge);
+//   - the overlay node and every descendant carry only the standard tag of
+//     their kind (!!map, !!seq, !!str, !!int, !!bool; !!null only on a
+//     scalar), and there is no anchor, alias or merge key anywhere inside.
+//
+// It returns the validated overlay (nil when absent). A document the YAML
+// parser rejects is left to the main unmarshal, which reports it.
+func parseOAuthExtraModelsYAML(data []byte) (map[string][]OAuthExtraModel, error) {
+	var document yaml.Node
+	if errUnmarshal := yaml.Unmarshal(data, &document); errUnmarshal != nil {
+		return nil, nil
+	}
+	if len(document.Content) == 0 {
+		return nil, nil
+	}
+	root := document.Content[0]
+	if root.Kind != yaml.MappingNode {
+		// No overlay key exists outside a root mapping; the main unmarshal
+		// decides such a document (and adoptOAuthExtraModels refuses any
+		// overlay it would still produce).
+		return nil, nil
+	}
+	if root.ShortTag() != "!!map" || root.Anchor != "" {
+		return nil, fmt.Errorf("invalid %s: the config root must be a plain mapping (no tag or anchor)", OAuthExtraModelsKey)
+	}
+	var overlay *yaml.Node
+	for index := 0; index+1 < len(root.Content); index += 2 {
+		keyNode, value := root.Content[index], root.Content[index+1]
+		if isYAMLMergeKey(keyNode) {
+			if yamlMergeSuppliesKey(value, OAuthExtraModelsKey, map[*yaml.Node]bool{}) {
+				return nil, fmt.Errorf("invalid %s: must be a literal top-level key, not supplied through a merge (<<)", OAuthExtraModelsKey)
+			}
+			continue
+		}
+		if !yamlKeyMatches(keyNode, OAuthExtraModelsKey) {
+			continue
+		}
+		if !isPlainYAMLKey(keyNode) {
+			return nil, fmt.Errorf("invalid %s: must be a literal top-level key (no alias, anchor or tag)", OAuthExtraModelsKey)
+		}
+		if overlay != nil {
+			return nil, fmt.Errorf("invalid %s: the key is defined more than once", OAuthExtraModelsKey)
+		}
+		overlay = value
+	}
+	if overlay == nil {
+		return nil, nil
+	}
+	if errShape := validateOAuthExtraModelsShape(overlay); errShape != nil {
+		return nil, fmt.Errorf("invalid %s: %w", OAuthExtraModelsKey, errShape)
+	}
+	entries, errDecode := decodeOAuthExtraModelsNode(overlay)
+	if errDecode != nil {
+		return nil, fmt.Errorf("invalid %s: %w", OAuthExtraModelsKey, errDecode)
+	}
+	return entries, nil
+}
+
+// adoptOAuthExtraModels installs the overlay validated by
+// parseOAuthExtraModelsYAML into the decoded config. The main decode must have
+// produced the same overlay: a difference means some YAML construct reached
+// the field around the structural check, and the whole load is refused.
+func adoptOAuthExtraModels(cfg *Config, entries map[string][]OAuthExtraModel) error {
+	if !reflect.DeepEqual(NormalizeOAuthExtraModels(cfg.OAuthExtraModels), NormalizeOAuthExtraModels(entries)) {
+		return fmt.Errorf("invalid %s: the decoded overlay differs from the validated literal overlay", OAuthExtraModelsKey)
+	}
+	if errValidate := validateOAuthExtraModelsDecoded(entries); errValidate != nil {
+		return errValidate
+	}
+	cfg.OAuthExtraModels = entries
+	return nil
+}
+
+// validateOAuthExtraModelsDecoded re-checks the decoded overlay semantically
+// (channel, name, display-name, limits, thinking, duplicates), so no decode
+// path can populate Config.OAuthExtraModels without validation.
+func validateOAuthExtraModelsDecoded(entries map[string][]OAuthExtraModel) error {
+	channels := make([]string, 0, len(entries))
+	for channel := range entries {
+		channels = append(channels, channel)
+	}
+	sort.Strings(channels)
+	for _, channel := range channels {
+		if !IsOAuthExtraModelChannel(channel) {
+			return fmt.Errorf("invalid %s: channel %q is not allowed (allowed: claude, codex)", OAuthExtraModelsKey, channel)
+		}
+		seen := make(map[string]struct{}, len(entries[channel]))
+		for position, model := range entries[channel] {
+			name := model.Name
+			entry := oauthExtraModelStrict{Name: &name, Thinking: model.Thinking}
+			if model.DisplayName != "" {
+				displayName := model.DisplayName
+				entry.DisplayName = &displayName
+			}
+			if model.MaxContextLength != 0 {
+				maxContextLength := model.MaxContextLength
+				entry.MaxContextLength = &maxContextLength
+			}
+			if model.MaxCompletionTokens != 0 {
+				maxCompletionTokens := model.MaxCompletionTokens
+				entry.MaxCompletionTokens = &maxCompletionTokens
+			}
+			if errEntry := validateOAuthExtraModelEntry(entry); errEntry != nil {
+				return fmt.Errorf("invalid %s: %s[%d]: %w", OAuthExtraModelsKey, channel, position, errEntry)
+			}
+			key := strings.ToLower(name)
+			if _, exists := seen[key]; exists {
+				return fmt.Errorf("invalid %s: %s[%d]: duplicate model %q", OAuthExtraModelsKey, channel, position, name)
+			}
+			seen[key] = struct{}{}
+		}
+	}
+	return nil
+}
+
+func isYAMLNullScalar(node *yaml.Node) bool {
+	return node.Kind == yaml.ScalarNode && node.ShortTag() == "!!null"
+}
+
+// isYAMLMergeKey is the decoder's own merge-key test.
+func isYAMLMergeKey(node *yaml.Node) bool {
+	return node.Kind == yaml.ScalarNode && node.Value == "<<" && (node.Tag == "" || node.Tag == "!" || node.ShortTag() == "!!merge")
+}
+
+// isPlainYAMLKey reports whether a mapping key is a plain string scalar: no
+// alias, anchor or non-string tag.
+func isPlainYAMLKey(node *yaml.Node) bool {
+	return node.Kind == yaml.ScalarNode && node.ShortTag() == "!!str" && node.Anchor == ""
+}
+
+// yamlKeyMatches reports whether a mapping key names name as written or as the
+// decoder resolves it (through an alias, a !!binary or a custom tag).
+func yamlKeyMatches(key *yaml.Node, name string) bool {
+	resolved := key
+	if resolved.Kind == yaml.AliasNode && resolved.Alias != nil {
+		resolved = resolved.Alias
+	}
+	if resolved.Value == name {
+		return true
+	}
+	var decoded string
+	return key.Decode(&decoded) == nil && decoded == name
+}
+
+// yamlMergeSuppliesKey reports whether the value of a merge key would supply
+// name to the mapping it is merged into: a mapping (or an alias of one) that
+// has the key, directly or through its own merge, or a sequence of such.
+func yamlMergeSuppliesKey(value *yaml.Node, name string, visited map[*yaml.Node]bool) bool {
+	if value == nil {
+		return false
+	}
+	if value.Kind == yaml.AliasNode {
+		if value.Alias == nil {
+			return false
+		}
+		value = value.Alias
+	}
+	if visited[value] {
+		return false
+	}
+	visited[value] = true
+	switch value.Kind {
+	case yaml.MappingNode:
+		for index := 0; index+1 < len(value.Content); index += 2 {
+			keyNode := value.Content[index]
+			if isYAMLMergeKey(keyNode) {
+				if yamlMergeSuppliesKey(value.Content[index+1], name, visited) {
+					return true
+				}
+				continue
+			}
+			if yamlKeyMatches(keyNode, name) {
+				return true
+			}
+		}
+	case yaml.SequenceNode:
+		for _, item := range value.Content {
+			if yamlMergeSuppliesKey(item, name, visited) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// validateOAuthExtraModelsShape refuses anything but plain YAML inside the
+// overlay: every node carries the standard tag of its kind (!!map, !!seq,
+// !!str, !!int, !!bool, or !!null on a scalar), and there is no anchor, alias
+// or merge key; every mapping key is a plain string.
+func validateOAuthExtraModelsShape(node *yaml.Node) error {
+	if node.Anchor != "" {
+		return errors.New("anchors are not supported inside the overlay")
+	}
+	switch node.Kind {
+	case yaml.AliasNode:
+		return errors.New("aliases are not supported inside the overlay")
+	case yaml.MappingNode:
+		if tag := node.ShortTag(); tag != "!!map" {
+			return fmt.Errorf("a mapping carries the tag %s (only the standard tag is supported)", tag)
+		}
+		for index := 0; index+1 < len(node.Content); index += 2 {
+			keyNode := node.Content[index]
+			if isYAMLMergeKey(keyNode) {
+				return errors.New("merge keys are not supported inside the overlay")
+			}
+			if !isPlainYAMLKey(keyNode) {
+				return fmt.Errorf("key %q must be a plain string (no alias, anchor or tag)", keyNode.Value)
+			}
+			if errValue := validateOAuthExtraModelsShape(node.Content[index+1]); errValue != nil {
+				return errValue
+			}
+		}
+	case yaml.SequenceNode:
+		if tag := node.ShortTag(); tag != "!!seq" {
+			return fmt.Errorf("a list carries the tag %s (only the standard tag is supported)", tag)
+		}
+		for _, item := range node.Content {
+			if errItem := validateOAuthExtraModelsShape(item); errItem != nil {
+				return errItem
+			}
+		}
+	case yaml.ScalarNode:
+		switch tag := node.ShortTag(); tag {
+		case "!!str", "!!int", "!!bool", "!!null":
+		default:
+			return fmt.Errorf("a scalar carries the tag %s (only !!str, !!int, !!bool and !!null are supported)", tag)
+		}
+	default:
+		return errors.New("unsupported YAML node inside the overlay")
+	}
+	return nil
+}
+
+// decodeOAuthExtraModelsNode decodes a structurally validated overlay node, a
+// mapping of channel to a list of entries. Each entry is type-checked on its
+// node, strictly decoded (unknown fields refused) and value-validated.
+// Presence comes from the node: an explicitly written limit must be > 0, an
+// omitted one stays omitted.
+func decodeOAuthExtraModelsNode(node *yaml.Node) (map[string][]OAuthExtraModel, error) {
+	if isYAMLNullScalar(node) {
+		return nil, nil
+	}
+	if node.Kind != yaml.MappingNode {
+		return nil, errors.New("must be a mapping of OAuth channel to a list of models")
+	}
+	entries := make(map[string][]OAuthExtraModel, len(node.Content)/2)
+	for index := 0; index+1 < len(node.Content); index += 2 {
+		channel, value := node.Content[index].Value, node.Content[index+1]
+		if !IsOAuthExtraModelChannel(channel) {
+			return nil, fmt.Errorf("channel %q is not allowed (allowed: claude, codex)", channel)
+		}
+		if _, exists := entries[channel]; exists {
+			return nil, fmt.Errorf("channel %q is defined more than once", channel)
+		}
+		if isYAMLNullScalar(value) {
+			entries[channel] = nil
+			continue
+		}
+		if value.Kind != yaml.SequenceNode {
+			return nil, fmt.Errorf("%s: must be a list of models", channel)
+		}
+		list := make([]OAuthExtraModel, 0, len(value.Content))
+		seen := make(map[string]struct{}, len(value.Content))
+		for position, item := range value.Content {
+			model, errEntry := decodeOAuthExtraModelItem(item)
+			if errEntry != nil {
+				return nil, fmt.Errorf("%s[%d]: %w", channel, position, errEntry)
+			}
+			key := strings.ToLower(model.Name)
+			if _, exists := seen[key]; exists {
+				return nil, fmt.Errorf("%s[%d]: duplicate model %q", channel, position, model.Name)
+			}
+			seen[key] = struct{}{}
+			list = append(list, model)
+		}
+		entries[channel] = list
+	}
+	return NormalizeOAuthExtraModels(entries), nil
+}
+
+// oauthExtraModelFields and oauthExtraModelThinkingFields are the closed
+// schemas of an entry and of its thinking capability: field -> required kind.
+var (
+	oauthExtraModelFields = map[string]string{
+		"name": "string", "display-name": "string",
+		"max-context-length": "integer", "max-completion-tokens": "integer",
+		"thinking": "thinking",
+	}
+	oauthExtraModelThinkingFields = map[string]string{
+		"min": "integer", "max": "integer",
+		"zero-allowed": "boolean", "dynamic-allowed": "boolean",
+		"levels": "list of strings",
+	}
+)
+
+// validateOAuthExtraModelFields checks an entry's (or its thinking's) fields
+// on the node: only schema fields, each explicitly present one of its type. The
+// decoder would otherwise truncate a float (1.9 -> 1) into a Go int, turn a
+// null into an omitted field and drop unknown fields silently.
+func validateOAuthExtraModelFields(node *yaml.Node, fields map[string]string, prefix string) error {
+	if node.Kind != yaml.MappingNode {
+		return errors.New("must be a mapping")
+	}
+	for index := 0; index+1 < len(node.Content); index += 2 {
+		field, value := node.Content[index].Value, node.Content[index+1]
+		kind, known := fields[field]
+		if !known {
+			return fmt.Errorf("field %s%q is not supported", prefix, field)
+		}
+		name := prefix + field
+		switch kind {
+		case "integer":
+			if errInt := validateOAuthExtraModelInt(name, value); errInt != nil {
+				return errInt
+			}
+		case "string", "boolean":
+			tag := map[string]string{"string": "!!str", "boolean": "!!bool"}[kind]
+			if value.Kind != yaml.ScalarNode || value.ShortTag() != tag {
+				return fmt.Errorf("%s must be a %s", name, kind)
+			}
+		case "thinking":
+			if value.Kind != yaml.MappingNode {
+				return fmt.Errorf("%s must be a mapping", name)
+			}
+			if errThinking := validateOAuthExtraModelFields(value, oauthExtraModelThinkingFields, name+" "); errThinking != nil {
+				return errThinking
+			}
+		case "list of strings":
+			if value.Kind != yaml.SequenceNode {
+				return fmt.Errorf("%s must be a list of strings", name)
+			}
+			for _, item := range value.Content {
+				if item.Kind != yaml.ScalarNode || item.ShortTag() != "!!str" {
+					return fmt.Errorf("%s must be a list of strings", name)
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func validateOAuthExtraModelInt(field string, node *yaml.Node) error {
+	if node.Kind == yaml.ScalarNode && node.ShortTag() == "!!int" {
+		var value interface{}
+		if node.Decode(&value) == nil {
+			switch value.(type) {
+			case int, int64, uint64:
+				return nil
+			}
+		}
+	}
+	return fmt.Errorf("%s must be an integer", field)
+}
+
+// decodeOAuthExtraModelItem type-checks one entry node, decodes it strictly
+// (KnownFields) and validates its values.
+func decodeOAuthExtraModelItem(item *yaml.Node) (OAuthExtraModel, error) {
+	if errFields := validateOAuthExtraModelFields(item, oauthExtraModelFields, ""); errFields != nil {
+		return OAuthExtraModel{}, errFields
+	}
+	raw, errMarshal := yaml.Marshal(item)
+	if errMarshal != nil {
+		return OAuthExtraModel{}, errMarshal
+	}
+	var entry oauthExtraModelStrict
+	decoder := yaml.NewDecoder(bytes.NewReader(raw))
+	decoder.KnownFields(true)
+	if errDecode := decoder.Decode(&entry); errDecode != nil {
+		return OAuthExtraModel{}, errDecode
+	}
+	if errEntry := validateOAuthExtraModelEntry(entry); errEntry != nil {
+		return OAuthExtraModel{}, errEntry
+	}
+	model := OAuthExtraModel{Name: *entry.Name, Thinking: entry.Thinking}
+	if entry.DisplayName != nil {
+		model.DisplayName = *entry.DisplayName
+	}
+	if entry.MaxContextLength != nil {
+		model.MaxContextLength = *entry.MaxContextLength
+	}
+	if entry.MaxCompletionTokens != nil {
+		model.MaxCompletionTokens = *entry.MaxCompletionTokens
+	}
+	return model, nil
+}
+
+func validateOAuthExtraModelEntry(entry oauthExtraModelStrict) error {
+	if entry.Name == nil {
+		return errors.New("name is required")
+	}
+	if !oauthExtraModelNamePattern.MatchString(*entry.Name) {
+		return fmt.Errorf("name %q is not a valid upstream model id", *entry.Name)
+	}
+	if entry.DisplayName != nil {
+		displayName := *entry.DisplayName
+		if strings.TrimSpace(displayName) == "" || strings.TrimSpace(displayName) != displayName {
+			return errors.New("display-name must be non-blank without surrounding whitespace")
+		}
+		if !utf8.ValidString(displayName) || utf8.RuneCountInString(displayName) > maxOAuthExtraModelDisplayName {
+			return fmt.Errorf("display-name must be valid UTF-8 of at most %d characters", maxOAuthExtraModelDisplayName)
+		}
+		for _, r := range displayName {
+			if unicode.IsControl(r) {
+				return errors.New("display-name must not contain control characters")
+			}
+		}
+	}
+	if entry.MaxContextLength != nil && *entry.MaxContextLength <= 0 {
+		return errors.New("max-context-length must be > 0")
+	}
+	if entry.MaxCompletionTokens != nil && *entry.MaxCompletionTokens <= 0 {
+		return errors.New("max-completion-tokens must be > 0")
+	}
+	if entry.Thinking != nil {
+		if errThinking := ValidateOAuthExtraModelThinking(entry.Thinking); errThinking != nil {
+			return fmt.Errorf("thinking: %w", errThinking)
+		}
+	}
+	return nil
+}
+
+// ValidateOAuthExtraModelThinking checks a thinking capability with the
+// thinking package's own level vocabulary: levels are the discrete effort
+// levels and the special modes none/auto, lower case, without duplicates; a
+// budget range needs 0 <= min <= max; the capability must declare levels or a
+// budget.
+func ValidateOAuthExtraModelThinking(support *registry.ThinkingSupport) error {
+	if support == nil {
+		return nil
+	}
+	if support.Min < 0 || support.Max < 0 {
+		return errors.New("min and max must be >= 0")
+	}
+	if support.Min > 0 && support.Max == 0 {
+		return errors.New("min needs a max")
+	}
+	if support.Max > 0 && support.Min > support.Max {
+		return errors.New("min must be <= max")
+	}
+	if len(support.Levels) == 0 && support.Max == 0 {
+		return errors.New("must declare levels or a budget (max)")
+	}
+	seen := make(map[string]struct{}, len(support.Levels))
+	for _, level := range support.Levels {
+		if level != strings.ToLower(strings.TrimSpace(level)) {
+			return fmt.Errorf("level %q must be lower case without whitespace", level)
+		}
+		_, isLevel := thinking.ParseLevelSuffix(level)
+		_, isSpecial := thinking.ParseSpecialSuffix(level)
+		if !isLevel && !(isSpecial && level != "-1") {
+			return fmt.Errorf("level %q is not a thinking level", level)
+		}
+		if _, exists := seen[level]; exists {
+			return fmt.Errorf("duplicate level %q", level)
+		}
+		seen[level] = struct{}{}
+	}
+	return nil
+}
+
+// NormalizeOAuthExtraModels returns the validated overlay in canonical form:
+// empty channel lists dropped, a nil map when nothing remains, and no empty
+// slices, so a reload compares overlay content exactly.
+func NormalizeOAuthExtraModels(entries map[string][]OAuthExtraModel) map[string][]OAuthExtraModel {
+	if len(entries) == 0 {
+		return nil
+	}
+	out := make(map[string][]OAuthExtraModel, len(entries))
+	for channel, models := range entries {
+		if len(models) == 0 {
+			continue
+		}
+		list := make([]OAuthExtraModel, 0, len(models))
+		for _, model := range models {
+			if model.Thinking != nil {
+				support := *model.Thinking
+				if len(support.Levels) == 0 {
+					support.Levels = nil
+				} else {
+					support.Levels = append([]string(nil), support.Levels...)
+				}
+				model.Thinking = &support
+			}
+			list = append(list, model)
+		}
+		out[channel] = list
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
