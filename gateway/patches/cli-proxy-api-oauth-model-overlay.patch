+func TestCM053OverlayStaticWins(t *testing.T) {
+	staticClaude := internalregistry.GetClaudeModels()[0]
+	staticCodex := internalregistry.GetCodexPlusModels()[0]
+	proOnly := ""
+	for _, model := range internalregistry.GetCodexProModels() {
+		if internalregistry.LookupStaticModelInfoByChannel(model.ID, "codex") != nil && len(cm053Find(internalregistry.GetCodexFreeModels(), model.ID)) == 0 {
+			proOnly = model.ID
+			break
+		}
+	}
+	shadowName := strings.ToUpper(staticClaude.ID) // case-normalized collision
+	text := `oauth-extra-models:
+  claude:
+    - name: ` + shadowName + `
+      display-name: Overlay Must Not Win
+      max-context-length: 7
+    - name: claude-cm053-overlay-static-wins-new
+  codex:
+    - name: ` + staticCodex.ID + `
+      display-name: Overlay Must Not Win
+`
+	if proOnly != "" {
+		text += "    - name: " + proOnly + "\n      display-name: Overlay Must Not Win\n"
+	}
+	cfg := cm053LoadConfig(t, text)
+
+	hook := logtest.NewGlobal()
+	defer hook.Reset()
+	service := &Service{cfg: cfg}
+	var models []*ModelInfo
+	for i := 0; i < 3; i++ { // repeated registration (refresh) keeps one Warn per entry
+		models = cm053Register(t, service, cm053ClaudeOAuth("cm053-overlay-static-wins-claude"))
+	}
+	found := cm053Find(models, staticClaude.ID)
+	if len(found) != 1 {
+		t.Fatalf("static id %q registered %d times", staticClaude.ID, len(found))
+	}
+	if found[0].ID != staticClaude.ID || found[0].DisplayName != staticClaude.DisplayName || found[0].ContextLength == 7 {
+		t.Fatalf("overlay replaced the static entry: %+v", found[0])
+	}
+	if len(cm053Find(models, "claude-cm053-overlay-static-wins-new")) != 1 {
+		t.Fatal("a non-colliding overlay entry next to a shadowed one must still register")
+	}
+	codexModels := cm053Register(t, service, cm053CodexOAuth("cm053-overlay-static-wins-codex", "free"))
+	if got := cm053Find(codexModels, staticCodex.ID); len(got) != 1 || got[0].DisplayName == "Overlay Must Not Win" {
+		t.Fatalf("codex static entry lost to the overlay: %+v", got)
+	}
+	if proOnly != "" {
+		// A static model of the channel the account's plan list omits stays
+		// omitted: the overlay never redefines a model the registry knows.
+		if got := cm053Find(codexModels, proOnly); len(got) != 0 {
+			t.Fatalf("overlay re-planned the static model %q onto a free account", proOnly)
+		}
+	}
+
+	var warns []string
+	for _, entry := range hook.AllEntries() {
+		if entry.Level == log.WarnLevel && strings.HasPrefix(entry.Message, "oauth-extra-models:") {
+			if entry.Message != "oauth-extra-models: entry duplicates a static model; the static entry wins and the overlay entry is dropped" {
+				t.Fatalf("Warn line text changed: %q", entry.Message)
+			}
+			warns = append(warns, entry.Data["channel"].(string)+"/"+entry.Data["model"].(string))
+		}
+	}
+	want := 2
+	if proOnly != "" {
+		want = 3
+	}
+	if len(warns) != want {
+		t.Fatalf("static-wins Warn lines = %v, want %d (one per dropped entry)", warns, want)
+	}
+}
