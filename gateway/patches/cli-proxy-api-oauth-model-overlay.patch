+// TestCM053OverlayReloadRefreshRegistry drives the production reload chain:
+// config file → watcher reload (the existing refusal path) → forced OAuth
+// re-registration → registry, with oauth-model-alias unchanged throughout.
+func TestCM053OverlayReloadRefreshRegistry(t *testing.T) {
+	const alias = "cm053-overlay-reload-alias"
+	dir := t.TempDir()
+	authDir := filepath.Join(dir, "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	authPath := filepath.Join(authDir, "claude-cm053-reload.json")
+	if err := os.WriteFile(authPath, []byte(`{"type":"claude","email":"cm053-reload@example.invalid","access_token":"sk-ant-oat01-cm053-reload"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	configPath := filepath.Join(dir, "config.yaml")
+	head := "auth-dir: " + authDir + "\napi-keys: [cm053-reload-key]\noauth-model-alias:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      alias: " + alias + "\n"
+	write := func(overlay string) {
+		t.Helper()
+		if err := os.WriteFile(configPath, []byte(head+overlay), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("")
+	initial, err := internalconfig.LoadConfig(configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	manager := coreauth.NewManager(nil, nil, nil)
+	service := &Service{cfg: initial, coreManager: manager}
+	var callbacks []*config.Config
+	var callbackMu sync.Mutex
+	w, err := watcher.NewWatcher(configPath, authDir, func(cfg *config.Config) {
+		callbackMu.Lock()
+		callbacks = append(callbacks, cfg)
+		callbackMu.Unlock()
+		service.cfgMu.Lock()
+		service.cfg = cfg
+		service.cfgMu.Unlock()
+		manager.SetConfig(cfg)
+		manager.SetOAuthModelAlias(cfg.OAuthModelAlias)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = w.Stop() }()
+	service.authUpdates = make(chan watcher.AuthUpdate, 256)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go service.consumeAuthUpdates(ctx)
+	w.SetAuthUpdateQueue(service.authUpdates)
+	w.SetConfig(initial)
+
+	var authID string
+	reload := func(step string) []*ModelInfo {
+		t.Helper()
+		w.ReloadConfigIfChanged()
+		if barrier := w.DispatchAuthBarrier(); barrier != nil {
+			select {
+			case <-barrier:
+			case <-time.After(10 * time.Second):
+				t.Fatalf("%s: auth updates were not applied", step)
+			}
+		}
+		if authID == "" {
+			for _, auth := range manager.List() {
+				if auth != nil && auth.Provider == "claude" {
+					authID = auth.ID
+				}
+			}
+			if authID == "" {
+				t.Fatalf("%s: the claude OAuth auth was not loaded", step)
+			}
+			t.Cleanup(func() { GlobalModelRegistry().UnregisterClient(authID) })
+		}
+		return GlobalModelRegistry().GetModelsForClient(authID)
+	}
+
+	models := reload("start")
+	if len(cm053Find(models, alias)) != 0 {
+		t.Fatalf("start: alias served before the overlay exists: %v", cm053IDs(models))
+	}
+
+	// add
+	write("oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      display-name: Reload One\n      max-context-length: 200000\n")
+	models = reload("add")
+	if got := cm053Find(models, alias); len(got) != 1 || got[0].DisplayName != "Reload One" || got[0].ContextLength != 200000 {
+		t.Fatalf("add: overlay not registered after an overlay-only reload: %v", cm053IDs(models))
+	}
+
+	// edit (content only: same name, aliases unchanged)
+	write("oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      display-name: Reload One\n      max-context-length: 400000\n      max-completion-tokens: 64000\n")
+	models = reload("edit")
+	if got := cm053Find(models, alias); len(got) != 1 || got[0].ContextLength != 400000 || got[0].MaxCompletionTokens != 64000 {
+		t.Fatalf("edit: registry kept the previous overlay content: %+v", got)
+	}
+
+	// invalid: refused through the existing reload refusal path; the previous
+	// config and registration stay.
+	callbackMu.Lock()
+	before := len(callbacks)
+	callbackMu.Unlock()
+	write("oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 0\n")
+	models = reload("invalid")
+	callbackMu.Lock()
+	after := len(callbacks)
+	callbackMu.Unlock()
+	if after != before {
+		t.Fatal("invalid: a refused reload reached the config callback")
+	}
+	if got := cm053Find(models, alias); len(got) != 1 || got[0].ContextLength != 400000 {
+		t.Fatalf("invalid: previous registration not kept: %+v", got)
+	}
+
+	// remove
+	write("")
+	models = reload("remove")
+	if len(cm053Find(models, alias)) != 0 || len(cm053Find(models, "claude-cm053-overlay-reload-1")) != 0 {
+		t.Fatalf("remove: overlay still registered: %v", cm053IDs(models))
+	}
+	callbackMu.Lock()
+	defer callbackMu.Unlock()
+	for _, cfg := range callbacks {
+		if !reflect.DeepEqual(cfg.OAuthModelAlias, initial.OAuthModelAlias) {
+			t.Fatal("aliases must stay unchanged across the reload steps")
+		}
+	}
+}
