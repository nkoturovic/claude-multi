+// cm053OverlayShapeCases are overlays whose YAML shape is refused structurally,
+// before any decode: the overlay must be a literal top-level key of a plain
+// root mapping, and it and every descendant carry only the standard tag of
+// their kind, with no anchor, alias or merge key. Each case (prefix + the
+// config head + body) was accepted by the capture-based validation of the
+// previous revision; the same table drives the watcher reload gate.
+var cm053OverlayShapeCases = map[string]struct{ prefix, body string }{
+	// !!null on a non-scalar skips an Unmarshaler, but the decoder still fills it
+	"null-tag-mapping":      {"", "oauth-extra-models: !!null {claude: [{name: claude-cm053-shape-1, max-context-length: 0, headers: {x-cm053: injected}}]}\n"},
+	"null-tag-headers":      {"", "oauth-extra-models: !!null {codex: [{name: gpt-cm053-shape-1, headers: {x-cm053: injected}}]}\n"},
+	"null-tag-base-url":     {"", "oauth-extra-models: !!null\n  codex:\n    - name: gpt-cm053-shape-1\n      base-url: https://example.invalid\n"},
+	"null-tag-zero-limits":  {"", "oauth-extra-models: !!null {codex: [{name: gpt-cm053-shape-1, max-context-length: 0, max-completion-tokens: 0}]}\n"},
+	"null-tag-float-limit":  {"", "oauth-extra-models: !!null {codex: [{name: gpt-cm053-shape-1, max-context-length: 1.9}]}\n"},
+	"null-tag-channel-list": {"", "oauth-extra-models:\n  codex: !!null [{name: gpt-cm053-shape-1}]\n"},
+	"null-tag-entry":        {"", "oauth-extra-models:\n  codex:\n    - !!null {name: gpt-cm053-shape-1}\n"},
+	// the overlay must be a literal top-level key, never supplied by a merge
+	"merge-overlay":      {"", "<<: {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}\n"},
+	"merge-null-tag":     {"", "<<: {oauth-extra-models: !!null {claude: [{name: claude-cm053-shape-1, max-context-length: 0, headers: {x-cm053: injected}}]}}\n"},
+	"merge-alias":        {"", "x-cm053-base: &base {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}\n<<: *base\n"},
+	"merge-sequence":     {"", "<<: [{pprof: {enable: false}}, {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}]\n"},
+	"merge-nested":       {"", "<<: {<<: {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}}\n"},
+	"merge-with-literal": {"", "<<: {oauth-extra-models: {gemini: [{name: gemini-cm053}]}}\noauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	// no anchors or aliases on or inside the overlay, and a literal key
+	"anchor-overlay": {"", "oauth-extra-models: &overlay {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	"anchor-entry":   {"", "oauth-extra-models:\n  codex:\n    - &entry {name: gpt-cm053-shape-1}\n"},
+	"anchor-scalar":  {"", "oauth-extra-models:\n  codex:\n    - name: &name gpt-cm053-shape-1\n"},
+	"anchor-key":     {"", "&key oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	"alias-overlay":  {"", "x-cm053-overlay: &overlay {codex: [{name: gpt-cm053-shape-1}]}\noauth-extra-models: *overlay\n"},
+	"alias-key":      {"", "x-cm053-key: &key oauth-extra-models\n*key : {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	// standard tags only
+	"custom-tag-overlay": {"", "oauth-extra-models: !cm053 {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	"custom-tag-entry":   {"", "oauth-extra-models:\n  codex:\n    - !cm053 {name: gpt-cm053-shape-1}\n"},
+	"custom-tag-scalar":  {"", "oauth-extra-models:\n  codex:\n    - name: !cm053 gpt-cm053-shape-1\n"},
+	"custom-tag-key":     {"", "!cm053 oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	"str-tag-list":       {"", "oauth-extra-models:\n  codex: !!str [{name: gpt-cm053-shape-1}]\n"},
+	"float-display-name": {"", "oauth-extra-models:\n  codex:\n    - name: gpt-cm053-shape-1\n      display-name: 1.5\n"},
+	"binary-name":        {"", "oauth-extra-models:\n  codex:\n    - name: !!binary Z3B0LWNtMDUzLXNoYXBlLTE=\n"},
+	// the root is a plain mapping
+	"root-custom-tag": {"--- !cm053\n", "oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	"root-anchor":     {"--- &root\n", "oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}\n"},
+}
+
+func TestCM053OverlayShapeRefused(t *testing.T) {
+	dir := t.TempDir()
+	for name, shape := range cm053OverlayShapeCases {
+		t.Run(name, func(t *testing.T) {
+			document := shape.prefix + "api-keys: [cm053]\n" + shape.body
+			if cfg, err := LoadConfigBytes([]byte(document)); err == nil {
+				t.Fatalf("LoadConfigBytes accepted the overlay shape: %+v", cfg.OAuthExtraModels)
+			}
+			if cfg, err := ParseConfigBytes([]byte(document)); err == nil {
+				t.Fatalf("ParseConfigBytes accepted the overlay shape: %+v", cfg.OAuthExtraModels)
+			}
+			path := filepath.Join(dir, name+".yaml")
+			if err := os.WriteFile(path, []byte(document), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := LoadConfig(path); err == nil {
+				t.Fatal("LoadConfig accepted the overlay shape")
+			}
+			if cfg, err := LoadConfigOptional(path, true); err != nil || cfg.OAuthExtraModels != nil || len(cfg.APIKeys) != 0 {
+				t.Fatalf("LoadConfigOptional did not fall back to the empty config: %+v, %v", cfg, err)
+			}
+		})
+	}
+}
