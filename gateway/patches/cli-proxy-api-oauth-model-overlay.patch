+// cm053CapabilityExecutor records the capabilities bound to the attempt and
+// applies thinking exactly as the executors do.
+type cm053CapabilityExecutor struct {
+	mu        sync.Mutex
+	seenModel string
+	info      *internalregistry.ModelInfo
+	infos     []*internalregistry.ModelInfo
+	body      []byte
+	effort    string
+}
+
+func (*cm053CapabilityExecutor) Identifier() string { return "claude" }
+
+func (e *cm053CapabilityExecutor) Execute(_ context.Context, _ *coreauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	info, _ := coreauth.ResolvedModelInfo(req)
+	e.mu.Lock()
+	effort := e.effort
+	e.mu.Unlock()
+	if effort == "" {
+		effort = "max"
+	}
+	body := []byte(`{"model":"` + req.Model + `","thinking":{"type":"adaptive"},"output_config":{"effort":"` + effort + `"}}`)
+	out, err := helps.ApplyRequestThinking(body, req, opts, opts.SourceFormat.String(), "claude", "claude")
+	e.mu.Lock()
+	e.seenModel, e.info, e.body = req.Model, info, out
+	e.infos = append(e.infos, info)
+	e.mu.Unlock()
+	return cliproxyexecutor.Response{Payload: []byte(`{"id":"msg_1","type":"message","role":"assistant","content":[]}`)}, err
+}
+
+func (e *cm053CapabilityExecutor) ExecuteStream(ctx context.Context, auth *coreauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	resp, err := e.Execute(ctx, auth, req, opts)
+	if err != nil {
+		return nil, err
+	}
+	chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+	chunks <- cliproxyexecutor.StreamChunk{Payload: resp.Payload}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func (*cm053CapabilityExecutor) Refresh(_ context.Context, auth *coreauth.Auth) (*coreauth.Auth, error) {
+	return auth, nil
+}
+
+func (e *cm053CapabilityExecutor) CountTokens(ctx context.Context, auth *coreauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(ctx, auth, req, opts)
+}
+
+func (e *cm053CapabilityExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
