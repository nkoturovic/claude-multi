+type cm053Upstream struct {
+	mu     sync.Mutex
+	models []string
+	paths  []string
+	auth   []string
+}
+
+func (u *cm053Upstream) record(r *http.Request) {
+	body, _ := io.ReadAll(r.Body)
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.paths = append(u.paths, r.URL.Path)
+	u.models = append(u.models, gjson.GetBytes(body, "model").String())
+	u.auth = append(u.auth, r.Header.Get("Authorization"))
+}
+
+func (u *cm053Upstream) snapshot() ([]string, []string, []string) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return append([]string(nil), u.models...), append([]string(nil), u.paths...), append([]string(nil), u.auth...)
+}
