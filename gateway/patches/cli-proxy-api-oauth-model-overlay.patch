+// appendOAuthExtraModels (claude-multi local patch, oauth-model-overlay)
+// appends the channel's oauth-extra-models entries to an OAuth auth's static
+// list, before exclusions, exactly like static models. On a case-normalized
+// collision with the auth's static list, or with any static definition of the
+// channel, the static entry wins and the overlay entry is dropped.
+func (s *Service) appendOAuthExtraModels(provider, authKind string, models []*ModelInfo) []*ModelInfo {
+	if s == nil {
+		return models
+	}
+	channel := coreauth.OAuthModelAliasChannel(provider, authKind)
+	if channel != "claude" && channel != "codex" {
+		return models
+	}
+	s.cfgMu.RLock()
+	cfg := s.cfg
+	s.cfgMu.RUnlock()
+	if cfg == nil || len(cfg.OAuthExtraModels[channel]) == 0 {
+		return models
+	}
+	existing := make(map[string]struct{}, len(models))
+	for _, model := range models {
+		if model != nil {
+			existing[strings.ToLower(strings.TrimSpace(model.ID))] = struct{}{}
+		}
+	}
+	out := append(make([]*ModelInfo, 0, len(models)+len(cfg.OAuthExtraModels[channel])), models...)
+	now := time.Now().Unix()
+	for _, entry := range cfg.OAuthExtraModels[channel] {
+		info := modelconfig.OAuthExtraModelInfo(channel, entry, now)
+		if info == nil {
+			continue
+		}
+		key := strings.ToLower(info.ID)
+		if _, shadowed := existing[key]; shadowed || modelconfig.OAuthExtraModelStaticKnown(channel, info.ID) {
+			if _, warned := s.oauthExtraShadowWarned.LoadOrStore(channel+"\x00"+key, struct{}{}); !warned {
+				log.WithFields(log.Fields{"channel": channel, "model": info.ID}).Warn("oauth-extra-models: entry duplicates a static model; the static entry wins and the overlay entry is dropped")
+			}
+			continue
+		}
+		existing[key] = struct{}{}
+		out = append(out, info)
+	}
+	return out
+}
