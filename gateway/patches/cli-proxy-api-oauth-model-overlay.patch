+// lookupOAuthExtraModelCapability (claude-multi local patch,
+// oauth-model-overlay) binds an oauth-extra-models entry's capabilities to an
+// OAuth execution attempt after wire resolution, so a non-fork
+// oauth-model-alias onto an overlay model (registered only under its alias)
+// still validates thinking against the overlay entry. A model the static
+// registry defines keeps the registry path (static wins).
+func lookupOAuthExtraModelCapability(routing *apiKeyModelRoutingSnapshot, auth *Auth, upstreamModel string) (*registry.ModelInfo, bool) {
+	if routing == nil || routing.config == nil || auth == nil || len(routing.config.OAuthExtraModels) == 0 {
+		return nil, false
+	}
+	channel := OAuthModelAliasChannel(auth.Provider, auth.AuthKind())
+	if channel != "claude" && channel != "codex" {
+		return nil, false
+	}
+	selected := strings.TrimSpace(thinking.ParseSuffix(strings.TrimSpace(upstreamModel)).ModelName)
+	if selected == "" || modelconfig.OAuthExtraModelStaticKnown(channel, selected) {
+		return nil, false
+	}
+	for _, entry := range routing.config.OAuthExtraModels[channel] {
+		if !strings.EqualFold(strings.TrimSpace(entry.Name), selected) {
+			continue
+		}
+		modelInfo := modelconfig.OAuthExtraModelInfo(channel, entry, 0)
+		return modelInfo, modelInfo != nil
+	}
+	return nil, false
+}
