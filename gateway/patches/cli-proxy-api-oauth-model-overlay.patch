diff --git a/internal/watcher/oauth_extra_models_cm053_test.go b/internal/watcher/oauth_extra_models_cm053_test.go
new file mode 100644
index 0000000..4ed0be5
--- /dev/null
+++ b/internal/watcher/oauth_extra_models_cm053_test.go
@@ -0,0 +1,228 @@
+package watcher
+
+// claude-multi local patch (oauth-model-overlay): any change to overlay
+// content forces the OAuth registration refresh, with aliases and
+// prefixes unchanged; an invalid overlay reload is refused and keeps the
+// previous config.
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/watcher/diff"
+)
+
+func TestCM053OverlayReloadRefresh(t *testing.T) {
+	dir := t.TempDir()
+	authDir := filepath.Join(dir, "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(authDir, "claude-cm053.json"), []byte(`{"type":"claude","email":"cm053@example.invalid","access_token":"sk-ant-oat01-cm053"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	configPath := filepath.Join(dir, "config.yaml")
+	head := "auth-dir: " + authDir + "\napi-keys: [cm053-key]\noauth-model-alias:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      alias: cm053-overlay-reload-alias\n"
+	write := func(body string) {
+		t.Helper()
+		if err := os.WriteFile(configPath, []byte(head+body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("")
+	initial, err := config.LoadConfig(configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var mu sync.Mutex
+	var callbacks []*config.Config
+	queue := make(chan AuthUpdate, 64)
+	w := &Watcher{
+		configPath:     configPath,
+		authDir:        authDir,
+		lastAuthHashes: make(map[string]string),
+		reloadCallback: func(cfg *config.Config) {
+			mu.Lock()
+			callbacks = append(callbacks, cfg)
+			mu.Unlock()
+		},
+	}
+	w.SetConfig(initial)
+	w.SetAuthUpdateQueue(queue)
+	defer w.stopDispatch()
+
+	// drain returns the actions dispatched for the auth since the last drain.
+	drain := func(step string) []AuthUpdateAction {
+		t.Helper()
+		barrier := w.DispatchAuthBarrier()
+		var actions []AuthUpdateAction
+		deadline := time.After(10 * time.Second)
+		for {
+			select {
+			case update := <-queue:
+				if update.IsBarrier() {
+					update.ReleaseBarrier()
+					<-barrier
+					return actions
+				}
+				actions = append(actions, update.Action)
+			case <-deadline:
+				t.Fatalf("%s: dispatch did not complete", step)
+			}
+		}
+	}
+	reload := func(step, body string, wantOK bool) []AuthUpdateAction {
+		t.Helper()
+		write(body)
+		if ok := w.reloadConfig(); ok != wantOK {
+			t.Fatalf("%s: reloadConfig = %v, want %v", step, ok, wantOK)
+		}
+		return drain(step)
+	}
+
+	if actions := reload("start", "", true); len(actions) != 1 || actions[0] != AuthUpdateActionAdd {
+		t.Fatalf("start: actions = %v, want one add", actions)
+	}
+	// Control: a reload without an overlay content change re-registers nothing.
+	if actions := reload("unrelated", "pprof:\n  addr: 127.0.0.1:18317\n", true); len(actions) != 0 {
+		t.Fatalf("unrelated change: actions = %v, want none", actions)
+	}
+	steps := []struct{ name, body string }{
+		{"add", "oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 200000\n"},
+		{"edit", "oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 400000\n"},
+		{"edit-thinking", "oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 400000\n      thinking:\n        levels: [low, high]\n"},
+		{"add-channel", "oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 400000\n      thinking:\n        levels: [low, high]\n  codex:\n    - name: gpt-cm053-overlay-reload-1\n"},
+		{"remove", ""},
+	}
+	for _, step := range steps {
+		if actions := reload(step.name, step.body, true); len(actions) != 1 || actions[0] != AuthUpdateActionModify {
+			t.Fatalf("%s: actions = %v, want one forced modify (aliases unchanged)", step.name, actions)
+		}
+	}
+	// Same overlay content, different YAML layout: no refresh.
+	write("oauth-extra-models: {claude: [{name: claude-cm053-overlay-reload-1, max-context-length: 400000}]}\n")
+	if !w.reloadConfig() {
+		t.Fatal("flow-style overlay refused")
+	}
+	drain("flow")
+	if actions := reload("same-content", "oauth-extra-models:\n  claude:\n    - max-context-length: 400000\n      name: claude-cm053-overlay-reload-1\n", true); len(actions) != 0 {
+		t.Fatalf("same content: actions = %v, want none", actions)
+	}
+
+	// Invalid overlay: refused through the reload refusal path; the previous
+	// config stays and no callback or refresh happens.
+	mu.Lock()
+	before := len(callbacks)
+	mu.Unlock()
+	w.clientsMutex.RLock()
+	previous := w.config
+	w.clientsMutex.RUnlock()
+	invalid := []struct{ name, body string }{
+		{"invalid", "oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 400000\n      headers: {x: y}\n"},
+		// an overlay supplied through a root merge is validated like a literal one
+		{"invalid-merge", "<<: {oauth-extra-models: {claude: [{name: claude-cm053-bad, max-context-length: -1, thinking: {levels: [ultra]}, headers: {x-cm053: ignored}}]}}\n"},
+		{"invalid-merge-field", "<<: {oauth-extra-models: {claude: [{name: claude-cm053-bad, headers: {x-cm053: ignored}}]}}\n"},
+		{"invalid-merge-anchor", "x-cm053-base: &base\n  oauth-extra-models:\n    claude:\n      - name: claude-cm053-bad\n        max-context-length: -1\n<<: *base\n"},
+		{"invalid-fraction", "oauth-extra-models:\n  claude:\n    - name: claude-cm053-overlay-reload-1\n      max-context-length: 1.9\n"},
+	}
+	for _, step := range invalid {
+		if actions := reload(step.name, step.body, false); len(actions) != 0 {
+			t.Fatalf("%s: actions = %v, want none", step.name, actions)
+		}
+		w.clientsMutex.RLock()
+		kept := w.config
+		w.clientsMutex.RUnlock()
+		mu.Lock()
+		after := len(callbacks)
+		mu.Unlock()
+		if kept != previous || after != before {
+			t.Fatalf("%s: invalid overlay reload replaced the running config", step.name)
+		}
+	}
+	// Every overlay shape refused at load is refused on reload as well (the
+	// config gate's table), and the previous config stays.
+	for name, shape := range cm053WatcherShapeCases {
+		if err := os.WriteFile(configPath, []byte(shape.prefix+head+shape.body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if w.reloadConfig() {
+			// Report every accepted shape, then put the previous config back
+			// so the remaining cases are still checked against it.
+			t.Errorf("shape %s: reload accepted", name)
+			drain("accepted " + name)
+			w.clientsMutex.Lock()
+			w.config = previous
+			w.clientsMutex.Unlock()
+			mu.Lock()
+			before = len(callbacks)
+			mu.Unlock()
+			continue
+		}
+		if actions := drain("shape " + name); len(actions) != 0 {
+			t.Fatalf("shape %s: actions = %v, want none", name, actions)
+		}
+		w.clientsMutex.RLock()
+		kept := w.config
+		w.clientsMutex.RUnlock()
+		mu.Lock()
+		after := len(callbacks)
+		mu.Unlock()
+		if kept != previous || after != before {
+			t.Fatalf("shape %s: refused reload replaced the running config", name)
+		}
+	}
+
+	details := diff.BuildConfigChangeDetails(&config.Config{}, &config.Config{OAuthExtraModels: map[string][]config.OAuthExtraModel{"codex": {{Name: "gpt-cm053"}}}})
+	found := false
+	for _, detail := range details {
+		if detail == "oauth-extra-models[codex]: updated (0 -> 1 entries)" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("config change details = %v", details)
+	}
+}
+
+// cm053WatcherShapeCases mirrors the config package's cm053OverlayShapeCases
+// (test tables are not shared across packages).
+var cm053WatcherShapeCases = map[string]struct{ prefix, body string }{
+	// !!null on a non-scalar skips an Unmarshaler, but the decoder still fills it
+	"null-tag-mapping":      {"", "oauth-extra-models: !!null {claude: [{name: claude-cm053-shape-1, max-context-length: 0, headers: {x-cm053: injected}}]}\n"},
+	"null-tag-headers":      {"", "oauth-extra-models: !!null {codex: [{name: gpt-cm053-shape-1, headers: {x-cm053: injected}}]}\n"},
+	"null-tag-base-url":     {"", "oauth-extra-models: !!null\n  codex:\n    - name: gpt-cm053-shape-1\n      base-url: https://example.invalid\n"},
+	"null-tag-zero-limits":  {"", "oauth-extra-models: !!null {codex: [{name: gpt-cm053-shape-1, max-context-length: 0, max-completion-tokens: 0}]}\n"},
+	"null-tag-float-limit":  {"", "oauth-extra-models: !!null {codex: [{name: gpt-cm053-shape-1, max-context-length: 1.9}]}\n"},
+	"null-tag-channel-list": {"", "oauth-extra-models:\n  codex: !!null [{name: gpt-cm053-shape-1}]\n"},
+	"null-tag-entry":        {"", "oauth-extra-models:\n  codex:\n    - !!null {name: gpt-cm053-shape-1}\n"},
+	// the overlay must be a literal top-level key, never supplied by a merge
+	"merge-overlay":      {"", "<<: {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}\n"},
+	"merge-null-tag":     {"", "<<: {oauth-extra-models: !!null {claude: [{name: claude-cm053-shape-1, max-context-length: 0, headers: {x-cm053: injected}}]}}\n"},
+	"merge-alias":        {"", "x-cm053-base: &base {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}\n<<: *base\n"},
+	"merge-sequence":     {"", "<<: [{pprof: {enable: false}}, {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}]\n"},
+	"merge-nested":       {"", "<<: {<<: {oauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}}}\n"},
+	"merge-with-literal": {"", "<<: {oauth-extra-models: {gemini: [{name: gemini-cm053}]}}\noauth-extra-models: {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	// no anchors or aliases on or inside the overlay, and a literal key
+	"anchor-overlay": {"", "oauth-extra-models: &overlay {codex: [{name: gpt-cm053-shape-1}]}\n"},
+	"anchor-entry":   {"", "oauth-extra-models:\n  codex:\n    - &entry {name: gpt-cm053-shape-1}\n"},
