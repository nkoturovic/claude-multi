+package claude
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func contentChunksStream(deltas ...string) [][]byte {
+	var param any
+	var out [][]byte
+	for _, delta := range deltas {
+		out = append(out, ConvertOpenAIResponseToClaude(context.Background(), "", []byte(`{"stream":true}`), nil,
+			[]byte(`data: {"id":"fixture","model":"fixture","choices":[{"delta":`+delta+`}]}`), &param)...)
+	}
+	out = append(out, ConvertOpenAIResponseToClaude(context.Background(), "", []byte(`{"stream":true}`), nil,
+		[]byte(`data: {"choices":[{"delta":{},"finish_reason":"stop"}]}`), &param)...)
+	out = append(out, ConvertOpenAIResponseToClaude(context.Background(), "", []byte(`{"stream":true}`), nil,
+		[]byte(`data: {"choices":[],"usage":{"prompt_tokens":11,"completion_tokens":4}}`), &param)...)
+	out = append(out, ConvertOpenAIResponseToClaude(context.Background(), "", []byte(`{"stream":true}`), nil,
+		[]byte(`data: [DONE]`), &param)...)
+	return out
+}
+
+func contentChunksBlocks(t *testing.T, out [][]byte) []string {
+	t.Helper()
+	var blocks []string
+	open := -1
+	starts, stops := 0, 0
+	for _, raw := range out {
+		parts := bytes.SplitN(raw, []byte("\ndata: "), 2)
+		if len(parts) != 2 {
+			t.Fatalf("not an SSE event: %q", raw)
+		}
+		value := gjson.ParseBytes(bytes.TrimSpace(parts[1]))
+		switch value.Get("type").String() {
+		case "content_block_start":
+			if open != -1 {
+				t.Fatal("overlapping blocks")
+			}
+			open = int(value.Get("index").Int())
+			if open != len(blocks) {
+				t.Fatalf("index %d, expected %d", open, len(blocks))
+			}
+			blocks = append(blocks, value.Get("content_block.type").String()+":")
+		case "content_block_delta":
+			if open < 0 || int(value.Get("index").Int()) != open {
+				t.Fatal("delta outside its block")
+			}
+			for _, field := range []string{"text", "thinking", "partial_json"} {
+				blocks[open] += value.Get("delta." + field).String()
+			}
+			if value.Get("delta.type").String() == "signature_delta" {
+				t.Fatal("fabricated signature")
+			}
+		case "content_block_stop":
+			if open < 0 || int(value.Get("index").Int()) != open {
+				t.Fatal("stop outside its block")
+			}
+			open = -1
+		case "message_start":
+			starts++
+		case "message_stop":
+			stops++
+		}
+	}
+	if open != -1 || starts != 1 || stops != 1 {
+		t.Fatalf("incomplete stream: open=%d starts=%d stops=%d", open, starts, stops)
+	}
+	return blocks
+}
+
+func TestContentChunksStreaming(t *testing.T) {
+	cases := []struct {
+		name    string
+		content []string
+		want    []string
+	}{
+		{"thinking-repeat-closed", []string{`[{"type":"thinking","thinking":[{"type":"text","text":"a"}],"closed":true}]`, `[{"type":"thinking","thinking":[{"type":"text","text":"b"}],"closed":true}]`}, []string{"thinking:ab"}},
+		{"transition-in-one-array", []string{`[{"type":"thinking","thinking":[{"type":"text","text":"a"},{"type":"text","text":"b"}]},{"type":"text","text":"answer"}]`}, []string{"thinking:ab", "text:answer"}},
+		{"text-only", []string{`[{"type":"text","text":"a"},{"type":"text","text":"b"}]`}, []string{"text:ab"}},
+		{"back-to-thinking", []string{`[{"type":"thinking","thinking":[{"type":"text","text":"a"}]},{"type":"text","text":"b"},{"type":"thinking","thinking":[{"type":"text","text":"c"}]}]`}, []string{"thinking:a", "text:b", "thinking:c"}},
+		{"empty-array", []string{`[]`}, nil},
+		{"empty-chunks", []string{`[{"type":"text","text":""},{"type":"thinking","thinking":[],"closed":true}]`}, nil},
+		{"null", []string{`null`}, nil},
+		{"null-chunk", []string{`[null]`}, []string{"text:[null]"}},
+		{"malformed-text", []string{`[{"type":"text","text":7}]`}, []string{`text:[{"type":"text","text":7}]`}},
+		{"malformed-thinking", []string{`[{"type":"thinking","thinking":"a"}]`}, []string{`text:[{"type":"thinking","thinking":"a"}]`}},
+		{"unknown-nested", []string{`[{"type":"thinking","thinking":[{"type":"image","url":"fixture"}]}]`}, []string{`text:[{"type":"thinking","thinking":[{"type":"image","url":"fixture"}]}]`}},
+		{"unknown-mixed", []string{`[{"type":"text","text":"a"},{"type":"image","url":"fixture"}]`}, []string{`text:[{"type":"text","text":"a"},{"type":"image","url":"fixture"}]`}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var deltas []string
+			for _, content := range tc.content {
+				deltas = append(deltas, `{"content":`+content+`}`)
+			}
+			out := contentChunksStream(deltas...)
+			if got := contentChunksBlocks(t, out); !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("blocks = %#v, want %#v", got, tc.want)
+			}
+			wire := string(bytes.Join(out, nil))
+			if !strings.Contains(wire, `"stop_reason":"end_turn"`) || !strings.Contains(wire, `"input_tokens":11,"output_tokens":4`) {
+				t.Fatalf("finish/usage missing: %s", wire)
+			}
+		})
+	}
+}
+
+func TestContentChunksToolInterleaving(t *testing.T) {
+	out := contentChunksStream(
+		`{"content":[{"type":"thinking","thinking":[{"type":"text","text":"before"}]}]}`,
+		`{"tool_calls":[{"index":0,"id":"call_fixture","type":"function","function":{"name":"fixture","arguments":"{\"k\":"}}]}`,
+		`{"content":[{"type":"thinking","thinking":[{"type":"text","text":"during"}],"closed":true},{"type":"text","text":"answer"}]}`,
+		`{"tool_calls":[{"index":0,"function":{"arguments":"1}"}}]}`,
+	)
+	want := []string{"thinking:before", `tool_use:{"k":1}`, "thinking:during", "text:answer"}
+	if got := contentChunksBlocks(t, out); !reflect.DeepEqual(got, want) {
+		t.Fatalf("blocks = %#v, want %#v", got, want)
+	}
+	if !bytes.Contains(bytes.Join(out, nil), []byte(`"stop_reason":"tool_use"`)) {
+		t.Fatal("tool finish lost")
+	}
+}
