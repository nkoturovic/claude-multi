+		})
+	}
+}
+
+func TestContentChunksFinishAndUsage(t *testing.T) {
+	for _, finish := range []string{"stop", "length", ""} {
+		for _, withUsage := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/usage=%t", finish, withUsage), func(t *testing.T) {
+				var param any
+				var out [][]byte
+				emit := func(raw string) {
+					out = append(out, ConvertOpenAIResponseToClaude(context.Background(), "", []byte(`{"stream":true}`), nil, []byte("data: "+raw), &param)...)
+				}
+				emit(`{"id":"fixture","model":"fixture","choices":[{"delta":{"content":[{"type":"thinking","thinking":[{"type":"text","text":"thought"}],"closed":true},{"type":"text","text":"answer"}]}}]}`)
+				if finish != "" {
+					emit(`{"choices":[{"delta":{},"finish_reason":"` + finish + `"}]}`)
+				}
+				if withUsage {
+					emit(`{"choices":[],"usage":{"prompt_tokens":11,"completion_tokens":4}}`)
+				}
+				emit(`[DONE]`)
+				emit(`[DONE]`)
+				if got := contentChunksBlocks(t, out); !reflect.DeepEqual(got, []string{"thinking:thought", "text:answer"}) {
+					t.Fatalf("blocks: %#v", got)
+				}
+				wire := string(bytes.Join(out, nil))
+				want := "end_turn"
+				if finish == "length" {
+					want = "max_tokens"
+				}
+				if strings.Count(wire, "event: message_delta\n") != 1 || !strings.Contains(wire, `"stop_reason":"`+want+`"`) {
+					t.Fatalf("terminal events: %s", wire)
+				}
+				if withUsage && !strings.Contains(wire, `"input_tokens":11,"output_tokens":4`) {
+					t.Fatal("usage lost")
+				}
+			})
+		}
+	}
+}
