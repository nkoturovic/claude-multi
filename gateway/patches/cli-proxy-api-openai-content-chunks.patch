+func TestContentChunksNonStreaming(t *testing.T) {
+	cases := []struct {
+		name, content    string
+		want, registered []string
+	}{
+		{"thinking-text", `[{"type":"thinking","thinking":[{"type":"text","text":"a"},{"type":"text","text":"b"}],"closed":true},{"type":"text","text":"answer"}]`, []string{"thinking:ab", "text:answer"}, nil},
+		{"text-only", `[{"type":"text","text":"a"}]`, []string{"text:a"}, nil},
+		{"repeated-thinking", `[{"type":"thinking","thinking":[{"type":"text","text":"a"}],"closed":true},{"type":"thinking","thinking":[{"type":"text","text":"b"}],"closed":true}]`, []string{"thinking:a", "thinking:b"}, []string{"thinking:ab"}},
+		{"empty", `[]`, []string{}, nil},
+		{"null", `null`, []string{}, nil},
+		{"malformed", `[{"type":"thinking","thinking":null}]`, []string{`text:[{"type":"thinking","thinking":null}]`}, []string{}},
+		{"unknown", `[{"type":"image","url":"fixture"}]`, []string{`text:[{"type":"image","url":"fixture"}]`}, []string{}},
+		{"unknown-mixed", `[{"type":"text","text":"a"},{"type":"unknown"}]`, []string{`text:[{"type":"text","text":"a"},{"type":"unknown"}]`}, []string{"text:a"}},
+	}
+	for _, tc := range cases {
+		for _, registered := range []bool{false, true} {
+			name := "helper/"
+			if registered {
+				name = "registered/"
+			}
+			t.Run(name+tc.name, func(t *testing.T) {
+				raw := []byte(`{"id":"fixture","model":"fixture","choices":[{"message":{"content":` + tc.content + `},"finish_reason":"stop"}],"usage":{"prompt_tokens":11,"completion_tokens":4}}`)
+				out := convertOpenAINonStreamingToAnthropic(raw)[0]
+				want := tc.want
+				if registered {
+					out = ConvertOpenAIResponseToClaudeNonStream(context.Background(), "", nil, nil, raw, nil)
+					if tc.registered != nil {
+						want = tc.registered
+					}
+				}
+				got := []string{}
+				for _, block := range gjson.GetBytes(out, "content").Array() {
+					kind := block.Get("type").String()
+					got = append(got, kind+":"+block.Get(kind).String())
+					if block.Get("signature").Exists() {
+						t.Fatal("fabricated signature")
+					}
+				}
+				if !reflect.DeepEqual(got, want) {
+					t.Fatalf("got %#v, want %#v", got, want)
+				}
+				if gjson.GetBytes(out, "usage.input_tokens").Int() != 11 || gjson.GetBytes(out, "usage.output_tokens").Int() != 4 || gjson.GetBytes(out, "stop_reason").String() != "end_turn" {
+					t.Fatalf("finish/usage lost: %s", out)
+				}
+			})
+		}
+	}
+}
