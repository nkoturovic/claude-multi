diff --git a/internal/runtime/executor/openai_compat_redirect.go b/internal/runtime/executor/openai_compat_redirect.go
new file mode 100644
index 0000000..b41e94f
--- /dev/null
+++ b/internal/runtime/executor/openai_compat_redirect.go
@@ -0,0 +1,93 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/upstreamredirect"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// openAICompatRedirectMode captures the redirect policy of an
+// OpenAI-compatible request from the selected auth — the same information
+// that attaches its credentials (resolveCredentials' api_key and the
+// configured "header:" attributes that ApplyCustomHeadersFromAttrs sends).
+// A keyed provider follows no redirect at all (the keyed-compat mode, which
+// keyed chat safety requires); a configured custom header counts as a credential,
+// because its name is arbitrary. The request itself can carry credentials
+// the auth does not show, so the policy of a request is
+// openAICompatRequestRedirectMode.
+func openAICompatRedirectMode(auth *cliproxyauth.Auth) upstreamredirect.Mode {
+	if auth == nil || auth.Attributes == nil {
+		return upstreamredirect.Unrestricted
+	}
+	if strings.TrimSpace(auth.Attributes["api_key"]) != "" {
+		return upstreamredirect.RefuseAll
+	}
+	for key, value := range auth.Attributes {
+		if !strings.HasPrefix(key, "header:") {
+			continue
+		}
+		if strings.TrimSpace(strings.TrimPrefix(key, "header:")) != "" && strings.TrimSpace(value) != "" {
+			return upstreamredirect.RefuseAll
+		}
+	}
+	return upstreamredirect.Unrestricted
+}
+
+// openAICompatCredentiallessHeaders are the only request headers a
+// credentialless compat request may carry: the ones the executor itself sets
+// on a keyless request (content negotiation, user agent, caching) and the
+// transport-level framing headers. Any other header — Authorization,
+// X-Api-Key, Cookie, or an arbitrary caller-supplied name — may be a
+// credential.
+var openAICompatCredentiallessHeaders = map[string]struct{}{
+	"Accept":           {},
+	"Accept-Encoding":  {},
+	"Accept-Language":  {},
+	"Cache-Control":    {},
+	"Connection":       {},
+	"Content-Encoding": {},
+	"Content-Language": {},
+	"Content-Length":   {},
+	"Content-Type":     {},
+	"Pragma":           {},
+	"User-Agent":       {},
+}
+
+// openAICompatRequestRedirectMode captures the redirect policy of one
+// OpenAI-compatible request from the selected auth AND the fully prepared
+// initial request, before Do (never from a redirected request's headers).
+// Unrestricted (Go's default, the keyless/LAN behaviour) is reserved for a
+// demonstrably credentialless request: a keyless auth, no URL userinfo, no
+// query string (a query can carry a key), and only
+// openAICompatCredentiallessHeaders. Anything else — a keyed auth, a header
+// the caller attached before HttpRequest, URL userinfo — follows no
+// redirect (RefuseAll).
+func openAICompatRequestRedirectMode(auth *cliproxyauth.Auth, req *http.Request) upstreamredirect.Mode {
+	if mode := openAICompatRedirectMode(auth); mode != upstreamredirect.Unrestricted {
+		return mode
+	}
+	if req == nil || req.URL == nil {
+		return upstreamredirect.RefuseAll
+	}
+	if req.URL.User != nil || req.URL.RawQuery != "" || req.URL.ForceQuery {
+		return upstreamredirect.RefuseAll
+	}
+	for name := range req.Header {
+		if _, ok := openAICompatCredentiallessHeaders[http.CanonicalHeaderKey(name)]; !ok {
+			return upstreamredirect.RefuseAll
+		}
+	}
+	return upstreamredirect.Unrestricted
+}
+
+// newHTTPClient returns the compat HTTP client for the prepared request req,
+// with the redirect policy captured from auth and req, and that mode for the
+// post-Do check. Call it after every header of req is set and before Do.
+func (e *OpenAICompatExecutor) newHTTPClient(ctx context.Context, auth *cliproxyauth.Auth, req *http.Request) (*http.Client, upstreamredirect.Mode) {
+	mode := openAICompatRequestRedirectMode(auth, req)
+	return upstreamredirect.Guard(helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0), mode), mode
+}
