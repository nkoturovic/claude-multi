+// TestCM053KeylessCompatRedirectBehaviorPreserved: a keyless compat provider
+// (no key, no custom header: the LAN route) keeps Go's default handling — the
+// redirect is followed, exactly as before the patch — for chat, stream and a
+// credentialless generic HttpRequest.
+func TestCM053KeylessCompatRedirectBehaviorPreserved(t *testing.T) {
+	keyless := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": "http://lan.cm053.example/v1"}}
+	if mode := openAICompatRedirectMode(keyless); mode != upstreamredirect.Unrestricted {
+		t.Fatalf("keyless compat mode = %d, want Unrestricted", mode)
+	}
+	plain, _ := http.NewRequest(http.MethodPost, "http://lan.cm053.example/v1/chat/completions", strings.NewReader(`{}`))
+	for _, name := range []string{"Content-Type", "User-Agent", "Accept", "Cache-Control"} {
+		plain.Header.Set(name, "cm053-plain")
+	}
+	if mode := openAICompatRequestRedirectMode(keyless, plain); mode != upstreamredirect.Unrestricted {
+		t.Fatalf("keyless credentialless request mode = %d, want Unrestricted", mode)
+	}
+	for _, entry := range cm053CompatEntryPoints(false)[:2] {
+		entry := entry
+		t.Run(entry.name, func(t *testing.T) {
+			upstream := &cm053RedirectUpstream{status: http.StatusTemporaryRedirect, location: "https://" + cm053EvilHost + "/lan-moved"}
+			capture := cm053CaptureContext(upstream)
+			_ = entry.run(capture.ctx, &config.Config{})
+			hits, _ := upstream.snapshot()
+			if len(hits) != 2 || !strings.Contains(hits[1].host, cm053EvilHost) || hits[1].bodyLen == 0 {
+				t.Fatalf("keyless compat redirect hits = %+v, want it followed with the body replayed (upstream behaviour)", hits)
+			}
+		})
+	}
+	t.Run("compat/http-request", func(t *testing.T) {
+		upstream := &cm053RedirectUpstream{status: http.StatusTemporaryRedirect, location: "https://" + cm053EvilHost + "/lan-moved"}
+		ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(upstream))
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://api.cm053.example/v1/anything", strings.NewReader(`{"x":1}`))
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := NewOpenAICompatExecutor("openai-compatibility", &config.Config{}).HttpRequest(ctx, keyless, req)
+		if err != nil {
+			t.Fatalf("keyless HttpRequest error = %v", err)
+		}
+		_ = resp.Body.Close()
+		hits, _ := upstream.snapshot()
+		if len(hits) != 2 || !strings.Contains(hits[1].host, cm053EvilHost) || hits[1].bodyLen == 0 || resp.StatusCode != http.StatusOK {
+			t.Fatalf("keyless HttpRequest redirect hits = %+v status %d, want it followed with the body replayed", hits, resp.StatusCode)
+		}
+	})
+}
