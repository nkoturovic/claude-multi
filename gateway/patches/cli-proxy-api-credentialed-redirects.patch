+// TestCM053ExecutorClientFactoryCoverage pins the coverage table above against
+// the source: every HTTP Do in the executor packages and the Claude/Codex
+// OAuth clients is wrapped by the post-Do check (except the named
+// uncredentialed grounding resolver), and every client literal carries the
+// same-origin policy.
+func TestCM053ExecutorClientFactoryCoverage(t *testing.T) {
+	roots := []string{".", "helps", filepath.Join("..", "..", "auth", "claude"), filepath.Join("..", "..", "auth", "codex")}
+	doCall := regexp.MustCompile(`\.Do\((httpReq|req)\)`)
+	wrapped := regexp.MustCompile(`(upstreamredirect|redirectMode)\.(Result|StripLocation)\([^()]*\.Do\((httpReq|req)\)\)`)
+	literal := regexp.MustCompile(`&http\.Client\{`)
+	policy := regexp.MustCompile(`CheckRedirect:\s*upstreamredirect\.CheckRedirect\(upstreamredirect\.SameOrigin\)`)
+	unwrappedAllowed := map[string]int{filepath.Join("helps", "antigravity_grounding_urls.go"): 1}
+	wantLiterals := map[string]int{
+		filepath.Join("helps", "proxy_helpers.go"):                       4,
+		filepath.Join("helps", "utls_client.go"):                         1,
+		"antigravity_executor.go":                                        1,
+		filepath.Join("..", "..", "auth", "claude", "utls_transport.go"): 1,
+		filepath.Join("..", "..", "auth", "codex", "openai_auth.go"):     1,
+	}
+	totalWrapped := 0
+	for _, root := range roots {
+		files, errGlob := filepath.Glob(filepath.Join(root, "*.go"))
+		if errGlob != nil {
+			t.Fatal(errGlob)
+		}
+		for _, file := range files {
+			if strings.HasSuffix(file, "_test.go") {
+				continue
+			}
+			src, errRead := os.ReadFile(file)
+			if errRead != nil {
+				t.Fatal(errRead)
+			}
+			rel := filepath.Clean(file)
+			unwrapped := 0
+			for _, line := range strings.Split(string(src), "\n") {
+				if !doCall.MatchString(line) {
+					continue
+				}
+				if wrapped.MatchString(line) {
+					totalWrapped++
+					continue
+				}
+				unwrapped++
+			}
+			if unwrapped != unwrappedAllowed[rel] {
+				t.Errorf("%s: %d HTTP Do call(s) without the post-Do redirect check (allowed %d)", rel, unwrapped, unwrappedAllowed[rel])
+			}
+			literals := len(literal.FindAllIndex(src, -1))
+			if literals != wantLiterals[rel] {
+				t.Errorf("%s: %d http.Client literal(s), coverage table has %d", rel, literals, wantLiterals[rel])
+			}
+			if literals > 0 && len(policy.FindAllIndex(src, -1)) < literals {
+				t.Errorf("%s: an http.Client literal lacks the same-origin redirect policy", rel)
+			}
+		}
+	}
+	// 52 executor sites + 5 OAuth sites on the pinned source; a lower count means a site
+	// moved out of the scan.
+	if totalWrapped != 57 {
+		t.Errorf("wrapped Do sites = %d, want 57 (update the coverage table deliberately)", totalWrapped)
+	}
+}
