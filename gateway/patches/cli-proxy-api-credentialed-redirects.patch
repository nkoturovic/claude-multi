+// cm053CompatCredentialedRequest is one initial request whose credential the
+// auth does not show: a header attached by the caller before HttpRequest, or
+// a URL credential.
+type cm053CompatCredentialedRequest struct {
+	name     string
+	url      string
+	header   string
+	value    string
+	evidence func(hit cm053RedirectHit) bool
+}
+
+func cm053CompatCredentialedRequests() []cm053CompatCredentialedRequest {
+	return []cm053CompatCredentialedRequest{
+		{name: "x-api-key", url: "https://api.cm053.example/v1/anything", header: "X-Api-Key", value: "cm053-dummy-preattached-key"},
+		{name: "authorization", url: "https://api.cm053.example/v1/anything", header: "Authorization", value: "Bearer cm053-dummy-preattached-bearer"},
+		{name: "custom-header", url: "https://api.cm053.example/v1/anything", header: "X-Cm053-Custom-Credential", value: "cm053-dummy-custom"},
+		{name: "cookie", url: "https://api.cm053.example/v1/anything", header: "Cookie", value: "session=cm053-dummy-cookie"},
+		{name: "url-userinfo", url: "https://cm053user:cm053-dummy-pass@api.cm053.example/v1/anything", evidence: func(hit cm053RedirectHit) bool { return hit.header.Get("Authorization") != "" }},
+		{name: "url-query-key", url: "https://api.cm053.example/v1/anything?key=cm053-dummy-query-key"},
+	}
+}
