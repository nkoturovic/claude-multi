+type cm053EntryPoint struct {
+	name string
+	run  func(ctx context.Context, cfg *config.Config) error
+}
+
+func cm053DrainStream(result *cliproxyexecutor.StreamResult, err error) error {
+	if err != nil {
+		return err
+	}
+	var chunkErr error
+	for chunk := range result.Chunks {
+		if chunk.Err != nil && chunkErr == nil {
+			chunkErr = chunk.Err
+		}
+	}
+	return chunkErr
+}
