index 0000000..4432e7a
--- /dev/null
+++ b/internal/runtime/executor/upstream_redirect_cm053_test.go
@@ -0,0 +1,770 @@
+package executor
+
+// Credentialed redirect handling: entry-point matrix and the
+// executor client factory / entry-point coverage table.
+//
+// Coverage table (executable: TestCM053ExecutorClientFactoryCoverage pins it
+// against the source, so a new client literal or an unwrapped Do fails).
+//
+//	Factory / client                           Mode               Entry points (post-Do check)
+//	helps.NewProxyAwareHTTPClient              same-origin        Gemini, Vertex, Kimi, xAI, Meta, Codex images,
+//	                                                              Antigravity (via newAntigravityHTTPClient): Result;
+//	                                                              HttpRequest: StripLocation
+//	helps.NewUtlsHTTPClient                    same-origin        Claude Execute/ExecuteStream/countTokensUpstream
+//	                                                              (doClaudeUpstreamRequest), Codex HTTP: Result;
+//	                                                              Claude/Codex HttpRequest: StripLocation
+//	helps.NewDevinHTTPClient (3 branches)      same-origin        Devin: Result; HttpRequest: StripLocation
+//	antigravity direct proxy client            same-origin        Antigravity: Result; HttpRequest: StripLocation
+//	OpenAICompatExecutor.newHTTPClient         credentialed:      OpenAI-compatible chat, stream, compact, images:
+//	  (helps.NewProxyAwareHTTPClient + Guard,  refuse-all;        redirectMode.Result; HttpRequest: StripLocation
+//	  mode from the auth AND the prepared      credentialless:
+//	  initial request)                         Go default
+//	claude.NewAnthropicHttpClient (OAuth)      same-origin        token exchange, refresh, profile/roles: Result
+//	codex.NewCodexAuth client (OAuth)          same-origin        token exchange, refresh: Result
+//
+// Residuals (named; claude-multi routes to none of them as a credentialed
+// request, or they carry no credential):
+//   - helps.resolveAntigravityGroundingURL: an uncredentialed HEAD to a public
+//     vertexaisearch redirect URL that deliberately reads Location (its own
+//     CheckRedirect = ErrUseLastResponse); unchanged.
+//   - Clients handed to libraries (the Kimi device-flow refresh client, the
+//     Vertex service-account oauth2 token client) carry the factory's
+//     same-origin CheckRedirect, but the library owns Do, so there is no
+//     post-Do check: a final 3xx surfaces as that library's error.
+//   - WebSocket paths (Codex and xAI websockets, the AI Studio relay) are not
+//     HTTP redirects and are out of scope.
+//   - Other OAuth/login clients under internal/auth (Kimi, Meta, Antigravity,
+//     Gemini, Qwen, iFlow, ...) are not claude-multi routes.
+//
+// Every upstream below is an injected RoundTripper ("cliproxy.roundtripper")
+// that records each request; no socket is opened and no external network is
+// involved.
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/clienterror"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/logging"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/upstreamredirect"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+const (
+	cm053RedirectCanary = "cm053-location-canary"
+	cm053EvilHost       = "evil.cm053.example"
+	cm053UpstreamHeader = "cm053-upstream-header-value"
+)
+
+type cm053RedirectHit struct {
+	host    string
+	path    string
+	bodyLen int
+	header  http.Header
+}
+
+type cm053RedirectBody struct {
+	mu     sync.Mutex
+	r      io.Reader
+	read   int
+	closed bool
+}
+
+func (b *cm053RedirectBody) Read(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	n, err := b.r.Read(p)
+	b.read += n
+	return n, err
+}
+
+func (b *cm053RedirectBody) Close() error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.closed = true
+	return nil
+}
+
+// cm053RedirectUpstream answers every request to a non-evil host with the
+// scripted 3xx (a request to /cm053-hop2 is redirected to the evil host: the
+// multi-hop escape), and every request to the evil host with 200.
+type cm053RedirectUpstream struct {
+	mu       sync.Mutex
+	status   int
+	location string
+	hits     []cm053RedirectHit
+	bodies   []*cm053RedirectBody
+}
+
+func (u *cm053RedirectUpstream) RoundTrip(req *http.Request) (*http.Response, error) {
+	var n int
+	if req.Body != nil {
+		body, _ := io.ReadAll(req.Body)
+		_ = req.Body.Close()
+		n = len(body)
+	}
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.hits = append(u.hits, cm053RedirectHit{host: req.URL.Host, path: req.URL.Path, bodyLen: n, header: req.Header.Clone()})
+	if strings.Contains(req.URL.Host, cm053EvilHost) {
+		return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(`{"stolen":true}`)), Request: req}, nil
+	}
+	location := u.location
+	if strings.HasSuffix(req.URL.Path, "/cm053-hop2") {
+		location = "https://" + cm053EvilHost + "/hop2-escape?" + cm053RedirectCanary
+	}
+	body := &cm053RedirectBody{r: bytes.NewReader(append([]byte(`{"redirect":"`+cm053RedirectCanary+`","pad":"`), bytes.Repeat([]byte("P"), 64<<10)...))}
+	u.bodies = append(u.bodies, body)
+	return &http.Response{
+		StatusCode: u.status,
+		Header: http.Header{
+			"Location":          []string{location},
+			"Content-Type":      []string{"application/json"},
+			"X-Upstream-Secret": []string{cm053UpstreamHeader},
+			"Retry-After":       []string{"3600"},
+		},
+		Body:    body,
+		Request: req,
+	}, nil
+}
+
+func (u *cm053RedirectUpstream) snapshot() ([]cm053RedirectHit, []*cm053RedirectBody) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return append([]cm053RedirectHit(nil), u.hits...), append([]*cm053RedirectBody(nil), u.bodies...)
+}
+
+type cm053Capture struct {
+	ctx context.Context
+	gin *gin.Context
+}
+
+// cm053CaptureContext returns a context with the injected upstream, request-log
+// capture (a gin context) and the response-headers holder, so the gate can
+// prove no Location or upstream header value was recorded anywhere.
+func cm053CaptureContext(upstream http.RoundTripper) cm053Capture {
+	gin.SetMode(gin.TestMode)
+	ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ginCtx.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+	ctx := context.WithValue(context.Background(), "gin", ginCtx)
+	ctx = logging.WithResponseHeadersHolder(ctx)
+	ctx = context.WithValue(ctx, "cliproxy.roundtripper", upstream)
+	return cm053Capture{ctx: ctx, gin: ginCtx}
+}
+
+func cm053CaptureConfig() *config.Config {
+	cfg := &config.Config{}
+	cfg.RequestLog = true
+	return cfg
+}
+
+func (c cm053Capture) assertNothingCaptured(t *testing.T) {
+	t.Helper()
+	for key, value := range c.gin.Keys {
+		var text string
+		switch v := value.(type) {
+		case []byte:
+			text = string(v)
+		case string:
+			text = v
+		default:
+			text = fmt.Sprintf("%v", v)
+		}
+		for _, needle := range []string{cm053RedirectCanary, cm053EvilHost, cm053UpstreamHeader} {
+			if strings.Contains(text, needle) {
+				t.Fatalf("captured %s contains %q: %s", key, needle, text)
+			}
+		}
+	}
+	headers := logging.GetResponseHeaders(c.ctx)
+	for key, values := range headers {
+		if strings.EqualFold(key, "Location") || strings.Contains(strings.Join(values, ","), cm053RedirectCanary) || strings.Contains(strings.Join(values, ","), cm053UpstreamHeader) {
+			t.Fatalf("response-header metadata recorded %s: %v", key, values)
+		}
+	}
+}
+
+// cm053AssertFixedRefusal is the go/no-go assertion for one entry point: a
+// fixed local 502 "upstream redirect refused", never a direct response, no
+// Location or upstream header value anywhere, no request to the destination,
+// and the refused body drained (at most 2 KiB) and closed.
+func cm053AssertFixedRefusal(t *testing.T, err error, capture cm053Capture, upstream *cm053RedirectUpstream) {
+	t.Helper()
+	if err == nil {
+		t.Fatal("redirected request succeeded; want a refusal")
+	}
+	if got := clienterror.HTTPStatusFromError(err); got != http.StatusBadGateway {
+		t.Fatalf("downstream status = %d (%T %v), want 502", got, err, err)
+	}
+	if !upstreamredirect.IsRefused(err) || err.Error() != upstreamredirect.Message {
+		t.Fatalf("error = %T %q, want the fixed %q", err, err.Error(), upstreamredirect.Message)
+	}
+	var direct *cliproxyexecutor.RequestTerminatedError
+	if errors.As(err, &direct) {
+		t.Fatalf("refusal became a direct response: status %d headers %v", direct.StatusCode(), direct.ResponseHeaders())
+	}
+	type headerCarrier interface{ Headers() http.Header }
+	var carrier headerCarrier
+	if errors.As(err, &carrier) && len(carrier.Headers()) > 0 {
+		t.Fatalf("refusal carries upstream headers: %v", carrier.Headers())
+	}
+	hits, bodies := upstream.snapshot()
+	if len(hits) == 0 {
+		t.Fatal("the origin received no request")
+	}
+	for _, hit := range hits {
+		if strings.Contains(hit.host, cm053EvilHost) {
+			t.Fatalf("the redirect destination received a request: %+v", hit)
+		}
+	}
+	for i, body := range bodies {
+		body.mu.Lock()
+		closed, read := body.closed, body.read
+		body.mu.Unlock()
+		if i == len(bodies)-1 && (!closed || read > 2<<10) {
+			t.Fatalf("refused body closed=%t read=%d, want closed after at most 2 KiB", closed, read)
+		}
+	}
+	capture.assertNothingCaptured(t)
+}
+
+var cm053RedirectCodes = []int{http.StatusMovedPermanently, http.StatusFound, http.StatusSeeOther, http.StatusTemporaryRedirect, http.StatusPermanentRedirect}
+
+// cm053SameOriginDestinations are refused by every credentialed mode; the
+// multi-hop case is a permitted same-origin hop followed by an escape.
+var cm053SameOriginDestinations = map[string]string{
+	"unrelated-host": "https://" + cm053EvilHost + "/steal?" + cm053RedirectCanary,
+	"https-to-http":  "http://" + cm053EvilHost + "/steal?" + cm053RedirectCanary,
+	"multi-hop":      "/cm053-hop2?" + cm053RedirectCanary,
+	"malformed":      "https://" + cm053EvilHost + "/%zz?" + cm053RedirectCanary,
+}
