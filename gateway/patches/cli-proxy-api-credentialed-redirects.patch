+// TestCM053GenericHttpRequestStripsLocation: the generic HttpRequest APIs keep
+// returning the upstream response, with Location removed and no request to
+// the destination.
+func TestCM053GenericHttpRequestStripsLocation(t *testing.T) {
+	type httpRequester interface {
+		HttpRequest(context.Context, *cliproxyauth.Auth, *http.Request) (*http.Response, error)
+	}
+	cases := []struct {
+		name string
+		exec httpRequester
+		auth *cliproxyauth.Auth
+	}{
+		{"claude", NewClaudeExecutor(&config.Config{}), &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "cm053-dummy", "base_url": "https://api.cm053.example"}}},
+		{"codex", NewCodexExecutor(&config.Config{}), &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "cm053-dummy", "base_url": "https://api.cm053.example"}}},
+		{"gemini", NewGeminiExecutor(&config.Config{}), &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "cm053-dummy"}}},
+		{"vertex", NewGeminiVertexExecutor(&config.Config{}), &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "cm053-dummy"}}},
+		{"xai", NewXAIExecutor(&config.Config{}), &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "cm053-dummy"}}},
+		{"compat-keyed", NewOpenAICompatExecutor("openai-compatibility", &config.Config{}), &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "cm053-dummy", "base_url": "https://api.cm053.example/v1"}}},
+	}
+	for _, tc := range cases {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			upstream := &cm053RedirectUpstream{status: http.StatusTemporaryRedirect, location: "https://" + cm053EvilHost + "/steal?" + cm053RedirectCanary}
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(upstream))
+			req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://api.cm053.example/v1/anything", strings.NewReader(`{"x":1}`))
+			resp, err := tc.exec.HttpRequest(ctx, tc.auth, req)
+			if err != nil {
+				t.Fatalf("HttpRequest error = %v, want the response", err)
+			}
+			defer resp.Body.Close()
+			if resp.StatusCode != http.StatusTemporaryRedirect {
+				t.Fatalf("status = %d, want the upstream 307", resp.StatusCode)
+			}
+			if got := resp.Header.Values("Location"); len(got) != 0 {
+				t.Fatalf("generic response still carries Location %v", got)
+			}
+			hits, _ := upstream.snapshot()
+			for _, hit := range hits {
+				if strings.Contains(hit.host, cm053EvilHost) {
+					t.Fatalf("destination received a request: %+v", hit)
+				}
+			}
+		})
+	}
+}
