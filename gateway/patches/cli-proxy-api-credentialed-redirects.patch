+// TestCM053KeyedCompatRefusesEveryRedirect: a keyed OpenAI-compatible provider
+// follows no redirect — relative and same-origin included.
+func TestCM053KeyedCompatRefusesEveryRedirect(t *testing.T) {
+	destinations := map[string]string{
+		"relative":             "/v1/elsewhere?" + cm053RedirectCanary,
+		"same-origin-absolute": "https://api.cm053.example/v1/elsewhere?" + cm053RedirectCanary,
+	}
+	for name, location := range cm053SameOriginDestinations {
+		destinations[name] = location
+	}
+	cm053RunRefusalMatrix(t, cm053CompatEntryPoints(true), destinations, true)
+
+	// A configured custom header counts as a credential too.
+	upstream := &cm053RedirectUpstream{status: http.StatusTemporaryRedirect, location: "/v1/elsewhere?" + cm053RedirectCanary}
+	capture := cm053CaptureContext(upstream)
+	auth := &cliproxyauth.Auth{ID: "cm053-compat-header", Provider: "openai-compatibility", Attributes: map[string]string{"base_url": "https://api.cm053.example/v1", "header:X-Cm053-Token": "cm053-dummy-header-credential"}}
+	// The auth-level decision alone is RefuseAll for a key and for a
+	// configured custom header (the prepared-request check is a second,
+	// independent layer).
+	for _, credentialed := range []*cliproxyauth.Auth{auth, cm053CompatEntryPointAuth(true)} {
+		if mode := openAICompatRedirectMode(credentialed); mode != upstreamredirect.RefuseAll {
+			t.Fatalf("auth-level compat mode for %s = %d, want RefuseAll", credentialed.ID, mode)
+		}
+	}
+	_, err := NewOpenAICompatExecutor("openai-compatibility", cm053CaptureConfig()).Execute(capture.ctx, auth, cliproxyexecutor.Request{Model: "cm053-chat", Payload: []byte(`{"model":"cm053-chat","messages":[{"role":"user","content":"hi"}]}`)}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI})
+	cm053AssertFixedRefusal(t, err, capture, upstream)
+	if hits, _ := upstream.snapshot(); len(hits) != 1 {
+		t.Fatalf("header-credentialed compat followed a redirect: %d upstream requests, want 1", len(hits))
+	}
+}
