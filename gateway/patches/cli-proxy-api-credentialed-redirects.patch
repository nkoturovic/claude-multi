diff --git a/internal/auth/claude/oauth_redirect_cm053_test.go b/internal/auth/claude/oauth_redirect_cm053_test.go
new file mode 100644
index 0000000..565dd1e
--- /dev/null
+++ b/internal/auth/claude/oauth_redirect_cm053_test.go
@@ -0,0 +1,63 @@
+package claude
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/upstreamredirect"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+// Credentialed redirects: the claude OAuth control-plane client carries credentials
+// in a replayable refresh body, so it follows redirects only within the
+// original origin, and a refused redirect is a fixed refusal with no Location.
+
+type cm053OAuthUpstream struct {
+	mu    sync.Mutex
+	hosts []string
+}
+
+func (u *cm053OAuthUpstream) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Body != nil {
+		_, _ = io.Copy(io.Discard, req.Body)
+		_ = req.Body.Close()
+	}
+	u.mu.Lock()
+	u.hosts = append(u.hosts, req.URL.Host)
+	u.mu.Unlock()
+	if strings.Contains(req.URL.Host, "evil.cm053.example") {
+		return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(`{"access_token":"stolen"}`)), Request: req}, nil
+	}
+	return &http.Response{
+		StatusCode: http.StatusTemporaryRedirect,
+		Header:     http.Header{"Location": []string{"https://evil.cm053.example/token?cm053-location-canary"}},
+		Body:       io.NopCloser(strings.NewReader("cm053-location-canary")),
+		Request:    req,
+	}, nil
+}
+
+func TestCM053OAuthRefreshRefusesCrossOriginRedirect(t *testing.T) {
+	upstream := &cm053OAuthUpstream{}
+	o := &ClaudeAuth{httpClient: NewAnthropicHttpClient(&config.SDKConfig{})}
+	if o.httpClient.CheckRedirect == nil {
+		t.Fatal("OAuth client has no redirect policy")
+	}
+	o.httpClient.Transport = upstream // keep the constructed CheckRedirect
+	var data *ClaudeTokenData
+	data, err := o.RefreshTokens(context.Background(), "cm053-dummy-refresh-token")
+	if data != nil || !upstreamredirect.IsRefused(err) {
+		t.Fatalf("refresh = %v, %v; want the fixed redirect refusal", data, err)
+	}
+	if strings.Contains(err.Error(), "cm053-location-canary") || strings.Contains(err.Error(), "evil.cm053.example") {
+		t.Fatalf("refresh error carries the Location: %v", err)
+	}
+	upstream.mu.Lock()
+	defer upstream.mu.Unlock()
+	if len(upstream.hosts) != 1 || strings.Contains(upstream.hosts[0], "evil") {
+		t.Fatalf("requests = %v, want only the token endpoint", upstream.hosts)
+	}
+}
