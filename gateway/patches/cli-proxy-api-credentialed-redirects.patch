diff --git a/internal/runtime/executor/helps/upstream_redirect_cm053_test.go b/internal/runtime/executor/helps/upstream_redirect_cm053_test.go
new file mode 100644
index 0000000..6ca458b
--- /dev/null
+++ b/internal/runtime/executor/helps/upstream_redirect_cm053_test.go
@@ -0,0 +1,131 @@
+package helps
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/upstreamredirect"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+// Every executor client factory in this package returns a client
+// with the credentialed same-origin redirect policy, on every construction
+// branch, and the usage wrapper (TrackHTTPClient*) keeps it.
+
+// cm053AssertSameOriginPolicy checks a client's CheckRedirect functionally: a
+// cross-origin hop is refused with ErrUseLastResponse, a same-origin hop is
+// permitted.
+func cm053AssertSameOriginPolicy(t *testing.T, name string, client *http.Client) {
+	t.Helper()
+	if client == nil || client.CheckRedirect == nil {
+		t.Fatalf("%s: client has no redirect policy (Go's default follows any origin)", name)
+	}
+	original, _ := http.NewRequest(http.MethodPost, "https://api.cm053.example/v1/messages", nil)
+	cross, _ := http.NewRequest(http.MethodPost, "https://evil.cm053.example/steal", nil)
+	same, _ := http.NewRequest(http.MethodPost, "https://api.cm053.example/v1/other", nil)
+	if err := client.CheckRedirect(cross, []*http.Request{original}); !errors.Is(err, http.ErrUseLastResponse) {
+		t.Fatalf("%s: cross-origin hop = %v, want ErrUseLastResponse", name, err)
+	}
+	if err := client.CheckRedirect(same, []*http.Request{original}); err != nil {
+		t.Fatalf("%s: same-origin hop = %v, want permitted", name, err)
+	}
+}
+
+type cm053RecordingRT struct {
+	mu    sync.Mutex
+	hosts []string
+}
+
+func (r *cm053RecordingRT) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Body != nil {
+		_, _ = io.Copy(io.Discard, req.Body)
+		_ = req.Body.Close()
+	}
+	r.mu.Lock()
+	r.hosts = append(r.hosts, req.URL.Host)
+	r.mu.Unlock()
+	if req.URL.Host == "api.cm053.example" {
+		return &http.Response{
+			StatusCode: http.StatusTemporaryRedirect,
+			Header:     http.Header{"Location": []string{"https://evil.cm053.example/steal"}},
+			Body:       io.NopCloser(strings.NewReader("redirect")),
+			Request:    req,
+		}, nil
+	}
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{}, Body: io.NopCloser(strings.NewReader("stolen")), Request: req}, nil
+}
+
+func (r *cm053RecordingRT) snapshot() []string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]string(nil), r.hosts...)
+}
+
+// TestCM053HelpsClientFactoriesCarrySameOriginPolicy covers every construction
+// branch of NewProxyAwareHTTPClient, NewUtlsHTTPClient and NewDevinHTTPClient.
+func TestCM053HelpsClientFactoriesCarrySameOriginPolicy(t *testing.T) {
+	proxyCfg := &config.Config{SDKConfig: sdkconfig.SDKConfig{ProxyURL: "http://proxy.cm053.example:8080"}}
+	plainCfg := &config.Config{}
+	rtCtx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(&cm053RecordingRT{}))
+	transportCtx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(&http.Transport{}))
+	auth := &cliproxyauth.Auth{ID: "cm053-factory"}
+
+	cm053AssertSameOriginPolicy(t, "NewProxyAwareHTTPClient/direct", NewProxyAwareHTTPClient(context.Background(), plainCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewProxyAwareHTTPClient/proxy", NewProxyAwareHTTPClient(context.Background(), proxyCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewProxyAwareHTTPClient/context-roundtripper", NewProxyAwareHTTPClient(rtCtx, plainCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewProxyAwareHTTPClient/timeout", NewProxyAwareHTTPClient(context.Background(), plainCfg, auth, 1))
+
+	cm053AssertSameOriginPolicy(t, "NewUtlsHTTPClient/direct", NewUtlsHTTPClient(context.Background(), plainCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewUtlsHTTPClient/proxy", NewUtlsHTTPClient(context.Background(), proxyCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewUtlsHTTPClient/context-roundtripper", NewUtlsHTTPClient(rtCtx, plainCfg, auth, 0))
+
+	cm053AssertSameOriginPolicy(t, "NewDevinHTTPClient/context-transport", NewDevinHTTPClient(transportCtx, plainCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewDevinHTTPClient/context-roundtripper", NewDevinHTTPClient(rtCtx, plainCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewDevinHTTPClient/direct", NewDevinHTTPClient(context.Background(), plainCfg, auth, 0))
+	cm053AssertSameOriginPolicy(t, "NewDevinHTTPClient/proxy", NewDevinHTTPClient(context.Background(), proxyCfg, auth, 0))
+}
+
+// TestCM053UsageWrapperPreservesRedirectPolicy: TrackHTTPClient copies the
+// client and replaces its transport; the redirect policy survives, and a
+// cross-origin redirect through the wrapped client reaches no destination.
+func TestCM053UsageWrapperPreservesRedirectPolicy(t *testing.T) {
+	for _, packetOnly := range []bool{false, true} {
+		rec := &cm053RecordingRT{}
+		ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(rec))
+		base := NewProxyAwareHTTPClient(ctx, &config.Config{}, &cliproxyauth.Auth{ID: "cm053-usage"}, 0)
+		reporter := &UsageReporter{}
+		var tracked *http.Client
+		if packetOnly {
+			tracked = reporter.TrackHTTPClientRoundTripOnly(base)
+		} else {
+			tracked = reporter.TrackHTTPClient(base)
+		}
+		if tracked == base {
+			t.Fatal("usage wrapper returned the shared client instead of a copy")
+		}
+		cm053AssertSameOriginPolicy(t, "TrackHTTPClient", tracked)
+
+		for _, mode := range []upstreamredirect.Mode{upstreamredirect.SameOrigin, upstreamredirect.RefuseAll} {
+			guarded := reporter.TrackHTTPClient(upstreamredirect.Guard(base, mode))
+			req, _ := http.NewRequest(http.MethodPost, "https://api.cm053.example/v1/messages", bytes.NewReader([]byte("prompt")))
+			req.Header.Set("Authorization", "Bearer cm053-dummy")
+			resp, err := upstreamredirect.Result(guarded.Do(req))
+			if resp != nil || !upstreamredirect.IsRefused(err) {
+				t.Fatalf("mode %d through the usage wrapper: resp %v err %v, want refused", mode, resp, err)
+			}
+		}
+		for _, host := range rec.snapshot() {
+			if strings.Contains(host, "evil") {
+				t.Fatalf("a redirect through the usage wrapper reached %s", host)
+			}
+		}
+	}
+}
