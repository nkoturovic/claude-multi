+// TestCM053CompatPreparedRequestCredentialsRefuseRedirects: the policy is
+// captured from the auth AND the prepared initial request. A keyless auth
+// with a credential the caller attached to the HttpRequest (X-Api-Key,
+// Authorization, an arbitrary custom header, a cookie) or a URL credential
+// (userinfo, a query key) follows no redirect — cross-origin, relative or
+// same-origin — with a replayable POST body; the destination receives
+// nothing and the generic API returns the 3xx without Location.
+func TestCM053CompatPreparedRequestCredentialsRefuseRedirects(t *testing.T) {
+	keyless := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": "https://api.cm053.example/v1"}}
+	destinations := map[string]string{
+		"unrelated-host":       "https://" + cm053EvilHost + "/steal?" + cm053RedirectCanary,
+		"relative":             "/v1/elsewhere?" + cm053RedirectCanary,
+		"same-origin-absolute": "https://api.cm053.example/v1/elsewhere?" + cm053RedirectCanary,
+	}
+	for _, cred := range cm053CompatCredentialedRequests() {
+		for _, status := range []int{http.StatusTemporaryRedirect, http.StatusPermanentRedirect, http.StatusFound} {
+			for destName, location := range destinations {
+				cred, status, destName, location := cred, status, destName, location
+				t.Run(fmt.Sprintf("%s/%d/%s", cred.name, status, destName), func(t *testing.T) {
+					upstream := &cm053RedirectUpstream{status: status, location: location}
+					ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(upstream))
+					req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, cred.url, strings.NewReader(`{"prompt":"cm053-body"}`))
+					if errReq != nil {
+						t.Fatal(errReq)
+					}
+					if req.GetBody == nil {
+						t.Fatal("request body is not replayable")
+					}
+					req.Header.Set("Content-Type", "application/json")
+					if cred.header != "" {
+						req.Header.Set(cred.header, cred.value)
+					}
+					if mode := openAICompatRequestRedirectMode(keyless, req); mode != upstreamredirect.RefuseAll {
+						t.Fatalf("prepared-request mode = %d, want RefuseAll", mode)
+					}
+					resp, err := NewOpenAICompatExecutor("openai-compatibility", &config.Config{}).HttpRequest(ctx, keyless, req)
+					if err != nil {
+						t.Fatalf("HttpRequest error = %v, want the response", err)
+					}
+					_ = resp.Body.Close()
+					if resp.StatusCode != status {
+						t.Fatalf("status = %d, want the upstream %d", resp.StatusCode, status)
+					}
+					if got := resp.Header.Values("Location"); len(got) != 0 {
+						t.Fatalf("generic response still carries Location %v", got)
+					}
+					hits, _ := upstream.snapshot()
+					if len(hits) != 1 {
+						t.Fatalf("credentialed request followed a redirect: %d upstream requests %+v, want 1", len(hits), hits)
+					}
+					if cred.header != "" && hits[0].header.Get(cred.header) != cred.value {
+						t.Fatalf("first request lacks the synthetic credential %s", cred.header)
+					}
+					if cred.evidence != nil && !cred.evidence(hits[0]) {
+						t.Fatal("first request lacks the synthetic URL credential")
+					}
+				})
+			}
+		}
+	}
+}
