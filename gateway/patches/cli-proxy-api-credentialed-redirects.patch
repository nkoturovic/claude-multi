index 0000000..eaca26c
--- /dev/null
+++ b/internal/upstreamredirect/upstreamredirect.go
@@ -0,0 +1,279 @@
+// Package upstreamredirect is the redirect policy for credentialed upstream
+// HTTP clients.
+//
+// Go's http.Client follows up to ten redirects by default and replays the
+// request body on 307/308. It drops the standard sensitive headers when the
+// host changes, but it forwards arbitrary custom headers, and a same-host
+// redirect keeps every header. For a client that carries upstream
+// credentials (bearer or API-key headers, OAuth tokens, configured custom
+// headers) that means a hostile or misconfigured upstream can move the
+// prompt body, and possibly the credential, to another origin.
+//
+// The policy has two credentialed modes, both captured when the client is
+// built from the selected auth (never from a redirected request's headers):
+//
+//   - SameOrigin (authenticated executors and OAuth clients): a redirect is
+//     followed only when it keeps the original request's scheme, canonical
+//     hostname and effective port; destination userinfo and malformed or
+//     ambiguous destinations are refused, and every hop is compared with the
+//     original request, not the previous hop. The normal ten-hop limit stays.
+//   - RefuseAll (keyed OpenAI-compatible providers): no redirect is followed,
+//     relative and same-origin included.
+//
+// Unrestricted keeps Go's default handling for uncredentialed (keyless/LAN)
+// clients.
+//
+// A refused hop is stopped in CheckRedirect with http.ErrUseLastResponse,
+// before any RoundTrip to the destination. The last response then comes
+// back from Do as a 3xx; Result (or Mode.Result) runs immediately after Do
+// and turns every final 3xx that carries a Location header — refused here,
+// or never followed by Go (for example a 307/308 whose body cannot be
+// replayed, or a 300) — into RefusedError: a fixed local 502 with the text
+// "upstream redirect refused", no upstream headers and no body. It is keyed
+// on "3xx with Location", not on a flag set in CheckRedirect. It drains at
+// most 2 KiB of the refused body and closes it. The generic
+// HttpRequest-style APIs return the response instead, with Location
+// removed (StripLocation).
+//
+// The package depends on the standard library only, so both the executor
+// helpers and the OAuth packages can use it.
+package upstreamredirect
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// Mode selects the redirect policy of one client.
+type Mode uint8
+
+const (
+	// Unrestricted keeps Go's default redirect handling (uncredentialed clients).
+	Unrestricted Mode = iota
+	// SameOrigin follows only redirects that keep the original origin.
+	SameOrigin
+	// RefuseAll follows no redirect at all.
+	RefuseAll
+)
+
+// Message is the fixed text of a refused upstream redirect.
+const Message = "upstream redirect refused"
+
+// maxRedirects mirrors net/http's default ten-hop limit.
+const maxRedirects = 10
+
+// maxDrainBytes bounds how much of a refused response body is read before it
+// is closed (the same 2 KiB net/http reads to reuse a connection).
+const maxDrainBytes = 2 << 10
+
+// RefusedError is the fixed local failure for a refused upstream redirect. It
+// carries no upstream status, headers, body, URL or Location.
+type RefusedError struct{}
+
+// Error returns the fixed message.
+func (RefusedError) Error() string { return Message }
+
+// StatusCode reports 502 Bad Gateway.
+func (RefusedError) StatusCode() int { return http.StatusBadGateway }
+
+// IsRefused reports whether err is, or wraps, a refused upstream redirect.
+func IsRefused(err error) bool {
+	return errors.Is(err, RefusedError{})
+}
+
+// CheckRedirect returns the http.Client.CheckRedirect function for mode; nil
+// (Go's default) for Unrestricted.
+func CheckRedirect(mode Mode) func(req *http.Request, via []*http.Request) error {
+	switch mode {
+	case SameOrigin:
+		return checkSameOrigin
+	case RefuseAll:
+		return refuseAll
+	default:
+		return nil
+	}
+}
+
+// Guard returns a copy of client whose redirect policy is mode. The client
+// passed in is never modified, so a shared client stays untouched; its
+// transport, timeout and jar are preserved.
+func Guard(client *http.Client, mode Mode) *http.Client {
+	if client == nil {
+		return nil
+	}
+	guarded := *client
+	guarded.CheckRedirect = CheckRedirect(mode)
+	return &guarded
+}
+
+func refuseAll(*http.Request, []*http.Request) error {
+	return http.ErrUseLastResponse
+}
+
+func checkSameOrigin(req *http.Request, via []*http.Request) error {
+	if req == nil || len(via) == 0 || len(via) >= maxRedirects {
+		// Never return a non-sentinel error: net/http would then return the
+		// response together with an error that carries the Location.
+		return http.ErrUseLastResponse
+	}
+	if via[0] == nil || !SameOriginAllowed(via[0].URL, req.URL) {
+		return http.ErrUseLastResponse
+	}
+	return nil
+}
+
+// SameOriginAllowed reports whether a redirect from the original request URL
+// to dest keeps the same scheme, canonical hostname and effective port, with
+// no userinfo and no malformed or ambiguous component.
+func SameOriginAllowed(original, dest *url.URL) bool {
+	if original == nil || dest == nil {
+		return false
+	}
+	if dest.User != nil || dest.Opaque != "" {
+		return false
+	}
+	from, ok := canonicalOrigin(original)
+	if !ok {
+		return false
+	}
+	to, ok := canonicalOrigin(dest)
+	if !ok {
+		return false
+	}
+	return from == to
+}
+
+type origin struct {
+	scheme string
+	host   string
+	port   int
+}
+
+func canonicalOrigin(u *url.URL) (origin, bool) {
+	scheme := strings.ToLower(u.Scheme)
+	defaultPort := 0
+	switch scheme {
+	case "https":
+		defaultPort = 443
+	case "http":
+		defaultPort = 80
+	default:
+		return origin{}, false
+	}
+	host := strings.ToLower(u.Hostname())
+	if host == "" || strings.ContainsAny(host, " %\\") {
+		return origin{}, false
+	}
+	port := defaultPort
+	if raw := u.Port(); raw != "" {
+		n, err := strconv.Atoi(raw)
+		// A leading zero or an out-of-range port is ambiguous: refuse it.
+		if err != nil || n < 1 || n > 65535 || strconv.Itoa(n) != raw {
+			return origin{}, false
+		}
+		port = n
+	} else if strings.HasSuffix(u.Host, ":") {
+		// "host:" (an empty explicit port) is ambiguous.
+		return origin{}, false
+	}
+	return origin{scheme: scheme, host: host, port: port}, true
+}
+
+// Result is the post-Do check for a credentialed client. Call it immediately
+// after Do, before any metadata recording, capture or classification. A
+// final 3xx with a Location header, a refusal, or a malformed Location
+// becomes RefusedError; the refused body is drained (at most 2 KiB) and
+// closed. Every other result is returned unchanged.
+func Result(resp *http.Response, err error) (*http.Response, error) {
+	if err != nil {
+		if IsRefused(err) || isLocationParseError(err) {
+			closeRefused(resp)
+			return nil, RefusedError{}
+		}
+		return resp, err
+	}
+	if isRedirectWithLocation(resp) {
+		closeRefused(resp)
+		return nil, RefusedError{}
+	}
+	return resp, nil
+}
+
+// StripLocation is the post-Do check for the generic HttpRequest APIs, which
+// return the upstream response to their caller: a final 3xx keeps its status
+// and body, but every Location header is removed. A malformed Location still
+// becomes RefusedError, because net/http returns no response for it.
+func StripLocation(resp *http.Response, err error) (*http.Response, error) {
+	if err != nil {
+		if IsRefused(err) || isLocationParseError(err) {
+			closeRefused(resp)
+			return nil, RefusedError{}
+		}
+		return resp, err
+	}
+	if isRedirectWithLocation(resp) {
+		stripped := resp.Header.Clone()
+		for key := range stripped {
+			if strings.EqualFold(key, "Location") {
+				delete(stripped, key)
+			}
+		}
+		resp.Header = stripped
+	}
+	return resp, nil
+}
+
+// Result applies Result for a credentialed mode and returns the Unrestricted
+// result unchanged.
+func (m Mode) Result(resp *http.Response, err error) (*http.Response, error) {
+	if m == Unrestricted {
+		return resp, err
+	}
+	return Result(resp, err)
+}
+
+// StripLocation applies StripLocation for a credentialed mode and returns the
+// Unrestricted result unchanged.
+func (m Mode) StripLocation(resp *http.Response, err error) (*http.Response, error) {
+	if m == Unrestricted {
+		return resp, err
+	}
+	return StripLocation(resp, err)
+}
+
+func isRedirectWithLocation(resp *http.Response) bool {
+	if resp == nil || resp.StatusCode < 300 || resp.StatusCode > 399 {
+		return false
+	}
+	for key, values := range resp.Header {
+		if strings.EqualFold(key, "Location") && len(values) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// locationParseErrorPrefix is net/http's error text when a redirect's Location
+// cannot be parsed (net/http/client.go); that text embeds the Location, so the
+// error is replaced, never recorded. TestCM053LocationParseErrorShape pins it.
+const locationParseErrorPrefix = "failed to parse Location header"
+
+func isLocationParseError(err error) bool {
+	var urlErr *url.Error
+	if !errors.As(err, &urlErr) || urlErr == nil || urlErr.Err == nil {
+		return false
+	}
+	return strings.HasPrefix(urlErr.Err.Error(), locationParseErrorPrefix)
+}
+
+func closeRefused(resp *http.Response) {
+	if resp == nil || resp.Body == nil {
+		return
+	}
+	_, _ = io.CopyN(io.Discard, resp.Body, maxDrainBytes)
+	_ = resp.Body.Close()
+}
diff --git a/internal/upstreamredirect/upstreamredirect_cm053_test.go b/internal/upstreamredirect/upstreamredirect_cm053_test.go
new file mode 100644
index 0000000..27d4da2
--- /dev/null
+++ b/internal/upstreamredirect/upstreamredirect_cm053_test.go
@@ -0,0 +1,458 @@
+package upstreamredirect
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// Redirect policy gates. Every upstream is an injected RoundTripper that
+// records each request it receives (host, path, headers, body bytes), so the
+// matrix can name arbitrary hosts, ports and schemes without DNS or sockets.
+
+const cm053Canary = "cm053-location-canary"
+
+type cm053Hit struct {
+	url     string
+	host    string
+	method  string
+	header  http.Header
+	bodyLen int
+}
+
+type cm053Recorder struct {
+	mu   sync.Mutex
+	hits []cm053Hit
+	// respond returns the scripted response for one request.
+	respond func(req *http.Request) *http.Response
+}
+
+func (r *cm053Recorder) RoundTrip(req *http.Request) (*http.Response, error) {
+	var body []byte
+	if req.Body != nil {
+		body, _ = io.ReadAll(req.Body)
+		_ = req.Body.Close()
+	}
+	r.mu.Lock()
+	r.hits = append(r.hits, cm053Hit{url: req.URL.String(), host: req.URL.Host, method: req.Method, header: req.Header.Clone(), bodyLen: len(body)})
+	r.mu.Unlock()
+	resp := r.respond(req)
+	resp.Request = req
+	return resp, nil
+}
+
+func (r *cm053Recorder) snapshot() []cm053Hit {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]cm053Hit(nil), r.hits...)
+}
+
+// cm053Body tracks how much of a response body was read and whether it was closed.
+type cm053Body struct {
+	mu     sync.Mutex
+	reader io.Reader
+	read   int
+	closed bool
+}
+
+func newCM053Body(content []byte) *cm053Body {
+	return &cm053Body{reader: bytes.NewReader(content)}
+}
+
+func (b *cm053Body) Read(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	n, err := b.reader.Read(p)
+	b.read += n
+	return n, err
+}
+
+func (b *cm053Body) Close() error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.closed = true
+	return nil
+}
+
+func cm053Redirect(status int, location string) *http.Response {
+	return &http.Response{
+		StatusCode: status,
+		Header: http.Header{
+			"Location":          []string{location},
+			"Content-Type":      []string{"text/plain"},
+			"X-Upstream-Secret": []string{"cm053-upstream-header"},
+		},
+		Body: io.NopCloser(strings.NewReader("redirect body " + cm053Canary)),
+	}
+}
+
+func cm053OK() *http.Response {
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(`{"ok":true}`))}
+}
+
+// cm053CredentialHeaders are the credential shapes the executors attach:
+// bearer, x-api-key, x-goog-api-key and an arbitrary configured header.
+var cm053CredentialHeaders = map[string]string{
+	"Authorization":    "Bearer cm053-dummy-bearer",
+	"X-Api-Key":        "cm053-dummy-x-api-key",
+	"X-Goog-Api-Key":   "cm053-dummy-goog-key",
+	"X-Cm053-Custom-K": "cm053-dummy-custom",
+}
+
+const cm053Origin = "https://api.cm053.example/v1/messages"
+
+// cm053Send posts a replayable body with every credential header through a
+// client with the given policy, following the scripted redirect chain.
+func cm053Send(t *testing.T, client *http.Client) (*http.Response, error) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodPost, cm053Origin, bytes.NewReader([]byte(`{"prompt":"cm053-secret-prompt"}`)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if req.GetBody == nil {
+		t.Fatal("fixture body is not replayable; 307/308 would pass for the wrong reason")
+	}
+	for name, value := range cm053CredentialHeaders {
+		req.Header.Set(name, value)
+	}
+	return Result(client.Do(req))
+}
+
+type cm053Destination struct {
+	name     string
+	location string
+	// sameOrigin reports whether the destination keeps the original origin.
+	sameOrigin bool
+	// malformed destinations are refused even by Go's default client.
+	malformed bool
+}
+
+var cm053Destinations = []cm053Destination{
+	{name: "unrelated-host", location: "https://evil.cm053.example/steal?" + cm053Canary},
+	{name: "subdomain", location: "https://sub.api.cm053.example/steal?" + cm053Canary},
+	{name: "changed-port", location: "https://api.cm053.example:8443/steal?" + cm053Canary},
+	{name: "https-to-http", location: "http://api.cm053.example/steal?" + cm053Canary},
+	{name: "userinfo", location: "https://user:pw@api.cm053.example/steal?" + cm053Canary},
+	{name: "empty-port", location: "https://api.cm053.example:/steal?" + cm053Canary},
+	{name: "leading-zero-port", location: "https://api.cm053.example:0443/steal?" + cm053Canary},
+	{name: "trailing-dot-host", location: "https://api.cm053.example./steal?" + cm053Canary},
+	{name: "malformed", location: "https://api.cm053.example/%zz?" + cm053Canary, malformed: true},
+	{name: "relative", location: "/v1/followed?" + cm053Canary, sameOrigin: true},
+	{name: "same-origin-absolute", location: "https://api.cm053.example/v1/followed?" + cm053Canary, sameOrigin: true},
+	{name: "same-origin-canonical", location: "https://API.cm053.example:443/v1/followed?" + cm053Canary, sameOrigin: true},
+}
+
+var cm053Codes = []int{http.StatusMovedPermanently, http.StatusFound, http.StatusSeeOther, http.StatusTemporaryRedirect, http.StatusPermanentRedirect}
+
+// cm053Script answers the origin's first request with the redirect and every
+// other request with 200.
+func cm053Script(status int, location string) func(req *http.Request) *http.Response {
+	return func(req *http.Request) *http.Response {
+		if req.URL.String() == cm053Origin {
+			return cm053Redirect(status, location)
+		}
+		return cm053OK()
+	}
+}
+
+func cm053AssertRefused(t *testing.T, resp *http.Response, err error, hits []cm053Hit) {
+	t.Helper()
+	if resp != nil {
+		t.Fatalf("refused redirect returned a response (status %d, header %v)", resp.StatusCode, resp.Header)
+	}
+	var refused RefusedError
+	if !errors.As(err, &refused) {
+		t.Fatalf("error = %T %v, want RefusedError", err, err)
+	}
+	if err.Error() != Message || refused.StatusCode() != http.StatusBadGateway {
+		t.Fatalf("refused error = %q status %d, want %q 502", err.Error(), refused.StatusCode(), Message)
+	}
+	if strings.Contains(err.Error(), cm053Canary) {
+		t.Fatalf("refused error carries the Location: %q", err.Error())
+	}
+	if len(hits) != 1 || hits[0].url != cm053Origin {
+		t.Fatalf("requests = %+v, want exactly the original request (zero to the destination)", hits)
+	}
+	for name, value := range cm053CredentialHeaders {
+		if hits[0].header.Get(name) != value {
+			t.Fatalf("original request lost credential header %s", name)
+		}
+	}
+	if hits[0].bodyLen == 0 {
+		t.Fatal("original request carried no body")
+	}
+}
+
+// TestCM053CredentialedRedirectOriginMatrix: same-origin mode follows only
+// redirects that keep the original scheme, canonical host and effective port,
+// and refuses every other destination before any request reaches it.
+func TestCM053CredentialedRedirectOriginMatrix(t *testing.T) {
+	for _, status := range cm053Codes {
+		for _, dest := range cm053Destinations {
+			status, dest := status, dest
+			t.Run(fmt.Sprintf("%d/%s", status, dest.name), func(t *testing.T) {
+				rec := &cm053Recorder{respond: cm053Script(status, dest.location)}
+				client := Guard(&http.Client{Transport: rec}, SameOrigin)
+				resp, err := cm053Send(t, client)
+				hits := rec.snapshot()
+				if !dest.sameOrigin {
+					cm053AssertRefused(t, resp, err, hits)
+					return
+				}
+				if err != nil {
+					t.Fatalf("same-origin redirect error = %v", err)
+				}
+				_ = resp.Body.Close()
+				if resp.StatusCode != http.StatusOK || len(hits) != 2 {
+					t.Fatalf("same-origin redirect: status %d, requests %+v; want it followed once", resp.StatusCode, hits)
+				}
+				followed := hits[1]
+				if !strings.HasPrefix(followed.url, "https://") || !strings.EqualFold(strings.TrimSuffix(followed.host, ":443"), "api.cm053.example") {
+					t.Fatalf("followed request went to %s", followed.url)
+				}
+				// Go replays the body only on 307/308.
+				replay := status == http.StatusTemporaryRedirect || status == http.StatusPermanentRedirect
+				if replay && followed.bodyLen == 0 {
+					t.Fatalf("307/308 same-origin follow did not replay the body")
+				}
+			})
+		}
+	}
+}
+
+// TestCM053MultiHopEscapeRefused: a permitted same-origin hop followed by an
+// escape is refused at the escape; every hop is compared with the original.
+func TestCM053MultiHopEscapeRefused(t *testing.T) {
+	rec := &cm053Recorder{respond: func(req *http.Request) *http.Response {
+		switch req.URL.Path {
+		case "/v1/messages":
+			return cm053Redirect(http.StatusTemporaryRedirect, "/v1/hop2")
+		case "/v1/hop2":
+			return cm053Redirect(http.StatusTemporaryRedirect, "https://evil.cm053.example/steal?"+cm053Canary)
+		}
+		return cm053OK()
+	}}
+	resp, err := cm053Send(t, Guard(&http.Client{Transport: rec}, SameOrigin))
+	if resp != nil || !IsRefused(err) {
+		t.Fatalf("multi-hop escape: resp %v err %v, want refused", resp, err)
+	}
+	for _, hit := range rec.snapshot() {
+		if strings.Contains(hit.host, "evil") {
+			t.Fatalf("escape destination received a request: %+v", hit)
+		}
+	}
+	if hits := rec.snapshot(); len(hits) != 2 {
+		t.Fatalf("requests = %d, want 2 (origin and the same-origin hop)", len(hits))
+	}
+}
+
+// TestCM053SameOriginKeepsHopLimit: same-origin mode keeps the ten-hop limit;
+// the eleventh redirect is final and refused, never an error with a Location.
+func TestCM053SameOriginKeepsHopLimit(t *testing.T) {
+	var mu sync.Mutex
+	n := 0
+	rec := &cm053Recorder{respond: func(req *http.Request) *http.Response {
+		mu.Lock()
+		defer mu.Unlock()
+		n++
+		return cm053Redirect(http.StatusTemporaryRedirect, fmt.Sprintf("/v1/loop%d?%s", n, cm053Canary))
+	}}
+	resp, err := cm053Send(t, Guard(&http.Client{Transport: rec}, SameOrigin))
+	if resp != nil || !IsRefused(err) || strings.Contains(err.Error(), cm053Canary) {
+		t.Fatalf("hop limit: resp %v err %v, want a fixed refusal", resp, err)
+	}
+	if hits := rec.snapshot(); len(hits) != maxRedirects {
+		t.Fatalf("requests = %d, want %d (the original plus nine followed hops)", len(hits), maxRedirects)
+	}
+}
+
+// TestCM053KeyedCompatModeRefusesEveryRedirect: RefuseAll refuses relative and
+// same-origin redirects too.
+func TestCM053KeyedCompatModeRefusesEveryRedirect(t *testing.T) {
+	for _, status := range cm053Codes {
+		for _, dest := range cm053Destinations {
+			status, dest := status, dest
+			t.Run(fmt.Sprintf("%d/%s", status, dest.name), func(t *testing.T) {
+				rec := &cm053Recorder{respond: cm053Script(status, dest.location)}
+				resp, err := cm053Send(t, Guard(&http.Client{Transport: rec}, RefuseAll))
+				cm053AssertRefused(t, resp, err, rec.snapshot())
+			})
+		}
+	}
+}
+
+// TestCM053UnrestrictedModeKeepsGoDefault: the keyless mode is Go's default
+// client: every well-formed destination is followed.
+func TestCM053UnrestrictedModeKeepsGoDefault(t *testing.T) {
+	for _, dest := range cm053Destinations {
+		dest := dest
+		if dest.malformed {
+			continue
+		}
+		t.Run(dest.name, func(t *testing.T) {
+			rec := &cm053Recorder{respond: cm053Script(http.StatusTemporaryRedirect, dest.location)}
+			client := Guard(&http.Client{Transport: rec}, Unrestricted)
+			if client.CheckRedirect != nil {
+				t.Fatal("Unrestricted must keep Go's default CheckRedirect (nil)")
+			}
+			req, _ := http.NewRequest(http.MethodPost, cm053Origin, strings.NewReader("x"))
+			resp, err := Unrestricted.Result(client.Do(req))
+			if err != nil {
+				t.Fatalf("keyless redirect error = %v", err)
+			}
+			_ = resp.Body.Close()
+			if hits := rec.snapshot(); len(hits) != 2 {
+				t.Fatalf("keyless redirect requests = %d, want 2 (followed)", len(hits))
+			}
+		})
+	}
+}
+
+// TestCM053FinalRedirectWithoutFollowIsRefused: a final 3xx with Location that
+// Go never follows (a 307 whose body cannot be replayed; 300; 304) is refused
+// by the post-Do check itself, independent of CheckRedirect.
+func TestCM053FinalRedirectWithoutFollowIsRefused(t *testing.T) {
+	cases := map[string]struct {
+		status int
+		body   func() io.Reader
+	}{
+		"307-unreplayable-body": {status: http.StatusTemporaryRedirect, body: func() io.Reader { return io.MultiReader(strings.NewReader("x")) }},
+		"308-unreplayable-body": {status: http.StatusPermanentRedirect, body: func() io.Reader { return io.MultiReader(strings.NewReader("x")) }},
+		"300":                   {status: http.StatusMultipleChoices, body: func() io.Reader { return strings.NewReader("x") }},
+		"304":                   {status: http.StatusNotModified, body: func() io.Reader { return strings.NewReader("x") }},
+	}
+	for name, tc := range cases {
+		name, tc := name, tc
+		for _, mode := range []Mode{SameOrigin, RefuseAll} {
+			mode := mode
+			t.Run(fmt.Sprintf("%s/mode%d", name, mode), func(t *testing.T) {
+				body := newCM053Body(bytes.Repeat([]byte("B"), 1<<20))
+				rec := &cm053Recorder{respond: func(*http.Request) *http.Response {
+					resp := cm053Redirect(tc.status, "https://evil.cm053.example/steal?"+cm053Canary)
+					resp.Body = body
+					return resp
+				}}
+				req, _ := http.NewRequest(http.MethodPost, cm053Origin, tc.body())
+				req.Header.Set("Authorization", "Bearer cm053-dummy-bearer")
+				resp, err := mode.Result(Guard(&http.Client{Transport: rec}, mode).Do(req))
+				if resp != nil || !IsRefused(err) {
+					t.Fatalf("final %d: resp %v err %v, want refused", tc.status, resp, err)
+				}
+				if hits := rec.snapshot(); len(hits) != 1 {
+					t.Fatalf("requests = %d, want 1", len(hits))
+				}
+				body.mu.Lock()
+				defer body.mu.Unlock()
+				if !body.closed || body.read > maxDrainBytes {
+					t.Fatalf("refused body closed=%t read=%d, want closed after at most %d bytes", body.closed, body.read, maxDrainBytes)
+				}
+			})
+		}
+	}
+}
+
+// TestCM053LocationParseErrorShape pins net/http's malformed-Location error:
+// it embeds the Location, which is why Result replaces it with RefusedError.
+func TestCM053LocationParseErrorShape(t *testing.T) {
+	rec := &cm053Recorder{respond: cm053Script(http.StatusFound, "https://api.cm053.example/%zz?"+cm053Canary)}
+	req, _ := http.NewRequest(http.MethodGet, cm053Origin, nil)
+	_, rawErr := (&http.Client{Transport: rec}).Do(req)
+	var urlErr *url.Error
+	if !errors.As(rawErr, &urlErr) || !strings.HasPrefix(urlErr.Err.Error(), locationParseErrorPrefix) || !strings.Contains(rawErr.Error(), cm053Canary) {
+		t.Fatalf("net/http malformed-Location error = %v; the pinned prefix %q no longer matches", rawErr, locationParseErrorPrefix)
+	}
+	resp, err := Result(nil, rawErr)
+	if resp != nil || !IsRefused(err) || strings.Contains(err.Error(), cm053Canary) {
+		t.Fatalf("Result(parse error) = %v %v, want a fixed refusal", resp, err)
+	}
+	if _, err := StripLocation(nil, rawErr); !IsRefused(err) {
+		t.Fatalf("StripLocation(parse error) = %v, want a fixed refusal", err)
+	}
+	other := errors.New("dial tcp: connection refused")
+	if _, err := Result(nil, other); err != other {
+		t.Fatalf("Result changed an unrelated error: %v", err)
+	}
+}
+
+// TestCM053StripLocationForGenericAPI: the generic HttpRequest API keeps the
+// final 3xx status and body but loses every Location header.
+func TestCM053StripLocationForGenericAPI(t *testing.T) {
+	rec := &cm053Recorder{respond: cm053Script(http.StatusTemporaryRedirect, "https://evil.cm053.example/steal?"+cm053Canary)}
+	req, _ := http.NewRequest(http.MethodPost, cm053Origin, strings.NewReader("x"))
+	client := Guard(&http.Client{Transport: rec}, SameOrigin)
+	resp, err := StripLocation(client.Do(req))
+	if err != nil || resp == nil {
+		t.Fatalf("StripLocation = %v %v, want the response", resp, err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusTemporaryRedirect {
+		t.Fatalf("status = %d, want the upstream 307", resp.StatusCode)
+	}
+	for key, values := range resp.Header {
+		if strings.EqualFold(key, "Location") || strings.Contains(strings.Join(values, ","), cm053Canary) {
+			t.Fatalf("generic response still carries %s: %v", key, values)
+		}
+	}
+	if hits := rec.snapshot(); len(hits) != 1 {
+		t.Fatalf("requests = %d, want 1", len(hits))
+	}
+}
+
+// TestCM053RedirectNegativeControl: an intentionally unguarded client makes
+// this fixture detect the original leak — the destination receives the
+// replayed prompt body and the arbitrary credential header — so the gates
+// above pass because of the policy, not because of the fixture.
+func TestCM053RedirectNegativeControl(t *testing.T) {
+	rec := &cm053Recorder{respond: cm053Script(http.StatusTemporaryRedirect, "https://api.cm053.example.evil.example/steal")}
+	req, _ := http.NewRequest(http.MethodPost, cm053Origin, bytes.NewReader([]byte(`{"prompt":"cm053-secret-prompt"}`)))
+	for name, value := range cm053CredentialHeaders {
+		req.Header.Set(name, value)
+	}
+	resp, err := (&http.Client{Transport: rec}).Do(req)
+	if err != nil {
+		t.Fatalf("unguarded client error = %v", err)
+	}
+	_ = resp.Body.Close()
+	hits := rec.snapshot()
+	if len(hits) != 2 || !strings.Contains(hits[1].host, "evil") {
+		t.Fatalf("unguarded client did not follow the escape: %+v", hits)
+	}
+	if hits[1].bodyLen == 0 || hits[1].header.Get("X-Cm053-Custom-K") == "" {
+		t.Fatalf("fixture does not detect the leak: escape got body=%d custom=%q", hits[1].bodyLen, hits[1].header.Get("X-Cm053-Custom-K"))
+	}
+	// The same request through the guarded client leaks nothing.
+	rec2 := &cm053Recorder{respond: rec.respond}
+	req2, _ := http.NewRequest(http.MethodPost, cm053Origin, bytes.NewReader([]byte(`{"prompt":"cm053-secret-prompt"}`)))
+	resp2, err2 := Result(Guard(&http.Client{Transport: rec2}, SameOrigin).Do(req2))
+	cm053AssertRefusedNoCredentialCheck(t, resp2, err2, rec2.snapshot())
+}
+
+func cm053AssertRefusedNoCredentialCheck(t *testing.T, resp *http.Response, err error, hits []cm053Hit) {
+	t.Helper()
+	if resp != nil || !IsRefused(err) || len(hits) != 1 {
+		t.Fatalf("guarded client: resp %v err %v hits %d, want refused with one request", resp, err, len(hits))
+	}
+}
+
+// TestCM053GuardCopiesClient: Guard never mutates the client it is given and
+// keeps its transport and timeout.
+func TestCM053GuardCopiesClient(t *testing.T) {
+	rec := &cm053Recorder{respond: func(*http.Request) *http.Response { return cm053OK() }}
+	base := &http.Client{Transport: rec, Timeout: 7}
+	guarded := Guard(base, RefuseAll)
+	if base.CheckRedirect != nil {
+		t.Fatal("Guard mutated the shared client")
+	}
+	if guarded == base || guarded.Transport != rec || guarded.Timeout != 7 || guarded.CheckRedirect == nil {
+		t.Fatalf("Guard copy = %+v", guarded)
+	}
+	if Guard(nil, SameOrigin) != nil {
+		t.Fatal("Guard(nil) != nil")
+	}
+}
