+// cm053RunRefusalMatrix runs every entry point against every code and
+// destination; refuseAll additionally requires that no hop at all was
+// followed (keyed compat: exactly one upstream request).
+func cm053RunRefusalMatrix(t *testing.T, entries []cm053EntryPoint, destinations map[string]string, refuseAll bool) {
+	t.Helper()
+	for _, entry := range entries {
+		for _, status := range cm053RedirectCodes {
+			for destName, location := range destinations {
+				entry, status, destName, location := entry, status, destName, location
+				t.Run(fmt.Sprintf("%s/%d/%s", entry.name, status, destName), func(t *testing.T) {
+					upstream := &cm053RedirectUpstream{status: status, location: location}
+					capture := cm053CaptureContext(upstream)
+					err := entry.run(capture.ctx, cm053CaptureConfig())
+					cm053AssertFixedRefusal(t, err, capture, upstream)
+					if hits, _ := upstream.snapshot(); refuseAll && len(hits) != 1 {
+						t.Fatalf("keyed compat followed a redirect: %d upstream requests, want 1", len(hits))
+					}
+				})
+			}
+		}
+	}
+}
