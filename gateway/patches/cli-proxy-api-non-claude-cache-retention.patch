+func TestClaudeExecutorCountTokensNeverLeaksRetentionFromMalformedThirdPartyPayload(t *testing.T) {
+	for _, payload := range [][]byte{
+		[]byte(`{"prompt_cache_retention":"24h"`),
+		// Empty payload: the boundary must fail closed (no upstream request)
+		// or the pipeline must repair it into a retention-free body — an
+		// empty or unprovable body never reaches the upstream as-is.
+		[]byte{},
+	} {
+		t.Run(string(payload), func(t *testing.T) {
+			upstreamHits := 0
+			var gotBody []byte
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				upstreamHits++
+				body, errRead := io.ReadAll(r.Body)
+				if errRead != nil {
+					t.Fatalf("read body: %v", errRead)
+				}
+				gotBody = bytes.Clone(body)
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"input_tokens":5}`))
+			}))
+			defer server.Close()
+
+			executor := NewClaudeExecutor(&config.Config{})
+			auth := &cliproxyauth.Auth{Attributes: map[string]string{
+				"api_key":  "key-123",
+				"base_url": server.URL,
+			}}
+			_, err := executor.CountTokens(context.Background(), auth, cliproxyexecutor.Request{
+				Model:   "kimi-k2.5",
+				Payload: payload,
+			}, cliproxyexecutor.Options{
+				SourceFormat: sdktranslator.FromString("claude"),
+			})
+			// Two acceptable outcomes, both leak-free: fail closed at the
+			// boundary (no upstream request), or the pipeline's own repair
+			// upstream of the boundary (which drops the malformed content)
+			// followed by a retention-free upstream body.
+			if err != nil {
+				if upstreamHits != 0 {
+					t.Fatalf("upstream received %d requests despite fail-closed error: %v", upstreamHits, err)
+				}
+				return
+			}
+			if upstreamHits != 1 {
+				t.Fatalf("upstream received %d requests, want 1", upstreamHits)
+			}
+			if len(gotBody) == 0 {
+				t.Fatal("expected captured upstream body")
+			}
+			assertRetentionStripped(t, gotBody)
+		})
+	}
+}
