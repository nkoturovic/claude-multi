+func TestCodexWebsocketsDuplexContinuationStripsRetentionFromEveryResponseCreate(t *testing.T) {
+	frames := make(chan []byte, 2)
+	serverDone := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(serverDone)
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+
+		_, first, err := conn.ReadMessage()
+		if err != nil {
+			t.Errorf("read first create: %v", err)
+			return
+		}
+		frames <- bytes.Clone(first)
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"resp-1","output":[]}}`))
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.completed","response":{"id":"resp-1","output":[]}}`))
+
+		_, second, err := conn.ReadMessage()
+		if err != nil {
+			t.Errorf("read continuation create: %v", err)
+			return
+		}
+		frames <- bytes.Clone(second)
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"resp-2","output":[]}}`))
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.completed","response":{"id":"resp-2","output":[]}}`))
+		_, _, _ = conn.ReadMessage()
+	}))
+	defer server.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	input := make(chan cliproxyexecutor.WebsocketInput, 4)
+	ctx = cliproxyexecutor.WithWebsocketInput(cliproxyexecutor.WithDownstreamWebsocket(ctx), input)
+
+	exec := NewCodexWebsocketsExecutor(&config.Config{Codex: config.CodexConfig{ResponseSteering: true}})
+	exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+	auth := &cliproxyauth.Auth{ID: "retention-duplex-test", Provider: "codex", Attributes: map[string]string{"api_key": "test-key", "base_url": server.URL, "websockets": "true"}}
+	req := cliproxyexecutor.Request{
+		Model:   "gpt-6-astra",
+		Payload: []byte(`{"model":"gpt-6-astra","prompt_cache_retention":"24h","prompt_cache_key":"cache-123","input":[{"role":"user","content":"turn 1"}]}`),
+	}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("codex"), Metadata: map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: "retention-duplex"}}
+
+	result, err := exec.ExecuteStream(ctx, auth, req, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		eventType := gjson.GetBytes(chunk.Payload, "type").String()
+		eventID := gjson.GetBytes(chunk.Payload, "response.id").String()
+		if eventType == "response.completed" && eventID == "resp-1" {
+			continuation, errSet := sjson.SetBytes([]byte(`{"type":"response.create","model":"gpt-6-astra","prompt_cache_key":"cache-123","input":[{"role":"user","content":"turn 2"}]}`), "prompt_cache_retention", "24h")
+			if errSet != nil {
+				t.Fatalf("build continuation: %v", errSet)
+			}
+			input <- cliproxyexecutor.WebsocketInput{Payload: retentionDuplicatePayload(t, string(continuation))}
+		}
+		if eventType == "response.completed" && eventID == "resp-2" {
+			cancel()
+			break
+		}
+	}
+	select {
+	case <-serverDone:
+	case <-time.After(3 * time.Second):
+		t.Fatal("server did not finish")
+	}
+
+	close(frames)
+	count := 0
+	for frame := range frames {
+		count++
+		if got := gjson.GetBytes(frame, "type").String(); got != "response.create" {
+			t.Fatalf("frame %d type = %q, want response.create; frame=%s", count, got, string(frame))
+		}
+		assertRetentionStripped(t, frame)
+	}
+	if count != 2 {
+		t.Fatalf("captured %d response.create frames, want 2", count)
+	}
+}
