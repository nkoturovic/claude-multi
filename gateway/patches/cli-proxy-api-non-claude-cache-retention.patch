+		Model:   "kimi-k3",
+		Payload: payload,
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude}); err != nil {
+		t.Fatalf("Execute() error = %v", err)
+	}
+	if !strings.HasPrefix(gotURL, "https://api.kimi.com/coding/v1/messages") {
+		t.Fatalf("upstream URL = %q, want Kimi messages endpoint", gotURL)
+	}
+	assertRetentionStripped(t, gotBody)
+}
+
+func TestKimiExecutorCountTokensStripsRetentionAtThirdPartyBoundary(t *testing.T) {
+	var gotURL string
+	var gotBody []byte
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", kimiRoundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		gotURL = req.URL.String()
+		var errRead error
+		gotBody, errRead = io.ReadAll(req.Body)
+		if errRead != nil {
+			return nil, errRead
+		}
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(`{"input_tokens":42}`)),
+		}, nil
+	}))
