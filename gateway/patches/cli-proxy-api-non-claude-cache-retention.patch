+}
+
+// Official Anthropic streaming transport keeps the field (negative guard for
+// the stream path, complementing the execute/count_tokens guards).
+
+func TestClaudeExecutorExecuteStreamPreservesRetentionForOfficialAnthropicEndpoint(t *testing.T) {
+	var gotBody []byte
+	rt := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		body, errRead := io.ReadAll(req.Body)
+		if errRead != nil {
+			return nil, errRead
+		}
+		gotBody = bytes.Clone(body)
+		return &http.Response{
+			StatusCode: 200,
+			Header:     http.Header{"Content-Type": []string{"text/event-stream"}},
+			Body: io.NopCloser(strings.NewReader(strings.Join([]string{
+				`event: message_start`,
+				`data: {"type":"message_start","message":{"id":"msg_123","model":"claude-sonnet-4-5"}}`,
+				`event: message_delta`,
+				`data: {"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"input_tokens":2,"output_tokens":1}}`,
+				`event: message_stop`,
+				`data: {"type":"message_stop"}`,
+				``,
+			}, "\n"))),
+		}, nil
+	})
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", rt)
+
+	executor := NewClaudeExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"api_key": "key-123",
+	}}
+	payload := []byte(`{"prompt_cache_retention":"24h","messages":[{"role":"user","content":[{"type":"text","text":"hello"}]}]}`)
+	result, err := executor.ExecuteStream(ctx, auth, cliproxyexecutor.Request{
+		Model:   "claude-sonnet-4-5",
+		Payload: payload,
+	}, cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FromString("claude"),
+	})
+	if err != nil {
+		t.Fatalf("ExecuteStream() error = %v", err)
+	}
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream chunk error = %v", chunk.Err)
+		}
+	}
+	if len(gotBody) == 0 {
+		t.Fatal("expected captured upstream body")
+	}
+	assertRetentionPresent(t, gotBody)
+}
diff --git a/internal/runtime/executor/openai_compat_chat_retention_cm053_test.go b/internal/runtime/executor/openai_compat_chat_retention_cm053_test.go
new file mode 100644
index 0000000..109d54c
--- /dev/null
+++ b/internal/runtime/executor/openai_compat_chat_retention_cm053_test.go
@@ -0,0 +1,335 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// The OpenAI-compatible chat completions
+// boundary. The compatibility executor applies payload rules, tool-result and
+// max-tokens normalization, prompt-cache-key insertion and (stream)
+// include_usage after translation, so a late payload override could put
+// prompt_cache_retention back on a chat request. Two final strips close it:
+// non-stream Execute (chat branch only) and ExecuteStream (unconditional:
+// the stream always targets /chat/completions, even under the
+// "responses/compact" Alt). Keyed and keyless chat alike; the genuine
+// non-stream /responses/compact request keeps the field. Every upstream is a
+// loopback httptest server; no external network access is involved.
+
+type cm053CompatUpstream struct {
+	mu       sync.Mutex
+	requests int
+	paths    []string
+	bodies   [][]byte
+	auths    []string
+}
+
+func (u *cm053CompatUpstream) snapshot() (int, []string, [][]byte, []string) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return u.requests, append([]string(nil), u.paths...), append([][]byte(nil), u.bodies...), append([]string(nil), u.auths...)
+}
+
+func newCM053CompatUpstream(t *testing.T) (*cm053CompatUpstream, *httptest.Server) {
+	t.Helper()
+	upstream := &cm053CompatUpstream{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		upstream.mu.Lock()
+		upstream.requests++
+		upstream.paths = append(upstream.paths, r.URL.Path)
+		upstream.bodies = append(upstream.bodies, bytes.Clone(body))
+		upstream.auths = append(upstream.auths, r.Header.Get("Authorization"))
+		upstream.mu.Unlock()
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/responses/compact"):
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(`{"id":"resp_1","object":"response.compaction","usage":{"input_tokens":1,"output_tokens":2,"total_tokens":3}}`))
+		case r.Header.Get("Accept") == "text/event-stream":
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = w.Write([]byte(`data: {"id":"chatcmpl_1","object":"chat.completion.chunk","model":"cm053-chat","choices":[{"index":0,"delta":{"role":"assistant","content":"ok"},"finish_reason":null}]}` + "\n\n"))
+			_, _ = w.Write([]byte(`data: {"id":"chatcmpl_1","object":"chat.completion.chunk","model":"cm053-chat","choices":[{"index":0,"delta":{},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}` + "\n\n"))
+			_, _ = w.Write([]byte("data: [DONE]\n\n"))
+		default:
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(`{"id":"chatcmpl_1","object":"chat.completion","model":"cm053-chat","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`))
+		}
+	}))
+	t.Cleanup(server.Close)
+	return upstream, server
+}
+
+// cm053CompatAuth returns a compat auth for server; keyed attaches a synthetic
+// bearer credential, keyless attaches none.
+func cm053CompatAuth(server *httptest.Server, keyed bool) *cliproxyauth.Auth {
+	attrs := map[string]string{
+		"base_url":     server.URL + "/v1",
+		"compat_name":  "cm053",
+		"provider_key": "cm053",
+	}
+	if keyed {
+		attrs["api_key"] = "cm053-dummy-key"
+	}
+	return &cliproxyauth.Auth{Provider: "openai-compatibility", Attributes: attrs}
+}
+
+func cm053CompatConfig(payload config.PayloadConfig) *config.Config {
+	return &config.Config{
+		OpenAICompatibility: []config.OpenAICompatibility{{
+			Name:                  "cm053",
+			SupportPromptCacheKey: true,
+		}},
+		Payload: payload,
+	}
+}
+
+// cm053RunCompat sends one request through Execute or ExecuteStream (draining
+// the stream) and returns the executor error, or the first chunk error.
+func cm053RunCompat(t *testing.T, exec *OpenAICompatExecutor, auth *cliproxyauth.Auth, stream bool, source string, alt string, payload []byte) error {
+	t.Helper()
+	req := cliproxyexecutor.Request{Model: "cm053-chat", Payload: payload}
+	opts := cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FromString(source),
+		Alt:          alt,
+		Stream:       stream,
+	}
+	if !stream {
+		_, err := exec.Execute(context.Background(), auth, req, opts)
+		return err
+	}
+	result, err := exec.ExecuteStream(context.Background(), auth, req, opts)
+	if err != nil {
+		return err
+	}
+	var chunkErr error
+	for chunk := range result.Chunks {
+		if chunk.Err != nil && chunkErr == nil {
+			chunkErr = chunk.Err
+		}
+	}
+	return chunkErr
+}
+
+func cm053Mode(stream bool) string {
+	if stream {
+		return "stream"
+	}
+	return "execute"
+}
+
+func cm053KeyMode(keyed bool) string {
+	if keyed {
+		return "keyed"
+	}
+	return "keyless"
+}
+
+// cm053AssertOneChatRequest checks that exactly one request reached the chat
+// endpoint with the expected credential shape, and returns its body.
+func cm053AssertOneChatRequest(t *testing.T, upstream *cm053CompatUpstream, keyed bool) []byte {
+	t.Helper()
+	count, paths, bodies, auths := upstream.snapshot()
+	if count != 1 {
+		t.Fatalf("upstream requests = %d, want 1", count)
+	}
+	if paths[0] != "/v1/chat/completions" {
+		t.Fatalf("upstream path = %q, want /v1/chat/completions", paths[0])
+	}
+	if keyed && auths[0] != "Bearer cm053-dummy-key" {
+		t.Fatalf("keyed request carried Authorization %q, want the synthetic bearer", auths[0])
+	}
+	if !keyed && auths[0] != "" {
+		t.Fatalf("keyless request carried Authorization %q, want none", auths[0])
+	}
+	if !gjson.ValidBytes(bodies[0]) {
+		t.Fatalf("upstream body is not valid JSON: %s", string(bodies[0]))
+	}
+	return bodies[0]
+}
+
+// TestCM053CompatChatRetentionFinalBoundary: an OpenAI-format chat request
+// carrying prompt_cache_retention leaves the compat executor without it, keyed
+// and keyless, non-stream and stream; prompt_cache_key and nested entries are
+// preserved.
+func TestCM053CompatChatRetentionFinalBoundary(t *testing.T) {
+	for _, keyed := range []bool{true, false} {
+		for _, stream := range []bool{false, true} {
+			keyed, stream := keyed, stream
+			t.Run(cm053KeyMode(keyed)+"/"+cm053Mode(stream), func(t *testing.T) {
+				upstream, server := newCM053CompatUpstream(t)
+				exec := NewOpenAICompatExecutor("openai-compatibility", cm053CompatConfig(config.PayloadConfig{}))
+				payload := []byte(`{"model":"cm053-chat","prompt_cache_retention":"24h","prompt_cache_key":"cache-cm053","metadata":{"prompt_cache_retention":"nested"},"messages":[{"role":"user","content":"hi"}]}`)
+				if err := cm053RunCompat(t, exec, cm053CompatAuth(server, keyed), stream, "openai", "", payload); err != nil {
+					t.Fatalf("request error: %v", err)
+				}
+				body := cm053AssertOneChatRequest(t, upstream, keyed)
+				assertRetentionStripped(t, body)
+				if got := gjson.GetBytes(body, "prompt_cache_key").String(); got != "cache-cm053" {
+					t.Fatalf("prompt_cache_key = %q, want cache-cm053; body=%s", got, string(body))
+				}
+				if got := gjson.GetBytes(body, "metadata.prompt_cache_retention").String(); got != "nested" {
+					t.Fatalf("nested metadata.prompt_cache_retention = %q, want nested; body=%s", got, string(body))
+				}
+			})
+		}
+	}
+}
+
+// TestCM053CompatChatRetentionLateOverride: a payload rule (override and
+// override-raw) that injects prompt_cache_retention after translation of a
+// Claude-format request — the reviewed Claude /v1/messages -> chat route,
+// whose translator drops the inbound field — is still stripped. A marker set
+// by the same rule proves the late injection ran.
+func TestCM053CompatChatRetentionLateOverride(t *testing.T) {
+	rules := map[string]config.PayloadConfig{
+		"override": {Override: []config.PayloadRule{{
+			Models: []config.PayloadModelRule{{Name: "*", Protocol: "openai"}},
+			Params: map[string]any{"prompt_cache_retention": "24h", "cm053_late_marker": "late"},
+		}}},
+		"override-raw": {OverrideRaw: []config.PayloadRule{{
+			Models: []config.PayloadModelRule{{Name: "*", Protocol: "openai"}},
+			Params: map[string]any{"prompt_cache_retention": `"24h"`, "cm053_late_marker": `"late"`},
+		}}},
+	}
+	for name, rule := range rules {
+		for _, keyed := range []bool{true, false} {
+			for _, stream := range []bool{false, true} {
+				name, rule, keyed, stream := name, rule, keyed, stream
+				t.Run(name+"/"+cm053KeyMode(keyed)+"/"+cm053Mode(stream), func(t *testing.T) {
+					upstream, server := newCM053CompatUpstream(t)
+					exec := NewOpenAICompatExecutor("openai-compatibility", cm053CompatConfig(rule))
+					payload := []byte(`{"model":"cm053-chat","max_tokens":64,"messages":[{"role":"user","content":"hi"}]}`)
+					if err := cm053RunCompat(t, exec, cm053CompatAuth(server, keyed), stream, "claude", "", payload); err != nil {
+						t.Fatalf("request error: %v", err)
+					}
+					body := cm053AssertOneChatRequest(t, upstream, keyed)
+					if got := gjson.GetBytes(body, "cm053_late_marker").String(); got != "late" {
+						t.Fatalf("late payload rule did not run (marker %q); body=%s", got, string(body))
+					}
+					assertRetentionStripped(t, body)
+				})
+			}
+		}
+	}
+}
+
+// TestCM053CompatChatRetentionDuplicateKeys: duplicate top-level
+// prompt_cache_retention members (which a single sjson delete cannot clear)
+// are all removed at the chat boundary; prompt_cache_key survives.
+func TestCM053CompatChatRetentionDuplicateKeys(t *testing.T) {
+	for _, keyed := range []bool{true, false} {
+		for _, stream := range []bool{false, true} {
+			keyed, stream := keyed, stream
+			t.Run(cm053KeyMode(keyed)+"/"+cm053Mode(stream), func(t *testing.T) {
+				upstream, server := newCM053CompatUpstream(t)
+				exec := NewOpenAICompatExecutor("openai-compatibility", cm053CompatConfig(config.PayloadConfig{}))
+				payload := retentionDuplicatePayload(t, `{"model":"cm053-chat","prompt_cache_retention":"24h","prompt_cache_key":"cache-cm053","messages":[{"role":"user","content":"hi"}]}`)
+				if err := cm053RunCompat(t, exec, cm053CompatAuth(server, keyed), stream, "openai", "", payload); err != nil {
+					t.Fatalf("request error: %v", err)
+				}
+				body := cm053AssertOneChatRequest(t, upstream, keyed)
+				if n := bytes.Count(body, []byte(`"prompt_cache_retention"`)); n != 0 {
+					t.Fatalf("upstream body carries %d prompt_cache_retention members, want 0: %s", n, string(body))
+				}
+				if got := gjson.GetBytes(body, "prompt_cache_key").String(); got != "cache-cm053" {
+					t.Fatalf("prompt_cache_key = %q, want cache-cm053; body=%s", got, string(body))
+				}
+			})
+		}
+	}
+}
+
+// TestCM053CompatChatRetentionFailureSendsNothing: when the final chat body
+// cannot be proven free of the field (a late raw rule leaves it invalid JSON),
+// the executor fails closed and the upstream receives zero requests.
+func TestCM053CompatChatRetentionFailureSendsNothing(t *testing.T) {
+	broken := config.PayloadConfig{OverrideRaw: []config.PayloadRule{{
+		Models: []config.PayloadModelRule{{Name: "*", Protocol: "openai"}},
+		Params: map[string]any{"cm053_broken": "{"},
+	}}}
+	for _, keyed := range []bool{true, false} {
+		for _, stream := range []bool{false, true} {
+			keyed, stream := keyed, stream
+			t.Run(cm053KeyMode(keyed)+"/"+cm053Mode(stream), func(t *testing.T) {
+				upstream, server := newCM053CompatUpstream(t)
+				exec := NewOpenAICompatExecutor("openai-compatibility", cm053CompatConfig(broken))
+				payload := []byte(`{"model":"cm053-chat","prompt_cache_retention":"24h","messages":[{"role":"user","content":"hi"}]}`)
+				err := cm053RunCompat(t, exec, cm053CompatAuth(server, keyed), stream, "openai", "", payload)
+				if err == nil {
+					t.Fatal("request succeeded, want a fail-closed boundary error")
+				}
+				if !strings.Contains(err.Error(), "strip prompt_cache_retention") {
+					t.Fatalf("error = %v, want the retention boundary error", err)
+				}
+				if count, _, _, _ := upstream.snapshot(); count != 0 {
+					t.Fatalf("upstream requests = %d, want 0 (nothing may leave)", count)
+				}
+			})
+		}
+	}
+}
+
+// TestCM053CompatStreamAltStillSanitized: a stream under the
+// "responses/compact" Alt still targets /chat/completions and is stripped —
+// from the inbound payload, from duplicates and from a late override — while
+// the genuine non-stream /responses/compact request keeps the field.
+func TestCM053CompatStreamAltStillSanitized(t *testing.T) {
+	late := config.PayloadConfig{Override: []config.PayloadRule{{
+		Models: []config.PayloadModelRule{{Name: "*", Protocol: "openai"}},
+		Params: map[string]any{"prompt_cache_retention": "24h", "cm053_late_marker": "late"},
+	}}}
+	cases := map[string]struct {
+		cfg     config.PayloadConfig
+		payload []byte
+		marker  bool
+	}{
+		"inbound":   {payload: []byte(`{"model":"cm053-chat","prompt_cache_retention":"24h","messages":[{"role":"user","content":"hi"}]}`)},
+		"duplicate": {payload: retentionDuplicatePayload(t, `{"model":"cm053-chat","prompt_cache_retention":"24h","messages":[{"role":"user","content":"hi"}]}`)},
+		"late":      {cfg: late, payload: []byte(`{"model":"cm053-chat","messages":[{"role":"user","content":"hi"}]}`), marker: true},
+	}
+	for name, tc := range cases {
+		for _, keyed := range []bool{true, false} {
+			name, tc, keyed := name, tc, keyed
+			t.Run(name+"/"+cm053KeyMode(keyed), func(t *testing.T) {
+				upstream, server := newCM053CompatUpstream(t)
+				exec := NewOpenAICompatExecutor("openai-compatibility", cm053CompatConfig(tc.cfg))
+				if err := cm053RunCompat(t, exec, cm053CompatAuth(server, keyed), true, "openai", "responses/compact", tc.payload); err != nil {
+					t.Fatalf("stream error: %v", err)
+				}
+				body := cm053AssertOneChatRequest(t, upstream, keyed)
+				if tc.marker && gjson.GetBytes(body, "cm053_late_marker").String() != "late" {
+					t.Fatalf("late payload rule did not run; body=%s", string(body))
+				}
+				if n := bytes.Count(body, []byte(`"prompt_cache_retention"`)); n != 0 {
+					t.Fatalf("stream under the compact Alt carries %d prompt_cache_retention members, want 0: %s", n, string(body))
+				}
+			})
+		}
+	}
+
+	t.Run("genuine-compact-exception", func(t *testing.T) {
+		upstream, server := newCM053CompatUpstream(t)
+		exec := NewOpenAICompatExecutor("openai-compatibility", cm053CompatConfig(config.PayloadConfig{}))
+		payload := []byte(`{"model":"cm053-chat","prompt_cache_retention":"24h","input":[{"role":"user","content":"hi"}]}`)
+		if err := cm053RunCompat(t, exec, cm053CompatAuth(server, true), false, "openai-response", "responses/compact", payload); err != nil {
+			t.Fatalf("compact error: %v", err)
+		}
+		count, paths, bodies, _ := upstream.snapshot()
+		if count != 1 || paths[0] != "/v1/responses/compact" {
+			t.Fatalf("compact requests = %d paths = %v, want one /v1/responses/compact", count, paths)
+		}
+		assertRetentionPresent(t, bodies[0])
+	})
+}
