+// Extensions of the non-Claude cache-retention boundary tests for the
+// CLIProxyAPI 7.3 split executors: the call sites that did not exist on
+// 7.2.80 (Meta Responses, xAI /responses/compact, Codex duplex continuation
+// frames, delegated Kimi Claude-messages paths, Codex image paths) and the
+// duplicate-key cases that upstream's own single sjson delete cannot clear.
+// All upstreams are loopback fakes or injected round-trippers; no external
+// network access is involved.
+
+// retentionDuplicatePayload returns payload with two extra top-level
+// prompt_cache_retention members appended after the existing ones, so a
+// single sjson.DeleteBytes (upstream's early cleanup) leaves one behind.
+func retentionDuplicatePayload(t *testing.T, payload string) []byte {
+	t.Helper()
+	trimmed := strings.TrimSpace(payload)
+	if !strings.HasSuffix(trimmed, "}") {
+		t.Fatalf("payload is not an object: %s", payload)
+	}
+	return []byte(trimmed[:len(trimmed)-1] + `,"prompt_cache_retention":"48h","prompt_cache_retention":"72h"}`)
+}
