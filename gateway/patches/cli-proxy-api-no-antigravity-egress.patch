--- /dev/null
+++ b/cmd/server/antigravity_version_cm053_test.go
@@ -0,0 +1,15 @@
+package main
+
+import "testing"
+
+func TestCM053NoAntigravityEgressLocalModel(t *testing.T) {
+	if antigravityVersionUpdaterPlan(true) {
+		t.Fatal("local-model must not start the Antigravity version updater")
+	}
+}
+
+func TestCM053NoAntigravityEgressRemoteModel(t *testing.T) {
+	if !antigravityVersionUpdaterPlan(false) {
+		t.Fatal("ordinary startup must retain the Antigravity version updater")
+	}
+}
