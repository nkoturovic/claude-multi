+// A terminal stream event that quotes the key becomes the fixed text of its
+// kind, in the non-stream body, the stream and the buffered stream bootstrap
+// (including the overload rejection a bootstrap fails over with).
+func TestCodexKeyTerminalFailureIsLocal(t *testing.T) {
+	cases := []struct {
+		name  string
+		event string
+		kind  compatsafe.Kind
+		want  int
+	}{
+		{name: "failed", kind: compatsafe.KindServerError, want: http.StatusBadGateway,
+			event: `{"type":"response.failed","response":{"id":"resp_key","status":"failed","error":{"code":"server_error","message":"request with ` + codexKeyTestSecret + ` failed"}}}`},
+		{name: "context", kind: compatsafe.KindContextLength, want: http.StatusBadRequest,
+			event: `{"type":"error","error":{"type":"invalid_request_error","code":"context_length_exceeded","message":"input of ` + codexKeyTestSecret + ` exceeds the context window"}}`},
+		{name: "credential", kind: compatsafe.KindAuthentication, want: http.StatusUnauthorized,
+			event: `{"type":"response.failed","response":{"error":{"type":"authentication_error","code":"invalid_api_key","message":"bad key ` + codexKeyTestSecret + `"}}}`},
+		{name: "overload", kind: compatsafe.KindServerError, want: http.StatusBadGateway,
+			event: `{"type":"error","error":{"type":"service_unavailable_error","code":"server_is_overloaded","message":"overloaded for ` + codexKeyTestSecret + `"}}`},
+	}
+	for _, tc := range cases {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.Copy(io.Discard, r.Body)
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = fmt.Fprintf(w, "event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_key\"}}\n\n")
+			_, _ = fmt.Fprintf(w, "data: %s\n\n", tc.event)
+		}))
+		for _, mode := range []string{"execute", "stream", "buffered"} {
+			t.Run(tc.name+"/"+mode, func(t *testing.T) {
+				cfg := &config.Config{}
+				run, want := mode, tc.want
+				if mode == "buffered" {
+					cfg.Codex.StreamBootstrapBuffering = true
+					run = "stream"
+					if tc.name == "overload" {
+						want = http.StatusServiceUnavailable // the bootstrap fails over with 503
+					}
+				}
+				err := codexKeyTestRun(t, cfg, codexKeyTestAuth(server.URL, true), run, nil)
+				if err == nil {
+					t.Fatal("no failure")
+				}
+				if err.Error() != tc.kind.Body() {
+					t.Fatalf("failure text = %q, want the fixed text of %s", err.Error(), tc.kind)
+				}
+				if got := codexKeyTestStatus(t, err); got != want {
+					t.Fatalf("status = %d, want %d", got, want)
+				}
+			})
+		}
+		t.Run(tc.name+"/account", func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Codex.StreamBootstrapBuffering = true
+			err := codexKeyTestRun(t, cfg, codexKeyTestAuth(server.URL, false), "stream", nil)
+			if err == nil || !strings.Contains(err.Error(), codexKeyTestSecret) {
+				t.Fatalf("account failure changed: %v", err)
+			}
+		})
+		server.Close()
+	}
+}
