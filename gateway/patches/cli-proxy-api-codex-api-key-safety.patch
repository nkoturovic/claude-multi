+// A transport failure keeps only its trusted identity: the request URL (here
+// carrying a marker in its path) never reaches the failure text.
+func TestCodexKeyTransportErrorIsLocal(t *testing.T) {
+	const marker = "transport-marker-path"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hijacker, ok := w.(http.Hijacker)
+		if !ok {
+			t.Error("no hijacker")
+			return
+		}
+		conn, _, err := hijacker.Hijack()
+		if err == nil {
+			_ = conn.Close()
+		}
+	}))
+	defer server.Close()
+	base := server.URL + "/" + marker
+	for _, mode := range codexKeyTestModes {
+		t.Run(mode, func(t *testing.T) {
+			err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(base, true), mode, nil)
+			if err == nil {
+				t.Fatal("no failure")
+			}
+			if strings.Contains(err.Error(), marker) {
+				t.Fatalf("transport failure kept the request URL: %q", err.Error())
+			}
+			var transport compatsafe.TransportError
+			if !errors.As(err, &transport) && !errors.Is(err, io.EOF) && !errors.Is(err, io.ErrUnexpectedEOF) {
+				t.Fatalf("failure %T is not a trusted transport identity", err)
+			}
+		})
+	}
+	t.Run("account", func(t *testing.T) {
+		err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(base, false), "execute", nil)
+		if err == nil || !strings.Contains(err.Error(), marker) {
+			t.Fatalf("account failure changed: %v", err)
+		}
+	})
+}
