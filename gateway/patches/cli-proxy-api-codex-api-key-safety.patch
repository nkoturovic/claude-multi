+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// A credential-shaped value made of words; the fake upstreams quote it back.
+const codexKeyTestSecret = "codex-key-fixture-value"
+
+// The HTTP paths of the codex executor: Execute, ExecuteStream and compact.
+var codexKeyTestModes = []string{"execute", "stream", "compact"}
+
+func codexKeyTestAuth(baseURL string, apiKey bool) *cliproxyauth.Auth {
+	auth := &cliproxyauth.Auth{ID: "codex-key-test", Provider: "codex", Attributes: map[string]string{"base_url": baseURL}}
+	if apiKey {
+		auth.Attributes["api_key"] = codexKeyTestSecret
+	} else {
+		auth.Metadata = map[string]any{"access_token": codexKeyTestSecret, "account_id": "codex-key-test-account"}
+	}
+	return auth
+}
+
+// codexKeyTestRun sends one request in mode and returns its failure: the
+// returned error, or the first error chunk of a stream.
+func codexKeyTestRun(t *testing.T, cfg *config.Config, auth *cliproxyauth.Auth, mode string, inbound http.Header) error {
+	t.Helper()
+	payload := `{"model":"gpt-5.5","input":[{"role":"user","content":"fixture"}],"prompt_cache_key":"codex-key-test-cache"}`
+	req := cliproxyexecutor.Request{Model: "gpt-5.5", Payload: []byte(payload)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Headers: inbound}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	executor := NewCodexExecutor(cfg)
+	switch mode {
+	case "stream":
+		opts.Stream = true
+		result, err := executor.ExecuteStream(ctx, auth, req, opts)
+		if err != nil {
+			return err
+		}
+		var failure error
+		for chunk := range result.Chunks {
+			if chunk.Err != nil && failure == nil {
+				failure = chunk.Err
+			}
+		}
+		return failure
+	case "compact":
+		opts.Alt = "responses/compact"
+	}
+	_, err := executor.Execute(ctx, auth, req, opts)
+	return err
+}
+
+func codexKeyTestStatus(t *testing.T, err error) int {
+	t.Helper()
+	var coded interface{ StatusCode() int }
+	if !errors.As(err, &coded) {
+		t.Fatalf("failure %T carries no status", err)
+	}
+	return coded.StatusCode()
+}
+
+func codexKeyTestCompleted() string {
+	return `{"type":"response.completed","response":{"id":"resp_key","model":"gpt-5.5","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`
+}
+
+// A non-2xx response that quotes the key becomes the fixed text of its kind;
+// the status, the usage-limit retry delay and the credential scope survive.
+func TestCodexKeyStatusFailureIsLocal(t *testing.T) {
+	retry := 300 * time.Second
+	cases := []struct {
+		name     string
+		status   int
+		body     string
+		kind     compatsafe.Kind
+		want     int
+		retry    *time.Duration
+		scoped   bool
+		jsonBody bool
+	}{
+		{name: "credential", status: http.StatusUnauthorized, jsonBody: true, kind: compatsafe.KindAuthentication, want: http.StatusUnauthorized,
+			body: `{"error":{"message":"Incorrect API key provided: ` + codexKeyTestSecret + `","type":"invalid_request_error","code":"invalid_api_key"}}`},
+		{name: "context", status: http.StatusBadRequest, jsonBody: true, kind: compatsafe.KindContextLength, want: http.StatusBadRequest,
+			body: `{"error":{"message":"request for ` + codexKeyTestSecret + ` exceeds the context window","type":"invalid_request_error","code":"context_length_exceeded"}}`},
+		{name: "usage-limit", status: http.StatusTooManyRequests, jsonBody: true, kind: compatsafe.KindRateLimited, want: http.StatusTooManyRequests,
+			retry: &retry, scoped: true,
+			body: `{"error":{"type":"usage_limit_reached","message":"limit for ` + codexKeyTestSecret + `","resets_in_seconds":300}}`},
+		{name: "server", status: http.StatusInternalServerError, kind: compatsafe.KindServerError, want: http.StatusInternalServerError,
+			body: "upstream failed for " + codexKeyTestSecret},
+		{name: "oversized", status: http.StatusBadRequest, kind: compatsafe.KindErrorBodyTooLarge, want: http.StatusBadRequest,
+			body: strings.Repeat("x", 2*compatsafe.MaxErrorBody) + codexKeyTestSecret},
+	}
+	for _, tc := range cases {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.Copy(io.Discard, r.Body)
+			if tc.jsonBody {
+				w.Header().Set("Content-Type", "application/json")
+			}
+			w.WriteHeader(tc.status)
+			_, _ = io.WriteString(w, tc.body)
+		}))
+		for _, mode := range codexKeyTestModes {
+			t.Run(tc.name+"/"+mode, func(t *testing.T) {
+				err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, true), mode, nil)
+				if err == nil {
+					t.Fatal("no failure")
+				}
+				if err.Error() != tc.kind.Body() {
+					t.Fatalf("failure text = %q, want the fixed text of %s", err.Error(), tc.kind)
+				}
+				if got := codexKeyTestStatus(t, err); got != tc.want {
+					t.Fatalf("status = %d, want %d", got, tc.want)
+				}
+				var failure statusErr
+				if !errors.As(err, &failure) {
+					t.Fatalf("failure %T is not a classified status", err)
+				}
+				if (failure.RetryAfter() == nil) != (tc.retry == nil) || (tc.retry != nil && *failure.RetryAfter() != *tc.retry) {
+					t.Fatalf("retry delay = %v, want %v", failure.RetryAfter(), tc.retry)
+				}
+				if failure.IsCredentialScoped() != tc.scoped {
+					t.Fatalf("credential scope = %t, want %t", failure.IsCredentialScoped(), tc.scoped)
+				}
+			})
+		}
+		// A ChatGPT account keeps the upstream text (and reads the whole body).
+		t.Run(tc.name+"/account", func(t *testing.T) {
+			err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, false), "execute", nil)
+			if err == nil || !strings.Contains(err.Error(), codexKeyTestSecret) {
+				t.Fatalf("account failure changed: %v", err)
+			}
+		})
+		server.Close()
+	}
+}
