+// An API key with codex cloaking disabled is a plain API client: no default
+// codex Version and no session header, whatever set it; the prompt cache key
+// stays in the body and a client's own Version passes through. Cloaked API
+// keys and ChatGPT accounts keep the codex client identity.
+func TestCodexPlainKeyIdentity(t *testing.T) {
+	uncloaked := &config.Config{}
+	uncloaked.Codex.DisableCodexCloaking = true
+	sessionFromClient := http.Header{"Session-Id": {"client-session"}}
+	for _, mode := range codexKeyTestModes {
+		t.Run(mode+"/plain", func(t *testing.T) {
+			for name, auth := range map[string]*cliproxyauth.Auth{
+				"config":    codexKeyTestAuth("", true),
+				"attribute": codexKeyTestAuth("", true),
+			} {
+				cfg := uncloaked
+				if name == "attribute" {
+					cfg = &config.Config{}
+					auth.Attributes[cliproxyauth.AttributeCodexDisableCloaking] = "true"
+				}
+				header, body := codexKeyTestHeaders(t, cfg, auth, mode, sessionFromClient)
+				for _, key := range []string{"Version", "Session-Id", "Session_id", "Originator", "Chatgpt-Account-Id"} {
+					if _, present := header[http.CanonicalHeaderKey(key)]; present || header.Get(key) != "" {
+						t.Fatalf("%s: plain key sent %s", name, key)
+					}
+				}
+				if got := gjson.GetBytes(body, "prompt_cache_key").String(); got != "codex-key-test-cache" {
+					t.Fatalf("%s: prompt cache key = %q", name, got)
+				}
+			}
+			header, _ := codexKeyTestHeaders(t, uncloaked, codexKeyTestAuth("", true), mode, http.Header{"Version": {"0.200.0"}})
+			if got := header.Get("Version"); got != "0.200.0" {
+				t.Fatalf("client Version = %q, want it passed through", got)
+			}
+		})
+		t.Run(mode+"/codex-identity", func(t *testing.T) {
+			for name, tc := range map[string]struct {
+				cfg  *config.Config
+				auth *cliproxyauth.Auth
+			}{
+				"cloaked-key":       {&config.Config{}, codexKeyTestAuth("", true)},
+				"account":           {&config.Config{}, codexKeyTestAuth("", false)},
+				"uncloaked-account": {uncloaked, codexKeyTestAuth("", false)},
+			} {
+				header, _ := codexKeyTestHeaders(t, tc.cfg, tc.auth, mode, nil)
+				if got := header.Get("Version"); got != codexClientVersion {
+					t.Fatalf("%s: Version = %q, want %q", name, got, codexClientVersion)
+				}
+				if got := header.Get("Session-Id"); got != "codex-key-test-cache" {
+					t.Fatalf("%s: Session-Id = %q", name, got)
+				}
+			}
+		})
+	}
+	// The websocket header builder applies the same Version default.
+	plain := codexKeyTestAuth("", true)
+	if got := applyCodexWebsocketHeaders(context.Background(), nil, plain, codexKeyTestSecret, uncloaked, false).Get("Version"); got != "" {
+		t.Fatalf("websocket plain key Version = %q", got)
+	}
+	account := codexKeyTestAuth("", false)
+	if got := applyCodexWebsocketHeaders(context.Background(), nil, account, codexKeyTestSecret, uncloaked, false).Get("Version"); got != codexClientVersion {
+		t.Fatalf("websocket account Version = %q", got)
+	}
+}
