diff --git a/internal/runtime/executor/codex_key_safety.go b/internal/runtime/executor/codex_key_safety.go
new file mode 100644
--- /dev/null
+++ b/internal/runtime/executor/codex_key_safety.go
@@ -0,0 +1,151 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/compatsafe"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/upstreamredirect"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// Codex API-key failure safety and the plain API-key client identity.
+//
+// A codex API key travels to the configured base URL as a bearer token, and
+// a provider may quote the credential it received in a failure: in a non-2xx
+// body, in the error of a terminal stream event (error, response.failed) or
+// in a transport error. For an API-key auth such a failure is rebuilt from
+// local data before it is captured, logged, published or returned by the
+// HTTP Execute, ExecuteStream and compact paths:
+//
+//   - a non-2xx body is read through the keyed chat route's bound
+//     (compatsafe.MaxErrorBody bytes plus one to detect overflow);
+//   - the codex classification still runs on the bounded body or on the
+//     terminal event (the status, 429 for usage limits and model capacity,
+//     the credential scope, the retry-after delay, the invalid-signature
+//     replay reset), and only its typed results are kept;
+//   - the text is the fixed error envelope of one compatsafe.Kind, chosen by
+//     the codex classification first and by the keyed chat classification
+//     otherwise; provider message, code and type strings are never kept;
+//   - transport, read and scanner errors keep only their trusted identity
+//     (compatsafe.Transport, which keeps the redirect refusal as it is).
+//
+// An API-key auth with codex cloaking disabled is a plain API client: its
+// requests carry no default codex client Version and no session header (the
+// prompt cache key still travels in the body). ChatGPT-account auths, and
+// API-key auths that keep cloaking on, keep the codex client identity and the
+// upstream failure text. Image requests, websockets and the SDK HttpRequest
+// are outside these promises.
+
+// codexClientVersion is the Version header a codex client request carries
+// when its client sends none.
+const codexClientVersion = "0.159.1"
+
+// codexKeySafe reports whether the failures of auth are rebuilt locally.
+func codexKeySafe(auth *cliproxyauth.Auth) bool {
+	return codexAuthUsesAPIKey(auth)
+}
+
+// codexPlainKey reports whether auth is an API key presented as a plain API
+// client: codex cloaking is disabled for it.
+func codexPlainKey(cfg *config.Config, auth *cliproxyauth.Auth) bool {
+	return codexAuthUsesAPIKey(auth) && isCodexCloakingDisabled(cfg, auth)
+}
+
+// codexVersionDefault is the Version header sent when the client sends none:
+// none for a plain API key, the codex client's version otherwise.
+func codexVersionDefault(cfg *config.Config, auth *cliproxyauth.Auth) string {
+	if codexPlainKey(cfg, auth) {
+		return ""
+	}
+	return codexClientVersion
+}
+
+// dropCodexPlainKeySession removes every session header from the final
+// request headers of a plain API key, whatever set it (the prompt cache, the
+// client, a model override or identity rewriting).
+func dropCodexPlainKeySession(headers http.Header, cfg *config.Config, auth *cliproxyauth.Auth) {
+	if headers == nil || !codexPlainKey(cfg, auth) {
+		return
+	}
+	deleteHeaderCaseInsensitive(headers, "Session-Id")
+	deleteHeaderCaseInsensitive(headers, "Session_id")
+}
+
+// codexKeyFailure keeps the typed results of a classified codex failure and
+// replaces its text with the fixed envelope of kind.
+func codexKeyFailure(classified statusErr, kind compatsafe.Kind) statusErr {
+	return statusErr{code: classified.code, msg: kind.Body(), retryAfter: classified.retryAfter,
+		credentialScoped: classified.credentialScoped}
+}
+
+// codexKeyKind selects the fixed kind of a codex failure from its status and
+// its body. The authoritative 402 and 429 statuses come first; then the
+// categories the codex classification names (context length, an invalid
+// thinking signature or a missing previous response, which are request
+// faults, and an authentication failure); everything else is classified like
+// a keyed chat failure (compatsafe.Classify, which examines at most
+// compatsafe.MaxErrorBody bytes).
+func codexKeyKind(status int, body []byte) compatsafe.Kind {
+	if status != http.StatusTooManyRequests && status != http.StatusPaymentRequired {
+		if code, _, ok := codexStatusErrorClassification(status, body); ok {
+			switch code {
+			case "context_too_large":
+				return compatsafe.KindContextLength
+			case "auth_unavailable":
+				return compatsafe.KindAuthentication
+			default:
+				return compatsafe.KindInvalidRequest
+			}
+		}
+	}
+	return compatsafe.Classify(status, body)
+}
+
+// codexKeyTerminalFailure is the safe form of a classified terminal stream
+// failure (or of the bootstrap overload rejection built from it).
+func codexKeyTerminalFailure(classified statusErr, body []byte) statusErr {
+	return codexKeyFailure(classified, codexKeyKind(classified.code, body))
+}
+
+// codexKeyHTTPFailure reads and classifies a non-2xx response of an API-key
+// auth. It returns the safe failure and the body the caller may still
+// examine locally (nil when the body overflowed the bound or could not be
+// read). Only the safe failure's text is captured, and only its status and
+// kind are logged.
+func codexKeyHTTPFailure(ctx context.Context, cfg *config.Config, resp *http.Response, modelLevelCooling bool) (statusErr, []byte) {
+	body, overflow, readable := compatsafe.ReadErrorBody(resp.Body)
+	examinable := readable && !overflow
+	if !examinable {
+		body = nil
+	}
+	classified := newCodexStatusErrWithCooling(resp.StatusCode, body, modelLevelCooling)
+	var kind compatsafe.Kind
+	if examinable {
+		kind = codexKeyKind(classified.code, body)
+	} else {
+		kind = compatsafe.HTTPFailure(classified.code, nil, overflow, readable, nil).Kind
+	}
+	failure := codexKeyFailure(classified, kind)
+	helps.AppendAPIResponseChunk(ctx, cfg, []byte(failure.msg))
+	helps.LogWithRequestID(ctx).Debugf("request error, error status: %d, failure kind: %s", failure.code, kind)
+	return failure, body
+}
+
+// codexBootstrapOverloadFailure is the overload rejection of a buffered
+// stream bootstrap, in its safe form for an API-key auth.
+func codexBootstrapOverloadFailure(auth *cliproxyauth.Auth, body []byte) statusErr {
+	failure := newCodexBootstrapOverloadErr(body)
+	if codexKeySafe(auth) {
+		failure = codexKeyTerminalFailure(failure, body)
+	}
+	return failure
+}
+
+// codexKeyTransportError keeps only the trusted identity of a transport,
+// read or scanner error of an API-key auth.
+func codexKeyTransportError(err error) error {
+	return compatsafe.Transport(err, upstreamredirect.IsRefused)
+}
