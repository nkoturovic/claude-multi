+func TestCM053CredentialSaveGenerationOrdering(t *testing.T) {
+	logs := cm053CaptureLogs(t)
+	store := newCM053Store()
+	m := cm053Manager(t, store)
+	cm053Register(t, m, cm053NewAuth("claude-a.json", "sk-old"))
+	logs.events(t)
+
+	// A refresh's verified save is paused after staging (its file sync). A result
+	// persist of a newer generation runs meanwhile and must not wait for it; the
+	// paused refresh must then decline to publish its older generation.
+	stagedCh, resume := make(chan struct{}), make(chan struct{})
+	store.set(func(s *cm053Store) {
+		s.staged = func() {
+			close(stagedCh)
+			<-resume
+		}
+	})
+	refreshed := make(chan struct{})
+	go func() {
+		defer close(refreshed)
+		if _, err := cm053RefreshErr(context.Background(), m, "claude-a.json", "sk-new"); err != nil {
+			t.Errorf("refresh: %v", err)
+		}
+	}()
+	<-stagedCh
+	resultDone := make(chan struct{})
+	go func() {
+		defer close(resultDone)
+		m.MarkResult(context.Background(), Result{AuthID: "claude-a.json", Provider: "claude", Model: "m", Success: true})
+	}()
+	select {
+	case <-resultDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("a lock-held result persist waited for a paused verified save")
+	}
+	close(resume)
+	<-refreshed
+
+	store.mu.Lock()
+	commits := append([]uint64(nil), store.commits["claude-a.json"]...)
+	saved := store.saved["claude-a.json"].Clone()
+	store.mu.Unlock()
+	current, _ := m.GetByID("claude-a.json")
+	if len(commits) != 1 || commits[0] != current.Generation || authAccessToken(saved) != "sk-new" {
+		t.Fatalf("commits=%v saved=%q current gen=%d, want only the newer result generation with the rotated token", commits, authAccessToken(saved), current.Generation)
+	}
+	events := logs.events(t)
+	if cm053Summary(events) != "result/unverified/no_sync refresh/skipped/stale_generation" {
+		t.Fatalf("events = %s", cm053Summary(events))
+	}
+
+	// A stalled directory sync (after the publish) holds no manager lock either.
+	syncedCh, resumeSync := make(chan struct{}), make(chan struct{})
+	store.set(func(s *cm053Store) {
+		s.staged = nil
+		s.synced = func() {
+			close(syncedCh)
+			<-resumeSync
+		}
+	})
+	refreshed = make(chan struct{})
+	go func() {
+		defer close(refreshed)
+		if _, err := cm053RefreshErr(context.Background(), m, "claude-a.json", "sk-newer"); err != nil {
+			t.Errorf("refresh: %v", err)
+		}
+	}()
+	<-syncedCh
+	resultDone = make(chan struct{})
+	go func() {
+		defer close(resultDone)
+		m.MarkResult(context.Background(), Result{AuthID: "claude-a.json", Provider: "claude", Model: "m", Success: true})
+		cm053SelectionLockProbe(m)
+	}()
+	select {
+	case <-resultDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("a lock-held persist waited for a stalled directory sync")
+	}
+	close(resumeSync)
+	<-refreshed
+	store.set(func(s *cm053Store) { s.synced = nil })
+
+	// A verified save that fails before its commit point after a newer generation was
+	// published meanwhile was superseded: stale, not the latest failure.
+	logs.events(t)
+	store.set(func(s *cm053Store) {
+		s.failStaged = syscall.EIO
+		s.staged = func() {
+			m.MarkResult(context.Background(), Result{AuthID: "claude-a.json", Provider: "claude", Model: "m", Success: true})
+		}
+	})
+	cm053Refresh(t, context.Background(), m, "claude-a.json", "sk-superseded")
+	store.set(func(s *cm053Store) { s.failStaged, s.staged = nil, nil })
+	if got := cm053Summary(logs.events(t)); got != "result/unverified/no_sync refresh/skipped/stale_generation" {
+		t.Fatalf("superseded failure events = %s", got)
+	}
+	// Without a newer publish the same failure is reported.
+	store.set(func(s *cm053Store) { s.failStaged = syscall.EIO })
+	cm053Refresh(t, context.Background(), m, "claude-a.json", "sk-lost")
+	store.set(func(s *cm053Store) { s.failStaged = nil })
+	if got := logs.events(t); len(got) != 1 || got[0].result != "failed" || got[0].stage != "sync" || got[0].errno != int(syscall.EIO) {
+		t.Fatalf("pre-commit failure events = %s", cm053Summary(got))
+	}
+
+	// Concurrent verified and lock-held persists of one auth, generations interleaved:
+	// publishes stay in generation order and the newest generation is what ends up
+	// stored. (Driven through persist itself: driving UpdateRefreshedAuth concurrently
+	// with MarkResult trips the upstream publication race in updateInternal, which is
+	// separate work, not this patch.)
+	logs.events(t)
+	template, _ := m.GetByID("claude-a.json")
+	var next atomic.Uint64
+	next.Store(template.Generation + 1)
+	var maxGen atomic.Uint64
+	var wg sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			for i := 0; i < 25; i++ {
+				snapshot := template.Clone()
+				snapshot.Generation = next.Add(1)
+				snapshot.Metadata["access_token"] = fmt.Sprintf("sk-gen-%d", snapshot.Generation)
+				for {
+					seen := maxGen.Load()
+					if snapshot.Generation <= seen || maxGen.CompareAndSwap(seen, snapshot.Generation) {
+						break
+					}
+				}
+				op, durability := persistOpRefresh, persistDurable
+				if (worker+i)%2 == 1 {
+					op, durability = persistOpResult, persistNoSync
+				}
+				if err := m.persist(context.Background(), snapshot, op, durability); err != nil {
+					t.Errorf("persist: %v", err)
+				}
+			}
+		}(worker)
+	}
+	wg.Wait()
+	store.mu.Lock()
+	commits = append([]uint64(nil), store.commits["claude-a.json"]...)
+	saved = store.saved["claude-a.json"].Clone()
+	store.mu.Unlock()
+	for i := 1; i < len(commits); i++ {
+		if commits[i] <= commits[i-1] {
+			t.Fatalf("publish order regressed: %v", commits)
+		}
+	}
+	if saved.Generation != maxGen.Load() || authAccessToken(saved) != fmt.Sprintf("sk-gen-%d", maxGen.Load()) {
+		t.Fatalf("stored gen=%d token=%q, want the newest generation %d", saved.Generation, authAccessToken(saved), maxGen.Load())
+	}
+	for _, e := range logs.events(t) {
+		if e.result == "failed" || (e.result == "skipped" && e.category != "stale_generation") {
+			t.Fatalf("unexpected event %+v", e)
+		}
+	}
+}
+
+// cm053SelectionLockProbe takes m.mu the way selection does.
+func cm053SelectionLockProbe(m *Manager) {
+	m.mu.RLock()
+	_ = len(m.auths)
+	m.mu.RUnlock()
+}
