+		}
+		failed = append(failed, fmt.Sprintf("%s:%d", e.stage, e.errno))
+	}
+	want := fmt.Sprintf("write:%d write:%d rename:%d rename:%d", syscall.ENOSPC, syscall.EDQUOT, syscall.EDQUOT, syscall.EDQUOT)
+	if strings.Join(failed, " ") != want {
+		t.Fatalf("failed events = %q, want %q (once per transition)", strings.Join(failed, " "), want)
+	}
+}
