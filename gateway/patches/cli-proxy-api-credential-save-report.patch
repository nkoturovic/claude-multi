+func TestCM053CredentialSaveShortWriteIsFailure(t *testing.T) {
+	for _, sync := range []bool{true, false} {
+		t.Run(fmt.Sprintf("sync=%t", sync), func(t *testing.T) {
+			dir := t.TempDir()
+			prior := cm053Seed(t, dir, "claude-a.json")
+			store, faults := cm053Store(dir)
+			faults.stage = "short_write"
+
+			auth := cm053Auth(dir, "claude-a.json", cm053NewAccess, cm053NewRefresh)
+			payload, _ := json.Marshal(func() map[string]any {
+				meta := cm053Metadata(cm053NewAccess, cm053NewRefresh)
