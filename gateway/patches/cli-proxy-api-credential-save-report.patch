+	store.set(func(s *cm053Store) { s.failErr = syscall.EDQUOT })
+	result(3)
+	store.set(func(s *cm053Store) { s.failStage = SaveStageRename })
+	result(2)
+	store.set(func(s *cm053Store) { s.failErr, s.unchanged = nil, true })
+	result(2) // unchanged: silent for result, but clears the failure
+	store.set(func(s *cm053Store) { s.failErr, s.failStage, s.unchanged = syscall.EDQUOT, SaveStageRename, false })
