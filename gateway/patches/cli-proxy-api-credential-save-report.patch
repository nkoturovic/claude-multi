diff --git a/sdk/auth/filestore_cm053_fsize_test.go b/sdk/auth/filestore_cm053_fsize_test.go
new file mode 100644
index 0000000..90845c4
--- /dev/null
+++ b/sdk/auth/filestore_cm053_fsize_test.go
@@ -0,0 +1,113 @@
+//go:build linux
+
+package auth
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// A black-box control on the real file system: a re-executed test process lowers
+// RLIMIT_FSIZE below the new payload and saves over a valid credential. The Go runtime
+// only forwards SIGXFSZ to signal.Notify, so the write fails with EFBIG. The previous
+// credential must be intact. (Upstream's in-place O_TRUNC write loses it.)
+const (
+	cm053FSizeChildEnv = "CM053_FSIZE_CHILD_DIR"
+	cm053FSizeModeEnv  = "CM053_FSIZE_MODE"
+	cm053FSizeLimit    = 4096
+)
+
+func cm053FSizeChild(t *testing.T, dir, mode string) {
+	limit := syscall.Rlimit{Cur: cm053FSizeLimit, Max: cm053FSizeLimit}
+	if err := syscall.Setrlimit(syscall.RLIMIT_FSIZE, &limit); err != nil {
+		fmt.Printf("CM053RESULT setrlimit-failed\n")
+		os.Exit(3)
+	}
+	meta := map[string]any{
+		"type":          "claude",
+		"access_token":  "sk-ant-oat01-SYNTHETIC-NEW-ACCESS",
+		"refresh_token": "sk-ant-ort01-SYNTHETIC-NEW-REFRESH",
+		"padding":       strings.Repeat("x", 4*cm053FSizeLimit),
+	}
+	auth := &cliproxyauth.Auth{
+		ID:         "claude-a.json",
+		Provider:   "claude",
+		FileName:   "claude-a.json",
+		Attributes: map[string]string{"path": filepath.Join(dir, "claude-a.json")},
+		Metadata:   meta,
+	}
+	store := NewFileTokenStore()
+	var err error
+	outcome := "none"
+	switch mode {
+	case "save":
+		_, err = store.Save(context.Background(), auth)
+	case "report":
+		var report cliproxyauth.SaveReport
+		report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+		outcome = fmt.Sprintf("%s/%s/%d", report.Outcome, report.Stage, report.Errno)
+	}
+	var errno syscall.Errno
+	if !errors.As(err, &errno) {
+		errno = 0
+	}
+	fmt.Printf("CM053RESULT errno=%d outcome=%s\n", int(errno), outcome)
+	os.Exit(0)
+}
+
+func TestCM053CredentialSaveFileSizeLimitKeepsPriorCredential(t *testing.T) {
+	if dir := os.Getenv(cm053FSizeChildEnv); dir != "" {
+		cm053FSizeChild(t, dir, os.Getenv(cm053FSizeModeEnv))
+		return
+	}
+	for _, mode := range []string{"save", "report"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			prior, err := json.Marshal(map[string]any{
+				"type":          "claude",
+				"access_token":  "sk-ant-oat01-SYNTHETIC-OLD-ACCESS",
+				"refresh_token": "sk-ant-ort01-SYNTHETIC-OLD-REFRESH",
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			dest := filepath.Join(dir, "claude-a.json")
+			if err = os.WriteFile(dest, prior, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestCM053CredentialSaveFileSizeLimitKeepsPriorCredential$", "-test.count=1")
+			cmd.Env = append(os.Environ(), cm053FSizeChildEnv+"="+dir, cm053FSizeModeEnv+"="+mode)
+			var out bytes.Buffer
+			cmd.Stdout, cmd.Stderr = &out, &out
+			if errRun := cmd.Run(); errRun != nil {
+				t.Fatalf("child: %v\n%s", errRun, out.String())
+			}
+			wantResult := "CM053RESULT errno=27 outcome=none"
+			if mode == "report" {
+				wantResult = "CM053RESULT errno=27 outcome=failed/write/27"
+			}
+			if !strings.Contains(out.String(), wantResult+"\n") {
+				t.Fatalf("child result: want %q (EFBIG) in\n%s", wantResult, out.String())
+			}
+			got, errRead := os.ReadFile(dest)
+			if errRead != nil || !bytes.Equal(got, prior) {
+				t.Fatalf("prior credential lost after an EFBIG write: %q (err %v), want %q", got, errRead, prior)
+			}
+			entries, _ := os.ReadDir(dir)
+			if len(entries) != 1 {
+				t.Fatalf("directory holds %d entries after the failed save, want only the destination", len(entries))
+			}
+		})
+	}
+}
diff --git a/sdk/auth/filestore_cm053_manager_test.go b/sdk/auth/filestore_cm053_manager_test.go
new file mode 100644
index 0000000..ae22b5f
--- /dev/null
+++ b/sdk/auth/filestore_cm053_manager_test.go
@@ -0,0 +1,175 @@
+package auth_test
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+
+	sdkauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/auth"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// This gate drives the Manager with the real FileTokenStore: a refresh's verified save
+// whose destination another save replaces during its directory sync must not produce a
+// persisted receipt, and must not be logged after the newer save as if it were current.
+
+type cm053ManagerLogs struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+func (c *cm053ManagerLogs) Levels() []log.Level { return log.AllLevels }
+
+func (c *cm053ManagerLogs) Fire(entry *log.Entry) error {
+	if strings.HasPrefix(entry.Message, "credential_save_v1 ") {
+		c.mu.Lock()
+		c.lines = append(c.lines, entry.Message)
+		c.mu.Unlock()
+	}
+	return nil
+}
+
+var cm053ManagerEvent = regexp.MustCompile(`^credential_save_v1 operation=([a-z]+) result=([a-z]+) .* category=([a-z_]+) bytes=`)
+
+// take returns "operation/result/category" for every event since the last call.
+func (c *cm053ManagerLogs) take(t *testing.T) string {
+	t.Helper()
+	c.mu.Lock()
+	lines := c.lines
+	c.lines = nil
+	c.mu.Unlock()
+	parts := make([]string, 0, len(lines))
+	for _, line := range lines {
+		m := cm053ManagerEvent.FindStringSubmatch(line)
+		if m == nil {
+			t.Fatalf("credential_save_v1 line off format: %q", line)
+		}
+		parts = append(parts, m[1]+"/"+m[2]+"/"+m[3])
+	}
+	return strings.Join(parts, " ")
+}
+
+func cm053CaptureManagerLogs(t *testing.T) *cm053ManagerLogs {
+	t.Helper()
+	capture := &cm053ManagerLogs{}
+	logger := log.StandardLogger()
+	saved := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		saved[level] = append([]log.Hook(nil), hooks...)
+	}
+	savedLevel := logger.GetLevel()
+	logger.SetLevel(log.TraceLevel)
+	logger.AddHook(capture)
+	t.Cleanup(func() {
+		logger.ReplaceHooks(saved)
+		logger.SetLevel(savedLevel)
+	})
+	return capture
+}
+
+func TestCM053CredentialSaveSupersededReceiptWithFileStore(t *testing.T) {
+	logs := cm053CaptureManagerLogs(t)
+	dir := t.TempDir()
+	path := filepath.Join(dir, "claude-a.json")
+	cm053WriteCredential(t, path, "sk-ant-oat01-SYNTHETIC-SEED")
+
+	var during func()
+	store, syncCounts := sdkauth.NewFileTokenStoreWithDirSyncHookForTest(func() {
+		if f := during; f != nil {
+			during = nil
+			f()
+		}
+	})
+	store.SetBaseDir(dir)
+	m := cliproxyauth.NewManager(store, nil, nil)
+	newAuth := func(access string) *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{
+			ID:         "claude-a.json",
+			Provider:   "claude",
+			FileName:   "claude-a.json",
+			Attributes: map[string]string{"path": path},
+			Metadata: map[string]any{
+				"type":          "claude",
+				"email":         "synthetic-user@example.invalid",
+				"access_token":  access,
+				"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH",
+				"disabled":      false,
+			},
+		}
+	}
+	if _, err := m.Register(cliproxyauth.WithSkipPersist(context.Background()), newAuth("sk-ant-oat01-SYNTHETIC-SEED")); err != nil {
+		t.Fatal(err)
+	}
+	refresh := func(access string) {
+		t.Helper()
+		base, ok := m.GetByID("claude-a.json")
+		if !ok {
+			t.Fatal("auth missing")
+		}
+		updated := base.Clone()
+		updated.Metadata["access_token"] = access
+		if _, err := m.UpdateRefreshedAuth(context.Background(), base, updated); err != nil {
+			t.Fatalf("UpdateRefreshedAuth: %v", err)
+		}
+	}
+	onDisk := func() string {
+		t.Helper()
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var meta map[string]any
+		if err = json.Unmarshal(raw, &meta); err != nil {
+			t.Fatal(err)
+		}
+		access, _ := meta["access_token"].(string)
+		return access
+	}
+
+	// Control: a request's result persist during the directory sync writes nothing new
+	// (the refreshed credential is already installed and on disk): the receipt stands.
+	during = func() {
+		m.MarkResult(context.Background(), cliproxyauth.Result{AuthID: "claude-a.json", Provider: "claude", Model: "m", Success: true})
+	}
+	refresh("sk-ant-oat01-SYNTHETIC-R1")
+	if got := logs.take(t); got != "refresh/persisted/none" {
+		t.Fatalf("control events = %q, want refresh/persisted/none", got)
+	}
+
+	// A re-registration writes a different credential, unsynced, between the refresh's
+	// rename and the end of its directory sync. The refresh must not report persisted,
+	// and nothing persisted may follow the newer write.
+	filesBefore, _ := syncCounts()
+	during = func() {
+		if _, err := m.Register(context.Background(), newAuth("sk-ant-oat01-SYNTHETIC-REREGISTERED")); err != nil {
+			t.Errorf("register: %v", err)
+		}
+	}
+	refresh("sk-ant-oat01-SYNTHETIC-R2")
+	filesAfter, _ := syncCounts()
+	got := logs.take(t)
+	if strings.Contains(got, "persisted") {
+		t.Fatalf("events = %q: a superseded refresh produced a persisted receipt (file syncs=%d)", got, filesAfter-filesBefore)
+	}
+	if got != "register/unverified/no_sync refresh/unverified/superseded" {
+		t.Fatalf("events = %q, want register/unverified/no_sync refresh/unverified/superseded", got)
+	}
+	if access := onDisk(); access != "sk-ant-oat01-SYNTHETIC-REREGISTERED" {
+		t.Fatalf("destination access token = %q, want the re-registered credential", access)
+	}
+	if filesAfter-filesBefore != 1 {
+		t.Fatalf("file syncs during the superseded refresh = %d, want 1 (the refresh's own)", filesAfter-filesBefore)
+	}
+
+	// The next refresh with no interference is a receipt again.
+	refresh("sk-ant-oat01-SYNTHETIC-R3")
+	if got := logs.take(t); got != "refresh/persisted/none" {
+		t.Fatalf("follow-up events = %q, want refresh/persisted/none", got)
+	}
+}
diff --git a/sdk/auth/filestore_cm053_test.go b/sdk/auth/filestore_cm053_test.go
new file mode 100644
index 0000000..1adf09f
--- /dev/null
+++ b/sdk/auth/filestore_cm053_test.go
@@ -0,0 +1,787 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// cm053Faults wraps the real save operations with injected failures and counters.
+type cm053Faults struct {
+	mu        sync.Mutex
+	stage     string // "", "open", "write", "short_write", "sync", "close", "rename", "dirsync"
+	err       error
+	suffix    string // fixed temp suffix when set
+	fileSyncs int
+	dirSyncs  int
+	temps     []string
+	events    []string
+	// pause runs while the temporary file exists: at an injected write, sync or close
+	// failure, and before every rename.
+	pause func()
+	// beforeDirSync runs before every directory sync: after a verified save's rename,
+	// with neither the caller's ordering lock nor the store lock held.
+	beforeDirSync func()
+}
+
+func (c *cm053Faults) paused() {
+	if c.pause != nil {
+		c.pause()
+	}
+}
+
+type cm053File struct {
+	f      saveFile
+	faults *cm053Faults
+}
+
+func (f *cm053File) Write(p []byte) (int, error) {
+	switch f.faults.current() {
+	case "write":
+		n, _ := f.f.Write(p[:len(p)/3])
+		f.faults.paused()
+		return n, f.faults.err
+	case "short_write":
+		// A short count with a nil error: the writer must not trust err alone.
+		n, err := f.f.Write(p[:len(p)/2])
+		f.faults.paused()
+		return n, err
+	}
+	return f.f.Write(p)
+}
+
+func (f *cm053File) Sync() error {
+	f.faults.record("sync")
+	f.faults.mu.Lock()
+	f.faults.fileSyncs++
+	f.faults.mu.Unlock()
+	if f.faults.current() == "sync" {
+		_ = f.f.Sync()
+		f.faults.paused()
+		return f.faults.err
+	}
+	return f.f.Sync()
+}
+
+func (f *cm053File) Close() error {
+	errClose := f.f.Close()
+	f.faults.record("close")
+	if f.faults.current() == "close" {
+		f.faults.paused()
+		return f.faults.err
+	}
+	return errClose
+}
+
+func (c *cm053Faults) current() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.stage
+}
+
+func (c *cm053Faults) record(event string) {
+	c.mu.Lock()
+	c.events = append(c.events, event)
+	c.mu.Unlock()
+}
+
+func (c *cm053Faults) ops() *saveFileOps {
+	return &saveFileOps{
+		openTemp: func(name string) (saveFile, error) {
+			c.mu.Lock()
+			c.temps = append(c.temps, name)
+			c.mu.Unlock()
+			c.record("open")
+			if c.current() == "open" {
+				return nil, c.err
+			}
+			file, err := defaultSaveFileOps.openTemp(name)
+			if err != nil {
+				return nil, err
+			}
+			return &cm053File{f: file, faults: c}, nil
+		},
+		rename: func(oldPath, newPath string) error {
+			c.record("rename")
+			c.paused()
+			if c.current() == "rename" {
+				return c.err
+			}
+			return os.Rename(oldPath, newPath)
+		},
+		remove: os.Remove,
+		syncDir: func(dir string) error {
+			if c.beforeDirSync != nil {
+				c.beforeDirSync()
+			}
+			c.record("dirsync")
+			c.mu.Lock()
+			c.dirSyncs++
+			c.mu.Unlock()
+			if c.current() == "dirsync" {
+				return c.err
+			}
+			return syncDirectory(dir)
+		},
+		tempSuffix: func() (string, error) {
+			if c.suffix != "" {
+				return c.suffix, nil
+			}
+			return randomSaveSuffix()
+		},
+	}
+}
+
+func (c *cm053Faults) syncCounts() (int, int) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.fileSyncs, c.dirSyncs
+}
+
+const (
+	cm053OldAccess  = "sk-ant-oat01-SYNTHETIC-OLD-ACCESS"
+	cm053OldRefresh = "sk-ant-ort01-SYNTHETIC-OLD-REFRESH"
+	cm053NewAccess  = "sk-ant-oat01-SYNTHETIC-NEW-ACCESS"
+	cm053NewRefresh = "sk-ant-ort01-SYNTHETIC-NEW-REFRESH"
+	cm053Email      = "synthetic-user@example.invalid"
