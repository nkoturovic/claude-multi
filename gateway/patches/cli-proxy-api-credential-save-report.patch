+
+// persistVerified runs a verified save: the store stages and syncs the payload, takes the
+// per-auth ordering lock only through the Commit callback (guard check, compare and
+// publish), and syncs the directory after releasing it. A stalled sync therefore never
+// holds pLock.mu, which the lock-held persist callers take while holding m.mu. The
+// completion is checked and reported under pLock.mu (no I/O there), so a completion that
+// a newer save's outcome overtook is reported superseded and never follows it as a receipt.
+func (m *Manager) persistVerified(ctx context.Context, auth *Auth, op persistOperation, pLock *authPersistLock, store ReportingStore) error {
+	pLock.mu.Lock()
+	stale := auth.RegistrationEpoch < pLock.lastEpoch || (auth.RegistrationEpoch == pLock.lastEpoch && auth.Generation < pLock.lastGeneration)
+	pLock.mu.Unlock()
+	if stale {
+		emitCredentialSave(op, auth, skippedSave(SaveCategoryStaleGeneration))
+		return nil
+	}
+	committed, declined := false, false
+	var ticket uint64
+	commit := func() (func(), bool) {
+		committed = true
+		pLock.mu.Lock()
+		t, ok := pLock.admit(auth)
+		if !ok {
+			pLock.mu.Unlock()
+			declined = true
+			return nil, false
+		}
+		ticket = t
+		return pLock.mu.Unlock, true
+	}
+	report, err := store.SaveWithReport(ctx, auth, SaveOptions{Sync: true, Commit: commit})
+	if declined {
+		emitCredentialSave(op, auth, skippedSave(SaveCategoryStaleGeneration))
+		return nil
+	}
+	pLock.mu.Lock()
+	defer pLock.mu.Unlock()
+	if !committed {
+		// The store stopped before its commit point. Keep the ordering record a
+		// lock-held save would have made; an attempt a newer generation superseded
+		// meanwhile is stale, not the latest failure.
+		t, admitted := pLock.admit(auth)
+		if !admitted {
+			emitCredentialSave(op, auth, skippedSave(SaveCategoryStaleGeneration))
+			return nil
+		}
+		ticket = t
+	}
+	if pLock.complete(ticket, report) {
+		report = supersededSave(report)
+	}
+	m.reportCredentialSave(op, auth, pLock, report)
+	return err
+}
+
+func (m *Manager) saveWithReport(ctx context.Context, auth *Auth, opts SaveOptions) (SaveReport, error) {
+	if reporting, ok := m.store.(ReportingStore); ok {
+		return reporting.SaveWithReport(ctx, auth, opts)
+	}
+	if _, err := m.store.Save(ctx, auth); err != nil {
+		return FailedSaveReport(SaveStageStore, err, 0, 0), err
+	}
+	return SaveReport{Outcome: SaveOutcomeUnverified, Stage: SaveStageNone, Category: SaveCategoryStoreUnreported}, nil
+}
+
+// reportCredentialSave emits the event for report, logging a failure only when its
+// (stage, errno, category) differs from the last failure logged for this auth.
+func (m *Manager) reportCredentialSave(op persistOperation, auth *Auth, pLock *authPersistLock, report SaveReport) {
+	if pLock != nil {
+		pLock.eventMu.Lock()
+		defer pLock.eventMu.Unlock()
+		switch report.Outcome {
+		case SaveOutcomeFailed:
+			key := fmt.Sprintf("%s/%d/%s", report.Stage, report.Errno, report.Category)
+			if pLock.lastFailure == key {
+				return
+			}
+			pLock.lastFailure = key
+		case SaveOutcomePersisted, SaveOutcomeUnverified, SaveOutcomeUnchanged:
+			// A superseded completion is older than the newest outcome: it clears nothing.
+			if report.Category != SaveCategorySuperseded {
+				pLock.lastFailure = ""
+			}
+		}
+	}
+	emitCredentialSave(op, auth, report)
+}
