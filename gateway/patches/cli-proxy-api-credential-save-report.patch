+func TestCM053CredentialSaveCommitCallback(t *testing.T) {
+	dir := t.TempDir()
+	prior := cm053Seed(t, dir, "claude-a.json")
+	store, faults := cm053Store(dir)
+	auth := cm053Auth(dir, "claude-a.json", cm053NewAccess, cm053NewRefresh)
+
+	takeOrder := func() string {
+		faults.mu.Lock()
+		defer faults.mu.Unlock()
+		order := strings.Join(faults.events, ",")
+		faults.events = nil
+		return order
+	}
+
+	// Declined at the first (unchanged-check) call: nothing staged or published.
+	report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true, Commit: func() (func(), bool) {
+		faults.record("commit")
+		return nil, false
+	}})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomeSkipped || report.Category != cliproxyauth.SaveCategoryCommitDeclined {
+		t.Fatalf("declined: report=%+v err=%v", report, err)
+	}
+	cm053AssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+	cm053AssertNoTemp(t, dir)
+	if order := takeOrder(); order != "commit" {
+		t.Fatalf("declined order = %s, want commit", order)
+	}
+
+	// Declined at the publish call: the staged temp is removed.
+	calls := 0
+	report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true, Commit: func() (func(), bool) {
+		faults.record("commit")
+		calls++
+		return func() { faults.record("release") }, calls == 1
+	}})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomeSkipped || report.Category != cliproxyauth.SaveCategoryCommitDeclined {
+		t.Fatalf("declined at publish: report=%+v err=%v", report, err)
+	}
+	cm053AssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+	cm053AssertNoTemp(t, dir)
+	if order := takeOrder(); order != "commit,release,open,sync,close,commit" {
+		t.Fatalf("declined-at-publish order = %s, want commit,release,open,sync,close,commit", order)
+	}
+
+	// Accepted: the unchanged check and the publish each run inside one commit/release
+	// pair; the file sync runs between them and the directory sync after the release, so
+	// the caller's lock is held over neither.
+	report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true, Commit: func() (func(), bool) {
+		faults.record("commit")
+		return func() { faults.record("release") }, true
+	}})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomePersisted {
+		t.Fatalf("accepted: report=%+v err=%v", report, err)
+	}
+	if order := takeOrder(); order != "commit,release,open,sync,close,commit,rename,release,dirsync" {
+		t.Fatalf("order = %s, want commit,release,open,sync,close,commit,rename,release,dirsync", order)
+	}
+
+	// Unchanged: one commit/release pair and no file work at all.
+	report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true, Commit: func() (func(), bool) {
+		faults.record("commit")
+		return func() { faults.record("release") }, true
+	}})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnchanged {
+		t.Fatalf("unchanged: report=%+v err=%v", report, err)
+	}
+	if order := takeOrder(); order != "commit,release" {
+		t.Fatalf("unchanged order = %s, want commit,release", order)
+	}
+
+	// Without Sync the callback brackets the whole save.
+	auth.Metadata["access_token"] = "sk-fourth"
+	report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Commit: func() (func(), bool) {
+		faults.record("commit")
+		return func() { faults.record("release") }, true
+	}})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnverified {
+		t.Fatalf("unsynced: report=%+v err=%v", report, err)
+	}
+	if order := takeOrder(); order != "commit,open,close,rename,release" {
+		t.Fatalf("order = %s, want commit,open,close,rename,release", order)
+	}
+}
