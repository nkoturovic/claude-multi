+//go:build unix
+
+package auth
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+// saveTempFlags opens a new private temp file: never an existing entry, never through a
+// symlink, never inherited by a child process.
+const saveTempFlags = os.O_WRONLY | os.O_CREATE | os.O_EXCL | syscall.O_NOFOLLOW | syscall.O_CLOEXEC
+
+var errDirSyncUnsupported = errors.New("auth filestore: directory sync unsupported")
+
+func syncDirectory(dir string) error {
+	handle, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	errSync := handle.Sync()
+	errClose := handle.Close()
+	if errSync != nil {
+		return errSync
+	}
+	return errClose
+}
