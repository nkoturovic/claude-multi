+func cm053AssertNoTemp(t *testing.T, dir string) {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.Contains(entry.Name(), saveTempMarker) {
+			t.Fatalf("temporary save file left behind: %s", entry.Name())
+		}
+	}
+}
+
+func cm053AssertBytes(t *testing.T, path string, want []byte) {
+	t.Helper()
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read destination: %v", err)
+	}
+	if string(got) != string(want) {
+		t.Fatalf("destination changed:\n got %q\nwant %q", got, want)
+	}
+}
+
+func cm053AssertMetadataOnly(t *testing.T, report cliproxyauth.SaveReport) {
+	t.Helper()
+	text := fmt.Sprintf("%+v", report)
+	for _, secret := range []string{cm053OldAccess, cm053OldRefresh, cm053NewAccess, cm053NewRefresh, cm053Email, "claude-a", string(os.PathSeparator)} {
+		if strings.Contains(text, secret) {
+			t.Fatalf("save report carries %q: %s", secret, text)
+		}
+	}
+}
