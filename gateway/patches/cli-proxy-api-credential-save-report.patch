+func TestCM053CredentialSaveEventVolumeRules(t *testing.T) {
+	logs := cm053CaptureLogs(t)
+	ops := []persistOperation{persistOpRefresh, persistOpPrepare, persistOpUpdate, persistOpResult, persistOpReconcile, persistOpRegister, persistOpReset}
+	outcomes := []SaveOutcome{SaveOutcomePersisted, SaveOutcomeFailed, SaveOutcomeUnverified, SaveOutcomeUnchanged, SaveOutcomeSkipped}
+	auth := cm053NewAuth("claude-a.json", "sk-a")
+	auth.EnsureIndex()
+	for _, op := range ops {
+		for _, outcome := range outcomes {
+			emitCredentialSave(op, auth, SaveReport{Outcome: outcome})
+			got := logs.events(t)
+			want := outcome == SaveOutcomePersisted || outcome == SaveOutcomeFailed || outcome == SaveOutcomeUnverified || op == persistOpRefresh
+			if (len(got) == 1) != want || len(got) > 1 {
+				t.Fatalf("%s/%s: %d events, want emitted=%t", op, outcome, len(got), want)
+			}
+			if want && (got[0].operation != string(op) || got[0].result != string(outcome) || got[0].stage != "none" || got[0].category != "none") {
+				t.Fatalf("%s/%s: event %+v", op, outcome, got[0])
+			}
+		}
+	}
+
+	// A store without the report interface is never "persisted".
+	m := cm053Manager(t, &legacyCM053Store{})
+	cm053Register(t, m, cm053NewAuth("claude-a.json", "sk-a"))
+	logs.events(t)
+	cm053Refresh(t, context.Background(), m, "claude-a.json", "sk-b")
+	if got := logs.events(t); len(got) != 1 || got[0].result != "unverified" || got[0].category != "store" {
+		t.Fatalf("legacy store events = %s", cm053Summary(got))
+	}
+	m = cm053Manager(t, &legacyCM053Store{err: fmt.Errorf("disk: %w", syscall.ENOSPC)})
+	cm053Register(t, m, cm053NewAuth("claude-a.json", "sk-a"))
+	logs.events(t)
+	cm053Refresh(t, context.Background(), m, "claude-a.json", "sk-b")
+	if got := logs.events(t); len(got) != 1 || got[0].result != "failed" || got[0].stage != "store" || got[0].errno != int(syscall.ENOSPC) {
+		t.Fatalf("legacy store failure events = %+v", got)
+	}
+}
