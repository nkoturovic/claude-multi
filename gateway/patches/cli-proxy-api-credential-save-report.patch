+func TestCM053CredentialSaveSkipIsNotSuccess(t *testing.T) {
+	logs := cm053CaptureLogs(t)
+	store := newCM053Store()
+	m := cm053Manager(t, store)
+	base := cm053Register(t, m, cm053NewAuth("claude-a.json", "sk-a"))
+	logs.events(t)
+
+	configKey := &Auth{ID: "cfg", Provider: "claude", Attributes: map[string]string{"api_key": "sk-cfg", "source": "config:claude-api-key"}, Metadata: map[string]any{"type": "claude"}}
+	if !IsConfigAPIKeyAuth(configKey) {
+		t.Fatal("fixture is not a config API key auth")
+	}
+	runtimeOnly := base.Clone()
+	runtimeOnly.Attributes["runtime_only"] = "true"
+	virtual := base.Clone()
+	virtual.Attributes[AttributePluginVirtual] = pluginVirtualAttrEnabled
+	noMetadata := base.Clone()
+	noMetadata.Metadata = nil
+	stale := base.Clone()
+	stale.Generation = 0 // older than what the next case persists
+
+	current := base.Clone()
+	current.Generation = 5
+	if err := m.persist(context.Background(), current, persistOpRefresh, persistDurable); err != nil {
+		t.Fatal(err)
+	}
+	if got := logs.events(t); len(got) != 1 || got[0].result != "persisted" {
+		t.Fatalf("setup persist events = %s", cm053Summary(got))
+	}
+	store.takeCalls()
+
+	newer := current.Clone()
+	newer.Generation = 6 // not stale: the skip-persist context itself must skip
+
+	cases := []struct {
+		name     string
+		ctx      context.Context
+		auth     *Auth
+		category string
+		manager  *Manager
+	}{
+		{"config api key", context.Background(), configKey, "config_api_key", m},
+		{"runtime only", context.Background(), runtimeOnly, "runtime_only", m},
+		{"plugin virtual", context.Background(), virtual, "plugin_virtual", m},
+		{"no metadata", context.Background(), noMetadata, "no_metadata", m},
+		{"stale generation", context.Background(), stale, "stale_generation", m},
+		{"skip persist", WithSkipPersist(context.Background()), newer, "skip_persist", m},
+		{"no store", context.Background(), base.Clone(), "no_store", cm053Manager(t, nil)},
+	}
+	for _, tc := range cases {
+		for _, durability := range []persistDurability{persistDurable, persistNoSync} {
+			if err := tc.manager.persist(tc.ctx, tc.auth, persistOpRefresh, durability); err != nil {
+				t.Fatalf("%s: persist error %v", tc.name, err)
+			}
+			got := logs.events(t)
+			if len(got) != 1 || got[0].result != "skipped" || got[0].category != tc.category || got[0].operation != "refresh" || got[0].level != log.InfoLevel {
+				t.Fatalf("%s (durable=%t): events = %s, want one refresh/skipped/%s at Info", tc.name, durability, cm053Summary(got), tc.category)
+			}
+			// Skips are refresh-only events: the per-request result persist stays silent.
+			if err := tc.manager.persist(tc.ctx, tc.auth, persistOpResult, durability); err != nil {
+				t.Fatalf("%s: persist error %v", tc.name, err)
+			}
+			if got = logs.events(t); len(got) != 0 {
+				t.Fatalf("%s: a non-refresh skip was logged: %s", tc.name, cm053Summary(got))
+			}
+		}
+	}
+	if calls := store.takeCalls(); len(calls) != 0 {
+		t.Fatalf("skipped persists reached the store: %v", calls)
+	}
+
+	// A watcher-driven refresh installation (skip-persist context) is not a save either.
+	cm053Register(t, m, cm053NewAuth("claude-c.json", "sk-c"))
+	logs.events(t)
+	cm053Refresh(t, WithSkipPersist(context.Background()), m, "claude-c.json", "sk-from-disk")
+	if got := logs.events(t); len(got) != 1 || got[0].result != "skipped" || got[0].category != "skip_persist" {
+		t.Fatalf("skip-persist refresh events = %s", cm053Summary(got))
+	}
+}
