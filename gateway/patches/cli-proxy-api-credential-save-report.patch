+func TestCM053CredentialSaveSupersededDuringDirSync(t *testing.T) {
+	type replace func(t *testing.T, store *FileTokenStore, dir, dest string)
+	cases := []struct {
+		name    string
+		replace replace
+	}{
+		{"same-store unsynced save", func(t *testing.T, store *FileTokenStore, dir, dest string) {
+			newer := cm053Auth(dir, "claude-a.json", "sk-ant-oat01-SYNTHETIC-NEWER", "sk-ant-ort01-SYNTHETIC-NEWER")
+			report, err := store.SaveWithReport(context.Background(), newer, cliproxyauth.SaveOptions{})
+			if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnverified {
+				t.Errorf("replacing save: report=%+v err=%v", report, err)
+			}
+		}},
+		{"outside replacement", func(t *testing.T, store *FileTokenStore, dir, dest string) {
+			other := filepath.Join(dir, "outside.tmp")
+			if err := os.WriteFile(other, []byte(`{"type":"claude","access_token":"sk-outside"}`), 0o600); err != nil {
+				t.Error(err)
+			}
+			if err := os.Rename(other, dest); err != nil {
+				t.Error(err)
+			}
+		}},
+		{"removal", func(t *testing.T, store *FileTokenStore, dir, dest string) {
+			if err := os.Remove(dest); err != nil {
+				t.Error(err)
+			}
+		}},
+		// The synced inode is back at the destination, but a newer same-store write
+		// happened in between (the check that does not rely on inode identity alone).
+		{"same-store save with the inode restored", func(t *testing.T, store *FileTokenStore, dir, dest string) {
+			keep := filepath.Join(dir, "keep.tmp")
+			if err := os.Link(dest, keep); err != nil {
+				t.Error(err)
+			}
+			newer := cm053Auth(dir, "claude-a.json", "sk-ant-oat01-SYNTHETIC-NEWER", "sk-ant-ort01-SYNTHETIC-NEWER")
+			if _, err := store.SaveWithReport(context.Background(), newer, cliproxyauth.SaveOptions{}); err != nil {
+				t.Error(err)
+			}
+			if err := os.Rename(keep, dest); err != nil {
+				t.Error(err)
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			cm053Seed(t, dir, "claude-a.json")
+			store, faults := cm053Store(dir)
+			dest := filepath.Join(dir, "claude-a.json")
+			var synced os.FileInfo
+			armed := true
+			faults.beforeDirSync = func() {
+				if !armed {
+					return
+				}
+				armed = false
+				info, errStat := os.Lstat(dest)
+				if errStat != nil {
+					t.Errorf("stat destination: %v", errStat)
+				}
+				synced = info
+				tc.replace(t, store, dir, dest)
+			}
+			auth := cm053Auth(dir, "claude-a.json", cm053NewAccess, cm053NewRefresh)
+			report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+			if err != nil {
+				t.Fatalf("SaveWithReport: %v", err)
+			}
+			current, errStat := os.Lstat(dest)
+			sameFile := errStat == nil && synced != nil && os.SameFile(synced, current)
+			fileSyncs, dirSyncs := faults.syncCounts()
+			if report.Outcome == cliproxyauth.SaveOutcomePersisted {
+				t.Fatalf("superseded save reported persisted: destination is the synced file=%t, file syncs=%d", sameFile, fileSyncs)
+			}
+			if report.Outcome != cliproxyauth.SaveOutcomeUnverified || report.Category != cliproxyauth.SaveCategorySuperseded ||
+				report.Stage != cliproxyauth.SaveStageNone || report.Errno != 0 || !report.CredentialsChanged {
+				t.Fatalf("report = %+v, want unverified/superseded with credentials_changed", report)
+			}
+			if fileSyncs != 1 || dirSyncs != 1 {
+				t.Fatalf("file syncs=%d dir syncs=%d, want 1 and 1", fileSyncs, dirSyncs)
+			}
+			cm053AssertMetadataOnly(t, report)
+			cm053AssertNoTemp(t, dir)
+
+			// With no replacement the next verified save is a receipt again.
+			auth.Metadata["access_token"] = "sk-ant-oat01-SYNTHETIC-AFTER"
+			report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+			if err != nil || report.Outcome != cliproxyauth.SaveOutcomePersisted {
+				t.Fatalf("follow-up save: report=%+v err=%v, want persisted", report, err)
+			}
+		})
+	}
+}
+
+// An unchanged credential needs no temporary file, write or sync: a verified save of it
+// is unchanged even where a temporary file cannot be created.
+func TestCM053CredentialSaveUnchangedNeedsNoWrite(t *testing.T) {
+	t.Run("unwritable directory", func(t *testing.T) {
+		dir := t.TempDir()
+		prior := cm053Seed(t, dir, "claude-a.json")
+		var meta map[string]any
+		if err := json.Unmarshal(prior, &meta); err != nil {
+			t.Fatal(err)
+		}
+		store, faults := cm053Store(dir)
+		if err := os.Chmod(dir, 0o500); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = os.Chmod(dir, 0o700) })
+		if probe, err := os.OpenFile(filepath.Join(dir, "probe"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600); err == nil {
+			_ = probe.Close()
+			t.Skip("directory permissions are not enforced (running as root?)")
+		}
+		for _, sync := range []bool{false, true} {
+			auth := cm053Auth(dir, "claude-a.json", cm053OldAccess, cm053OldRefresh)
+			auth.Metadata = meta
+			report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: sync})
+			if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnchanged || report.CredentialsChanged || report.Errno != 0 {
+				t.Fatalf("sync=%t: report=%+v err=%v, want unchanged", sync, report, err)
+			}
+		}
+		cm053AssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+		faults.mu.Lock()
+		temps := len(faults.temps)
+		faults.mu.Unlock()
+		if files, dirs := faults.syncCounts(); temps != 0 || files != 0 || dirs != 0 {
+			t.Fatalf("temps=%d file syncs=%d dir syncs=%d, want no file work", temps, files, dirs)
+		}
+	})
+	t.Run("temp creation fails", func(t *testing.T) {
+		dir := t.TempDir()
+		prior := cm053Seed(t, dir, "claude-a.json")
+		store, faults := cm053Store(dir)
+		faults.stage, faults.err = "open", syscall.EACCES
+		auth := cm053Auth(dir, "claude-a.json", cm053OldAccess, cm053OldRefresh)
+		report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+		if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnchanged {
+			t.Fatalf("report=%+v err=%v, want unchanged", report, err)
+		}
+		cm053AssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+		faults.mu.Lock()
+		events := strings.Join(faults.events, ",")
+		faults.mu.Unlock()
+		if events != "" {
+			t.Fatalf("file operations = %s, want none", events)
+		}
+		// A changed credential still reaches the failing open: the check skips only no-ops.
+		auth.Metadata["access_token"] = cm053NewAccess
+		report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+		if err == nil || report.Outcome != cliproxyauth.SaveOutcomeFailed || report.Stage != cliproxyauth.SaveStageOpen || report.Errno != int(syscall.EACCES) {
+			t.Fatalf("changed: report=%+v err=%v, want failed/open/EACCES", report, err)
+		}
+	})
+}
diff --git a/sdk/auth/filestore_cm053_watcher_test.go b/sdk/auth/filestore_cm053_watcher_test.go
new file mode 100644
index 0000000..cc4531f
--- /dev/null
+++ b/sdk/auth/filestore_cm053_watcher_test.go
@@ -0,0 +1,277 @@
+package auth_test
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/watcher"
+	sdkauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/auth"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// These gates run a real fsnotify Watcher on an auth directory while the file store
+// saves a credential, and a real initial scan next to a leftover save temp file. The
+// temp name must never look like a credential to either.
+
+const cm053WatchTimeout = 5 * time.Second
+
+type cm053WatchFixture struct {
+	t        *testing.T
+	authDir  string
+	queue    chan watcher.AuthUpdate
+	w        *watcher.Watcher
+	barriers int
+}
+
+func cm053WriteCredential(t *testing.T, path, access string) {
+	t.Helper()
+	raw, err := json.Marshal(map[string]any{
+		"type":          "claude",
+		"email":         "synthetic-user@example.invalid",
+		"access_token":  access,
+		"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH",
+		"disabled":      false,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func cm053StartWatcher(t *testing.T, authDir string) (*cm053WatchFixture, []watcher.AuthUpdate) {
+	t.Helper()
+	root := filepath.Dir(authDir)
+	cfgPath := filepath.Join(root, "cfg", "config.yaml")
+	if err := os.MkdirAll(filepath.Dir(cfgPath), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(cfgPath, []byte(fmt.Sprintf("auth-dir: %q\nport: 1\n", authDir)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.LoadConfig(cfgPath)
+	if err != nil {
+		t.Fatalf("load config: %v", err)
+	}
+	w, err := watcher.NewWatcher(cfgPath, authDir, func(*config.Config) {})
+	if err != nil {
+		t.Fatalf("NewWatcher: %v", err)
+	}
+	f := &cm053WatchFixture{t: t, authDir: authDir, queue: make(chan watcher.AuthUpdate, 1024), w: w}
+	w.SetConfig(cfg)
+	w.SetAuthUpdateQueue(f.queue)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		_ = w.Stop()
+	})
+	if err = w.Start(ctx); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	return f, f.drainToMarker()
+}
+
+// drainToMarker collects every update dispatched before a DispatchAuthBarrier marker.
+func (f *cm053WatchFixture) drainToMarker() []watcher.AuthUpdate {
+	f.t.Helper()
+	done := f.w.DispatchAuthBarrier()
+	if done == nil {
+		f.t.Fatal("DispatchAuthBarrier returned nil")
+	}
+	var got []watcher.AuthUpdate
+	deadline := time.After(cm053WatchTimeout)
+	for {
+		select {
+		case update := <-f.queue:
+			if update.IsBarrier() {
+				update.ReleaseBarrier()
+				return got
+			}
+			got = append(got, update)
+		case <-deadline:
+			f.t.Fatalf("no dispatch marker within %s", cm053WatchTimeout)
+		}
+	}
+}
+
+// settle writes a sibling barrier credential and returns every update up to and
+// excluding its add. The watcher handles inotify events in order, so every event of
+// the saves before it has been handled and dispatched by then.
+func (f *cm053WatchFixture) settle() []watcher.AuthUpdate {
+	f.t.Helper()
+	f.barriers++
+	id := fmt.Sprintf("cm053-barrier-%d.json", f.barriers)
+	cm053WriteCredential(f.t, filepath.Join(f.authDir, id), fmt.Sprintf("sk-barrier-%d", f.barriers))
+	var got []watcher.AuthUpdate
+	deadline := time.After(cm053WatchTimeout)
+	for {
+		select {
+		case update := <-f.queue:
+			if update.IsBarrier() {
+				update.ReleaseBarrier()
+				continue
+			}
+			if update.ID == id {
+				return append(got, f.drainToMarker()...)
+			}
+			got = append(got, update)
+		case <-deadline:
+			f.t.Fatalf("barrier %s not dispatched within %s", id, cm053WatchTimeout)
+		}
+	}
+}
+
+func cm053DescribeUpdates(updates []watcher.AuthUpdate) string {
+	parts := make([]string, 0, len(updates))
+	for _, u := range updates {
+		parts = append(parts, fmt.Sprintf("%s:%s", u.Action, u.ID))
+	}
+	return strings.Join(parts, " ")
+}
+
+func cm053AssertNoTempFiles(t *testing.T, dir string) {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.Contains(entry.Name(), ".cm-save-") {
+			t.Fatalf("temporary save file left behind: %s", entry.Name())
+		}
+	}
+}
+
+func cm053SaveAuth(authDir, access string) *cliproxyauth.Auth {
+	path := filepath.Join(authDir, "claude-a.json")
+	return &cliproxyauth.Auth{
+		ID:         "claude-a.json",
+		Provider:   "claude",
+		FileName:   "claude-a.json",
+		Attributes: map[string]string{"path": path},
+		Metadata: map[string]any{
+			"type":          "claude",
+			"email":         "synthetic-user@example.invalid",
+			"access_token":  access,
+			"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH",
+		},
+	}
+}
+
+func TestCM053CredentialSaveWatcherSeesOnlyDestination(t *testing.T) {
+	authDir := filepath.Join(t.TempDir(), "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	dest := filepath.Join(authDir, "claude-a.json")
+	cm053WriteCredential(t, dest, "sk-ant-oat01-SYNTHETIC-OLD")
+	f, initial := cm053StartWatcher(t, authDir)
+	if len(initial) != 1 || initial[0].ID != "claude-a.json" || initial[0].Action != watcher.AuthUpdateActionAdd {
+		t.Fatalf("initial updates = %s, want add:claude-a.json", cm053DescribeUpdates(initial))
+	}
+
+	// pausedSettle settles the watcher while a save's temporary file exists (partial
+	// content at a write failure, complete content at a sync, close or rename point):
+	// the watcher must have seen nothing.
+	pausedSettle := func(context string) func() {
+		return func() {
+			tempSeen := false
+			entries, _ := os.ReadDir(authDir)
+			for _, entry := range entries {
+				tempSeen = tempSeen || strings.Contains(entry.Name(), ".cm-save-")
+			}
+			if !tempSeen {
+				t.Errorf("%s: no temporary file exists at the pause point", context)
+			}
+			if got := f.settle(); len(got) != 0 {
+				t.Errorf("%s: watcher updates while the temp file exists: %s", context, cm053DescribeUpdates(got))
+			}
+		}
+	}
+
+	// Every forced pre-rename failure: the watcher sees nothing at all.
+	for i, stage := range []string{"open", "write", "short_write", "sync", "close", "rename"} {
+		pause := pausedSettle(stage)
+		if stage == "open" {
+			pause = nil // nothing is created
+		}
+		store := sdkauth.NewFileTokenStoreWithSaveFaultForTest(stage, syscall.ENOSPC, pause)
+		report, err := store.SaveWithReport(context.Background(), cm053SaveAuth(authDir, fmt.Sprintf("sk-failed-%d", i)), cliproxyauth.SaveOptions{Sync: true})
+		if err == nil || report.Outcome != cliproxyauth.SaveOutcomeFailed {
+			t.Fatalf("%s: report=%+v err=%v, want failed", stage, report, err)
+		}
+		if got := f.settle(); len(got) != 0 {
+			t.Fatalf("%s: failed save produced watcher updates: %s", stage, cm053DescribeUpdates(got))
+		}
+		cm053AssertNoTempFiles(t, authDir)
+	}
+
+	// One persisted save, then one unsynced save: each is exactly one modify of the
+	// destination, carrying the complete new content; never an add or remove.
+	for _, sync := range []bool{true, false} {
+		store := sdkauth.NewFileTokenStoreWithSaveFaultForTest("", nil, pausedSettle(fmt.Sprintf("sync=%t before rename", sync)))
+		access := fmt.Sprintf("sk-ant-oat01-SYNTHETIC-NEW-sync-%t", sync)
+		report, err := store.SaveWithReport(context.Background(), cm053SaveAuth(authDir, access), cliproxyauth.SaveOptions{Sync: sync})
+		wantOutcome := cliproxyauth.SaveOutcomeUnverified
+		if sync {
+			wantOutcome = cliproxyauth.SaveOutcomePersisted
+		}
+		if err != nil || report.Outcome != wantOutcome {
+			t.Fatalf("sync=%t: report=%+v err=%v, want %s", sync, report, err, wantOutcome)
+		}
+		got := f.settle()
+		if len(got) != 1 || got[0].ID != "claude-a.json" || got[0].Action != watcher.AuthUpdateActionModify {
+			t.Fatalf("sync=%t: updates = %s, want exactly modify:claude-a.json", sync, cm053DescribeUpdates(got))
+		}
+		if token, _ := got[0].Auth.Metadata["access_token"].(string); token != access {
+			t.Fatalf("sync=%t: watcher loaded access_token %q, want the complete new content", sync, token)
+		}
+		cm053AssertNoTempFiles(t, authDir)
+	}
+}
+
+func TestCM053StartupScanIgnoresSaveTemp(t *testing.T) {
+	authDir := filepath.Join(t.TempDir(), "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	dest := filepath.Join(authDir, "claude-a.json")
+	cm053WriteCredential(t, dest, "sk-ant-oat01-SYNTHETIC-DEST")
+	// A crash between create and rename leaves a complete credential copy behind.
+	leftover := sdkauth.SaveTempPathForTest(dest, "0123456789abcdef")
+	cm053WriteCredential(t, leftover, "sk-ant-oat01-SYNTHETIC-LEFTOVER")
+
+	_, initial := cm053StartWatcher(t, authDir)
+	if len(initial) != 1 || initial[0].ID != "claude-a.json" {
+		t.Fatalf("initial scan updates = %s, want only add:claude-a.json", cm053DescribeUpdates(initial))
+	}
+	if token, _ := initial[0].Auth.Metadata["access_token"].(string); token != "sk-ant-oat01-SYNTHETIC-DEST" {
+		t.Fatalf("initial scan loaded access_token %q", token)
+	}
+
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(authDir)
+	listed, err := store.List(context.Background())
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if len(listed) != 1 || listed[0].ID != "claude-a.json" {
+		ids := make([]string, 0, len(listed))
+		for _, a := range listed {
+			ids = append(ids, a.ID)
+		}
+		t.Fatalf("store List = %q, want only claude-a.json", ids)
+	}
+	if _, errStat := os.Stat(leftover); errStat != nil {
+		t.Fatalf("the scan must leave the leftover alone: %v", errStat)
+	}
+}
diff --git a/sdk/auth/filestore_save.go b/sdk/auth/filestore_save.go
new file mode 100644
index 0000000..308ea71
--- /dev/null
+++ b/sdk/auth/filestore_save.go
@@ -0,0 +1,431 @@
+package auth
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// A metadata save never rewrites the destination in place. It writes a same-directory
+// temporary file, checks the byte count, closes it and renames it over the destination,
+// so a failed write can never truncate the previous valid credential. With
+// SaveOptions.Sync it also syncs the file before the rename and the directory after it,
+// and reports persisted only when the destination is still the file it synced: no newer
+// write through this store and the same inode.
+//
+// The temporary name is ".<base>.cm-save-<16 hex>". It never ends in ".json" in any
+// letter case, so neither the auth-dir watcher (case-sensitive ".json" events) nor the
+// startup scans (case-insensitive ".json") ever load it as a credential.
+const saveTempMarker = ".cm-save-"
+
+// saveFile is the file surface a save uses; saveFileOps is its fault-injection seam.
+type saveFile interface {
+	Write([]byte) (int, error)
+	Sync() error
+	Close() error
+}
+
+type saveFileOps struct {
+	openTemp   func(name string) (saveFile, error)
+	rename     func(oldPath, newPath string) error
+	remove     func(name string) error
+	syncDir    func(dir string) error
+	tempSuffix func() (string, error)
+}
+
+var defaultSaveFileOps = &saveFileOps{
+	openTemp: func(name string) (saveFile, error) {
+		file, err := os.OpenFile(name, saveTempFlags, 0o600)
+		if err != nil {
+			return nil, err
+		}
+		return file, nil
+	},
+	rename:     os.Rename,
+	remove:     os.Remove,
+	syncDir:    syncDirectory,
+	tempSuffix: randomSaveSuffix,
+}
+
+// publishLocked records a write to path and returns its sequence number. The caller holds s.mu.
+func (s *FileTokenStore) publishLocked(path string) uint64 {
+	if s.published == nil {
+		s.published = make(map[string]uint64)
+	}
+	s.publishSeq++
+	s.published[path] = s.publishSeq
+	return s.publishSeq
+}
+
+// stillPublished reports whether path is still the file a verified save published as
+// seq: no later write through this store, and the destination is the staged inode (an
+// outside replacement or removal fails the second check).
+func (s *FileTokenStore) stillPublished(path string, seq uint64, staged os.FileInfo) bool {
+	if staged == nil {
+		return false
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.published[path] != seq {
+		return false
+	}
+	current, err := os.Lstat(path)
+	return err == nil && os.SameFile(staged, current)
+}
+
+func unchangedSave(size int) cliproxyauth.SaveReport {
+	return cliproxyauth.SaveReport{Outcome: cliproxyauth.SaveOutcomeUnchanged, Stage: cliproxyauth.SaveStageNone, Category: cliproxyauth.SaveCategoryNone, Size: size}
+}
+
+func (s *FileTokenStore) saveOps() *saveFileOps {
+	if s.fileOps != nil {
+		return s.fileOps
+	}
+	return defaultSaveFileOps
+}
+
+func randomSaveSuffix() (string, error) {
+	var buf [8]byte
+	if _, err := rand.Read(buf[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(buf[:]), nil
+}
+
+func saveTempPath(dest, suffix string) string {
+	return filepath.Join(filepath.Dir(dest), "."+filepath.Base(dest)+saveTempMarker+suffix)
+}
+
+// stageSave writes raw to a new temporary file next to dest and closes it. It removes the
+// temporary file on every failure and returns its path on success.
+func stageSave(ops *saveFileOps, dest string, raw []byte, sync bool) (string, cliproxyauth.SaveReport, error) {
+	size := len(raw)
+	suffix, err := ops.tempSuffix()
+	if err != nil {
+		return "", cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageOpen, err, 0, size), fmt.Errorf("auth filestore: temp name failed: %w", err)
+	}
+	tmp := saveTempPath(dest, suffix)
+	file, err := ops.openTemp(tmp)
+	if err != nil {
+		// O_EXCL: nothing was created, and an existing entry is not ours to remove.
+		return "", cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageOpen, err, 0, size), fmt.Errorf("auth filestore: open temp failed: %w", err)
+	}
+	n, err := file.Write(raw)
+	if err == nil && n != size {
+		err = io.ErrShortWrite
+	}
+	stage := cliproxyauth.SaveStageWrite
+	if err == nil && sync {
+		stage = cliproxyauth.SaveStageSync
+		err = file.Sync()
+	}
+	if err != nil {
+		_ = file.Close()
+		_ = ops.remove(tmp)
+		return "", cliproxyauth.FailedSaveReport(stage, err, n, size), fmt.Errorf("auth filestore: %s temp failed: %w", stage, err)
+	}
+	if err = file.Close(); err != nil {
+		_ = ops.remove(tmp)
+		return "", cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageClose, err, n, size), fmt.Errorf("auth filestore: close temp failed: %w", err)
+	}
+	return tmp, cliproxyauth.SaveReport{Bytes: n, Size: size}, nil
+}
+
+// credentialsChangedOnDisk reports whether after carries different credentials than the
+// destination content before (nil when the destination did not exist).
+func credentialsChangedOnDisk(before, after []byte) bool {
+	var beforeMeta, afterMeta map[string]any
+	if len(before) > 0 {
+		if err := json.Unmarshal(before, &beforeMeta); err != nil {
+			beforeMeta = nil
+		}
+	}
+	if err := json.Unmarshal(after, &afterMeta); err != nil {
+		afterMeta = nil
+	}
+	return cliproxyauth.CredentialsChanged(&cliproxyauth.Auth{Metadata: beforeMeta}, &cliproxyauth.Auth{Metadata: afterMeta})
+}
+
+// SaveWithReport persists auth like Save and reports a typed, metadata-only outcome
+// (cliproxyauth.ReportingStore). Only opts.Sync on the metadata branch can report
+// persisted; the delegated TokenStorage branch reports unverified.
+func (s *FileTokenStore) SaveWithReport(ctx context.Context, auth *cliproxyauth.Auth, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	report, _, err := s.save(ctx, auth, opts)
+	return report, err
+}
+
+func (s *FileTokenStore) save(ctx context.Context, auth *cliproxyauth.Auth, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, string, error) {
+	if auth == nil {
+		err := fmt.Errorf("auth filestore: auth is nil")
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageValidate, err, 0, 0), "", err
+	}
+	cliproxyauth.NormalizeCredentialMetadata(auth.Metadata)
+	if errWeight := cliproxyauth.ValidateAuthWeight(auth); errWeight != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageValidate, errWeight, 0, 0), "", fmt.Errorf("auth filestore: %w", errWeight)
+	}
+
+	path, err := s.resolveAuthPath(auth)
+	if err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStagePath, err, 0, 0), "", err
+	}
+	if path == "" {
+		err = fmt.Errorf("auth filestore: missing file path attribute for %s", auth.ID)
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStagePath, err, 0, 0), "", err
+	}
+
+	// Runtime updates must not recreate a disabled credential whose source file
+	// was deliberately removed. Login and migration callers explicitly mark the
+	// save when creating a missing disabled credential is intentional.
+	if auth.Disabled && !cliproxyauth.HasAuthCreationIntent(ctx) {
+		if _, statErr := os.Stat(path); os.IsNotExist(statErr) {
+			return cliproxyauth.SaveReport{Outcome: cliproxyauth.SaveOutcomeSkipped, Stage: cliproxyauth.SaveStageNone, Category: cliproxyauth.SaveCategoryDisabledAbsent}, "", nil
+		}
+	}
+
+	var report cliproxyauth.SaveReport
+	if opts.Sync && auth.Storage == nil && auth.Metadata != nil {
+		report, err = s.saveMetadataVerified(auth, path, opts)
+	} else {
+		report, err = s.saveLocked(auth, path, opts)
+	}
+	if err != nil || report.Outcome == cliproxyauth.SaveOutcomeSkipped {
+		return report, "", err
+	}
+
+	if auth.Attributes == nil {
+		auth.Attributes = make(map[string]string)
+	}
+	auth.Attributes[cliproxyauth.AttributePath] = path
+	auth.Attributes[cliproxyauth.AttributeSource] = path
+	auth.Attributes[cliproxyauth.AttributeSourceBackend] = cliproxyauth.AuthSourceFile
+
+	if strings.TrimSpace(auth.FileName) == "" {
+		auth.FileName = auth.ID
+	}
+	return report, path, nil
+}
+
+func commitDeclined() cliproxyauth.SaveReport {
+	return cliproxyauth.SaveReport{Outcome: cliproxyauth.SaveOutcomeSkipped, Stage: cliproxyauth.SaveStageNone, Category: cliproxyauth.SaveCategoryCommitDeclined}
+}
+
+// saveLocked is the save without a durability barrier: the delegated TokenStorage writer,
+// or a metadata write through temp file and rename, both under s.mu.
+func (s *FileTokenStore) saveLocked(auth *cliproxyauth.Auth, path string, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	if opts.Commit != nil {
+		release, ok := opts.Commit()
+		if !ok {
+			return commitDeclined(), nil
+		}
+		if release != nil {
+			defer release()
+		}
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMkdir, err, 0, 0), fmt.Errorf("auth filestore: create dir failed: %w", err)
+	}
+
+	// metadataSetter is a private interface for TokenStorage implementations that support metadata injection.
+	type metadataSetter interface {
+		SetMetadata(map[string]any)
+	}
+
+	switch {
+	case auth.Storage != nil:
+		// The delegated writer's completion guarantees are unknown: never persisted.
+		before, _ := os.ReadFile(path)
+		if auth.Metadata == nil {
+			auth.Metadata = make(map[string]any)
+		}
+		auth.Metadata["disabled"] = auth.Disabled
+		if setter, ok := auth.Storage.(metadataSetter); ok {
+			setter.SetMetadata(auth.Metadata)
+		}
+		// The delegated writer may have replaced the destination even when it fails.
+		s.publishLocked(path)
+		if err := auth.Storage.SaveTokenToFile(path); err != nil {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageDelegated, err, 0, 0), err
+		}
+		after, _ := os.ReadFile(path)
+		return cliproxyauth.SaveReport{
+			Outcome:            cliproxyauth.SaveOutcomeUnverified,
+			Stage:              cliproxyauth.SaveStageNone,
+			Category:           cliproxyauth.SaveCategoryDelegated,
+			Bytes:              len(after),
+			Size:               len(after),
+			CredentialsChanged: credentialsChangedOnDisk(before, after),
+		}, nil
+	case auth.Metadata != nil:
+		auth.Metadata["disabled"] = auth.Disabled
+		raw, errMarshal := json.Marshal(auth.Metadata)
+		if errMarshal != nil {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMarshal, errMarshal, 0, 0), fmt.Errorf("auth filestore: marshal metadata failed: %w", errMarshal)
+		}
+		existing, errRead := os.ReadFile(path)
+		if errRead == nil && jsonEqual(existing, raw) {
+			return unchangedSave(len(raw)), nil
+		}
+		if errRead != nil && !os.IsNotExist(errRead) {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRead, errRead, 0, len(raw)), fmt.Errorf("auth filestore: read existing failed: %w", errRead)
+		}
+		changed := credentialsChangedOnDisk(existing, raw)
+		ops := s.saveOps()
+		tmp, report, err := stageSave(ops, path, raw, false)
+		if err != nil {
+			report.CredentialsChanged = changed
+			return report, err
+		}
+		if err = ops.rename(tmp, path); err != nil {
+			_ = ops.remove(tmp)
+			report = cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRename, err, report.Bytes, report.Size)
+			report.CredentialsChanged = changed
+			return report, fmt.Errorf("auth filestore: rename failed: %w", err)
+		}
+		s.publishLocked(path)
+		report.Outcome = cliproxyauth.SaveOutcomeUnverified
+		report.Stage = cliproxyauth.SaveStageNone
+		report.Category = cliproxyauth.SaveCategoryNoSync
+		report.CredentialsChanged = changed
+		return report, nil
+	default:
+		err := fmt.Errorf("auth filestore: nothing to persist for %s", auth.ID)
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageStore, err, 0, 0), err
+	}
+}
+
+// compareDestination reads the destination under opts.Commit and s.mu and reports whether
+// it already holds raw (unchanged, done) or cannot be read (failed, done).
+func (s *FileTokenStore) compareDestination(path string, raw []byte, commit func() (func(), bool)) (cliproxyauth.SaveReport, bool, error) {
+	if commit != nil {
+		release, ok := commit()
+		if !ok {
+			return commitDeclined(), true, nil
+		}
+		if release != nil {
+			defer release()
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	existing, errRead := os.ReadFile(path)
+	if errRead == nil && jsonEqual(existing, raw) {
+		return unchangedSave(len(raw)), true, nil
+	}
+	if errRead != nil && !os.IsNotExist(errRead) {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRead, errRead, 0, len(raw)), true, fmt.Errorf("auth filestore: read existing failed: %w", errRead)
+	}
+	return cliproxyauth.SaveReport{}, false, nil
+}
+
+// saveMetadataVerified is the metadata save with the durability barrier. An unchanged
+// destination is detected first, under opts.Commit and s.mu, and costs no write or sync.
+// Otherwise the payload is staged and synced with neither held; the destination compare
+// and the rename run under them; the directory sync runs after both are released, and
+// the result is persisted only if the destination is still the synced file.
+func (s *FileTokenStore) saveMetadataVerified(auth *cliproxyauth.Auth, path string, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	auth.Metadata["disabled"] = auth.Disabled
+	raw, errMarshal := json.Marshal(auth.Metadata)
+	if errMarshal != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMarshal, errMarshal, 0, 0), fmt.Errorf("auth filestore: marshal metadata failed: %w", errMarshal)
+	}
+	if report, done, err := s.compareDestination(path, raw, opts.Commit); done {
+		return report, err
+	}
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMkdir, err, 0, len(raw)), fmt.Errorf("auth filestore: create dir failed: %w", err)
+	}
+	ops := s.saveOps()
+	tmp, staged, err := stageSave(ops, path, raw, true)
+	if err != nil {
+		// Unlocked, informational read: did the lost write carry new credentials?
+		existing, _ := os.ReadFile(path)
+		staged.CredentialsChanged = credentialsChangedOnDisk(existing, raw)
+		return staged, err
+	}
+	renamed := false
+	defer func() {
+		if !renamed {
+			_ = ops.remove(tmp)
+		}
+	}()
+
+	var release func()
+	if opts.Commit != nil {
+		var ok bool
+		if release, ok = opts.Commit(); !ok {
+			return commitDeclined(), nil
+		}
+	}
+	var seq uint64
+	var stagedInfo os.FileInfo
+	report, err := func() (cliproxyauth.SaveReport, error) {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		// The destination may have changed since the first compare.
+		existing, errRead := os.ReadFile(path)
+		if errRead == nil && jsonEqual(existing, raw) {
+			return unchangedSave(len(raw)), nil
+		}
+		if errRead != nil && !os.IsNotExist(errRead) {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRead, errRead, 0, len(raw)), fmt.Errorf("auth filestore: read existing failed: %w", errRead)
+		}
+		changed := credentialsChangedOnDisk(existing, raw)
+		// The synced inode; nil (never persisted) if it cannot be identified.
+		if info, errStat := os.Lstat(tmp); errStat == nil {
+			stagedInfo = info
+		}
+		if errRename := ops.rename(tmp, path); errRename != nil {
+			report := cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRename, errRename, staged.Bytes, staged.Size)
+			report.CredentialsChanged = changed
+			return report, fmt.Errorf("auth filestore: rename failed: %w", errRename)
+		}
+		renamed = true
+		seq = s.publishLocked(path)
+		return cliproxyauth.SaveReport{Bytes: staged.Bytes, Size: staged.Size, CredentialsChanged: changed}, nil
+	}()
+	if release != nil {
+		release()
+	}
+	if err != nil || report.Outcome == cliproxyauth.SaveOutcomeUnchanged {
+		return report, err
+	}
+
+	// The replacement is committed from here on: a failure is not "nothing changed".
+	if errSync := ops.syncDir(dir); errSync != nil {
+		if errors.Is(errSync, errDirSyncUnsupported) {
+			report.Outcome = cliproxyauth.SaveOutcomeUnverified
+			report.Stage = cliproxyauth.SaveStageNone
+			report.Category = cliproxyauth.SaveCategoryDirSyncUnsupported
+			return report, nil
+		}
+		failed := cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageDirSync, errSync, report.Bytes, report.Size)
+		failed.CredentialsChanged = report.CredentialsChanged
+		return failed, fmt.Errorf("auth filestore: directory sync failed after rename: %w", errSync)
+	}
+	report.Stage = cliproxyauth.SaveStageNone
+	// Neither lock was held over the directory sync, so another write may have replaced
+	// the destination meanwhile; the directory sync then made that file's (unsynced)
+	// entry durable, not ours.
+	if !s.stillPublished(path, seq, stagedInfo) {
+		report.Outcome = cliproxyauth.SaveOutcomeUnverified
+		report.Category = cliproxyauth.SaveCategorySuperseded
+		return report, nil
+	}
+	report.Outcome = cliproxyauth.SaveOutcomePersisted
+	report.Category = cliproxyauth.SaveCategoryNone
+	return report, nil
+}
