+				report.Category != cliproxyauth.SaveCategoryShortWrite || report.Errno != 0 {
+				t.Fatalf("report = %+v, want failed/write/short_write", report)
+			}
+			if report.Bytes != len(payload)/2 || report.Size != len(payload) {
+				t.Fatalf("bytes=%d size=%d, want %d of %d", report.Bytes, report.Size, len(payload)/2, len(payload))
+			}
+			if !report.CredentialsChanged {
