diff --git a/sdk/cliproxy/auth/credential_save.go b/sdk/cliproxy/auth/credential_save.go
new file mode 100644
index 0000000..8462ef9
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_save.go
@@ -0,0 +1,218 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"io"
+	"regexp"
+	"strings"
+	"syscall"
+
+	log "github.com/sirupsen/logrus"
+)
+
+// SaveOutcome classifies one credential save attempt. Only SaveOutcomePersisted from a
+// store that verified the write (byte count, file sync, close, rename, directory sync)
+// is evidence that the credential reached stable storage.
+type SaveOutcome string
+
+const (
+	// SaveOutcomePersisted: every step of the verified save completed.
+	SaveOutcomePersisted SaveOutcome = "persisted"
+	// SaveOutcomeFailed: a step failed; SaveReport.Stage names it.
+	SaveOutcomeFailed SaveOutcome = "failed"
+	// SaveOutcomeUnchanged: the destination already held equal content; nothing was written.
+	SaveOutcomeUnchanged SaveOutcome = "unchanged"
+	// SaveOutcomeSkipped: persistence did not run (runtime-only auth, stale generation, ...).
+	SaveOutcomeSkipped SaveOutcome = "skipped"
+	// SaveOutcomeUnverified: the write completed without a durability barrier, or through
+	// a writer whose completion guarantees are unknown.
+	SaveOutcomeUnverified SaveOutcome = "unverified"
+)
+
+// SaveStage names the step at which a save failed. It is SaveStageNone for any other outcome.
+type SaveStage string
+
+const (
+	SaveStageNone      SaveStage = "none"
+	SaveStageValidate  SaveStage = "validate"
+	SaveStagePath      SaveStage = "path"
+	SaveStageMkdir     SaveStage = "mkdir"
+	SaveStageRead      SaveStage = "read"
+	SaveStageMarshal   SaveStage = "marshal"
+	SaveStageOpen      SaveStage = "open"
+	SaveStageWrite     SaveStage = "write"
+	SaveStageSync      SaveStage = "sync"
+	SaveStageClose     SaveStage = "close"
+	SaveStageRename    SaveStage = "rename"
+	SaveStageDirSync   SaveStage = "dirsync" // the replacement is already committed
+	SaveStageDelegated SaveStage = "delegated"
+	SaveStageStore     SaveStage = "store"
+)
+
+// SaveCategory qualifies an outcome with a fixed, non-secret reason.
+type SaveCategory string
+
+const (
+	SaveCategoryNone SaveCategory = "none"
+	// Failure categories.
+	SaveCategoryErrno      SaveCategory = "errno" // SaveReport.Errno carries the number
+	SaveCategoryShortWrite SaveCategory = "short_write"
+	SaveCategoryError      SaveCategory = "error" // a failure without an errno
+	// Skip reasons.
+	SaveCategoryNoStore         SaveCategory = "no_store"
+	SaveCategoryConfigAPIKey    SaveCategory = "config_api_key"
+	SaveCategoryRuntimeOnly     SaveCategory = "runtime_only"
+	SaveCategoryPluginVirtual   SaveCategory = "plugin_virtual"
+	SaveCategoryNoMetadata      SaveCategory = "no_metadata"
+	SaveCategoryStaleGeneration SaveCategory = "stale_generation"
+	SaveCategorySkipPersist     SaveCategory = "skip_persist"
+	SaveCategoryDisabledAbsent  SaveCategory = "disabled_absent"
+	// SaveCategoryCommitDeclined: the SaveOptions.Commit callback abandoned the save.
+	SaveCategoryCommitDeclined SaveCategory = "commit_declined"
+	// Reasons a completed write is unverified.
+	SaveCategoryNoSync             SaveCategory = "no_sync"
+	SaveCategoryDelegated          SaveCategory = "delegated"
+	SaveCategoryStoreUnreported    SaveCategory = "store"
+	SaveCategoryDirSyncUnsupported SaveCategory = "dirsync_unsupported"
+	// SaveCategorySuperseded: the write completed, but a newer write replaced the
+	// destination (or a newer save of the same auth completed) before this save's
+	// durability was established, so it is never a receipt for the current credential.
+	SaveCategorySuperseded SaveCategory = "superseded"
+)
+
+// SaveReport is the metadata-only result of one save. It never carries a path, an auth
+// ID, credential material or error text.
+type SaveReport struct {
+	Outcome  SaveOutcome
+	Stage    SaveStage
+	Category SaveCategory
+	// Errno is the numeric system error of a failed step, or 0.
+	Errno int
+	// Bytes is the number of payload bytes written; Size the payload length attempted.
+	Bytes int
+	Size  int
+	// CredentialsChanged reports whether the attempted content carries different
+	// credentials (tokens or API key) than the destination held before the attempt.
+	CredentialsChanged bool
+}
+
+// SaveOptions controls ReportingStore.SaveWithReport.
+type SaveOptions struct {
+	// Sync requests the verified durability barrier (file sync before the rename and a
+	// directory sync after it). Without it a completed metadata write is unverified.
+	Sync bool
+	// Commit, when set, brackets each step at which the store reads or publishes the
+	// destination. With Sync it is called up to twice: before staging, for the unchanged
+	// check, and after the payload has been staged, for the compare and publish. Each call
+	// returns release (called once that step is done, before any file or directory sync)
+	// and ok=false to abandon the save. The Manager uses it to keep its per-auth ordering
+	// lock off the file and directory syncs.
+	Commit func() (release func(), ok bool)
+}
+
+// ReportingStore is optionally implemented by a Store whose saves report a typed outcome.
+// Stores that do not implement it keep their Store.Save contract; the Manager then reports
+// a nil error as unverified.
+type ReportingStore interface {
+	SaveWithReport(ctx context.Context, auth *Auth, opts SaveOptions) (SaveReport, error)
+}
+
+// FailedSaveReport builds a failure report for stage from err: io.ErrShortWrite becomes
+// short_write, a system errno is kept as a number, anything else is category error.
+func FailedSaveReport(stage SaveStage, err error, bytes, size int) SaveReport {
+	report := SaveReport{Outcome: SaveOutcomeFailed, Stage: stage, Category: SaveCategoryError, Bytes: bytes, Size: size}
+	var errno syscall.Errno
+	if errors.Is(err, io.ErrShortWrite) {
+		report.Category = SaveCategoryShortWrite
+	} else if errors.As(err, &errno) && errno != 0 {
+		report.Category = SaveCategoryErrno
+		report.Errno = int(errno)
+	}
+	return report
+}
+
+type persistOperation string
+
+const (
+	persistOpRefresh   persistOperation = "refresh"
+	persistOpPrepare   persistOperation = "prepare"
+	persistOpUpdate    persistOperation = "update"
+	persistOpResult    persistOperation = "result"
+	persistOpReconcile persistOperation = "reconcile"
+	persistOpRegister  persistOperation = "register"
+	persistOpReset     persistOperation = "reset"
+)
+
+// persistDurability says whether a persist call runs the verified durability barrier.
+// Only the refresh/prepare/update persist in updateInternal, which runs outside m.mu,
+// uses persistDurable. Callers holding m.mu must use persistNoSync: a stalled sync
+// would block every selection. Register keeps the upstream write cost (persistNoSync).
+type persistDurability bool
+
+const (
+	persistNoSync  persistDurability = false
+	persistDurable persistDurability = true
+)
+
+// credentialSaveEventFormat is the one metadata-only save event. Every value is a fixed
+// enum, a validated identifier or a number; never an auth ID, path, email, token or error text.
+const credentialSaveEventFormat = "credential_save_v1 operation=%s result=%s provider=%s auth_index=%s credentials_changed=%t stage=%s errno=%d category=%s bytes=%d size=%d generation=%d epoch=%d"
+
+var (
+	credentialSaveProviderPattern = regexp.MustCompile(`^[a-z0-9][a-z0-9._-]{0,63}$`)
+	credentialSaveIndexPattern    = regexp.MustCompile(`^[0-9a-f]{16}$`)
+)
+
+func credentialSaveProvider(provider string) string {
+	provider = strings.ToLower(strings.TrimSpace(provider))
+	if !credentialSaveProviderPattern.MatchString(provider) {
+		return "invalid"
+	}
+	return provider
+}
+
+// credentialSaveIndex logs only a generated index shape; EnsureIndex keeps any preexisting
+// index text, which must not reach the log unchecked.
+func credentialSaveIndex(index string) string {
+	if !credentialSaveIndexPattern.MatchString(index) {
+		return "invalid"
+	}
+	return index
+}
+
+// shouldEmitCredentialSave applies the event volume rule: persisted, failed and unverified
+// for every operation; unchanged and skipped only for refresh (a result persist runs on
+// every request and is normally unchanged).
+func shouldEmitCredentialSave(op persistOperation, outcome SaveOutcome) bool {
+	switch outcome {
+	case SaveOutcomePersisted, SaveOutcomeFailed, SaveOutcomeUnverified:
+		return true
+	default:
+		return op == persistOpRefresh
+	}
+}
+
+func emitCredentialSave(op persistOperation, auth *Auth, report SaveReport) {
+	if auth == nil || !shouldEmitCredentialSave(op, report.Outcome) {
+		return
+	}
+	stage := report.Stage
+	if stage == "" {
+		stage = SaveStageNone
+	}
+	category := report.Category
+	if category == "" {
+		category = SaveCategoryNone
+	}
+	args := []any{
+		op, report.Outcome, credentialSaveProvider(auth.Provider), credentialSaveIndex(auth.Index),
+		report.CredentialsChanged, stage, report.Errno, category, report.Bytes, report.Size,
+		auth.Generation, auth.RegistrationEpoch,
+	}
+	if report.Outcome == SaveOutcomeFailed {
+		log.Warnf(credentialSaveEventFormat, args...)
+		return
+	}
+	log.Infof(credentialSaveEventFormat, args...)
+}
diff --git a/sdk/cliproxy/auth/credential_save_cm053_test.go b/sdk/cliproxy/auth/credential_save_cm053_test.go
new file mode 100644
index 0000000..f8ddaa0
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_save_cm053_test.go
@@ -0,0 +1,853 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	log "github.com/sirupsen/logrus"
+)
+
+// cm053Store is an in-memory ReportingStore. It follows the FileTokenStore contract:
+// with Sync it "stages" first, then calls opts.Commit, publishes, releases and "syncs".
+type cm053Store struct {
+	mu        sync.Mutex
+	saved     map[string]*Auth
+	commits   map[string][]uint64 // committed generations per auth, in publish order
+	calls     []bool              // opts.Sync of every SaveWithReport call
+	syncs     int
+	legacy    int
+	failErr   error
+	failStage SaveStage
+	unchanged bool
+	// failStaged fails a Sync save after the staged hook, before opts.Commit.
+	failStaged error
+	// staged runs after staging, before opts.Commit; synced after the release, before
+	// the directory sync would complete.
+	staged func()
+	synced func()
+}
+
+func newCM053Store() *cm053Store {
+	return &cm053Store{saved: make(map[string]*Auth), commits: make(map[string][]uint64)}
+}
+
+func (s *cm053Store) List(context.Context) ([]*Auth, error) { return nil, nil }
+func (s *cm053Store) Delete(context.Context, string) error  { return nil }
+func (s *cm053Store) Save(context.Context, *Auth) (string, error) {
+	s.mu.Lock()
+	s.legacy++
+	s.mu.Unlock()
+	return "", nil
+}
+
+func (s *cm053Store) SaveWithReport(_ context.Context, auth *Auth, opts SaveOptions) (SaveReport, error) {
+	s.mu.Lock()
+	s.calls = append(s.calls, opts.Sync)
+	failErr, failStage, unchanged, staged, synced, failStaged := s.failErr, s.failStage, s.unchanged, s.staged, s.synced, s.failStaged
+	previous := s.saved[auth.ID]
+	s.mu.Unlock()
+	changed := previous == nil || CredentialsChanged(previous, auth)
+	if failErr != nil {
+		report := FailedSaveReport(failStage, failErr, 0, 64)
+		report.CredentialsChanged = changed
+		return report, fmt.Errorf("cm053 store %s %s: %w", auth.ID, authAccessToken(auth), failErr)
+	}
+	if unchanged {
+		return SaveReport{Outcome: SaveOutcomeUnchanged, Stage: SaveStageNone, Category: SaveCategoryNone, Size: 64}, nil
+	}
+	if opts.Sync && staged != nil {
+		staged()
+	}
+	if opts.Sync && failStaged != nil {
+		report := FailedSaveReport(SaveStageSync, failStaged, 64, 64)
+		report.CredentialsChanged = changed
+		return report, failStaged
+	}
+	var release func()
+	if opts.Commit != nil {
+		var ok bool
+		if release, ok = opts.Commit(); !ok {
+			return SaveReport{Outcome: SaveOutcomeSkipped, Stage: SaveStageNone, Category: SaveCategoryCommitDeclined}, nil
+		}
+	}
+	s.mu.Lock()
+	s.saved[auth.ID] = auth.Clone()
+	s.commits[auth.ID] = append(s.commits[auth.ID], auth.Generation)
+	s.mu.Unlock()
+	if release != nil {
+		release()
+	}
+	if !opts.Sync {
+		return SaveReport{Outcome: SaveOutcomeUnverified, Stage: SaveStageNone, Category: SaveCategoryNoSync, Bytes: 64, Size: 64, CredentialsChanged: changed}, nil
+	}
+	if synced != nil {
+		synced()
+	}
+	s.mu.Lock()
+	s.syncs++
+	s.mu.Unlock()
+	return SaveReport{Outcome: SaveOutcomePersisted, Stage: SaveStageNone, Category: SaveCategoryNone, Bytes: 64, Size: 64, CredentialsChanged: changed}, nil
+}
+
+func (s *cm053Store) set(fn func(*cm053Store)) {
+	s.mu.Lock()
+	fn(s)
+	s.mu.Unlock()
+}
+
+// takeCalls returns and clears the recorded opts.Sync values.
+func (s *cm053Store) takeCalls() []bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	calls := s.calls
+	s.calls = nil
+	return calls
+}
+
+// cm053Event is one parsed credential_save_v1 line.
+type cm053Event struct {
+	level                              log.Level
+	operation, result, provider, index string
+	changed                            bool
+	stage, category                    string
+	errno, bytes, size                 int
+	generation, epoch                  int64
+}
+
+var cm053EventPattern = regexp.MustCompile(`^credential_save_v1 operation=([a-z]+) result=([a-z]+) provider=([a-z0-9._-]+) auth_index=([0-9a-f]{16}|invalid) credentials_changed=(true|false) stage=([a-z]+) errno=([0-9]+) category=([a-z_]+) bytes=([0-9]+) size=([0-9]+) generation=([0-9]+) epoch=([0-9]+)$`)
+
+type cm053LogCapture struct {
+	mu      sync.Mutex
+	entries []*log.Entry
+}
+
+func (c *cm053LogCapture) Levels() []log.Level { return log.AllLevels }
+
+func (c *cm053LogCapture) Fire(entry *log.Entry) error {
+	c.mu.Lock()
+	c.entries = append(c.entries, entry)
+	c.mu.Unlock()
+	return nil
+}
+
+func cm053CaptureLogs(t *testing.T) *cm053LogCapture {
+	t.Helper()
+	capture := &cm053LogCapture{}
+	logger := log.StandardLogger()
+	savedHooks := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		savedHooks[level] = append([]log.Hook(nil), hooks...)
+	}
+	savedLevel := logger.GetLevel()
+	logger.SetLevel(log.TraceLevel)
+	logger.AddHook(capture)
+	t.Cleanup(func() {
+		logger.ReplaceHooks(savedHooks)
+		logger.SetLevel(savedLevel)
+	})
+	return capture
+}
+
+// events parses every credential_save_v1 line captured since the last call.
+func (c *cm053LogCapture) events(t *testing.T) []cm053Event {
+	t.Helper()
+	c.mu.Lock()
+	entries := c.entries
+	c.entries = nil
+	c.mu.Unlock()
+	var events []cm053Event
+	for _, entry := range entries {
+		if !strings.Contains(entry.Message, "credential_save") {
+			continue
+		}
+		m := cm053EventPattern.FindStringSubmatch(entry.Message)
+		if m == nil {
+			t.Fatalf("credential_save line off the fixed format: %q", entry.Message)
+		}
+		if len(entry.Data) != 0 {
+			t.Fatalf("credential_save line carries logger fields: %v", entry.Data)
+		}
+		atoi := func(s string) int { n, _ := strconv.Atoi(s); return n }
+		atoi64 := func(s string) int64 { n, _ := strconv.ParseInt(s, 10, 64); return n }
+		events = append(events, cm053Event{
+			level: entry.Level, operation: m[1], result: m[2], provider: m[3], index: m[4],
+			changed: m[5] == "true", stage: m[6], errno: atoi(m[7]), category: m[8],
+			bytes: atoi(m[9]), size: atoi(m[10]), generation: atoi64(m[11]), epoch: atoi64(m[12]),
+		})
+	}
+	return events
+}
+
+func (c *cm053LogCapture) all() []*log.Entry {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]*log.Entry(nil), c.entries...)
+}
+
+func cm053Summary(events []cm053Event) string {
+	parts := make([]string, 0, len(events))
+	for _, e := range events {
+		parts = append(parts, fmt.Sprintf("%s/%s/%s", e.operation, e.result, e.category))
+	}
+	return strings.Join(parts, " ")
+}
+
+func cm053NewAuth(id, access string) *Auth {
+	return &Auth{
+		ID:         id,
+		Provider:   "claude",
+		Status:     StatusActive,
+		FileName:   id,
+		Attributes: map[string]string{"path": "/cm053/auth/" + id},
+		Metadata: map[string]any{
+			"type":          "claude",
+			"email":         "synthetic-user@example.invalid",
+			"access_token":  access,
+			"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH-" + access,
+		},
+	}
+}
+
+// cm053Manager starts no auto-refresh loop, so no cleanup takes m.mu: a regression that
+// strands a goroutine holding it fails the test instead of hanging it.
+func cm053Manager(t *testing.T, store Store) *Manager {
+	t.Helper()
+	return NewManager(store, nil, nil)
+}
+
+func cm053Register(t *testing.T, m *Manager, auth *Auth) *Auth {
+	t.Helper()
+	registered, err := m.Register(WithSkipPersist(context.Background()), auth)
+	if err != nil || registered == nil {
+		t.Fatalf("register: %v", err)
+	}
+	return registered
+}
+
+// cm053RefreshErr runs the production refresh installation, UpdateRefreshedAuth. It is
+// safe to call from any goroutine.
+func cm053RefreshErr(ctx context.Context, m *Manager, id, access string) (*Auth, error) {
+	base, ok := m.GetByID(id)
+	if !ok {
+		return nil, fmt.Errorf("auth %s missing", id)
+	}
+	updated := base.Clone()
+	updated.Metadata["access_token"] = access
+	updated.Metadata["refresh_token"] = "sk-ant-ort01-SYNTHETIC-REFRESH-" + access
+	saved, err := m.UpdateRefreshedAuth(ctx, base, updated)
+	if err == nil && saved == nil {
+		err = fmt.Errorf("UpdateRefreshedAuth returned no auth")
+	}
+	return saved, err
+}
+
+func cm053Refresh(t *testing.T, ctx context.Context, m *Manager, id, access string) *Auth {
+	t.Helper()
+	saved, err := cm053RefreshErr(ctx, m, id, access)
+	if err != nil {
+		t.Fatalf("UpdateRefreshedAuth: %v", err)
+	}
+	return saved
+}
