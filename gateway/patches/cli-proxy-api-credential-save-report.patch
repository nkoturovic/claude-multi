+func cm053Metadata(access, refresh string) map[string]any {
+	return map[string]any{
+		"type":          "claude",
+		"email":         cm053Email,
+		"access_token":  access,
+		"refresh_token": refresh,
+		"expired":       "2026-09-28T12:00:00Z",
+	}
+}
+
+func cm053Auth(dir, name, access, refresh string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{
+		ID:         name,
+		Provider:   "claude",
+		FileName:   name,
+		Attributes: map[string]string{"path": filepath.Join(dir, name)},
+		Metadata:   cm053Metadata(access, refresh),
+	}
+}
+
+// cm053Seed writes the previous valid credential and returns its bytes.
+func cm053Seed(t *testing.T, dir, name string) []byte {
+	t.Helper()
+	meta := cm053Metadata(cm053OldAccess, cm053OldRefresh)
+	meta["disabled"] = false
+	raw, err := json.Marshal(meta)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(dir, name), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return raw
+}
+
+func cm053Store(dir string) (*FileTokenStore, *cm053Faults) {
+	faults := &cm053Faults{}
+	store := NewFileTokenStore()
+	store.SetBaseDir(dir)
+	store.fileOps = faults.ops()
+	return store, faults
+}
