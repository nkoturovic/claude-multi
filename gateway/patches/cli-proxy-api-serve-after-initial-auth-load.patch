diff --git a/sdk/cliproxy/startup_gate.go b/sdk/cliproxy/startup_gate.go
new file mode 100644
index 0000000..7898832
--- /dev/null
+++ b/sdk/cliproxy/startup_gate.go
@@ -0,0 +1,165 @@
+package cliproxy
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	log "github.com/sirupsen/logrus"
+)
+
+// The start-up gate holds model-serving requests that arrive after the HTTP listener
+// started but before the watcher's initial auth load is registered, so a request that
+// races a restart never gets model_not_found for a file-auth model that is merely not
+// registered yet. Run's start-up order is unchanged; only requests wait.
+
+// initialAuthReadyTimeout bounds the gate: it opens at the latest this long after Run
+// began, so a broken or slow auth can never keep the gateway from serving.
+const initialAuthReadyTimeout = 30 * time.Second
+
+// initialAuthReadyWait is the bound Run applies; tests shorten it.
+var initialAuthReadyWait = initialAuthReadyTimeout
+
+// Test seams.
+var (
+	startupGateWaitHook    func(event string) // "wait", then "opened" or "cancelled"
+	startupGateBarrierHook func()             // the initial auth barrier was queued
+	startupGateOpenHook    func(reason string)
+)
+
+// Reasons the gate opened.
+const (
+	startupGateBarrier       = "barrier"
+	startupGateDeadline      = "deadline"
+	startupGateCancelled     = "cancelled"
+	startupGateNotApplicable = "not-applicable"
+)
+
+// startupGatedPrefixes are the model-serving route groups (internal/api/server_routes.go).
+var startupGatedPrefixes = []string{"/v1", "/v1beta", "/openai/v1", "/backend-api/codex"}
+
+type startupGate struct {
+	opened        chan struct{}
+	once          sync.Once
+	barrierQueued atomic.Bool
+	storedAuths   atomic.Int64 // recorded by Run after the auth store loaded
+
+	mu       sync.Mutex
+	deadline *time.Timer
+	stopCtx  func() bool
+}
+
+// armStartupGate creates the gate for this Run. It opens on the first of: the initial
+// auth barrier released, the deadline, ctx cancelled, or open(notApplicable).
+func (s *Service) armStartupGate(ctx context.Context) *startupGate {
+	gate := &startupGate{opened: make(chan struct{})}
+	s.startupGate.Store(gate)
+	gate.mu.Lock()
+	gate.deadline = time.AfterFunc(initialAuthReadyWait, func() { gate.open(startupGateDeadline) })
+	gate.stopCtx = context.AfterFunc(ctx, func() { gate.open(startupGateCancelled) })
+	gate.mu.Unlock()
+	return gate
+}
+
+// open closes the gate once; later calls return at once. The close-once step only
+// closes the channel (and runs the test seam, nil in production); the first opener
+// then stops the other triggers and, on the deadline, logs the warning from values
+// recorded earlier. Nothing here takes a lock another component can hold.
+func (g *startupGate) open(reason string) {
+	first := false
+	g.once.Do(func() {
+		close(g.opened)
+		first = true
+		if startupGateOpenHook != nil {
+			startupGateOpenHook(reason)
+		}
+	})
+	if !first {
+		return
+	}
+	g.mu.Lock() // held only while armStartupGate installs the triggers
+	if g.deadline != nil {
+		g.deadline.Stop()
+	}
+	if g.stopCtx != nil {
+		g.stopCtx()
+	}
+	g.mu.Unlock()
+	if reason == startupGateDeadline {
+		log.Warnf("initial auth registration not confirmed within %s of start (initial auth barrier queued: %t, %d stored auths loaded at start); serving model requests anyway", initialAuthReadyWait, g.barrierQueued.Load(), g.storedAuths.Load())
+	}
+}
+
+// awaitBarrier opens the gate when done closes. A nil done (no barrier support or no
+// queue) opens it at once. The waiter also exits when the gate opens otherwise, and
+// the deadline and Run's ctx always open it, so it never outlives the start-up bound.
+func (g *startupGate) awaitBarrier(done <-chan struct{}) {
+	if done == nil {
+		g.open(startupGateNotApplicable)
+		return
+	}
+	g.barrierQueued.Store(true)
+	if startupGateBarrierHook != nil {
+		startupGateBarrierHook()
+	}
+	go func() {
+		select {
+		case <-done:
+			g.open(startupGateBarrier)
+		case <-g.opened:
+		}
+	}()
+}
+
+// startupGated reports whether a request waits for the gate: model-serving routes
+// only, never health, management, static assets, preflight or the provider websocket.
+func startupGated(method, path, skipPath string) bool {
+	if method == "OPTIONS" || (skipPath != "" && path == skipPath) {
+		return false
+	}
+	for _, prefix := range startupGatedPrefixes {
+		if path == prefix || strings.HasPrefix(path, prefix+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+// middleware holds gated requests until the gate opens or the request is cancelled.
+// It never answers a request itself; once open it costs one channel receive.
+func (g *startupGate) middleware(skipPath string) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		select {
+		case <-g.opened:
+			return
+		default:
+		}
+		if !startupGated(c.Request.Method, c.Request.URL.Path, skipPath) {
+			return
+		}
+		if startupGateWaitHook != nil {
+			startupGateWaitHook("wait")
+		}
+		select {
+		case <-g.opened:
+			if startupGateWaitHook != nil {
+				startupGateWaitHook("opened")
+			}
+		case <-c.Request.Context().Done():
+			if startupGateWaitHook != nil {
+				startupGateWaitHook("cancelled")
+			}
+			c.Abort()
+		}
+	}
+}
+
+func (s *Service) websocketGatewayPath() string {
+	if s == nil || s.wsGateway == nil {
+		return ""
+	}
+	return s.wsGateway.Path()
+}
