+// TestRunGateHoldsOnlyModelRoutes: while the gate is closed, /healthz and management
+// routes answer at once, a model request waits, and a model request cancelled while
+// waiting returns without reaching its handler.
+func TestRunGateHoldsOnlyModelRoutes(t *testing.T) {
+	authDir := t.TempDir()
+	writeGateTestAuthFile(t, authDir)
+	setGateTestVar(t, &initialAuthReadyWait, time.Minute)
+	ev := installGateTestEvents(t)
+
+	h := newGateTestService(t, authDir, gateTestOptions{})
+	h.service.authUpdateMu.Lock() // keep the barrier (and so the gate) closed
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(h.service.authUpdateMu.Unlock) }
+	h.run(t)
+	t.Cleanup(unblock)
+	waitClosed(t, ev.barrierQueued, "the initial barrier")
+
+	health := mustFirstResponse(t, func() *http.Request {
+		req, _ := http.NewRequest(http.MethodGet, h.url("/healthz"), nil)
+		return req
+	})
+	if health.status != http.StatusOK {
+		t.Fatalf("GET /healthz with the gate closed = %d %s", health.status, health.body)
+	}
+	client := gateTestHTTPClient()
+	mgmtReq, _ := http.NewRequest(http.MethodGet, h.url("/v0/management/config"), nil)
+	mgmtStart := time.Now()
+	mgmtResp, errMgmt := client.Do(mgmtReq)
+	if errMgmt != nil {
+		t.Fatalf("management request with the gate closed: %v", errMgmt)
+	}
+	_ = mgmtResp.Body.Close()
+	if elapsed := time.Since(mgmtStart); elapsed > 5*time.Second {
+		t.Fatalf("management request waited %s at the gate", elapsed)
+	}
+	select {
+	case <-ev.opened:
+		t.Fatal("gate opened while the initial batch was stalled")
+	default:
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	requestDone := make(chan error, 1)
+	go func() {
+		resp, errDo := client.Do(h.request(ctx, http.MethodGet, "/v1/models", nil))
+		if resp != nil {
+			_ = resp.Body.Close()
+		}
+		requestDone <- errDo
+	}()
+	waitClosed(t, ev.waiting, "the model request to wait at the gate")
+	cancel()
+	if errDo := <-requestDone; errDo == nil {
+		t.Fatal("cancelled model request returned a response while the gate was closed")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for ev.cancelled.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if ev.cancelled.Load() != 1 {
+		t.Fatalf("gate saw %d cancelled waits; want 1", ev.cancelled.Load())
+	}
+	select {
+	case <-ev.opened:
+		t.Fatal("gate opened by the cancelled request")
+	default:
+	}
+}
+
+func TestStartupGatedRoutes(t *testing.T) {
+	for path, want := range map[string]bool{
+		"/v1/messages":               true,
+		"/v1/chat/completions":       true,
+		"/v1/models":                 true,
+		"/v1":                        true,
+		"/v1beta/models":             true,
+		"/openai/v1/responses":       true,
+		"/backend-api/codex/resp":    true,
+		"/v1/ws":                     false,
+		"/healthz":                   false,
+		"/v0/management/config":      false,
+		"/management.html":           false,
+		"/":                          false,
+		"/v1x/other":                 false,
+		"/anthropic/callback":        false,
+		"/keep-alive":                false,
+		"/backend-api/codexless/foo": false,
+	} {
+		if got := startupGated(http.MethodPost, path, "/v1/ws"); got != want {
+			t.Errorf("startupGated(%q) = %t; want %t", path, got, want)
+		}
+	}
+	if startupGated(http.MethodOptions, "/v1/messages", "/v1/ws") {
+		t.Error("preflight requests must not wait at the gate")
+	}
+}
+
+// blockingGateTestStore blocks List (which auth.Manager.Load calls with the manager
+// lock held) until released.
+type blockingGateTestStore struct {
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (s *blockingGateTestStore) List(context.Context) ([]*coreauth.Auth, error) {
+	s.once.Do(func() { close(s.entered) })
+	<-s.release
+	return nil, nil
+}
+
+func (s *blockingGateTestStore) Save(context.Context, *coreauth.Auth) (string, error) {
+	return "", nil
+}
+
+func (s *blockingGateTestStore) Delete(context.Context, string) error { return nil }
+
+// TestStartupGateDeadlineIgnoresManagerLock: while a store operation holds the auth
+// manager's lock, the deadline still opens the gate, the warning is logged, and a
+// second open returns at once. The gate never takes the manager lock.
+func TestStartupGateDeadlineIgnoresManagerLock(t *testing.T) {
+	store := &blockingGateTestStore{entered: make(chan struct{}), release: make(chan struct{})}
+	manager := coreauth.NewManager(store, nil, nil)
+	loadDone := make(chan struct{})
+	listDone := make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() {
+		closeOnce(&releaseOnce, store.release)
+		<-loadDone
+		<-listDone
+	})
+	go func() {
+		defer close(loadDone)
+		_ = manager.Load(context.Background())
+	}()
+	waitClosed(t, store.entered, "the store to block inside Manager.Load")
+	go func() {
+		defer close(listDone)
+		_ = manager.List()
+	}()
+	select {
+	case <-listDone:
+		t.Fatal("Manager.List returned while Load held the manager lock; the probe is not holding it")
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	const bound = 50 * time.Millisecond
+	setGateTestVar(t, &initialAuthReadyWait, bound)
+	warnings := installGateTestWarnHook(t)
+	s := &Service{coreManager: manager}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	armed := time.Now()
+	gate := s.armStartupGate(ctx)
+	waitClosed(t, gate.opened, "the gate to open at the deadline")
+	deadline := time.Now().Add(2 * time.Second)
+	for len(warnings.snapshot()) == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if msgs := warnings.snapshot(); len(msgs) != 1 {
+		t.Fatalf("deadline warnings = %d (%v) within %s of arming; want exactly 1", len(msgs), msgs, time.Since(armed))
+	}
+	secondOpen := make(chan struct{})
+	go func() {
+		defer close(secondOpen)
+		gate.open(startupGateCancelled)
+	}()
+	select {
+	case <-secondOpen:
+	case <-time.After(2 * time.Second):
+		t.Fatal("a second open blocked while the manager lock was held")
+	}
+	if msgs := warnings.snapshot(); len(msgs) != 1 {
+		t.Fatalf("deadline warnings after a second open = %d; want exactly 1", len(msgs))
+	}
+}
