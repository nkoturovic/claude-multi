+package cliproxy
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	internalregistry "github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/util"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+	log "github.com/sirupsen/logrus"
+)
+
+// These tests run Service.Run end to end (upstream start-up order: listener, then
+// watcher) with the real file watcher on a loopback listener whose port the kernel
+// picked. Upstream traffic never leaves the process: the core manager's
+// RoundTripperProvider answers every executor request. Run's Shutdown opens the gate,
+// drains the server and joins the auth update consumer, so once Run returned no
+// request or registration goroutine reads the test hooks any more.
+//
+// The harness sidesteps two data races that unpatched 7.3.15 has at every start, so
+// that -race reports only what this patch could add:
+//   - api.Server.Start and every request read api.Server.cfg, which the watcher's
+//     initial reload rewrites without synchronization (UpdateClientsContext):
+//     OnAfterStart waits until the listener answers, and tests whose gate opens at
+//     the deadline send requests only after Run passed watcher.Start (barrier seam).
+//   - Run's post-start plugin model sync registers concurrently with the consumer's
+//     initial batch (auth.Manager.ReconcileRegistryModelStates vs updateInternal's
+//     Clone): unless a test needs it, the plugin host is removed, which makes both
+//     plugin model syncs no-ops; file auths then register through the consumer only.
+
+const (
+	gateTestAPIKey    = "l8b-startup-key"
+	gateTestAlias     = "l8b-startup-probe"
+	gateTestAuthFile  = "claude-l8b-startup.json"
+	gateTestWarnToken = "initial auth registration not confirmed"
+	// gateTestHoldGuard only turns a would-be hang into a failure.
+	gateTestHoldGuard = 5 * time.Second
+)
+
+// gateTestRoundTripper answers every upstream request with a canned Anthropic message.
+type gateTestRoundTripper struct{ calls atomic.Int64 }
+
+func (rt *gateTestRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	rt.calls.Add(1)
+	if req.Body != nil {
+		_, _ = io.Copy(io.Discard, req.Body)
+		_ = req.Body.Close()
+	}
+	body := `{"id":"msg_l8b","type":"message","role":"assistant","model":"claude","content":[{"type":"text","text":"ok"}],"stop_reason":"end_turn","stop_sequence":null,"usage":{"input_tokens":1,"output_tokens":1}}`
+	return &http.Response{
+		StatusCode:    http.StatusOK,
+		Status:        "200 OK",
+		Header:        http.Header{"Content-Type": []string{"application/json"}},
+		Body:          io.NopCloser(strings.NewReader(body)),
+		ContentLength: int64(len(body)),
+		Request:       req,
+	}, nil
+}
+
+type gateTestRTProvider struct{ rt *gateTestRoundTripper }
+
+func (p gateTestRTProvider) RoundTripperFor(*coreauth.Auth) http.RoundTripper { return p.rt }
+
+// gateTestWarnHook collects the gate deadline warning.
+type gateTestWarnHook struct {
+	mu       sync.Mutex
+	messages []string
+}
+
+func (h *gateTestWarnHook) Levels() []log.Level { return []log.Level{log.WarnLevel} }
+
+func (h *gateTestWarnHook) Fire(entry *log.Entry) error {
+	if strings.Contains(entry.Message, gateTestWarnToken) {
+		h.mu.Lock()
+		h.messages = append(h.messages, entry.Message)
+		h.mu.Unlock()
+	}
+	return nil
+}
+
+func (h *gateTestWarnHook) snapshot() []string {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return append([]string(nil), h.messages...)
+}
+
+func installGateTestWarnHook(t *testing.T) *gateTestWarnHook {
+	t.Helper()
+	logger := log.StandardLogger()
+	previous := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		previous[level] = append([]log.Hook(nil), hooks...)
+	}
+	hook := &gateTestWarnHook{}
+	logger.AddHook(hook)
+	t.Cleanup(func() { logger.ReplaceHooks(previous) })
+	return hook
+}
+
+// setGateTestVar installs a package-level test variable and restores it at cleanup.
+// Call it before h.run: cleanups run LIFO, so the restore happens after Run returned.
+func setGateTestVar[T any](t *testing.T, target *T, value T) {
+	t.Helper()
+	previous := *target
+	*target = value
+	t.Cleanup(func() { *target = previous })
+}
+
+func freeLoopbackPort(t *testing.T) int {
+	t.Helper()
+	listener, errListen := net.Listen("tcp", "127.0.0.1:0")
+	if errListen != nil {
+		t.Fatalf("reserve loopback port: %v", errListen)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	if errClose := listener.Close(); errClose != nil {
+		t.Fatalf("release loopback port: %v", errClose)
+	}
+	return port
+}
+
+func writeGateTestAuthFile(t *testing.T, authDir string) {
+	t.Helper()
+	// Synthetic Claude OAuth file: no refresh token and a far-future expiry, so the
+	// auto-refresh loop has nothing to refresh.
+	content := `{"type":"claude","email":"l8b-startup@example.invalid","access_token":"l8b-synthetic-access","expired":"2099-01-01T00:00:00Z"}`
+	if errWrite := os.WriteFile(filepath.Join(authDir, gateTestAuthFile), []byte(content), 0o600); errWrite != nil {
+		t.Fatalf("write auth file: %v", errWrite)
+	}
+}
+
+type gateTestService struct {
+	service *Service
+	port    int
+	rt      *gateTestRoundTripper
+	watcher chan *WatcherWrapper
+	started time.Time
+	cancel  context.CancelFunc
+	done    chan error
+}
+
+type gateTestOptions struct {
+	hooks          Hooks
+	watcherFactory WatcherFactory
+	withPluginHost bool
+}
+
+// newGateTestService builds a service over authDir. The config file on disk matches
+// the in-memory config (API key, OAuth alias for the Claude channel), so a reload from
+// disk keeps the alias; the alias is served only once the file auth is registered.
+func newGateTestService(t *testing.T, authDir string, opts gateTestOptions) *gateTestService {
+	t.Helper()
+	// Never write logs, discovery or panel assets outside the test's temp dirs.
+	t.Setenv("WRITABLE_PATH", t.TempDir())
+	t.Setenv("writable_path", "")
+	claudeModels := internalregistry.GetClaudeModels()
+	if len(claudeModels) == 0 || claudeModels[0] == nil {
+		t.Fatal("embedded registry has no Claude models")
+	}
+	port := freeLoopbackPort(t)
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	configYAML := fmt.Sprintf("host: 127.0.0.1\nport: %d\nauth-dir: %q\napi-keys:\n  - %s\noauth-model-alias:\n  claude:\n    - name: %q\n      alias: %s\n      fork: true\n",
+		port, authDir, gateTestAPIKey, claudeModels[0].ID, gateTestAlias)
+	if errWrite := os.WriteFile(configPath, []byte(configYAML), 0o600); errWrite != nil {
+		t.Fatalf("write config: %v", errWrite)
+	}
+	cfg, errLoad := config.LoadConfig(configPath)
+	if errLoad != nil {
+		t.Fatalf("load config: %v", errLoad)
+	}
+
+	h := &gateTestService{port: port, watcher: make(chan *WatcherWrapper, 1)}
+	hooks := opts.hooks
+	userAfterStart := hooks.OnAfterStart
+	hooks.OnAfterStart = func(s *Service) {
+		// Order api.Server.Start's config read before the watcher's initial reload.
+		if got := firstResponse(gateTestHTTPClient(), func() *http.Request {
+			req, _ := http.NewRequest(http.MethodGet, h.url("/healthz"), nil)
+			return req
+		}, 10*time.Second, nil); got.err != nil {
+			t.Errorf("listener not answering after start: %v", got.err)
+		}
+		if userAfterStart != nil {
+			userAfterStart(s)
+		}
+	}
+	factory := opts.watcherFactory
+	if factory == nil {
+		factory = func(configPath, authDir string, reload func(*config.Config)) (*WatcherWrapper, error) {
+			w, errCreate := defaultWatcherFactory(configPath, authDir, reload)
+			if errCreate == nil {
+				h.watcher <- w
+			}
+			return w, errCreate
+		}
+	}
+	service, errBuild := NewBuilder().WithConfig(cfg).WithConfigPath(configPath).WithHooks(hooks).WithWatcherFactory(factory).Build()
+	if errBuild != nil {
+		t.Fatalf("Build() failed: %v", errBuild)
+	}
+	if !opts.withPluginHost {
+		service.pluginHost = nil
+	}
+	h.rt = &gateTestRoundTripper{}
+	service.coreManager.SetRoundTripperProvider(gateTestRTProvider{rt: h.rt})
+	h.service = service
+	return h
+}
+
+func (h *gateTestService) run(t *testing.T) {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	h.cancel = cancel
+	done := make(chan error, 1)
+	h.done = done
+	h.started = time.Now()
+	go func() { done <- h.service.Run(ctx) }()
+	t.Cleanup(func() { h.stop(t) })
+}
+
+func (h *gateTestService) stop(t *testing.T) {
+	t.Helper()
+	if h.done == nil {
+		return
+	}
+	h.cancel()
+	done := h.done
+	h.done = nil
+	select {
+	case errRun := <-done:
+		if errRun != nil && !errors.Is(errRun, context.Canceled) {
+			t.Errorf("Run() returned %v", errRun)
+		}
+	case <-time.After(30 * time.Second):
+		t.Fatal("Run() did not return after cancel")
+	}
+	reg := internalregistry.GetGlobalRegistry()
+	for _, auth := range h.service.coreManager.List() {
+		if auth != nil {
+			reg.UnregisterClient(auth.ID)
+		}
+	}
+}
+
+func (h *gateTestService) url(path string) string {
+	return fmt.Sprintf("http://127.0.0.1:%d%s", h.port, path)
+}
+
+func (h *gateTestService) request(ctx context.Context, method, path string, body []byte) *http.Request {
+	req, _ := http.NewRequestWithContext(ctx, method, h.url(path), bytes.NewReader(body))
+	req.Header.Set("Authorization", "Bearer "+gateTestAPIKey)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	return req
+}
+
+func (h *gateTestService) messagesRequest() *http.Request {
+	payload := []byte(`{"model":"` + gateTestAlias + `","max_tokens":8,"messages":[{"role":"user","content":"ping"}]}`)
+	return h.request(context.Background(), http.MethodPost, "/v1/messages", payload)
+}
+
+func gateTestHTTPClient() *http.Client {
+	// Proxy nil: loopback only, whatever the environment says.
+	return &http.Client{Timeout: 20 * time.Second, Transport: &http.Transport{Proxy: nil, DisableKeepAlives: true}}
+}
+
+type gateTestResponse struct {
+	status int
+	body   string
+	at     time.Time
+	err    error
+}
+
+// firstResponse retries until the listener accepts a connection and returns the first
+// HTTP response; onAttempt (optional) runs after every attempt. Safe from any goroutine.
+func firstResponse(client *http.Client, build func() *http.Request, deadline time.Duration, onAttempt func()) gateTestResponse {
+	limit := time.Now().Add(deadline)
+	for time.Now().Before(limit) {
+		resp, errDo := client.Do(build())
+		if onAttempt != nil {
+			onAttempt()
+		}
+		if errDo != nil {
+			time.Sleep(2 * time.Millisecond)
+			continue
+		}
+		at := time.Now()
+		body, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		return gateTestResponse{status: resp.StatusCode, body: string(body), at: at}
+	}
+	return gateTestResponse{err: fmt.Errorf("listener did not answer within %s", deadline)}
+}
+
+func mustFirstResponse(t *testing.T, build func() *http.Request) gateTestResponse {
+	t.Helper()
+	got := firstResponse(gateTestHTTPClient(), build, 20*time.Second, nil)
+	if got.err != nil {
+		t.Fatal(got.err)
+	}
+	return got
+}
+
+func closeOnce(once *sync.Once, ch chan struct{}) { once.Do(func() { close(ch) }) }
+
+// gateTestEvents records the gate seams.
+type gateTestEvents struct {
+	waitOnce, barrierOnce, openOnce sync.Once
+	waiting, barrierQueued, opened  chan struct{}
+	openReason                      atomic.Value
+	routableAtOpen                  atomic.Bool
+	cancelled                       atomic.Int64
+}
+
+func installGateTestEvents(t *testing.T) *gateTestEvents {
+	t.Helper()
+	ev := &gateTestEvents{waiting: make(chan struct{}), barrierQueued: make(chan struct{}), opened: make(chan struct{})}
+	setGateTestVar(t, &startupGateWaitHook, func(event string) {
+		switch event {
+		case "wait":
+			closeOnce(&ev.waitOnce, ev.waiting)
+		case "cancelled":
+			ev.cancelled.Add(1)
+		}
+	})
+	setGateTestVar(t, &startupGateBarrierHook, func() { closeOnce(&ev.barrierOnce, ev.barrierQueued) })
+	setGateTestVar(t, &startupGateOpenHook, func(reason string) {
+		ev.openReason.Store(reason)
+		ev.routableAtOpen.Store(len(util.GetProviderName(gateTestAlias)) > 0)
+		closeOnce(&ev.openOnce, ev.opened)
+	})
+	return ev
+}
+
+func (ev *gateTestEvents) reason() string {
+	reason, _ := ev.openReason.Load().(string)
+	return reason
+}
+
+func waitClosed(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(10 * time.Second):
+		t.Fatalf("timed out waiting for %s", what)
+	}
+}
+
+// TestRunFirstModelRequestDuringStartupIsServed races the first /v1/messages for a
+// file-auth alias against start-up, with channel-controlled registration: the file
+// auth's registration is held until the request is waiting at the gate and the
+// initial barrier is queued (or the gate opened, or the request was already
+// answered). When the gate opens, the alias must already be routable, and the first
+// response must be 200, never 400 model_not_found.
+//
+//   - present-at-start: the file exists before Run and the auth store loads it.
+//   - written-during-start: the file appears after the auth store loaded.
+func TestRunFirstModelRequestDuringStartupIsServed(t *testing.T) {
+	cases := []struct {
+		name           string
+		writeBeforeRun bool
+	}{
+		{name: "present-at-start", writeBeforeRun: true},
+		{name: "written-during-start", writeBeforeRun: false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			authDir := t.TempDir()
+			opts := gateTestOptions{}
+			if tc.writeBeforeRun {
+				writeGateTestAuthFile(t, authDir)
+			} else {
+				opts.hooks.OnBeforeStart = func(*config.Config) { writeGateTestAuthFile(t, authDir) }
+			}
+			setGateTestVar(t, &initialAuthReadyWait, initialAuthReadyTimeout)
+			warnings := installGateTestWarnHook(t)
+			ev := installGateTestEvents(t)
+
+			var answeredOnce sync.Once
+			answered := make(chan struct{})
+			var holdGuardExpired atomic.Bool
+			setGateTestVar(t, &modelRegistrationTaskHook, func() {
+				guard := time.NewTimer(gateTestHoldGuard)
+				defer guard.Stop()
+				select {
+				case <-ev.waiting:
+				case <-answered:
+					return
+				case <-guard.C:
+					holdGuardExpired.Store(true)
+					return
+				}
+				select {
+				case <-ev.barrierQueued:
+				case <-ev.opened:
+				case <-answered:
+				case <-guard.C:
+					holdGuardExpired.Store(true)
+				}
+			})
+
+			h := newGateTestService(t, authDir, opts)
+			results := make(chan gateTestResponse, 1)
+			go func() {
+				got := firstResponse(gateTestHTTPClient(), h.messagesRequest, 20*time.Second, nil)
+				closeOnce(&answeredOnce, answered)
+				results <- got
+			}()
+			h.run(t)
+
+			got := <-results
+			if got.err != nil {
+				t.Fatal(got.err)
+			}
+			if holdGuardExpired.Load() {
+				t.Fatal("registration was held but the request never waited at the gate")
+			}
+			if strings.Contains(got.body, "model_not_found") || strings.Contains(got.body, "unknown provider") || got.status == http.StatusBadRequest {
+				t.Fatalf("first response during start-up = %d %s; want the file-auth alias served", got.status, got.body)
+			}
+			if got.status != http.StatusOK {
+				t.Fatalf("first response during start-up = %d %s; want 200 from the fake upstream", got.status, got.body)
+			}
+			waitClosed(t, ev.opened, "gate open")
+			if reason := ev.reason(); reason != startupGateBarrier {
+				t.Fatalf("gate opened by %q; want %q", reason, startupGateBarrier)
+			}
+			if !ev.routableAtOpen.Load() {
+				t.Fatal("gate opened before the file-auth alias was registered")
+			}
+			if h.rt.calls.Load() == 0 {
+				t.Fatal("request did not reach the in-process upstream round tripper")
+			}
+			if msgs := warnings.snapshot(); len(msgs) != 0 {
+				t.Fatalf("gate deadline warning unexpectedly: %v", msgs)
+			}
+		})
+	}
+}
+
+func waitForGateWarning(warnings *gateTestWarnHook) {
+	deadline := time.Now().Add(2 * time.Second)
+	for len(warnings.snapshot()) == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func assertOneGateWarning(t *testing.T, warnings *gateTestWarnHook, authDir string) {
+	t.Helper()
+	msgs := warnings.snapshot()
+	if len(msgs) != 1 {
+		t.Fatalf("gate deadline warnings = %d (%v); want exactly 1", len(msgs), msgs)
+	}
+	for _, leak := range []string{gateTestAuthFile, "l8b-synthetic-access", "l8b-startup@example.invalid", authDir} {
+		if strings.Contains(msgs[0], leak) {
+			t.Fatalf("gate warning leaks %q: %s", leak, msgs[0])
+		}
+	}
+}
+
+// TestRunGateOpensAtDeadlineWhenConsumerStalls keeps the auth update consumer stuck
+// (as a broken or hanging auth would): the barrier is never released, the gate opens
+// at the deadline, model requests are served, and the warning appears exactly once.
+func TestRunGateOpensAtDeadlineWhenConsumerStalls(t *testing.T) {
+	authDir := t.TempDir()
+	writeGateTestAuthFile(t, authDir)
+	const bound = 400 * time.Millisecond
+	setGateTestVar(t, &initialAuthReadyWait, bound)
+	warnings := installGateTestWarnHook(t)
+	ev := installGateTestEvents(t)
+
+	h := newGateTestService(t, authDir, gateTestOptions{})
+	// handleAuthUpdates takes authUpdateMu first; only the queued-update consumer uses
+	// it, so holding it stalls exactly the initial batch.
+	h.service.authUpdateMu.Lock()
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(h.service.authUpdateMu.Unlock) }
+	h.run(t)
+	t.Cleanup(unblock) // LIFO: before h.run's stop
+	waitClosed(t, ev.barrierQueued, "the initial barrier")
+
+	got := mustFirstResponse(t, func() *http.Request {
+		return h.request(context.Background(), http.MethodGet, "/v1/models", nil)
+	})
+	if got.status != http.StatusOK {
+		t.Fatalf("GET /v1/models after gate deadline = %d %s", got.status, got.body)
+	}
+	if elapsed := got.at.Sub(h.started); elapsed < bound {
+		t.Fatalf("model request answered after %s, before the %s deadline", elapsed, bound)
+	}
+	waitClosed(t, ev.opened, "gate open")
+	if reason := ev.reason(); reason != startupGateDeadline {
+		t.Fatalf("gate opened by %q; want %q", reason, startupGateDeadline)
+	}
+	waitForGateWarning(warnings)
+	assertOneGateWarning(t, warnings, authDir)
+
+	unblock()
+	time.Sleep(200 * time.Millisecond)
+	if again := warnings.snapshot(); len(again) != 1 {
+		t.Fatalf("gate deadline warnings after release = %d; want exactly 1", len(again))
+	}
+}
+
+// TestRunGateOpensAtDeadlineWhenStartStalls adapts the round-2 review scenarios. With
+// the plugin host present, the watcher's initial reload registers the file auth inside
+// watcher.Start; that registration is blocked, and a config reload is requested while
+// Start is stalled (it waits on the watcher's config lock, as upstream). The gate must
+// still open at the deadline with one warning, and while the initial reload's
+// registration is stalled no other registration may start: the consumer gets the
+// initial batch only after Start dispatched it, exactly as upstream (no new
+// registration/consumer overlap). Teardown then releases one registration path at a
+// time, so the upstream races described at the top cannot fire.
+func TestRunGateOpensAtDeadlineWhenStartStalls(t *testing.T) {
+	authDir := t.TempDir()
+	writeGateTestAuthFile(t, authDir)
+	const bound = 400 * time.Millisecond
+	setGateTestVar(t, &initialAuthReadyWait, bound)
+	warnings := installGateTestWarnHook(t)
+	ev := installGateTestEvents(t)
+	release := make(chan struct{})
+	var releaseOnce, firstOnce sync.Once
+	firstCall := make(chan struct{})
+	var registrations atomic.Int64
+	unblock := func() { closeOnce(&releaseOnce, release) }
+	setGateTestVar(t, &modelRegistrationTaskHook, func() {
+		registrations.Add(1)
+		closeOnce(&firstOnce, firstCall)
+		<-release
+	})
+
+	h := newGateTestService(t, authDir, gateTestOptions{withPluginHost: true})
+	h.run(t)
+	reloadDone := make(chan struct{})
+	t.Cleanup(func() { unblock(); <-reloadDone }) // before h.run's stop (LIFO)
+
+	waitClosed(t, firstCall, "the initial reload's registration")
+	watcherWrapper := <-h.watcher
+	go func() {
+		defer close(reloadDone)
+		watcherWrapper.ReloadConfigIfChanged() // blocks until watcher.Start finished
+	}()
+
+	got := mustFirstResponse(t, func() *http.Request {
+		return h.request(context.Background(), http.MethodGet, "/v1/models", nil)
+	})
+	if got.status != http.StatusOK {
+		t.Fatalf("GET /v1/models after gate deadline = %d %s", got.status, got.body)
+	}
+	if elapsed := got.at.Sub(h.started); elapsed < bound {
+		t.Fatalf("model request answered after %s, before the %s deadline", elapsed, bound)
+	}
+	waitClosed(t, ev.opened, "gate open")
+	if reason := ev.reason(); reason != startupGateDeadline {
+		t.Fatalf("gate opened by %q; want %q", reason, startupGateDeadline)
+	}
+	waitForGateWarning(warnings)
+	assertOneGateWarning(t, warnings, authDir)
+	select {
+	case <-reloadDone:
+		t.Fatal("config reload finished while watcher.Start was stalled")
+	default:
+	}
+	if n := registrations.Load(); n != 1 {
+		t.Fatalf("%d registrations started while the initial reload's was stalled; want 1 (no consumer overlap)", n)
+	}
+
+	// Teardown, one registration path at a time: park the consumer, cancel Run (its
+	// post-start plugin sync then registers nothing), release the stalled
+	// registration, let the reload finish, and only then let the consumer go.
+	h.service.authUpdateMu.Lock()
+	h.cancel()
+	unblock()
+	waitClosed(t, reloadDone, "the config reload")
+	h.service.authUpdateMu.Unlock()
+	h.stop(t)
+	if again := warnings.snapshot(); len(again) != 1 {
+		t.Fatalf("gate deadline warnings after release = %d; want exactly 1", len(again))
+	}
+}
