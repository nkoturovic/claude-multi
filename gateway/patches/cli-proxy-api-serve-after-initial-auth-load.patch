@@ -0,0 +1,66 @@
+package watcher
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDispatchAuthBarrierFollowsPendingUpdates(t *testing.T) {
+	queue := make(chan AuthUpdate, 8)
+	w := &Watcher{}
+	w.SetAuthUpdateQueue(queue)
+	defer w.stopDispatch()
+
+	w.dispatchAuthUpdates([]AuthUpdate{
+		{Action: AuthUpdateActionAdd, ID: "a"},
+		{Action: AuthUpdateActionAdd, ID: "b"},
+	})
+	done := w.DispatchAuthBarrier()
+	if done == nil {
+		t.Fatal("DispatchAuthBarrier() = nil with a queue configured")
+	}
+	// A later update for an auth still pending replaces it in place, ahead of the
+	// marker; either way the marker follows every update dispatched before it.
+	w.dispatchAuthUpdates([]AuthUpdate{{Action: AuthUpdateActionModify, ID: "a"}})
+
+	got := make([]AuthUpdate, 0, 3)
+	for len(got) < 3 {
+		select {
+		case update := <-queue:
+			got = append(got, update)
+		case <-time.After(2 * time.Second):
+			t.Fatalf("timed out after %d updates", len(got))
+		}
+	}
+	if got[0].IsBarrier() || got[1].IsBarrier() || !got[2].IsBarrier() {
+		t.Fatalf("barrier must follow every earlier update: %+v", got)
+	}
+	if got[2].Auth != nil || got[2].ID != "" {
+		t.Fatalf("barrier must carry no auth: %+v", got[2])
+	}
+
+	select {
+	case <-done:
+		t.Fatal("barrier released before the consumer released it")
+	default:
+	}
+	got[2].ReleaseBarrier()
+	got[2].ReleaseBarrier() // idempotent
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("barrier not released")
+	}
+	got[0].ReleaseBarrier() // no-op on ordinary updates
+}
+
+func TestDispatchAuthBarrierWithoutQueue(t *testing.T) {
+	w := &Watcher{}
+	if done := w.DispatchAuthBarrier(); done != nil {
+		t.Fatal("DispatchAuthBarrier() without a queue must return nil")
+	}
+	var nilWatcher *Watcher
+	if done := nilWatcher.DispatchAuthBarrier(); done != nil {
+		t.Fatal("DispatchAuthBarrier() on a nil watcher must return nil")
+	}
+}
