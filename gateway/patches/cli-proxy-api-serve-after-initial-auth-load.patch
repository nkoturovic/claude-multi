+// authBarrier is closed once the consumer has applied every update queued before it.
+type authBarrier struct {
+	once sync.Once
+	done chan struct{}
+}
+
+func (b *authBarrier) release() {
+	b.once.Do(func() { close(b.done) })
+}
+
+// dispatchAuthBarrier appends a marker to the pending FIFO. dispatchLoop delivers
+// pending updates in order on one goroutine, so the marker reaches the queue only
+// after every update pending before it. Later updates for an auth already pending
+// replace it in place, ahead of the marker, so the marker never overtakes one.
+func (w *Watcher) dispatchAuthBarrier() <-chan struct{} {
+	if w == nil {
+		return nil
+	}
+	barrier := &authBarrier{done: make(chan struct{})}
+	w.clientsMutex.RLock()
+	defer w.clientsMutex.RUnlock()
+	if w.authQueue == nil {
+		return nil
+	}
+	w.dispatchMu.Lock()
+	if w.pendingUpdates == nil {
+		w.pendingUpdates = make(map[string]AuthUpdate)
+	}
+	// Auth IDs never contain NUL, so the key cannot collide with a real update.
+	key := fmt.Sprintf("\x00barrier:%p", barrier)
+	w.pendingOrder = append(w.pendingOrder, key)
+	w.pendingUpdates[key] = AuthUpdate{Action: authUpdateActionBarrier, barrier: barrier}
+	if w.dispatchCond != nil {
+		w.dispatchCond.Signal()
+	}
+	w.dispatchMu.Unlock()
+	return barrier.done
+}
