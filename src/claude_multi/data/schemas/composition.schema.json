{
  "version": 1,
  "type": "object",
  "required": ["version", "name", "availability", "slots", "native_agents"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "description": { "type": "string", "maxLength": 256 },
    "availability": {
      "type": "object",
      "required": ["providers", "models"],
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": { "enum": ["lead+agents", "lead", "agents", "off"] }
        },
        "models": {
          "type": "object",
          "additionalProperties": { "enum": ["lead+agents", "lead", "agents", "off"] }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "model"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "pattern": "^cm-[a-z][a-z0-9-]*$" },
          "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "lane": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "preferred": { "type": "boolean" }
        }
      }
    },
    "native_agents": {
      "type": "object",
      "required": ["explore", "plan", "general_purpose"],
      "additionalProperties": false,
      "properties": {
        "explore": { "enum": ["replace", "native", "off"] },
        "plan": { "enum": ["native", "off"] },
        "general_purpose": { "enum": ["on", "off"] }
      }
    },
    "workflows": { "enum": ["native", "off"] },
    "seed": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "version": { "const": 1 }
      }
    }
  }
}
