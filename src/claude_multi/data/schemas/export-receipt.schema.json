{
  "version": 1,
  "type": "object",
  "required": ["version", "exported_at", "sha256"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "exported_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
