{
  "version": 1,
  "type": "object",
  "required": [
    "version",
    "path"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(~/|/)"
    }
  }
}
