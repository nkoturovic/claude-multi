{
  "version": 1,
  "type": "object",
  "required": ["version", "record_prefixes", "pools"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "record_prefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "display", "sign_in", "acknowledgement", "record_prefix", "registry"],
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "display": { "type": "string", "minLength": 1, "maxLength": 64 },
          "client_account": { "type": "boolean" },
          "sign_in": {
            "type": "object",
            "required": ["flow", "host", "command", "policies"],
            "additionalProperties": false,
            "properties": {
              "flow": { "enum": ["browser", "device"] },
              "host": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
              },
              "command": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}-login$" },
              "policies": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["public", "public-strict"] }
              }
            }
          },
          "acknowledgement": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9.-]*/[1-9][0-9]*$" },
              "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "record_prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "registry": {
            "type": "object",
            "required": ["section", "sections"],
            "additionalProperties": false,
            "properties": {
              "section": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "sections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
              }
            }
          }
        }
      }
    }
  }
}
