#!/usr/bin/env python3
"""claude-multi-dev: catalog maintenance (draft, check, review, promote).

The source-checkout launcher: an installed package runs the same command
through its console script (claude_multi.entrypoints).
"""

import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_ROOT, "src"))

from claude_multi.entrypoints import prepare_source, run  # noqa: E402

# Inside a source tree: the checkout's own resources and the source channel.
prepare_source(_ROOT)

if __name__ == "__main__":
    raise SystemExit(run("claude-multi-dev"))
